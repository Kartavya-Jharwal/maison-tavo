# Store the agents transact with.
UCP_BUSINESS_URL=https://maison-tavo.myshopify.com

# Public URL of this server's /.well-known/ucp. The store fetches it on every
# call, so localhost won't work. Use the URL printed by `bun run tunnel:agents`.
UCP_AGENT_PROFILE_URL=https://your-tunnel.trycloudflare.com/.well-known/ucp

PORT=4443
