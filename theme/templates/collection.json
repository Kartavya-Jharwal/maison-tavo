    "collection_tree": {
      "type": "maison-collection-tree",
      "settings": {
        "padding-block-start": 12,
        "padding-block-end": 20
      }
    },
    "maison_collection_hero": {
      "type": "maison-collection-hero",
      "name": "Collection hero",
      "settings": {
        "show_buying_guide": true,
        "overlay_enabled": true,
        "padding-block-start": 0,
        "padding-block-end": 0
      }
    }
