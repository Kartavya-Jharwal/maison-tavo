{%- comment -%}
  Brand heading face — Libre Baskerville (OFL, transitional serif).
  High-contrast Baskerville class for luxury kitchenware display.
  Latin 400 is preloaded (critical); 700 + italic load on demand.
  Metric-overridden Georgia fallback keeps swap near-zero-CLS.
{%- endcomment -%}
{{ 'libre-baskerville-latin-400-normal.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: 'anonymous' }}
<style>
  @font-face {
    font-family: 'Libre Baskerville';
    font-style: normal;
    font-weight: 400;
    font-display: swap;
    src: url('{{ 'libre-baskerville-latin-400-normal.woff2' | asset_url }}') format('woff2');
    unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
  }

  @font-face {
    font-family: 'Libre Baskerville';
    font-style: normal;
    font-weight: 700;
    font-display: swap;
    src: url('{{ 'libre-baskerville-latin-700-normal.woff2' | asset_url }}') format('woff2');
    unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
  }

  @font-face {
    font-family: 'Libre Baskerville';
    font-style: italic;
    font-weight: 400;
    font-display: swap;
    src: url('{{ 'libre-baskerville-latin-400-italic.woff2' | asset_url }}') format('woff2');
    unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
  }

  @font-face {
    font-family: 'Libre Baskerville Fallback';
    src: local('Georgia');
    size-adjust: 102%;
    ascent-override: 92%;
    descent-override: 24%;
  }

  :root {
    --font-libre-baskerville--family: 'Libre Baskerville', 'Libre Baskerville Fallback', Georgia, 'Times New Roman', serif;
    --brand-font-heading: var(--font-libre-baskerville--family);
    --font-heading--family: var(--font-libre-baskerville--family);
  }

  .hero__content-wrapper .text-block.h2,
  .hero__content-wrapper .text-block.h1,
  .maison-editorial__title,
  .splash-intro__heading {
    font-family: var(--font-libre-baskerville--family);
    font-weight: 700;
    letter-spacing: -0.01em;
  }
</style>
