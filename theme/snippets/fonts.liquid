  /* ── Noto Serif Devanagari (eyebrow / kansa lockup) — 400 only ───── */
  @font-face {
    font-family: 'Noto Serif Devanagari';
    font-style: normal;
    font-weight: 400;
    font-display: swap;
    src: url('{{ 'noto-serif-devanagari-400-normal.woff2' | asset_url }}') format('woff2');
    unicode-range: U+0900-097F, U+A8E0-A8FF, U+1CD0-1CFF;
  }
  @font-face {
    font-family: 'Noto Serif Devanagari Fallback';
    src: local('Nirmala UI'), local('Mangal'), local('Tiro Devanagari Hindi');
    size-adjust: 100%;
  }

  :root {
    --font-body--family: 'Bai Jamjuree', 'Bai Jamjuree Fallback', system-ui, sans-serif;
    --font-accent--family: 'Satoshi', 'Satoshi Fallback', system-ui, sans-serif;
    --font-subheading--family: var(--font-accent--family);
    --font-instrument-serif--family: 'Instrument Serif', 'Instrument Serif Fallback', 'Instrument Serif Times Fallback', Georgia, serif;
    --font-heading--family: var(--font-instrument-serif--family);
    --font-highlight--family: var(--font-heading--family);
    --font-wordmark--family: 'Noto Serif', 'Noto Serif Wordmark Fallback', Georgia, serif;
    --font-mono--family: 'JetBrains Mono', 'JetBrains Mono Fallback', ui-monospace, monospace;
    --font-devanagari--family: 'Noto Serif Devanagari', 'Noto Serif Devanagari Fallback', 'Tiro Devanagari Hindi', serif;

    --brand-font-body: var(--font-body--family);
    --brand-font-accent: var(--font-accent--family);
    --brand-font-heading: var(--font-heading--family);
    --brand-font-highlight: var(--font-highlight--family);
    --brand-font-wordmark: var(--font-wordmark--family);
    --brand-font-mono: var(--font-mono--family);

    /*
      Maison Utopia modular type scale (OWNER) — rem only, never px font-size.
      Viewport: 320px → 1440px | Body (step 0): 1rem → 1.25rem
      Ratio: mobile minor third 1.2 → desktop perfect fourth 1.333 (4/3)
      Step n: min = 1×1.2^n , max = 1.25×(4/3)^n ; fluid = Utopia clamp(min, i + s·vw, max)
      Preferred ratio: 1.333 (perfect fourth) at max viewport
    */
    --mt-type-xs: clamp(0.6944rem, 0.692rem + 0.0008vw, 0.7031rem); /* −2 */
    --mt-type-sm: clamp(0.8333rem, 0.8036rem + 0.0093vw, 0.9375rem); /* −1 */
    --mt-type-md: clamp(1rem, 0.9286rem + 0.0223vw, 1.25rem); /*  0 body */
    --mt-type-lg: clamp(1.2rem, 1.0667rem + 0.0417vw, 1.6667rem); /* +1 */
    --mt-type-xl: clamp(1.44rem, 1.2165rem + 0.0698vw, 2.2222rem); /* +2 */
    --mt-type-2xl: clamp(1.728rem, 1.3752rem + 0.1103vw, 2.963rem); /* +3 */
    --mt-type-3xl: clamp(2.0736rem, 1.5373rem + 0.1676vw, 3.9506rem); /* +4 */
    --mt-type-4xl: clamp(2.4883rem, 1.6943rem + 0.2481vw, 5.2675rem); /* +5 hero */

    /* Lint / Horizon bridges — alias the modular steps */
    --font-size--fluid-xs: var(--mt-type-xs);
    --font-size--fluid-sm: var(--mt-type-sm);
    --font-size--fluid-md: var(--mt-type-md);
    --font-size--fluid-lg: var(--mt-type-lg);
    --font-size--fluid-xl: var(--mt-type-xl);
    --font-size--fluid-2xl: var(--mt-type-2xl);
    --font-size--fluid-3xl: var(--mt-type-3xl);
    --font-size--fluid-display: var(--mt-type-4xl);

    --font-size--brand-body: var(--mt-type-md);
    --font-size--brand-accent: var(--mt-type-xs);
    --font-size--brand-nav: var(--mt-type-sm);
    --font-size--brand-button: var(--mt-type-xs);
    --font-size--brand-heading: var(--mt-type-2xl);
    --font-size--brand-highlight: var(--mt-type-lg);
    /* Wordmarks sit outside the modular ladder (string-width / cqi) */
    --font-size--brand-wordmark: clamp(1.25rem, 1.05rem + 0.8vw, 1.875rem);
    --font-size--brand-wordmark-display: clamp(2.75rem, 1.4rem + 9cqi, 9rem);
    /*
      Splash wordmark ≈ 69vw string width for "Maison Tavo"
      (Noto Serif 100 + −0.07em tracking → ~5.5em advance) → 69vw / 5.5.
    */
    --font-size--brand-wordmark-splash: clamp(2.75rem, calc(69vw / 5.5), 14rem);

    --letter-spacing--wordmark: -0.07em;
    --font-weight--wordmark: 100;

    /* Early semantic --mt-type roles (Agents 2/3 apply; refreshed in theme-styles-variables) */
    --mt-type-family-body: var(--font-body--family);
    --mt-type-family-accent: var(--font-accent--family);
    --mt-type-family-heading: var(--font-heading--family);
    --mt-type-family-wordmark: var(--font-wordmark--family);
    --mt-type-family-mono: var(--font-mono--family);
    --mt-type-body: var(--mt-type-md);
    --mt-type-accent: var(--mt-type-xs);
    --mt-type-nav: var(--mt-type-sm);
    --mt-type-button: var(--mt-type-xs);
    --mt-type-lede: var(--mt-type-lg);
    --mt-type-title: var(--mt-type-xl);
    --mt-type-heading: var(--mt-type-2xl);
    --mt-type-display: var(--mt-type-3xl);
    --mt-type-display-lg: var(--mt-type-4xl);
    --mt-type-mono: var(--mt-type-xs);
    --mt-type-wordmark: var(--font-size--brand-wordmark);
    --mt-type-wordmark-display: var(--font-size--brand-wordmark-display);
    --mt-type-wordmark-splash: var(--font-size--brand-wordmark-splash);
    --mt-type-tracking-heading: -0.02em;
    --mt-type-tracking-wordmark: var(--letter-spacing--wordmark);
    --mt-type-tracking-accent: 0.08em;
    --mt-type-leading-body: 1.65;
  }

  html {
    font-size: 100%;
  }

  h1, h2, h3, h4, .h1, .h2, .h3, .h4,
  .hero__content-wrapper .text-block.h2,
  .hero__content-wrapper .text-block.h1,
  .maison-editorial__title,
  .maison-hero__headline {
    font-family: var(--mt-type-family-heading, var(--font-heading--family));
    letter-spacing: var(--mt-type-tracking-heading, -0.02em);
  }

  .maison-highlight,
  .maison-hero__headline--italic,
  em.maison-highlight {
    font-family: var(--mt-type-family-heading, var(--font-highlight--family));
    font-style: italic;
  }

  .maison-wordmark,
  .header-logo,
  .header__heading-text,
  .header__heading-link,
  .mt-veil__mark,
  .mt-coda__word,
  .splash-intro__heading {
    font-family: var(--mt-type-family-wordmark, var(--font-wordmark--family));
    font-weight: var(--font-weight--wordmark);
    letter-spacing: var(--mt-type-tracking-wordmark, var(--letter-spacing--wordmark));
    font-kerning: normal;
    font-feature-settings: 'kern' 1, 'liga' 1;
  }

  .maison-devanagari {
    font-family: var(--mt-type-family-devanagari, var(--font-devanagari--family));
    letter-spacing: 0.04em;
  }
</style>
