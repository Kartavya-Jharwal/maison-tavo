<style>
  @font-face {
    font-family: 'Libre Baskerville';
    font-style: normal;
    font-weight: 400;
    font-display: swap;
    src: url('{{ 'libre-baskerville-latin-400-normal.woff2' | asset_url }}') format('woff2');
    unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
  }

  @font-face {
    font-family: 'Libre Baskerville';
    font-style: normal;
    font-weight: 700;
    font-display: swap;
    src: url('{{ 'libre-baskerville-latin-700-normal.woff2' | asset_url }}') format('woff2');
    unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
  }

  @font-face {
    font-family: 'Libre Baskerville';
    font-style: italic;
    font-weight: 400;
    font-display: swap;
    src: url('{{ 'libre-baskerville-latin-400-italic.woff2' | asset_url }}') format('woff2');
    unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
  }

  @font-face {
    font-family: 'Libre Baskerville Fallback';
    src: local('Georgia');
    size-adjust: 102%;
    ascent-override: 92%;
    descent-override: 24%;
  }

  :root {
    --font-heading--family: 'Fraunces', 'Libre Baskerville', Georgia, serif;
    --font-body--family: 'Hanken Grotesk', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    --font-mono--family: 'JetBrains Mono', 'Anonymous Pro', monospace;
    --font-devanagari--family: 'Noto Serif Devanagari', 'Tiro Devanagari Hindi', serif;
    --brand-font-heading: var(--font-heading--family);
    --brand-font-body: var(--font-body--family);
    --brand-font-mono: var(--font-mono--family);
  }

  h1, h2, h3, h4, .h1, .h2, .h3, .h4,
  .hero__content-wrapper .text-block.h2,
  .hero__content-wrapper .text-block.h1,
