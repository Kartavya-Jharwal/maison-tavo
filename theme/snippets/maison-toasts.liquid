{%- doc -%}
  Toast / edge-nudge host for commerce feedback and secondary mail CTA.
  Behaviour: scripts/src/maison-toasts.js (bundled into maison-runtime.js).

  Coordination (popup-releases / mail page agent):
  - Mail page handle: pages/mail
  - Primary popup root: [data-mt-mail-primary]
  - Primary dismiss controls: [data-mt-mail-primary-dismiss] or [data-dismiss]/[data-close] inside primary
  - Events: maison:mail-primary-show | maison:mail-primary-dismiss | maison:mail-primary-convert
  - Storage: mt-mail-primary, mt-mail-nudge, mt-mail-subscribed
  - Imperative API: dispatch maison:toast or window.MaisonToast.show({...})
{%- enddoc -%}

<div
  class="mt-toasts"
  data-mt-toasts
  aria-live="polite"
  aria-relevant="additions text"
  aria-atomic="false"
></div>

{%- comment -%}
  Fallback primary mail CTA. Mail/releases agent may replace with their own
  [data-mt-mail-primary] — this node is skipped when a non-fallback primary exists.
{%- endcomment -%}
<aside
  class="mt-mail-primary"
  data-mt-mail-primary
  data-mt-mail-primary-fallback
  role="dialog"
  aria-modal="false"
  aria-labelledby="mt-mail-primary-title"
  hidden
>
  <div class="mt-mail-primary__icon" aria-hidden="true">
    <i class="fa-solid fa-envelope"></i>
  </div>
  <div class="mt-mail-primary__body">
    <p class="mt-mail-primary__kicker">Mailing list</p>
    <p class="mt-mail-primary__title" id="mt-mail-primary-title">Get the next heat signal.</p>
    <p class="mt-mail-primary__copy">Release cycles open on a list — not a perpetual new-arrivals rail.</p>
    <div class="mt-mail-primary__actions">
      <a class="button" href="/pages/mail" data-mt-mail-primary-join>Join mail</a>
      <button type="button" class="button button-secondary" data-mt-mail-primary-dismiss>Not now</button>
    </div>
  </div>
  <button
    type="button"
    class="mt-mail-primary__close"
    data-mt-mail-primary-dismiss
    aria-label="Dismiss mailing list invitation"
  >
    <i class="fa-solid fa-xmark" aria-hidden="true"></i>
  </button>
</aside>

{% stylesheet %}
  .mt-mail-primary {
    position: fixed;
    inset-inline-start: clamp(0.75rem, 2.5vw, 1.5rem);
    inset-block-end: clamp(0.75rem, 2.5vw, 1.5rem);
    z-index: calc(var(--layer-raised, 20) + 35);
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 0.85rem;
    align-items: start;
    width: min(24rem, calc(100vw - 1.5rem));
    padding: 1rem 1.1rem;
    border: 1px solid rgb(var(--mt-color-bell-rgb, 184, 137, 58) / 0.45);
    background: var(--mt-color-bone, var(--color-background, #f7f2e9));
    color: var(--mt-color-soot, var(--color-foreground, #14110f));
    box-shadow: 0 20px 48px rgb(var(--mt-color-soot-rgb, 20, 17, 15) / 0.16);
  }

  .mt-mail-primary[hidden] {
    display: none;
  }

  .mt-mail-primary__icon {
    color: var(--mt-color-bell, #b8893a);
    margin-block-start: 0.15rem;
  }

  .mt-mail-primary__kicker {
    margin: 0 0 0.35rem;
    font-family: var(--mt-type-family-mono, var(--font-mono--family, ui-monospace, monospace));
    font-size: var(--mt-type-accent, var(--font-size--brand-accent, 0.75rem));
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgb(var(--mt-color-soot-rgb, 20, 17, 15) / 0.62);
  }

  .mt-mail-primary__title {
    margin: 0;
    font-family: var(--mt-type-family-heading, var(--font-heading--family, Georgia, serif));
    font-size: var(--mt-type-title, var(--font-size--fluid-lg, 1.25rem));
    font-weight: 400;
  }

  .mt-mail-primary__copy {
    margin: 0.4rem 0 0.85rem;
    font-size: var(--mt-type-body, var(--font-size--fluid-sm, 0.9375rem));
    color: rgb(var(--mt-color-soot-rgb, 20, 17, 15) / 0.78);
  }

  .mt-mail-primary__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .mt-mail-primary__close {
    appearance: none;
    border: 0;
    background: transparent;
    color: inherit;
    opacity: 0.55;
    padding: 0.15rem;
    cursor: pointer;
  }

  .mt-mail-primary__close:hover,
  .mt-mail-primary__close:focus-visible {
    opacity: 1;
  }

  .mt-mail-primary__close:focus-visible,
  .mt-mail-primary .button:focus-visible {
    outline: 2px solid var(--mt-color-bell, #b8893a);
    outline-offset: 2px;
  }

  @media (prefers-reduced-motion: no-preference) {
    .mt-mail-primary:not([hidden]) {
      animation: mt-toast-in 380ms cubic-bezier(0.22, 1, 0.36, 1);
    }
  }

  html[data-reduced-motion='true'] .mt-mail-primary {
    animation: none !important;
  }

  .mt-toasts {
    position: fixed;
    inset-inline-end: clamp(0.75rem, 2.5vw, 1.5rem);
    inset-block-end: clamp(0.75rem, 2.5vw, 1.5rem);
    z-index: calc(var(--layer-raised, 20) + 40);
    display: flex;
    flex-direction: column-reverse;
    gap: 0.65rem;
    width: min(22.5rem, calc(100vw - 1.5rem));
    pointer-events: none;
  }

  .mt-toast {
    pointer-events: auto;
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 0.75rem;
    align-items: start;
    padding: 0.85rem 0.95rem;
    border: 1px solid rgb(var(--mt-color-soot-rgb, 20, 17, 15) / 0.14);
    background: var(--mt-color-bone, var(--color-background, #f7f2e9));
    color: var(--mt-color-soot, var(--color-foreground, #14110f));
    box-shadow: 0 18px 40px rgb(var(--mt-color-soot-rgb, 20, 17, 15) / 0.16);
    font-family: var(--mt-type-family-body, var(--font-body--family, Georgia, serif));
    font-size: var(--mt-type-body, var(--font-size--fluid-sm, 0.9375rem));
    line-height: 1.35;
  }

  .mt-toast--error {
    border-color: rgb(var(--mt-color-ember-rgb, 226, 85, 43) / 0.45);
  }

  .mt-toast--nudge {
    border-color: rgb(var(--mt-color-bell-rgb, 184, 137, 58) / 0.55);
  }

  .mt-toast__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    inline-size: 1.25rem;
    block-size: 1.25rem;
    margin-block-start: 0.1rem;
    color: var(--mt-color-bell, #b8893a);
  }

  .mt-toast--error .mt-toast__icon {
    color: var(--mt-color-ember, #e2552b);
  }

  .mt-toast__body {
    display: grid;
    gap: 0.35rem;
    min-inline-size: 0;
  }

  .mt-toast__message {
    margin: 0;
  }

  .mt-toast__action {
    justify-self: start;
    font-family: var(--mt-type-family-mono, var(--font-mono--family, ui-monospace, monospace));
    font-size: var(--mt-type-accent, var(--font-size--brand-accent, 0.75rem));
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--mt-color-clay, #8e4b35);
    text-decoration: underline;
    text-underline-offset: 0.18em;
  }

  .mt-toast__action:focus-visible {
    outline: 2px solid var(--mt-color-bell, #b8893a);
    outline-offset: 3px;
  }

  .mt-toast__dismiss {
    appearance: none;
    border: 0;
    background: transparent;
    color: inherit;
    opacity: 0.55;
    padding: 0.15rem;
    inline-size: 1.5rem;
    block-size: 1.5rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
  }

  .mt-toast__dismiss:hover {
    opacity: 1;
  }

  .mt-toast__dismiss:focus-visible {
    outline: 2px solid var(--mt-color-bell, #b8893a);
    outline-offset: 2px;
    opacity: 1;
  }

  @media (prefers-reduced-motion: no-preference) {
    .mt-toast:not([data-static='true']) {
      animation: mt-toast-in 360ms cubic-bezier(0.22, 1, 0.36, 1);
    }

    .mt-toast[data-leaving='true'] {
      animation: mt-toast-out 260ms ease forwards;
    }
  }

  html[data-reduced-motion='true'] .mt-toast {
    animation: none !important;
  }

  @keyframes mt-toast-in {
    from {
      opacity: 0;
      transform: translateY(0.75rem);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes mt-toast-out {
    to {
      opacity: 0;
      transform: translateY(0.4rem);
    }
  }
{% endstylesheet %}
