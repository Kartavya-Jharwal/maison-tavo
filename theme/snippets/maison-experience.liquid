{%- doc -%}
  Site-wide client layers:
  1. 45% exploration profiler (localStorage only).
  2. Consent & Accessibility Preferences bar (Reduced Cookies + Reduced Animations toggle).
  3. Toast host is separate: snippets/maison-toasts.liquid (bundled in maison-runtime.js).
  Behaviour lives in scripts/src/maison-runtime.js.
{%- enddoc -%}

<dialog class="mt-profiler" data-mt-profiler aria-labelledby="mt-profiler-title">
  <button type="button" class="mt-profiler__close" data-mt-dialog-close aria-label="Close kitchen finder">&times;</button>
  <header class="mt-profiler__head">
    <p class="mt-profiler__kicker">Your kitchen · Stays on this device</p>
    <h2 class="mt-profiler__title" id="mt-profiler-title">Find cookware that fits</h2>
  </header>
  <form class="mt-profiler__form" data-mt-profiler-form>
    <section data-mt-step>
      <h3 tabindex="-1">Want help finding a piece for your kitchen?</h3>
      <p>Choose your hob and cooking style to highlight suitable pieces.</p>
      <div class="mt-profiler__actions">
        <button type="button" class="button" data-mt-next>Find my fit</button>
        <button type="button" class="button-secondary" data-mt-dialog-close>Maybe later</button>
      </div>
    </section>
    <section data-mt-step hidden>
      <h3 tabindex="-1">What do you cook on?</h3>
      <fieldset class="mt-profiler__q">
        <legend class="visually-hidden">Heat source</legend>
        <label><input type="radio" name="heat" value="induction"> Induction</label>
        <label><input type="radio" name="heat" value="flame"> Open flame</label>
      </fieldset>
      <button type="button" class="button" data-mt-next disabled>Continue</button>
    </section>
    <section data-mt-step hidden>
      <h3 tabindex="-1">How do you cook most often?</h3>
      <fieldset class="mt-profiler__q">
        <legend class="visually-hidden">Cooking style</legend>
        <label><input type="radio" name="style" value="sear"> High-heat searing</label>
        <label><input type="radio" name="style" value="simmer"> Slow simmer</label>
      </fieldset>
      <div class="mt-profiler__actions">
        <button type="button" class="button" data-mt-next disabled>Continue</button>
        <button type="button" class="button-secondary" data-mt-back>Back</button>
      </div>
    </section>
    <section data-mt-step hidden>
      <h3 tabindex="-1">Save your kitchen profile</h3>
      <label class="mt-profiler__email" for="MtProfilerEmail">Email (optional, stays on this device)</label>
      <input id="MtProfilerEmail" type="email" name="email" autocomplete="email">
      <p>Leave it blank to save just your cooking preferences.</p>
      <div class="mt-profiler__actions">
        <button type="submit" class="button">Save my preferences</button>
        <button type="button" class="button-secondary" data-mt-back>Back</button>
      </div>
    </section>
    <p data-mt-profile-error role="alert" hidden>Your browser couldn’t save these preferences.</p>
  </form>
</dialog>

<dialog class="mt-profiler" data-mt-exit-mail aria-labelledby="MtExitMailTitle">
  <button type="button" class="mt-profiler__close" data-mt-dialog-close aria-label="Close email invitation">&times;</button>
  <header class="mt-profiler__head">
    <h2 class="mt-profiler__title" id="MtExitMailTitle">Before you go</h2>
  </header>
  <section data-mt-step>
    <h3 tabindex="-1">Want cookware care notes and release updates?</h3>
    <p><a href="/pages/care">Read the cookware care guide</a> anytime.</p>
    <div class="mt-profiler__actions">
      <button type="button" class="button" data-mt-next>Yes, keep me posted</button>
      <button type="button" class="button-secondary" data-mt-dialog-close>No thanks</button>
    </div>
  </section>
  <section data-mt-step hidden>
    <h3 tabindex="-1">Where should we send updates?</h3>
    {% form 'customer', id: 'MaisonExitSignup', class: 'mt-profiler__form', return_to: request.path %}
      <input type="hidden" name="contact[tags]" value="newsletter">
      <label class="mt-profiler__email" for="MtExitEmail">Email</label>
      <input id="MtExitEmail" type="email" name="contact[email]" autocomplete="email" required>
      <p>Subscribe to Maison Tavo care notes and release emails. Unsubscribe anytime.</p>
      <button type="submit" class="button">Subscribe</button>
      {% if form.posted_successfully? %}
        <p data-mt-newsletter-success role="status">You’re on the list.</p>
      {% elsif form.errors %}
        <p data-mt-newsletter-error role="alert">{{ form.errors | default_errors }}</p>
      {% endif %}
    {% endform %}
  </section>
</dialog>

<!-- Consent & Accessibility Preferences Bar -->
<aside class="mt-consent-bar" data-mt-consent-bar role="region" aria-label="Privacy and accessibility preferences" hidden>
  <div class="mt-consent-bar__inner">
    <div class="mt-consent-bar__content">
      <p class="mt-consent-bar__eyebrow">Local Storage &amp; Motion Controls</p>
      <p class="mt-consent-bar__text">
        Maison Tavo stores kitchen preferences strictly on your device. We respect sensory comfort and low-bandwidth browsing.
      </p>
    </div>
    <div class="mt-consent-bar__actions">
      <button type="button" class="button mt-btn-sm" data-mt-consent-action="all">Accept All</button>
      <button type="button" class="button button-secondary mt-btn-sm" data-mt-consent-action="essential">Reduced Cookies</button>
      <button type="button" class="button button-secondary mt-btn-sm mt-motion-btn" data-mt-reduced-motion-toggle aria-label="Reduced motion" aria-pressed="false">
        Reduced Motion: <span data-mt-motion-label>OFF</span>
      </button>
    </div>
  </div>
</aside>

{% stylesheet %}
  .mt-profiler {
    inset: auto 0 var(--mt-space-md);
    inline-size: min(calc(100% - 2 * var(--mt-space-md)), 32rem);
    max-block-size: calc(100dvh - 2 * var(--mt-space-md));
    margin-inline: auto;
    padding: var(--mt-space-gutter);
    border: 1px solid var(--mt-surface-border);
    border-radius: var(--style-border-radius-lg);
    background: var(--mt-surface-raised);
    color: var(--mt-surface-ink);
    box-shadow: 0 16px 45px rgb(var(--mt-color-soot-rgb) / 0.22);
  }

  .mt-profiler [hidden] { display: none; }
  .mt-profiler::backdrop { background: rgb(var(--mt-color-soot-rgb) / 0.42); }

  .mt-profiler__close {
    position: absolute;
    inset-block-start: var(--mt-space-sm);
    inset-inline-end: var(--mt-space-sm);
    min-inline-size: var(--minimum-touch-target);
    min-block-size: var(--minimum-touch-target);
    border: 1px solid currentColor;
    border-radius: 50%;
    background: var(--mt-surface-raised);
    color: color-mix(in srgb, var(--color-error) 62%, var(--mt-surface-ink));
    font: 500 var(--mt-type-title) / 1 var(--mt-type-family-accent);
    cursor: pointer;
  }

  .mt-profiler__head {
    padding-inline-end: calc(var(--minimum-touch-target) + var(--mt-space-xs));
    margin-block-end: var(--mt-space-md);
  }

  .mt-profiler__kicker,
  .mt-consent-bar__eyebrow {
    margin: 0 0 var(--mt-space-xs);
    font: var(--mt-type-nav) / 1.4 var(--mt-type-family-accent);
  }

  .mt-profiler__title,
  .mt-profiler h3 {
    color: inherit;
    margin: 0 0 var(--mt-space-xs);
    text-wrap: balance;
  }

  .mt-profiler__title { font-size: var(--mt-type-heading); }
  .mt-profiler h3 { font-size: var(--mt-type-title); }
  .mt-profiler p { margin-block: 0 var(--mt-space-sm); }

  .mt-profiler__q {
    display: grid;
    gap: var(--mt-space-xs);
    margin: 0 0 var(--mt-space-md);
    padding: 0;
    border: 0;
  }

  .mt-profiler__q label,
  .mt-profiler input[type='email'] {
    min-block-size: var(--minimum-touch-target);
    padding: var(--mt-space-xs) var(--mt-space-sm);
    border: 1px solid color-mix(in srgb, var(--mt-surface-ink) 48%, transparent);
    border-radius: var(--style-border-radius-inputs);
    background: var(--mt-surface-raised);
    color: var(--mt-surface-ink);
  }

  .mt-profiler__q label {
    display: flex;
    align-items: center;
    gap: var(--mt-space-xs);
    cursor: pointer;
  }

  .mt-profiler__q label:has(:checked) {
    background: var(--mt-surface-ink);
    color: var(--mt-surface-raised);
  }

  .mt-profiler :is(button, a, input):focus-visible,
  .mt-profiler__q label:has(:focus-visible) {
    outline: 2px solid currentColor;
    outline-offset: 3px;
  }

  .mt-profiler__email {
    display: block;
    margin-block-end: var(--mt-space-xs);
    font-weight: 600;
  }

  .mt-profiler input[type='email'] {
    inline-size: 100%;
    margin-block-end: var(--mt-space-sm);
    font: inherit;
  }

  .mt-profiler__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--mt-space-xs);
  }

  @media (prefers-reduced-motion: no-preference) {
    html:not([data-reduced-motion='true']) .mt-profiler[open] {
      animation: mt-dialog-in 340ms cubic-bezier(0.2, 0.75, 0.3, 1) both;
    }

    html:not([data-reduced-motion='true']) .mt-profiler[open]::backdrop {
      animation: mt-dialog-dim 250ms linear both;
    }

    html:not([data-reduced-motion='true']) .mt-profiler [data-mt-step-enter] {
      animation: mt-step-in 220ms cubic-bezier(0.2, 0.75, 0.3, 1) both;
    }
  }

  @keyframes mt-dialog-in {
    from { transform: translateY(1.25rem) scale(0.985); opacity: 0; }
  }

  @keyframes mt-dialog-dim {
    from { opacity: 0; }
  }

  @keyframes mt-step-in {
    from { transform: translateY(0.4rem); opacity: 0; }
  }

  .mt-reset {
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
    text-decoration: underline;
    text-underline-offset: 3px;
    cursor: pointer;
  }

  /* --- Consent & Motion Bar --- */
  .mt-consent-bar {
    position: fixed;
    inset-inline: clamp(0.75rem, 2vw, 1.5rem);
    inset-block-end: clamp(0.75rem, 2vw, 1.5rem);
    z-index: 999;
    background: var(--bone, #F7F2E9);
    border: 1px solid rgba(184, 137, 58, 0.4);
    box-shadow: 0 16px 40px rgba(20, 17, 15, 0.14);
    padding: 1rem 1.25rem;
    border-radius: 4px;
    max-width: 58rem;
    margin-inline: auto;
    color: var(--soot, #14110F);
  }

  .mt-consent-bar[hidden] {
    display: none;
  }

  .mt-consent-bar__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem;
    flex-wrap: wrap;
  }

  .mt-consent-bar__content {
    flex: 1 1 20rem;
  }

  .mt-consent-bar__eyebrow {
    color: var(--bell, #B8893A);
    margin-bottom: 0.25rem;
  }

  .mt-consent-bar__text {
    margin: 0;
    font-size: var(--mt-type-accent);
    line-height: 1.45;
    color: rgba(20, 17, 15, 0.85);
  }

  .mt-consent-bar__actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .mt-btn-sm {
    padding: 0.5rem 0.875rem !important;
    font-size: var(--mt-type-accent) !important;
    min-height: 36px !important;
    line-height: 1.2 !important;
    white-space: nowrap;
  }

  .mt-motion-btn {
    font-family: var(--mt-type-family-mono) !important;
    letter-spacing: 0.05em;
  }

  html[data-reduced-motion="true"] *,
  html[data-reduced-motion="true"] *::before,
  html[data-reduced-motion="true"] *::after {
    animation-duration: 0.001ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.001ms !important;
    scroll-behavior: auto !important;
  }
{% endstylesheet %}
