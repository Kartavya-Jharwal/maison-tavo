{%- doc -%}
  Site-wide client layers:
  1. 45% exploration profiler (localStorage only).
  2. Consent & Accessibility Preferences bar (Reduced Cookies + Reduced Animations toggle).
  Behaviour lives in scripts/src/maison-runtime.js.
{%- enddoc -%}

<!-- 45% Exploration Profiler Modal -->
<section class="mt-profiler" data-mt-profiler role="dialog" aria-modal="false" aria-labelledby="mt-profiler-title" hidden>
  <form class="mt-profiler__form" data-mt-profiler-form>
    <div class="mt-profiler__head">
      <p class="mt-profiler__kicker">Your kitchen · stays on this device</p>
      <h2 class="mt-profiler__title" id="mt-profiler-title">Two questions, then we'll mark what suits you.</h2>
    </div>

    <fieldset class="mt-profiler__q">
      <legend>What do you cook on?</legend>
      <label><input type="radio" name="heat" value="induction" required> Induction</label>
      <label><input type="radio" name="heat" value="flame"> Open flame</label>
    </fieldset>

    <fieldset class="mt-profiler__q">
      <legend>How do you cook?</legend>
      <label><input type="radio" name="style" value="sear" required> High-heat searing</label>
      <label><input type="radio" name="style" value="simmer"> Slow simmer</label>
    </fieldset>

    <label class="mt-profiler__email">
      <span>Email <small>(optional, never sent)</small></span>
      <input type="email" name="email" autocomplete="email">
    </label>

    <div class="mt-profiler__actions">
      <button type="submit" class="button">Save to this device</button>
      <button type="button" class="button button-secondary" data-mt-profiler-later>Later</button>
    </div>
  </form>
</section>

<!-- Consent & Accessibility Preferences Bar -->
<aside class="mt-consent-bar" data-mt-consent-bar role="region" aria-label="Privacy and accessibility preferences" hidden>
  <div class="mt-consent-bar__inner">
    <div class="mt-consent-bar__content">
      <p class="mt-consent-bar__eyebrow">Local Storage &amp; Motion Controls</p>
      <p class="mt-consent-bar__text">
        Maison Tavo stores kitchen preferences strictly on your device. We respect sensory comfort and low-bandwidth browsing.
      </p>
    </div>
    <div class="mt-consent-bar__actions">
      <button type="button" class="button mt-btn-sm" data-mt-consent-action="all">Accept All</button>
      <button type="button" class="button button-secondary mt-btn-sm" data-mt-consent-action="essential">Reduced Cookies</button>
      <button type="button" class="button button-secondary mt-btn-sm mt-motion-btn" data-mt-reduced-motion-toggle aria-pressed="false">
        Reduced Motion: <span data-mt-motion-label>OFF</span>
      </button>
    </div>
  </div>
</aside>

{% stylesheet %}
  /* --- 45% Profiler Modal --- */
  .mt-profiler {
    position: fixed;
    inset-inline: clamp(0.75rem, 3vw, 2rem);
    inset-block-end: clamp(0.75rem, 3vw, 2rem);
    z-index: var(--layer-flat, 10);
    max-width: 44rem;
    margin-inline: auto;
    padding: clamp(1.25rem, 3vw, 2rem);
    border: 1px solid rgb(var(--color-foreground-rgb) / 0.15);
    background: var(--color-background);
    color: var(--color-foreground);
    box-shadow: 0 24px 60px rgb(0 0 0 / 0.18);
  }

  .mt-profiler[hidden] {
    display: none;
  }

  @media (prefers-reduced-motion: no-preference) {
    .mt-profiler:not([hidden]) {
      animation: mt-rise 420ms cubic-bezier(0.22, 1, 0.36, 1);
    }
  }

  @keyframes mt-rise {
    from { transform: translateY(24px); opacity: 0; }
  }

  .mt-profiler__form {
    display: grid;
    gap: 1.25rem;
  }

  .mt-profiler__kicker,
  .mt-profiler__q legend,
  .mt-profiler__email span,
  .mt-consent-bar__eyebrow {
    margin: 0 0 0.5rem;
    font-family: var(--font-mono--family, ui-monospace, monospace);
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgb(var(--color-foreground-rgb) / 0.7);
  }

  .mt-profiler__title {
    margin: 0;
    font-family: var(--font-heading--family);
    font-size: clamp(1.25rem, 1rem + 1vw, 1.75rem);
    font-weight: 400;
  }

  .mt-profiler__q {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    border: 0;
  }

  .mt-profiler__q legend {
    width: 100%;
  }

  .mt-profiler__q label {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 44px;
    padding: 0 1rem;
    border: 1px solid rgb(var(--color-foreground-rgb) / 0.2);
    border-radius: 999px;
    cursor: pointer;
  }

  .mt-profiler__q label:has(:checked) {
    border-color: var(--color-foreground);
    background: var(--color-foreground);
    color: var(--color-background);
  }

  .mt-profiler__q label:has(:focus-visible) {
    outline: 2px solid var(--bell, #b8893a);
    outline-offset: 2px;
  }

  .mt-profiler__email {
    display: grid;
  }

  .mt-profiler__email input {
    min-height: 44px;
    padding: 0 0.75rem;
    border: 1px solid rgb(var(--color-foreground-rgb) / 0.25);
    background: transparent;
    color: inherit;
  }

  .mt-profiler__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .mt-reset {
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
    text-decoration: underline;
    text-underline-offset: 3px;
    cursor: pointer;
  }

  /* --- Consent & Motion Bar --- */
  .mt-consent-bar {
    position: fixed;
    inset-inline: clamp(0.75rem, 2vw, 1.5rem);
    inset-block-end: clamp(0.75rem, 2vw, 1.5rem);
    z-index: 999;
    background: var(--bone, #F7F2E9);
    border: 1px solid rgba(184, 137, 58, 0.4);
    box-shadow: 0 16px 40px rgba(20, 17, 15, 0.14);
    padding: 1rem 1.25rem;
    border-radius: 4px;
    max-width: 58rem;
    margin-inline: auto;
    color: var(--soot, #14110F);
  }

  .mt-consent-bar[hidden] {
    display: none;
  }

  .mt-consent-bar__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem;
    flex-wrap: wrap;
  }

  .mt-consent-bar__content {
    flex: 1 1 20rem;
  }

  .mt-consent-bar__eyebrow {
    color: var(--bell, #B8893A);
    margin-bottom: 0.25rem;
  }

  .mt-consent-bar__text {
    margin: 0;
    font-size: 0.8125rem;
    line-height: 1.45;
    color: rgba(20, 17, 15, 0.85);
  }

  .mt-consent-bar__actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .mt-btn-sm {
    padding: 0.5rem 0.875rem !important;
    font-size: 0.75rem !important;
    min-height: 36px !important;
    line-height: 1.2 !important;
    white-space: nowrap;
  }

  .mt-motion-btn {
    font-family: var(--font-mono--family, monospace) !important;
    letter-spacing: 0.05em;
  }

  html[data-reduced-motion="true"] *,
  html[data-reduced-motion="true"] *::before,
  html[data-reduced-motion="true"] *::after {
    animation-duration: 0.001ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.001ms !important;
    scroll-behavior: auto !important;
  }
{% endstylesheet %}
