{%- doc -%}
  Store policy navigation sourced from `shop.policies`, so it always matches the
  policies the merchant has published in Admin. Rendered on policy routes and
  anywhere else a policy index is useful.

  @example
  {% render 'maison-policy-nav' %}
{%- enddoc -%}

{%- if shop.policies.size > 0 -%}
  <nav class="maison-policy-nav" aria-label="Store policies">
    <h2 class="maison-policy-nav__title">Store policies</h2>
    <ul class="maison-policy-nav__list">
      {%- for policy in shop.policies -%}
        <li class="maison-policy-nav__item">
          <a
            href="{{ policy.url }}"
            {% if request.path == policy.url %}
              aria-current="page"
            {% endif %}
          >
            {{ policy.title }}
          </a>
        </li>
      {%- endfor -%}
    </ul>
  </nav>

  {% style %}
    .maison-policy-nav {
      width: 100%;
      max-width: var(--normal-content-width, 48rem);
      margin: 0 auto var(--margin-2xl, 2rem);
      padding: var(--padding-lg, 1rem) 0;
      border-block: 1px solid rgb(var(--color-foreground-rgb) / 0.15);
    }

    .maison-policy-nav__title {
      margin: 0 0 var(--margin-sm, 0.75rem);
      font-family: var(--font-mono--family, monospace);
      font-size: var(--font-size--body-xs, 0.75rem);
      font-weight: 400;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: rgb(var(--color-foreground-rgb) / 0.7);
    }

    .maison-policy-nav__list {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem 1.25rem;
      margin: 0;
      padding: 0;
      list-style: none;
    }

    .maison-policy-nav__item a {
      color: inherit;
      text-decoration: none;
      border-bottom: 1px solid transparent;
    }

    .maison-policy-nav__item a:hover,
    .maison-policy-nav__item a:focus-visible,
    .maison-policy-nav__item a[aria-current='page'] {
      border-bottom-color: currentColor;
    }
  {% endstyle %}
{%- endif -%}
