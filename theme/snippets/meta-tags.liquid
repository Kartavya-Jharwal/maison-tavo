{% doc %}
  Renders all meta tags for the page including robots, Open Graph, Twitter
  Cards, article metadata, and SEO tags.

  Product and Article pages get their schema.org payloads from Shopify's
  `structured_data` filter elsewhere; this snippet only owns the document
  metadata contract.

  @param {object} [product] - The product object, available on product pages for price meta tags.
{% enddoc %}

<meta charset="utf-8">
<meta
  http-equiv="X-UA-Compatible"
  content="IE=edge"
>
<meta
  name="viewport"
  content="width=device-width,initial-scale=1,viewport-fit=cover"
>
<meta
  name="theme-color"
  content=""
>

{%- liquid
  assign og_title = page_title | default: shop.name
  assign og_url = canonical_url | default: request.origin
  assign og_type = 'website'
  assign og_description = page_description | default: shop.description | default: shop.name
  assign robots = 'index,follow'

  if request.page_type == 'product'
    assign og_type = 'product'
  elsif request.page_type == 'article'
    assign og_type = 'article'
  elsif request.page_type == 'password'
    assign og_url = request.origin
  endif

  comment
    Faceted and internal search URLs are crawl traps; carts and error pages
    carry no indexable content. Everything else stays indexable so collection
    and product routes remain discoverable.
  endcomment
  if request.page_type == 'search'
    if search.performed
      assign robots = 'noindex,follow'
    endif
  elsif request.page_type == 'cart' or request.page_type == '404' or request.page_type == 'password'
    assign robots = 'noindex,follow'
  endif
-%}

<meta
  name="robots"
  content="{{ robots }}"
>

<meta
  property="og:site_name"
  content="{{ shop.name }}"
>
<meta
  property="og:url"
  content="{{ og_url }}"
>
<meta
  property="og:title"
  content="{{ og_title | escape }}"
>
<meta
  property="og:type"
  content="{{ og_type }}"
>
<meta
  property="og:description"
  content="{{ og_description | escape }}"
>
<meta
  property="og:locale"
  content="{{ request.locale.iso_code | replace: '-', '_' }}"
>

{%- if page_image -%}
  <meta
    property="og:image"
    content="http:{{ page_image | image_url }}"
  >
  <meta
    property="og:image:secure_url"
    content="https:{{ page_image | image_url }}"
  >
  <meta
    property="og:image:width"
    content="{{ page_image.width }}"
  >
  <meta
    property="og:image:height"
    content="{{ page_image.height }}"
  >
  <meta
    property="og:image:alt"
    content="{{ page_image.alt | default: og_title | escape }}"
  >
{%- endif -%}

{%- if request.page_type == 'product' -%}
  {%- assign og_variant = product.selected_or_first_available_variant -%}
  <meta
    property="og:price:amount"
    content="{{ og_variant.price | money_without_currency | strip_html }}"
  >
  <meta
    property="og:price:currency"
    content="{{ cart.currency.iso_code }}"
  >
  <meta
    property="product:brand"
    content="{{ product.vendor | default: shop.name | escape }}"
  >
  <meta
    property="product:availability"
    content="{% if og_variant.available %}in stock{% else %}out of stock{% endif %}"
  >
  <meta
    property="product:condition"
    content="new"
  >
  <meta
    property="product:price:amount"
    content="{{ og_variant.price | money_without_currency | strip_html }}"
  >
  <meta
    property="product:price:currency"
    content="{{ cart.currency.iso_code }}"
  >
{%- endif -%}

{%- if request.page_type == 'article' -%}
  <meta
    property="article:published_time"
    content="{{ article.published_at | date: '%Y-%m-%dT%H:%M:%S%z' }}"
  >
  {%- if article.updated_at -%}
    <meta
      property="article:modified_time"
      content="{{ article.updated_at | date: '%Y-%m-%dT%H:%M:%S%z' }}"
    >
  {%- endif -%}
  <meta
    property="article:author"
    content="{{ article.author | escape }}"
  >
  <meta
    property="article:section"
    content="{{ blog.title | escape }}"
  >
  {%- for tag in article.tags limit: 6 -%}
    <meta
      property="article:tag"
      content="{{ tag | escape }}"
    >
  {%- endfor -%}
{%- endif -%}

{%- if settings.social_twitter_link != blank -%}
  <meta
    name="twitter:site"
    content="{{ settings.social_twitter_link | split: 'twitter.com/' | last | prepend: '@' }}"
  >
{%- endif -%}
<meta
  name="twitter:card"
  content="summary_large_image"
>
<meta
  name="twitter:title"
  content="{{ og_title | escape }}"
>
<meta
  name="twitter:description"
  content="{{ og_description | escape }}"
>
{%- if page_image -%}
  <meta
    name="twitter:image"
    content="https:{{ page_image | image_url }}"
  >
  <meta
    name="twitter:image:alt"
    content="{{ page_image.alt | default: og_title | escape }}"
  >
{%- endif -%}

<title>
  {{ page_title }}
  {%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif -%}
  {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
  {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
</title>

<link
  rel="canonical"
  href="{{ canonical_url }}"
>

{% if page_description %}
  <meta
    name="description"
    content="{{ page_description | escape }}"
  >
{% endif %}
