{%- doc -%}
  Emits the storefront identity graph once per page: Organization, WebSite and
  the site-wide SearchAction. Route-specific entities (CollectionPage, Blog,
  SearchResultsPage, WebPage) live in `maison-route-jsonld.liquid`.

  The graph is deliberately independent of Shopify's `structured_data` filter
  (which only covers Product and Article) so every route advertises a stable
  `@id` for the brand, the site, and the storefront search endpoint.

  @example
  {% render 'maison-seo-graph' %}
{%- enddoc -%}

{%- liquid
  assign home_url = request.origin | append: routes.root_url
  assign organization_id = home_url | append: '#organization'
  assign website_id = home_url | append: '#website'
  assign search_url = request.origin | append: routes.search_url

  assign logo_url = ''
  if settings.logo != blank
    assign logo_url = settings.logo | image_url: width: 600 | prepend: 'https:'
  endif

  assign social_urls = ''
  if settings.social_instagram_link != blank
    assign social_urls = social_urls | append: settings.social_instagram_link | append: '|'
  endif
  if settings.social_facebook_link != blank
    assign social_urls = social_urls | append: settings.social_facebook_link | append: '|'
  endif
  if settings.social_twitter_link != blank
    assign social_urls = social_urls | append: settings.social_twitter_link | append: '|'
  endif
  if settings.social_pinterest_link != blank
    assign social_urls = social_urls | append: settings.social_pinterest_link | append: '|'
  endif
  if settings.social_tiktok_link != blank
    assign social_urls = social_urls | append: settings.social_tiktok_link | append: '|'
  endif
  if settings.social_youtube_link != blank
    assign social_urls = social_urls | append: settings.social_youtube_link | append: '|'
  endif
  assign social_list = social_urls | split: '|'
-%}

<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "Organization",
        "@id": {{ organization_id | json }},
        "name": {{ shop.name | json }},
        "url": {{ home_url | json }},
        "description": {{ shop.description | default: shop.name | json }}
        {%- if logo_url != blank -%},
        "logo": {
          "@type": "ImageObject",
          "url": {{ logo_url | json }}
        }
        {%- endif -%}
        {%- if social_list.size > 0 -%},
        "sameAs": [
          {%- for social_url in social_list -%}
            {{ social_url | json }}{% unless forloop.last %},{% endunless %}
          {%- endfor -%}
        ]
        {%- endif -%}
      },
      {
        "@type": "WebSite",
        "@id": {{ website_id | json }},
        "url": {{ home_url | json }},
        "name": {{ shop.name | json }},
        "publisher": { "@id": {{ organization_id | json }} },
        "inLanguage": {{ request.locale.iso_code | json }},
        "potentialAction": {
          "@type": "SearchAction",
          "target": {
            "@type": "EntryPoint",
            "urlTemplate": {{ search_url | append: '?q={search_term_string}' | json }}
          },
          "query-input": "required name=search_term_string"
        }
      }
    ]
  }
</script>
