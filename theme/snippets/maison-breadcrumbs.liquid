{%- doc -%}
  Route-aware breadcrumb trail for the storefront. Renders an accessible
  ordered list and a matching BreadcrumbList JSON-LD block so the visible trail
  and the machine-readable trail can never drift apart.

  The trail is skipped for the home page and password gate. Product trails use
  the collection the visitor arrived from when Shopify exposes it, otherwise the
  product's first collection, matching Hydrogen's `$handle` product route.

  @example
  {% render 'maison-breadcrumbs' %}
{%- enddoc -%}

{%- liquid
  assign delimiter = '~|~'
  assign page_type = request.page_type

  assign crumb_labels = 'Home'
  assign crumb_urls = routes.root_url

  case page_type
    when 'collection'
      assign crumb_labels = crumb_labels | append: delimiter | append: collection.title
      assign crumb_urls = crumb_urls | append: delimiter | append: collection.url

    when 'product'
      assign crumb_collection = collection | default: product.collections.first
      if crumb_collection != blank
        assign crumb_labels = crumb_labels | append: delimiter | append: crumb_collection.title
        assign crumb_urls = crumb_urls | append: delimiter | append: crumb_collection.url
      else
        assign crumb_labels = crumb_labels | append: delimiter | append: 'Collections'
        assign crumb_urls = crumb_urls | append: delimiter | append: routes.collections_url
      endif
      assign crumb_labels = crumb_labels | append: delimiter | append: product.title
      assign crumb_urls = crumb_urls | append: delimiter | append: product.url

    when 'list-collections'
      assign crumb_labels = crumb_labels | append: delimiter | append: 'Collections'
      assign crumb_urls = crumb_urls | append: delimiter | append: routes.collections_url

    when 'blog'
      assign crumb_labels = crumb_labels | append: delimiter | append: blog.title
      assign crumb_urls = crumb_urls | append: delimiter | append: blog.url

    when 'article'
      assign crumb_labels = crumb_labels | append: delimiter | append: blog.title
      assign crumb_urls = crumb_urls | append: delimiter | append: blog.url
      assign crumb_labels = crumb_labels | append: delimiter | append: article.title
      assign crumb_urls = crumb_urls | append: delimiter | append: article.url

    when 'page'
      assign crumb_labels = crumb_labels | append: delimiter | append: page.title
      assign crumb_urls = crumb_urls | append: delimiter | append: page.url

    when 'search'
      assign crumb_labels = crumb_labels | append: delimiter | append: 'Search'
      assign crumb_urls = crumb_urls | append: delimiter | append: routes.search_url

    when 'cart'
      assign crumb_labels = crumb_labels | append: delimiter | append: 'Cart'
      assign crumb_urls = crumb_urls | append: delimiter | append: routes.cart_url

    when '404'
      assign crumb_labels = crumb_labels | append: delimiter | append: 'Page not found'
      assign crumb_urls = crumb_urls | append: delimiter | append: request.path
  endcase

  assign labels = crumb_labels | split: delimiter
  assign urls = crumb_urls | split: delimiter
-%}

{%- if labels.size > 1 -%}
  <nav class="maison-breadcrumbs" aria-label="Breadcrumb">
    <ol class="maison-breadcrumbs__list">
      {%- for label in labels -%}
        <li class="maison-breadcrumbs__item">
          {%- if forloop.last -%}
            <span aria-current="page">{{ label }}</span>
          {%- else -%}
            <a href="{{ urls[forloop.index0] }}">{{ label }}</a>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ol>
  </nav>

  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        {%- for label in labels -%}
          {
            "@type": "ListItem",
            "position": {{ forloop.index }},
            "name": {{ label | json }},
            "item": {{ request.origin | append: urls[forloop.index0] | json }}
          }{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ]
    }
  </script>
{%- endif -%}

{% style %}
  .maison-breadcrumbs {
    width: 100%;
    max-width: var(--page-content-width, 100%);
    margin-inline: auto;
    padding-inline: var(--page-margin, 1rem);
    padding-block: var(--padding-sm, 0.75rem);
  }

  .maison-breadcrumbs__list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.5rem;
    align-items: center;
    margin: 0;
    padding: 0;
    list-style: none;
    font-family: var(--font-mono--family, monospace);
    font-size: var(--font-size--body-xs, 0.75rem);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgb(var(--color-foreground-rgb) / 0.7);
  }

  .maison-breadcrumbs__item {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  .maison-breadcrumbs__item + .maison-breadcrumbs__item::before {
    content: '/';
    color: rgb(var(--color-foreground-rgb) / 0.35);
  }

  .maison-breadcrumbs__item a {
    color: inherit;
    text-decoration: none;
    border-bottom: 1px solid transparent;
  }

  .maison-breadcrumbs__item a:hover,
  .maison-breadcrumbs__item a:focus-visible {
    border-bottom-color: currentColor;
  }

  .maison-breadcrumbs__item [aria-current='page'] {
    color: var(--color-foreground);
  }
{% endstyle %}
