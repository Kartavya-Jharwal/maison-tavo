{%- doc -%}
  Video background styles. Kept in a standalone snippet so they can be rendered
  into dynamically-injected contexts (the quick-add modal) as well as on normal pages.

  @example
  {% render 'video-background-styles' %}
{%- enddoc -%}

{% stylesheet %}
  .video-background,
  .video-background > :is(img, video, svg) {
    position: absolute;
    top: 0;
    inset-inline-start: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
  }

  .video-background--cover > :is(img, video, svg) {
    object-fit: cover;
  }

  .video-background--contain > :is(img, video, svg) {
    object-fit: contain;
  }

  video-background-component:not([data-playing='true']) > video {
    display: none;
  }

  .video-background__toggle {
    position: absolute;
    z-index: 100;
    inset-block-end: 1rem;
    inset-inline-end: 1rem;
    min-height: 2.75rem;
    padding: 0.5rem 0.75rem;
    background: #14110f;
    color: #f7f2e9;
    border: 1px solid #f7f2e9;
    pointer-events: auto;
  }

  .video-background__toggle:focus-visible {
    outline: 2px solid #fff;
    outline-offset: 2px;
    box-shadow: 0 0 0 4px #14110f;
  }
{% endstylesheet %}
