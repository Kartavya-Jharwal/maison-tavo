{%- doc -%}
  Machine lens: ASCII silhouette plus the Schema.org Product payload an agent reads.
  The JSON is display text only; the crawlable JSON-LD stays in `maison-product-jsonld`.

  @param {object} product - Product drop
  @param {boolean} [full] - Show the full payload instead of the card summary
{%- enddoc -%}

{%- liquid
  assign specs = product.metafields.specs
  assign variant = product.selected_or_first_available_variant
  assign key = specs.lineup.value | append: ' ' | append: product.handle | append: ' ' | append: product.type | downcase

  if specs.heat_sources.value.first
    assign heat = specs.heat_sources.value | join: ', '
  else
    assign heat = specs.heat_sources.value
  endif
-%}

<div class="maison-machine{% if full %} maison-machine--full{% endif %}">
  <header class="maison-machine__chrome" aria-hidden="true">
    <span class="maison-machine__dot"></span>
    <span class="maison-machine__dot"></span>
    <span class="maison-machine__dot"></span>
    <span class="maison-machine__chrome-label">MACHINE · SCHEMA.ORG</span>
  </header>

  <pre class="maison-machine__ascii" aria-hidden="true">
    {%- if key contains 'knife' or key contains 'blade' or key contains 'kuro' -%}
{{ '
             ______________________________
   ________/                              \___
  |########|                                  >
   ‾‾‾‾‾‾‾‾\______________________________/‾‾‾
' }}
    {%- elsif key contains 'tagine' -%}
{{ '
              /\
             /  \
            /    \
          _(______)_
         (__________)
' }}
    {%- elsif key contains 'kadai' or key contains 'wok' -%}
{{ '
       __                      __
     (o) \____________________/ (o)
          \                  /
           \  ::: 78:22 ::: /
            \______________//
' }}
    {%- elsif key contains 'tava' -%}
{{ '
        ____________________
      .´                    `.__________
     (     TAVA  DISC         )_________)
      `----------------------´
' }}
    {%- elsif key contains 'donabe' or key contains 'dutch' or key contains 'braiser' or key contains 'handi' -%}
{{ '
             .-----.
          .-´       `-._
        _(______________)-.
       (  TERRE CLAY CORE  )
        \_________________/
' }}
    {%- elsif key contains 'tumbler' or key contains 'jug' or key contains 'teapot' -%}
{{ '
           .--------.
          /  KANSA   \
         |   VESSEL   |
         |    880Hz   |
          \__________/
' }}
    {%- elsif key contains 'clay' or key contains 'terre' or key contains 'kulhad' or key contains 'chai' or key contains 'platter' or key contains 'bowl' or key contains 'plate' -%}
{{ '
       .-~~~~~~~~-.
      (____________)
       \          /
        \  ::::  /
         \______/
' }}
    {%- else -%}
{{ '
      _____________
    .´             `.____________________
   (  FORGE HYBRID   )___________________)
    `._____________.´
' }}
    {%- endif -%}
  </pre>

  <pre class="maison-machine__json"><code>{
  <span class="maison-machine__key">"@type"</span>: <span class="maison-machine__str">"Product"</span>,
  <span class="maison-machine__key">"name"</span>: <span class="maison-machine__str">{{ product.title | json }}</span>,
  <span class="maison-machine__key">"sku"</span>: <span class="maison-machine__str">{{ variant.sku | default: product.handle | json }}</span>,
  <span class="maison-machine__key">"category"</span>: <span class="maison-machine__str">{{ product.type | json }}</span>,
  <span class="maison-machine__key">"price"</span>: <span class="maison-machine__str">{{ variant.price | money_without_currency | remove: ',' | json }}</span>,
  <span class="maison-machine__key">"priceCurrency"</span>: <span class="maison-machine__str">{{ cart.currency.iso_code | json }}</span>,
  <span class="maison-machine__key">"availability"</span>: <span class="maison-machine__str">"{% if variant.available %}InStock{% else %}OutOfStock{% endif %}"</span>
  {%- if specs.lineup.value != blank %},
  <span class="maison-machine__key">"lineup"</span>: <span class="maison-machine__str">{{ specs.lineup.value | json }}</span>{% endif %}
  {%- if specs.primary_material.value != blank %},
  <span class="maison-machine__key">"primaryMaterial"</span>: <span class="maison-machine__str">{{ specs.primary_material.value | json }}</span>{% endif %}
  {%- if specs.dimensions_summary.value != blank %},
  <span class="maison-machine__key">"dimensions"</span>: <span class="maison-machine__str">{{ specs.dimensions_summary.value | json }}</span>{% endif %}
  {%- if heat != blank %},
  <span class="maison-machine__key">"heatSources"</span>: <span class="maison-machine__str">{{ heat | json }}</span>{% endif %}
  {%- if specs.claim_status.value != blank %},
  <span class="maison-machine__key">"claimStatus"</span>: <span class="maison-machine__str">{{ specs.claim_status.value | json }}</span>{% endif %}
  {%- if full and specs.lining_material.value != blank %},
  <span class="maison-machine__key">"liningMaterial"</span>: <span class="maison-machine__str">{{ specs.lining_material.value | json }}</span>{% endif %}
  {%- if full and specs.food_contact_suitability.value != blank %},
  <span class="maison-machine__key">"foodContactSuitability"</span>: <span class="maison-machine__str">{{ specs.food_contact_suitability.value | json }}</span>{% endif %}
  {%- if full and specs.care_instructions.value != blank %},
  <span class="maison-machine__key">"careInstructions"</span>: <span class="maison-machine__str">{{ specs.care_instructions.value | json }}</span>{% endif %}
}</code></pre>

  <footer class="maison-machine__footer">
    <a href="/pages/ucp" class="maison-machine__endpoint-link">
      <span class="maison-machine__endpoint-dot" aria-hidden="true">●</span>
      <span>UCP Endpoint · Full Agent TUI ↗</span>
    </a>
  </footer>
</div>

{% stylesheet %}
  .maison-machine {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    width: 100%;
    height: 100%;
    padding: 0.85rem 0.9rem 1rem;
    overflow: hidden;
    background:
      radial-gradient(120% 80% at 0% 0%, rgba(184, 137, 58, 0.12), transparent 55%),
      var(--brand-color-obsidian-charcoal, #121212);
    color: #d8c79c;
    font-family: var(--mt-type-family-mono);
    font-variant-numeric: tabular-nums slashed-zero;
  }

  .maison-machine__chrome {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    min-height: 1rem;
  }

  .maison-machine__dot {
    width: 0.4rem;
    height: 0.4rem;
    border-radius: 50%;
    background: rgb(216 199 156 / 0.35);
  }

  .maison-machine__dot:nth-child(1) {
    background: #8a6a3a;
  }
  .maison-machine__dot:nth-child(2) {
    background: #b8893a;
  }
  .maison-machine__dot:nth-child(3) {
    background: #d4b56a;
  }

  .maison-machine__chrome-label {
    margin-inline-start: auto;
    font-size: var(--mt-type-mono);
    letter-spacing: 0.14em;
    color: rgb(216 199 156 / 0.55);
  }

  .maison-machine pre {
    margin: 0;
    font: inherit;
    white-space: pre;
  }

  .maison-machine__ascii {
    flex: 0 0 auto;
    padding-block: 0.35rem 0.15rem;
    font-size: var(--mt-type-mono);
    line-height: 1.2;
    color: var(--bell, #b8893a);
    border-block-end: 1px solid rgb(216 199 156 / 0.12);
  }

  .maison-machine__json {
    flex: 1 1 auto;
    min-height: 0;
    font-size: var(--mt-type-mono);
    line-height: 1.5;
    overflow: auto;
    color: #e9e2cf;
    scrollbar-width: thin;
  }

  .maison-machine__key {
    color: #9fb59a;
  }

  .maison-machine__str {
    color: #e2c48a;
  }

  .maison-machine__footer {
    display: flex;
    justify-content: flex-end;
    margin-block-start: 0.35rem;
    padding-block-start: 0.35rem;
    border-block-start: 1px solid rgba(216, 199, 156, 0.12);
  }

  .maison-machine__endpoint-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    color: var(--bell, #b8893a);
    text-decoration: none;
    font-size: var(--mt-type-mono, 0.65rem);
    letter-spacing: 0.08em;
    padding: 0.15rem 0.4rem;
    border: 1px solid rgba(184, 137, 58, 0.3);
    border-radius: 2px;
    transition: all 0.15s ease;
  }

  .maison-machine__endpoint-link:hover,
  .maison-machine__endpoint-link:focus-visible {
    background: var(--bell, #b8893a);
    color: #14110f;
  }

  .maison-machine__endpoint-dot {
    color: #6fbc7a;
    font-size: 0.5rem;
  }

  .maison-machine__endpoint-link:hover .maison-machine__endpoint-dot {
    color: #14110f;
  }

  .maison-machine--full {
    height: auto;
    min-height: 28rem;
    padding: clamp(1.25rem, 3vw, 2rem);
    gap: 1rem;
  }

  .maison-machine--full .maison-machine__ascii {
    font-size: var(--mt-type-nav);
  }

  .maison-machine--full .maison-machine__json {
    font-size: var(--mt-type-accent);
    overflow-x: auto;
  }
{% endstylesheet %}
