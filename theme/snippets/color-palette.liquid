{% doc %}
  Outputs CSS custom property declarations for the color palette defined in theme settings.
{% enddoc %}

{% comment %} Compute palette lightest & darkest once for smart contrast {% endcomment %}
{% liquid
  assign palette_lightest = '#ffffff'
  assign palette_lightest_brightness = -1
  assign palette_darkest = '#000000'
  assign palette_darkest_brightness = 256

  for palette_color in settings.color_palette
    if palette_color != blank and palette_color.alpha == 1
      assign b = palette_color | color_brightness
      if b > palette_lightest_brightness
        assign palette_lightest = palette_color
        assign palette_lightest_brightness = b
      endif
      if b < palette_darkest_brightness
        assign palette_darkest = palette_color
        assign palette_darkest_brightness = b
      endif
    endif
  endfor
%}

{% comment %} Primary button effective values {% endcomment %}
{% liquid
  if settings.palette_primary_button_background.alpha == 0
    assign effective_primary_button_focus_outline = settings.palette_primary_button_text
  else
    assign effective_primary_button_focus_outline = settings.palette_primary_button_background
  endif

  capture effective_primary_button_hover_background
    render 'util-palette-hover-shift', color: settings.palette_primary_button_background
  endcapture
  if settings.palette_primary_button_background.alpha == 1
    assign primary_hover_background_has_alpha = false
  else
    assign primary_hover_background_has_alpha = true
  endif

  assign primary_hover_brightness = effective_primary_button_hover_background | color_brightness
  if primary_hover_brightness > 128
    assign primary_button_hover_contrast = palette_darkest
  else
    assign primary_button_hover_contrast = palette_lightest
  endif

  if primary_hover_background_has_alpha
    assign effective_primary_button_hover_text = settings.palette_primary_button_text
  else
    assign effective_primary_button_hover_text = primary_button_hover_contrast
  endif

  if settings.palette_primary_button_border == settings.palette_primary_button_background
    assign effective_primary_button_hover_border = effective_primary_button_hover_background
  else
    capture effective_primary_button_hover_border
      render 'util-palette-hover-shift', color: settings.palette_primary_button_border
    endcapture
  endif
%}

{% comment %} Secondary button hover effective values {% endcomment %}
{% liquid
  capture effective_secondary_button_hover_background
    render 'util-palette-hover-shift', color: settings.palette_secondary_button_background
  endcapture
  if settings.palette_secondary_button_background.alpha == 1
    assign secondary_hover_background_has_alpha = false
  else
    assign secondary_hover_background_has_alpha = true
  endif

  assign secondary_hover_brightness = effective_secondary_button_hover_background | color_brightness
  if secondary_hover_brightness > 128
    assign secondary_button_hover_contrast = palette_darkest
  else
    assign secondary_button_hover_contrast = palette_lightest
  endif

  if secondary_hover_background_has_alpha
    assign effective_secondary_button_hover_text = settings.palette_secondary_button_text
  else
    assign effective_secondary_button_hover_text = secondary_button_hover_contrast
  endif

  if settings.palette_secondary_button_border == settings.palette_secondary_button_background
    assign effective_secondary_button_hover_border = effective_secondary_button_hover_background
  else
    capture effective_secondary_button_hover_border
      render 'util-palette-hover-shift', color: settings.palette_secondary_button_border
    endcapture
  endif
%}

{% comment %} Variant hover effective values (smart contrast for fallback text/border) {% endcomment %}
{% liquid
  capture effective_variant_hover_background
    render 'util-palette-hover-shift', color: settings.palette_variant_background
  endcapture

  if settings.palette_variant_background.alpha == 1
    assign variant_hover_background_has_alpha = false
  else
    assign variant_hover_background_has_alpha = true
  endif

  assign variant_hover_brightness = effective_variant_hover_background | color_brightness
  if variant_hover_brightness > 128
    assign variant_hover_contrast = palette_darkest
  else
    assign variant_hover_contrast = palette_lightest
  endif

  if variant_hover_background_has_alpha
    assign effective_variant_hover_text = settings.palette_variant_text
  else
    assign effective_variant_hover_text = variant_hover_contrast
  endif

  if settings.palette_variant_border == settings.palette_variant_background
    assign effective_variant_hover_border = effective_variant_hover_background
  else
    capture effective_variant_hover_border
      render 'util-palette-hover-shift', color: settings.palette_variant_border
    endcapture
  endif
%}
{% comment %} Selected variant hover effective values (smart contrast for fallback text/border) {% endcomment %}
{% liquid
  capture effective_selected_variant_hover_background
    render 'util-palette-hover-shift', color: settings.palette_selected_variant_background
  endcapture
  if settings.palette_selected_variant_background.alpha == 1
    assign selected_variant_hover_background_has_alpha = false
  else
    assign selected_variant_hover_background_has_alpha = true
  endif

  assign sel_variant_hover_brightness = effective_selected_variant_hover_background | color_brightness
  if sel_variant_hover_brightness > 128
    assign selected_variant_hover_contrast = palette_darkest
  else
    assign selected_variant_hover_contrast = palette_lightest
  endif

  if selected_variant_hover_background_has_alpha
    assign effective_selected_variant_hover_text = settings.palette_selected_variant_text
  else
    assign effective_selected_variant_hover_text = selected_variant_hover_contrast
  endif

  if settings.palette_selected_variant_border == settings.palette_selected_variant_background
    assign effective_selected_variant_hover_border = effective_selected_variant_hover_background
  else
    capture effective_selected_variant_hover_border
      render 'util-palette-hover-shift', color: settings.palette_selected_variant_border
    endcapture
  endif
%}

{% style %}
  /* Palette colors */
  :root {
    --color-background: {{ settings.page_background_color }};
    --color-background-rgb: {{ settings.page_background_color.rgb }};
    --color-foreground: {{ settings.page_text_color }};
    --color-foreground-rgb: {{ settings.page_text_color.rgb }};
    --color-border: {{ settings.page_text_color }};
    --color-border-rgb: {{ settings.page_text_color.rgb }};
    --palette-lightest: {{ palette_lightest }};
    --palette-lightest-rgb: {{ palette_lightest.rgb }};
    --palette-darkest: {{ palette_darkest }};
    --palette-darkest-rgb: {{ palette_darkest.rgb }};
    {% render 'brightness-opacities', background: settings.page_background_color %}

    --color-primary-button-text: rgb({{ settings.palette_primary_button_text.rgba }});
    --color-primary-button-background: rgb({{ settings.palette_primary_button_background.rgba }});
    --color-primary-button-border: rgb({{ settings.palette_primary_button_border.rgba }});
    --color-primary-button-focus-outline: rgb({{ effective_primary_button_focus_outline.rgb }});
    --color-primary-button-hover-text: rgb({{ effective_primary_button_hover_text.rgba }});
    --color-primary-button-hover-background: {{ effective_primary_button_hover_background }};
    --color-primary-button-hover-border: {{ effective_primary_button_hover_border }};

    --color-secondary-button-text: rgb({{ settings.palette_secondary_button_text.rgba }});
    --color-secondary-button-background: rgb({{ settings.palette_secondary_button_background.rgba }});
    --color-secondary-button-border: rgb({{ settings.palette_secondary_button_border.rgba }});
    --color-secondary-button-hover-text: rgb({{ effective_secondary_button_hover_text.rgba }});
    --color-secondary-button-hover-background: {{ effective_secondary_button_hover_background }};
    --color-secondary-button-hover-border: {{ effective_secondary_button_hover_border }};

    --color-input-background: rgb({{ settings.palette_input_background.rgba }});
    --color-input-text: rgb({{ settings.palette_input_text.rgba }});
    --color-input-text-rgb: {{ settings.palette_input_text.rgb }};
    --color-input-border: rgb({{ settings.palette_input_border.rgba }});

    --color-variant-background: rgb({{ settings.palette_variant_background.rgba }});
    --color-variant-border: rgb({{ settings.palette_variant_border.rgba }});
    --color-variant-text: rgb({{ settings.palette_variant_text.rgba }});
    --color-variant-text-rgb: {{ settings.palette_variant_text.rgb }};
    --color-variant-hover-background: {{ effective_variant_hover_background }};
    --color-variant-hover-text: rgb({{ effective_variant_hover_text.rgba }});
    --color-variant-hover-border: {{ effective_variant_hover_border }};

    --color-selected-variant-background: rgb({{ settings.palette_selected_variant_background.rgba }});
    --color-selected-variant-border: rgb({{ settings.palette_selected_variant_border.rgba }});
    --color-selected-variant-text: rgb({{ settings.palette_selected_variant_text.rgba }});
    --color-selected-variant-text-rgb: {{ settings.palette_selected_variant_text.rgb }};
    --color-selected-variant-hover-background: {{ effective_selected_variant_hover_background }};
    --color-selected-variant-hover-text: rgb({{ effective_selected_variant_hover_text.rgba }});
    --color-selected-variant-hover-border: {{ effective_selected_variant_hover_border }};

    --input-disabled-background-color: rgb(var(--color-foreground-rgb) / var(--opacity-10));
    --input-disabled-border-color: rgb(var(--color-foreground-rgb) / var(--opacity-5-15));
    --input-disabled-text-color: rgb(var(--color-foreground-rgb) / var(--opacity-50));
    --color-foreground-muted: rgb(var(--color-rgb, var(--color-foreground-rgb)) / var(--opacity-muted-text));
    --color-foreground-subdued: rgb(var(--color-rgb, var(--color-foreground-rgb)) / var(--opacity-subdued-text));
    --color-drawer-shadow-rgb: {{ settings.drawer_shadow_color.rgb }};
    --color-popover-shadow-rgb: {{ settings.popover_shadow_color.rgb }};

    /* Shadows */
    {% if settings.drawer_drop_shadow %}
      --shadow-drawer: var(--brand-shadow-md, 0px 4px 20px rgb(var(--color-drawer-shadow-rgb) / var(--opacity-15)));
    {% endif %}
    {% if settings.popover_drop_shadow %}
      --shadow-blur: 20px;
      --shadow-popover: var(--brand-shadow-md, 0px 4px 20px rgb(var(--color-popover-shadow-rgb) / var(--opacity-15)));
    {% endif %}

    --brand-color-canvas: var(--color-background);
    --brand-color-canvas-rgb: var(--color-background-rgb);
    --brand-color-ink: var(--color-foreground);
    --brand-color-ink-rgb: var(--color-foreground-rgb);
    --brand-color-border: var(--color-border);
    --splash-background: var(--brand-color-canvas);
    --splash-foreground: var(--brand-color-ink);

    /* Maison Tavo brand palette (M3) — settings → CSS custom properties */
    --brand-color-raw-copper: {{ settings.brand_color_raw_copper }};
    --brand-color-raw-copper-rgb: {{ settings.brand_color_raw_copper.rgb }};
    --brand-color-aged-bronze: {{ settings.brand_color_aged_bronze }};
    --brand-color-aged-bronze-rgb: {{ settings.brand_color_aged_bronze.rgb }};
    --brand-color-obsidian-charcoal: {{ settings.brand_color_obsidian_charcoal }};
    --brand-color-obsidian-charcoal-rgb: {{ settings.brand_color_obsidian_charcoal.rgb }};
    --brand-color-cast-clay: {{ settings.brand_color_cast_clay }};
    --brand-color-cast-clay-rgb: {{ settings.brand_color_cast_clay.rgb }};
    --brand-color-damascus-silver: {{ settings.brand_color_damascus_silver }};
    --brand-color-damascus-silver-rgb: {{ settings.brand_color_damascus_silver.rgb }};

    /*
      Canonical Maison palette — last in <head>, wins over settings drift.
      Prefer --mt-color-* / --mt-color-*-rgb. Short aliases for legacy CSS.
      Contrast pairs: docs/color-tokens.md
    */
    --mt-color-soot: #14110f;
    --mt-color-soot-rgb: 20, 17, 15;
    --mt-color-limewash: #efe8dc;
    --mt-color-limewash-rgb: 239, 232, 220;
    --mt-color-bone: #f7f2e9;
    --mt-color-bone-rgb: 247, 242, 233;
    --mt-color-bell: #b8893a;
    --mt-color-bell-rgb: 184, 137, 58;
    --mt-color-copper: #c2703d;
    --mt-color-copper-rgb: 194, 112, 61;
    --mt-color-clay: #8e4b35;
    --mt-color-clay-rgb: 142, 75, 53;
    --mt-color-steel: #8c9094;
    --mt-color-steel-rgb: 140, 144, 148;
    --mt-color-verdigris: #4f7f72;
    --mt-color-verdigris-rgb: 79, 127, 114;
    --mt-color-ember: #e2552b;
    --mt-color-ember-rgb: 226, 85, 43;

    --soot: var(--mt-color-soot);
    --limewash: var(--mt-color-limewash);
    --bone: var(--mt-color-bone);
    --bell: var(--mt-color-bell);
    --copper: var(--mt-color-copper);
    --clay: var(--mt-color-clay);
    --steel: var(--mt-color-steel);
    --verdigris: var(--mt-color-verdigris);
    --ember: var(--mt-color-ember);

    /* Semantic surfaces */
    --mt-surface-canvas: var(--mt-color-limewash);
    --mt-surface-raised: var(--mt-color-bone);
    --mt-surface-ink: var(--mt-color-soot);
    --mt-surface-accent: var(--mt-color-bell);
    --mt-surface-heat: var(--mt-color-ember);
    --mt-surface-metal: var(--mt-color-copper);
    --mt-surface-clay: var(--mt-color-clay);
    --mt-surface-steel: var(--mt-color-steel);
    --mt-surface-patina: var(--mt-color-verdigris);
    --mt-surface-border: rgb(var(--mt-color-bell-rgb) / 0.3);
    --mt-surface-border-subtle: rgb(var(--mt-color-soot-rgb) / 0.1);

    /* Horizon --color-* → Maison (safe commerce map) */
    --color-background: var(--mt-color-limewash);
    --color-background-rgb: var(--mt-color-limewash-rgb);
    --color-foreground: var(--mt-color-soot);
    --color-foreground-rgb: var(--mt-color-soot-rgb);
    --color-border: var(--mt-color-soot);
    --color-border-rgb: var(--mt-color-soot-rgb);
    --color-shadow-rgb: var(--mt-color-soot-rgb);
    --color-error: var(--mt-color-ember);
    --color-error-rgb: var(--mt-color-ember-rgb);
    --color-success: var(--mt-color-verdigris);
    --color-success-rgb: var(--mt-color-verdigris-rgb);
    --color-white: var(--mt-color-bone);
    --color-white-rgb: var(--mt-color-bone-rgb);
    --color-instock: var(--mt-color-verdigris);
    --color-lowstock: var(--mt-color-bell);
    --color-outofstock: var(--mt-color-steel);

    --brand-color-canvas: var(--mt-color-limewash);
    --brand-color-canvas-rgb: var(--mt-color-limewash-rgb);
    --brand-color-ink: var(--mt-color-soot);
    --brand-color-ink-rgb: var(--mt-color-soot-rgb);
    --brand-color-border: var(--mt-color-soot);
    --splash-background: var(--mt-color-limewash);
    --splash-foreground: var(--mt-color-soot);

    /* Commerce CTAs via Horizon button vars — no global button !important */
    --color-primary-button-background: var(--mt-color-soot);
    --color-primary-button-text: var(--mt-color-bone);
    --color-primary-button-border: var(--mt-color-bell);
    --color-primary-button-focus-outline: var(--mt-color-bell);
    --color-primary-button-hover-background: var(--mt-color-ember);
    --color-primary-button-hover-text: #ffffff;
    --color-primary-button-hover-border: var(--mt-color-ember);

    --color-secondary-button-text: var(--mt-color-soot);
    --color-secondary-button-background: transparent;
    --color-secondary-button-border: var(--mt-color-bell);
    --color-secondary-button-hover-text: var(--mt-color-bell);
    --color-secondary-button-hover-background: transparent;
    --color-secondary-button-hover-border: var(--mt-color-bell);

    --color-input-background: var(--mt-color-bone);
    --color-input-text: var(--mt-color-soot);
    --color-input-text-rgb: var(--mt-color-soot-rgb);
    --color-input-border: rgb(var(--mt-color-soot-rgb) / 0.2);
  }

  /* Rem root + Bai Jamjuree body — cascade after base.css, no !important */
  html {
    font-size: 100%;
  }

  body {
    color: var(--mt-surface-ink);
    background-color: var(--mt-surface-canvas);
    font-family: var(--mt-type-family-body, var(--font-body--family));
    font-size: var(--mt-type-body, 1rem);
    line-height: var(--mt-type-leading-body, 1.65);
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }

  /* Type roles — scoped selectors only (never [class*="heading|menu|nav|price"]) */
  h1, h2, h3, h4, h5, h6,
  .h1, .h2, .h3, .h4, .h5, .h6,
  .product-title,
  .collection-title,
  .maison-highlight,
  .maison-hero__headline,
  .maison-footer__headline,
  .maison-panopticon__heading,
  .maison-tree__title,
  .maison-last-call__heading {
    font-family: var(--mt-type-family-heading);
    font-weight: 400;
    letter-spacing: var(--mt-type-tracking-heading);
    color: var(--mt-surface-ink);
  }

  h1, .h1 {
    font-size: var(--mt-type-display);
    letter-spacing: var(--mt-type-tracking-heading, -0.02em);
  }

  /* Hero title — Instrument Serif large fluid display step (Typography Agent 3) */
  .maison-hero__headline {
    font-size: var(--mt-type-display-lg, var(--font-size--fluid-display));
  }

  h2, .h2 {
    font-size: var(--mt-type-heading);
  }

  h3, .h3,
  .maison-editorial__title,
  .maison-story__title,
  .maison-room__title,
  .maison-lineups__title,
  .maison-pdp-story__title,
  .maison-care__title {
    font-size: var(--mt-type-title);
    letter-spacing: -0.015em;
  }

  h4, .h4 {
    font-size: var(--mt-type-lede);
    letter-spacing: -0.01em;
  }

  .maison-lede {
    font-family: var(--mt-type-family-body);
    font-size: var(--mt-type-lede);
    line-height: var(--mt-type-leading-body);
  }

  .maison-body {
    font-family: var(--mt-type-family-body);
    font-size: var(--mt-type-body);
    line-height: var(--mt-type-leading-body);
  }

  .caption,
  .label,
  .overline,
  .announcement-bar__message,
  .header__menu .menu-list__link,
  .header-menu .menu-list__link,
  .navigation-link,
  .maison-tree__label,
  .maison-lens__option,
  .maison-eyebrow,
  .maison-kicker {
    font-family: var(--mt-type-family-accent);
    font-weight: 500;
  }

  .caption,
  .label,
  .overline,
  .announcement-bar__message,
  .maison-eyebrow,
  .maison-kicker {
    font-size: var(--mt-type-accent);
    letter-spacing: var(--mt-type-tracking-accent);
    text-transform: uppercase;
  }

  .header__menu .menu-list__link,
  .header-menu .menu-list__link,
  .navigation-link {
    font-size: var(--mt-type-nav);
    letter-spacing: var(--mt-type-tracking-accent);
  }

  .maison-wordmark,
  .header-logo,
  .header__heading-text,
  .header__heading-link,
  .mt-veil__mark {
    font-family: var(--mt-type-family-wordmark);
    font-weight: 100;
    font-size: var(--mt-type-wordmark);
    letter-spacing: var(--mt-type-tracking-wordmark);
    text-transform: none;
    font-kerning: normal;
    font-feature-settings: 'kern' 1, 'liga' 1;
    color: var(--mt-surface-ink);
  }

  /* Splash display mark — size owned by snippets/splash-intro.liquid (~68–70vw) */
  .splash-intro__heading {
    font-family: var(--mt-type-family-wordmark);
    font-weight: 100;
    letter-spacing: var(--mt-type-tracking-wordmark);
    text-transform: none;
    font-kerning: normal;
    font-feature-settings: 'kern' 1, 'liga' 1;
    color: var(--mt-surface-ink);
  }

  .mt-coda__word {
    font-family: var(--mt-type-family-wordmark);
    font-weight: var(--font-weight--wordmark, 100);
    font-size: var(--mt-type-wordmark-display);
    letter-spacing: var(--mt-type-tracking-wordmark);
    font-kerning: normal;
    font-feature-settings: 'kern' 1, 'liga' 1;
  }

  .price,
  .price-item,
  .product-price,
  .unit-price,
  .sku,
  .spec-value,
  [data-font-mono],
  code,
  pre,
  .agent-view,
  .ucp-view,
  .maison-mono,
  .maison-spec {
    font-family: var(--mt-type-family-mono);
    font-size: var(--mt-type-mono);
    font-variant-numeric: tabular-nums;
    font-feature-settings: 'tnum' 1, 'zero' 1;
  }

  .maison-devanagari,
  [lang='hi'],
  .kansa-script {
    font-family: var(--mt-type-family-devanagari);
    letter-spacing: 0.04em;
  }

  .button:not(.button-unstyled):not(.close-button):not(.menu-drawer__close-button):not(.menu-drawer__back-button),
  .button-secondary:not(.button-unstyled),
  button[name='add'],
  button[name='checkout'].cart__checkout-button,
  .maison-btn--primary {
    font-family: var(--mt-type-family-accent);
    font-size: var(--mt-type-button);
    letter-spacing: var(--mt-type-tracking-accent);
    text-transform: uppercase;
  }

  .header-wrapper,
  #header-component {
    background-color: var(--mt-surface-canvas);
    border-bottom: 1px solid var(--mt-surface-border);
    color: var(--mt-surface-ink);
  }

  .announcement-bar {
    background-color: var(--mt-surface-ink);
    color: var(--mt-surface-raised);
    border-bottom: 1px solid color-mix(in srgb, var(--bell) 35%, transparent);
    font-family: var(--mt-type-family-accent);
    font-size: var(--mt-type-accent);
    letter-spacing: var(--mt-type-tracking-accent);
  }

  .announcement-bar a {
    color: var(--mt-surface-accent);
  }

  .product-card,
  .collection-card {
    background-color: var(--mt-surface-raised);
    transition: border-color var(--mt-dur-mid) var(--mt-ease-strike),
      box-shadow var(--mt-dur-mid) var(--mt-ease-strike);
  }

  .product-card:hover,
  .collection-card:hover {
    border-color: var(--mt-surface-accent);
    box-shadow: var(--mt-elevation-md);
  }

  .cart-drawer,
  .theme-drawer {
    background-color: var(--mt-surface-raised);
    color: var(--mt-surface-ink);
  }

  .cart__trust,
  .cart-discount__label,
  .cart-note__label,
  .cart-totals__total-label {
    font-family: var(--mt-type-family-accent);
  }

  .cart-totals__total-value {
    font-family: var(--mt-type-family-heading);
    font-weight: 400;
  }

  .cart-discount__input,
  .cart-note__instructions,
  .cart-totals__tax-note {
    font-family: var(--mt-type-family-body);
  }

  .maison-footer-section,
  .maison-footer {
    background-color: var(--mt-surface-ink);
    color: var(--mt-surface-raised);
  }

  .maison-footer a {
    color: color-mix(in srgb, var(--bone) 85%, var(--bell));
  }

  .maison-footer a:hover {
    color: var(--mt-surface-accent);
  }

  /* Hide leftover Horizon footer chrome when Maison footer is present */
  .shopify-section-group-footer-group:has(.maison-footer) .shopify-section:has(> .footer):not(.maison-footer-section),
