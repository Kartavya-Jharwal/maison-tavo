<li class="maison-claim" {{ block.shopify_attributes }}>
  <span class="maison-evidence maison-evidence--{{ block.settings.status }}">[{{ block.settings.status | upcase }}]</span>
  <span class="maison-claim__text">{{ block.settings.claim | escape }}</span>
</li>

{% stylesheet %}
  .maison-claim {
    display: grid;
    grid-template-columns: 8.5rem 1fr;
    gap: 0.75rem;
    align-items: baseline;
    font-size: var(--mt-type-body);
    line-height: 1.55;
  }

  .maison-claim .maison-evidence {
    font-family: var(--mt-type-family-mono);
    font-size: var(--mt-type-mono);
    letter-spacing: 0.1em;
  }

  .maison-evidence--verified { color: var(--brand-color-aged-bronze, #5a6b5c); }
  .maison-evidence--observed { color: var(--bell, #b8893a); }
  .maison-evidence--hypothesis { color: var(--brand-color-raw-copper, #a45a3d); }
{% endstylesheet %}

{% schema %}
{
  "name": "Claim",
  "tag": null,
  "settings": [
    {
      "type": "select",
      "id": "status",
      "label": "Evidence",
      "options": [
        { "value": "verified", "label": "Verified — lab report" },
        { "value": "observed", "label": "Observed — test kitchen" },
        { "value": "hypothesis", "label": "Hypothesis — design target" }
      ],
      "default": "hypothesis"
    },
    {
      "type": "text",
      "id": "claim",
      "label": "Claim",
      "default": "Describe one measurable claim."
    }
  ]
}
{% endschema %}
