{%- doc -%}
  Industrial mono spec table for product `specs.*` metafields.
  Surfaces claim_status first so CONCEPT_SPEC rows are never read as verified fact,
  and renders repeatable material, lining, capacity, dimensions, suitability, and heat rows.
{%- enddoc -%}

{% liquid
  assign product_resource = closest.product
  assign specs = product_resource.metafields.specs
  assign claim = specs.claim_status.value
  assign lineup = specs.lineup.value
  assign thesis = specs.concept_thesis.value
  assign primary_material = specs.primary_material.value
  assign lining_material = specs.lining_material.value
  assign capacity_ml = specs.capacity_ml.value
  assign dimensions_summary = specs.dimensions_summary.value
  assign dishwasher = specs.dishwasher_suitability.value
  assign microwave = specs.microwave_suitability.value
  assign food_contact_suitability = specs.food_contact_suitability.value
  assign care_instructions = specs.care_instructions.value
  assign heat_compatibility = specs.heat_compatibility.value
  assign material = specs.material_architecture.value
  assign food_contact = specs.food_contact_strategy.value
  assign fabrication = specs.fabrication_route.value
  assign care = specs.care_hypothesis.value
  assign heat = specs.heat_sources.value
  assign risks = specs.engineering_risks.value
  assign tests = specs.required_prototype_tests.value
  assign barcode = product_resource.selected_or_first_available_variant.barcode
  assign has_specs = false
  if claim != blank or lineup != blank or primary_material != blank or material != blank or heat != blank or thesis != blank or food_contact != blank or fabrication != blank or care != blank or barcode != blank
    assign has_specs = true
  endif
  assign is_concept = false
  if claim == 'CONCEPT_SPEC'
    assign is_concept = true
  endif
%}

{% if product_resource != blank and has_specs %}
  <div
    class="maison-spec-table{% if is_concept %} maison-spec-table--concept{% endif %}"
    {{ block.shopify_attributes }}
  >
    {% if block.settings.heading != blank %}
      <h2 class="maison-spec-table__heading">{{ block.settings.heading | escape }}</h2>
    {% endif %}

    {% if claim != blank %}
      <p class="maison-spec-table__status" role="status">
        <span class="maison-spec-table__label">Claim status</span>
        <span class="maison-spec-table__badge maison-spec-table__badge--{{ claim | handleize }}">
          {{- claim | escape -}}
        </span>
        {% if product_resource.type != blank %}
          <span class="maison-spec-table__label">· Object type</span>
          <span class="maison-spec-table__badge">{{ product_resource.type | escape }}</span>
        {% endif %}
      </p>
      {% if is_concept %}
        <p class="maison-spec-table__notice">
          Design intents from the engineering sheet — not certified ratings or verified measurements.
          Specs below stay provisional until prototype validation.
        </p>
      {% elsif claim == 'PROTOTYPE_VALIDATED' %}
        <p class="maison-spec-table__notice">
          Prototype-validated against required tests. Not yet a production-verified claim.
        </p>
      {% endif %}
    {% endif %}

    <table class="maison-spec-table__grid">
      <caption class="visually-hidden">Product specification</caption>
      <tbody>
        {% if lineup != blank %}
          <tr>
            <th scope="row">Brand range</th>
            <td>{{ lineup | escape }}</td>
          </tr>
        {% endif %}
        {% if primary_material != blank %}
          <tr>
            <th scope="row">Primary material</th>
            <td>{{ primary_material | escape }}</td>
          </tr>
        {% endif %}
        {% if lining_material != blank %}
          <tr>
            <th scope="row">Lining / interface</th>
            <td>{{ lining_material | escape }}</td>
          </tr>
        {% endif %}
        {% if capacity_ml != blank %}
          <tr>
            <th scope="row">Nominal capacity</th>
            <td>{{ capacity_ml | escape }} ml</td>
          </tr>
        {% endif %}
        {% if dimensions_summary != blank %}
          <tr>
            <th scope="row">Dimensions</th>
            <td>{{ dimensions_summary | escape }}</td>
          </tr>
        {% endif %}
        {% if heat_compatibility != blank %}
          <tr>
            <th scope="row">Heat compatibility</th>
            <td>{{ heat_compatibility | escape }}</td>
          </tr>
        {% elsif heat != blank %}
          <tr>
            <th scope="row">Heat sources</th>
            <td>
              {%- if heat.first -%}
                {{ heat | join: ', ' | escape }}
              {%- else -%}
                {{ heat | escape }}
              {%- endif -%}
            </td>
          </tr>
        {% endif %}
        {% if dishwasher != blank %}
          <tr>
            <th scope="row">Dishwasher</th>
            <td>{{ dishwasher | replace: '_', ' ' | capitalize | escape }}</td>
          </tr>
        {% endif %}
        {% if microwave != blank %}
          <tr>
            <th scope="row">Microwave</th>
            <td>{{ microwave | replace: '_', ' ' | capitalize | escape }}</td>
          </tr>
        {% endif %}
        {% if food_contact_suitability != blank %}
          <tr>
            <th scope="row">Food-contact suitability</th>
            <td>{{ food_contact_suitability | escape | newline_to_br }}</td>
          </tr>
        {% elsif food_contact != blank %}
          <tr>
            <th scope="row">Food-contact strategy</th>
            <td>{{ food_contact | escape | newline_to_br }}</td>
          </tr>
        {% endif %}
        {% if care_instructions != blank %}
          <tr>
            <th scope="row">Care instructions</th>
            <td>{{ care_instructions | escape | newline_to_br }}</td>
          </tr>
        {% elsif care != blank %}
          <tr>
            <th scope="row">Care hypothesis</th>
            <td>{{ care | escape | newline_to_br }}</td>
          </tr>
        {% endif %}
        {% if material != blank %}
          <tr>
            <th scope="row">Material stack</th>
            <td>{{ material | escape | newline_to_br }}</td>
          </tr>
        {% endif %}
        {% if thesis != blank %}
          <tr>
            <th scope="row">Concept thesis</th>
            <td>{{ thesis | escape | newline_to_br }}</td>
          </tr>
        {% endif %}
        {% if fabrication != blank %}
          <tr>
            <th scope="row">Fabrication route</th>
            <td>{{ fabrication | escape | newline_to_br }}</td>
          </tr>
        {% endif %}
        {% if risks != blank %}
          <tr>
            <th scope="row">Engineering risks</th>
            <td>
              {%- if risks.first -%}
                {{ risks | join: '; ' | escape }}
              {%- else -%}
                {{ risks | escape }}
              {%- endif -%}
            </td>
          </tr>
        {% endif %}
        {% if tests != blank %}
          <tr>
            <th scope="row">Prototype test gates</th>
            <td>
              {%- if tests.first -%}
                {{ tests | join: '; ' | escape }}
              {%- else -%}
                {{ tests | escape }}
              {%- endif -%}
            </td>
          </tr>
        {% endif %}
        {% if barcode != blank %}
          <tr>
            <th scope="row">GTIN</th>
            <td>{{ barcode | escape }}</td>
          </tr>
        {% endif %}
      </tbody>
    </table>
  </div>
{% elsif request.design_mode %}
  <div class="maison-spec-table maison-spec-table--empty" {{ block.shopify_attributes }}>
    <p class="maison-spec-table__notice">
      Spec table appears when product metafields in the <code>specs</code> namespace are set.
    </p>
  </div>
{% endif %}

{% stylesheet %}
  .maison-spec-table {
    width: 100%;
    margin-block: var(--padding-md, 0.8rem) 0;
    color: var(--color-foreground);
  }

  .maison-spec-table__heading {
    margin: 0 0 0.75rem;
    font-family: var(--font-heading--family);
    font-size: var(--font-size--md, 1rem);
    letter-spacing: 0.04em;
  }

  .maison-spec-table__status {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin: 0 0 0.5rem;
  }

  .maison-spec-table__label {
    font-family: var(--font-mono--family, var(--font-accent--family));
    font-size: 0.6875rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgb(var(--color-foreground-rgb) / 0.65);
  }

  .maison-spec-table__badge {
    font-family: var(--font-mono--family, var(--font-accent--family));
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 0.2em 0.55em;
    border: 1px solid var(--color-foreground);
    color: var(--color-foreground);
  }

  .maison-spec-table__badge--concept-spec {
    border-color: var(--brand-color-raw-copper, var(--color-foreground));
    color: var(--brand-color-raw-copper, var(--color-foreground));
  }

  .maison-spec-table__badge--prototype-validated {
    border-color: var(--brand-color-aged-bronze, var(--color-foreground));
    color: var(--brand-color-aged-bronze, var(--color-foreground));
  }

  .maison-spec-table__badge--verified {
    border-color: var(--brand-color-obsidian-charcoal, var(--color-foreground));
    color: var(--brand-color-obsidian-charcoal, var(--color-foreground));
  }

  .maison-spec-table__notice {
    margin: 0 0 1rem;
    max-width: 42rem;
    font-family: var(--font-mono--family, var(--font-accent--family));
    font-size: 0.75rem;
    line-height: 1.45;
    color: rgb(var(--color-foreground-rgb) / 0.72);
  }

  .maison-spec-table--concept .maison-spec-table__grid td {
    font-style: italic;
  }

  .maison-spec-table__grid {
    width: 100%;
    border-collapse: collapse;
    border-block-start: 1px solid var(--brand-color-damascus-silver, rgb(var(--color-foreground-rgb) / 0.2));
  }

  .maison-spec-table__grid th,
  .maison-spec-table__grid td {
    padding-block: 0.75rem;
    padding-inline: 0 1rem;
    vertical-align: top;
    text-align: start;
    border-block-end: 1px solid rgb(var(--color-foreground-rgb) / 0.12);
  }

  .maison-spec-table__grid th {
    width: 34%;
    min-width: 8.5rem;
    font-family: var(--font-mono--family, var(--font-accent--family));
    font-size: 0.75rem;
    font-weight: 400;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: rgb(var(--color-foreground-rgb) / 0.65);
  }

  .maison-spec-table__grid td {
    font-family: var(--font-mono--family, var(--font-accent--family));
    font-size: 0.8125rem;
    line-height: 1.5;
    color: var(--color-foreground);
  }

  @media (prefers-reduced-motion: no-preference) {
    .maison-spec-table__grid tbody tr {
      animation: maison-spec-fade 0.5s ease both;
    }
  }

  @keyframes maison-spec-fade {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.maison_spec_table",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:settings.maison_spec_heading",
      "default": "Specification"
    }
  ],
  "presets": [
    {
      "name": "t:names.maison_spec_table"
    }
  ]
}
{% endschema %}
