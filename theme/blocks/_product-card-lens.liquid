{%- doc -%}
  Panopticon lens for Horizon product cards: Human (native gallery), Engineer (stratigraphy),
  Machine (ASCII + Schema.org). Overlays the card gallery so switching never shifts layout.
  Place directly after the card gallery block.
{%- enddoc -%}

{%- liquid
  assign product = closest.product
  assign specs = product.metafields.specs
  if specs.heat_sources.value.first
    assign heat = specs.heat_sources.value | join: ','
  else
    assign heat = specs.heat_sources.value
  endif
  assign uid = block.id | append: '-' | append: product.id
-%}

{%- if product != blank -%}
  <maison-lens
    class="maison-lens"
    data-lens="human"
    data-mt-heat="{{ heat | downcase | escape }}"
    data-mt-lineup="{{ specs.lineup.value | handleize }}"
    style="--lens-ratio: {{ block.settings.aspect_ratio }};"
    {{ block.shopify_attributes }}
  >
    <div
      class="maison-lens__stage"
      id="lens-engineer-{{ uid }}"
      data-lens-panel="engineer"
      hidden
    >
      {% render 'maison-stratigraphy', product: product, id_prefix: uid %}
    </div>
    <div
      class="maison-lens__stage"
      id="lens-machine-{{ uid }}"
      data-lens-panel="machine"
      hidden
    >
      {% render 'maison-machine-view', product: product %}
    </div>

    <div class="maison-lens__bar" role="group" aria-label="View {{ product.title | escape }} as">
      <button
        type="button"
        class="maison-lens__option"
        data-lens-option="human"
        aria-pressed="true"
      >
        Human
      </button>
      <button
        type="button"
        class="maison-lens__option"
        data-lens-option="engineer"
        aria-pressed="false"
        aria-controls="lens-engineer-{{ uid }}"
      >
        Engineer
      </button>
      <button
        type="button"
        class="maison-lens__option"
        data-lens-option="machine"
        aria-pressed="false"
        aria-controls="lens-machine-{{ uid }}"
      >
        Machine
      </button>
    </div>

    <p class="maison-lens__fit" data-mt-fit hidden></p>
  </maison-lens>
{%- elsif request.design_mode -%}
  <div class="maison-lens maison-lens--placeholder" {{ block.shopify_attributes }}>
    <div class="maison-lens__bar">
      <span class="maison-lens__option" aria-pressed="true">Human</span>
      <span class="maison-lens__option">Engineer</span>
      <span class="maison-lens__option">Machine</span>
    </div>
  </div>
{%- endif -%}

{% stylesheet %}
  .product-card__content:has(> .maison-lens) {
    container-type: inline-size;
  }

  .maison-lens {
    display: contents;
  }

  .maison-lens__stage {
    position: absolute;
    inset-block-start: 0;
    inset-inline: 0;
    z-index: 1;
    aspect-ratio: var(--lens-ratio, 4 / 5);
    overflow: hidden;
  }

  .maison-lens__stage[hidden] {
    display: none;
  }

  /* Keep gallery inert while a lens stage covers it */
  .product-card__content:has(.maison-lens[data-lens='engineer']) .card-gallery,
  .product-card__content:has(.maison-lens[data-lens='machine']) .card-gallery,
  .product-card__content:has(.maison-lens[data-lens='engineer']) .quick-add,
  .product-card__content:has(.maison-lens[data-lens='machine']) .quick-add {
    pointer-events: none;
  }

  @media (prefers-reduced-motion: no-preference) {
    .maison-lens__stage:not([hidden]) {
      animation: maison-lens-in 280ms cubic-bezier(0.22, 1, 0.36, 1);
    }
  }

  @keyframes maison-lens-in {
    from {
      opacity: 0;
      clip-path: inset(0 0 100% 0);
    }
    to {
      opacity: 1;
      clip-path: inset(0);
    }
  }

  .maison-lens__bar {
    position: relative;
    z-index: 2;
    display: inline-flex;
    align-self: flex-start;
    gap: 0.125rem;
    margin-block-start: 0.75rem;
    padding: 0.125rem;
    border: 1px solid rgb(var(--color-foreground-rgb) / 0.16);
    border-radius: 3px;
    max-width: 100%;
    background: rgb(var(--color-background-rgb) / 0.72);
  }

  .maison-lens__option {
    min-height: 2rem;
    padding: 0 0.875rem;
    border: 0;
    border-radius: 2px;
    background: transparent;
    color: rgb(var(--color-foreground-rgb) / 0.62);
    font-family: var(--font-mono--family, ui-monospace, monospace);
    font-size: clamp(0.625rem, 0.58rem + 0.18cqi, 0.6875rem);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    cursor: pointer;
    transition: color 160ms ease, background-color 160ms ease;
  }

  /* Mobile: full-width segmented control on a single stacked card */
  @media screen and (max-width: 749px) {
    .maison-lens__bar {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      width: 100%;
      margin-block-start: 0.625rem;
      border-radius: 3px;
    }

    .maison-lens__option {
      min-width: 0;
      min-height: 2.5rem;
      padding-inline: 0.35rem;
      font-size: 0.625rem;
      letter-spacing: 0.06em;
      text-align: center;
    }

    .maison-lens__stage {
      width: 100%;
    }
  }

  .maison-lens__option:hover {
    color: var(--color-foreground);
  }

  .maison-lens__option[aria-pressed='true'] {
    background: var(--color-foreground);
    color: var(--color-background);
  }

  .maison-lens__option:focus-visible {
    outline: 2px solid var(--bell, #b8893a);
    outline-offset: 2px;
  }

  .maison-lens__fit {
    position: relative;
    z-index: 2;
    margin: 0.35rem 0 0;
    font-family: var(--font-mono--family, ui-monospace, monospace);
    font-size: 0.6875rem;
    letter-spacing: 0.06em;
    color: var(--brand-color-aged-bronze, #5a6b5c);
  }

  .maison-lens__fit::before {
    content: '● ';
    color: var(--bell, #b8893a);
  }

  .maison-lens--placeholder .maison-lens__bar {
    margin-block-start: 0.75rem;
  }
{% endstylesheet %}

{%- comment -%}
  Behaviour lives in scripts/src/lens.js (bundled into assets/maison-runtime.js).
  It is intentionally not a `{% javascript %}` tag here: that tag repeats per
  block instance and left sections/maison-view-as.liquid without a handler on
  pages that had no product-card lens block.
{%- endcomment -%}

{% schema %}
{
  "name": "Panopticon lens",
  "tag": null,
  "settings": [
    {
      "type": "select",
      "id": "aspect_ratio",
      "label": "Match gallery ratio",
      "options": [
        { "value": "4 / 5", "label": "Portrait" },
        { "value": "1 / 1", "label": "Square" },
        { "value": "16 / 9", "label": "Landscape" }
      ],
      "default": "4 / 5"
    }
  ]
}
{% endschema %}
