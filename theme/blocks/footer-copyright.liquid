
{% assign block_settings = block.settings %}
<div
  class="
    footer-utilities__group-copyright
    custom-typography
    {% if block_settings.font_size != "" %}custom-font-size{% endif %}
  "
  style="
    {% render 'typography-style', preset: 'custom', settings: block_settings %}
    {% if block_settings.text_color != blank %}--color-utilities: {{ block_settings.text_color }};{% endif %}
  "
  {{ block.shopify_attributes }}
>
  <span class="footer-utilities__text">
    &copy; {{ 'now' | date: '%Y' }}
    {{ shop.name | link_to: routes.root_url -}}
    {%- if block_settings.show_powered_by -%}
      , {{ powered_by_link }}
    {%- endif -%}
  </span>
  {%- if block_settings.show_developer_credit -%}
    {%- liquid
      assign developer_name = block_settings.developer_name | default: settings.maison_developer_name | default: 'Kartavya'
      assign developer_url = block_settings.developer_url | default: settings.maison_developer_url | default: 'https://kartavya.tech'
      if developer_url == blank
        assign developer_url = 'https://kartavya.tech'
      endif
    -%}
    <span class="footer-utilities__developer">
      {{ 'maison.designed_developed_by' | t }}
      <a
        href="{{ developer_url }}"
        target="_blank"
        rel="noopener"
      >
        {{- developer_name | escape -}}
        <span class="visually-hidden">{{ 'accessibility.new_window' | t }}</span>
      </a>
    </span>
  {%- endif -%}
</div>

{% stylesheet %}
  .footer-utilities__group-copyright {
    color: var(--color-utilities, var(--color-foreground-muted));
  }

  .footer-utilities__developer {
    display: block;
    margin-block-start: 0.4em;
    color: var(--color-utilities, var(--color-foreground-muted));
  }

  .footer-utilities__developer a {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 0.18em;
    text-decoration-thickness: 1px;
  }

  .footer-utilities__developer a:hover,
  .footer-utilities__developer a:focus-visible {
    color: var(--color-foreground);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.copyright",
  "tag": null,
  "settings": [
    {
      "type": "checkbox",
      "id": "show_powered_by",
      "label": "t:settings.show_powered_by_shopify",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_developer_credit",
      "label": "t:settings.maison_show_developer_credit",
      "default": true
    },
    {
      "type": "text",
      "id": "developer_name",
      "label": "t:settings.maison_developer_name",
      "default": "Kartavya",
      "visible_if": "{{ block.settings.show_developer_credit == true }}"
    },
    {
      "type": "url",
      "id": "developer_url",
      "label": "t:settings.maison_developer_url",
      "default": "https://kartavya.tech",
      "visible_if": "{{ block.settings.show_developer_credit == true }}"
    },
    {
      "type": "paragraph",
      "content": "t:content.manage_store_name"
    },
    {
      "type": "header",
      "content": "t:content.appearance"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "t:settings.text_color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "select",
      "id": "font_size",
      "label": "t:settings.size",
      "options": [
        {
          "value": "0.625rem",
          "label": "10px"
        },
        {
          "value": "0.75rem",
          "label": "12px"
        },
        {
          "value": "0.875rem",
          "label": "14px"
        },
        {
          "value": "1rem",
          "label": "16px"
        },
        {
          "value": "1.125rem",
          "label": "18px"
        }
      ],
      "default": "0.75rem"
    },
    {
      "type": "select",
      "id": "case",
      "label": "t:settings.case",
      "options": [
        {
          "value": "none",
          "label": "t:options.default"
        },
        {
          "value": "uppercase",
          "label": "t:options.uppercase"
        }
      ],
      "default": "none"
    }
  ],
  "presets": [
    {
      "name": "t:names.copyright",
      "category": "t:categories.footer"
    }
  ]
}
{% endschema %}
