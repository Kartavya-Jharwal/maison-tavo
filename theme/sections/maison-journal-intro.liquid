{% liquid
  if section.settings.background_color != blank
    render 'contrast-override', background_color: section.settings.background_color, section_id: section.id
  endif
%}

<div
  class="section-background{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
></div>
<div
  class="section section--page-width spacing-style maison-editorial maison-journal-intro{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
  style="{% render 'spacing-style', settings: section.settings %}"
>
  <header class="maison-editorial__header">
    {% if section.settings.eyebrow != blank %}
      <p class="maison-editorial__eyebrow">{{ section.settings.eyebrow | escape }}</p>
    {% endif %}
    {% if section.settings.heading != blank %}
      <h1 class="maison-editorial__title">{{ section.settings.heading | escape }}</h1>
    {% elsif blog != blank %}
      <h1 class="maison-editorial__title">{{ blog.title | escape }}</h1>
    {% else %}
      <h1 class="maison-editorial__title">{{ 'maison.journal_kicker' | t }}</h1>
    {% endif %}
    {% if section.settings.lede != blank %}
      <p class="maison-editorial__lede">{{ section.settings.lede | escape }}</p>
    {% endif %}
  </header>
</div>

{% stylesheet %}
  .maison-editorial {
    color: var(--color-foreground);
  }

  .maison-editorial__header {
    max-width: 42rem;
    margin-block-end: 3rem;
  }

  .maison-editorial__eyebrow {
    margin: 0;
    font-family: var(--font-heading--family);
    font-size: 0.75rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-foreground-muted);
  }

  .maison-editorial__title {
    margin-block: 0.75rem 1rem;
    font-family: var(--font-heading--family);
    font-weight: var(--font-heading--weight);
    letter-spacing: 0.04em;
  }

  .maison-editorial__lede {
    margin: 0;
    max-width: 40rem;
    color: var(--color-foreground-muted);
    font-size: 1.125rem;
    line-height: 1.6;
  }

  .maison-journal-intro .maison-editorial__header {
    margin-block-end: 0;
    max-width: 44rem;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.maison_journal_intro",
  "tag": "section",
  "class": "section-wrapper",
  "enabled_on": {
    "templates": ["blog"]
  },
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:settings.maison_eyebrow",
      "default": "Atelier dispatches"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:settings.heading",
      "default": "Journal"
    },
    {
      "type": "textarea",
      "id": "lede",
      "label": "t:settings.maison_lede",
      "default": "Letters from the cutting table: fittings, cloth, and the making of Maison Tavo. Create a blog in Admin with handle journal, then publish articles here."
    },
    {
      "type": "paragraph",
      "content": "t:content.maison_pages_templates"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 16
    }
  ],
  "presets": [
    {
      "name": "t:names.maison_journal_intro",
      "category": "t:categories.storytelling"
    }
  ]
}
{% endschema %}
