{% assign forge_url = collections.forge.url | default: routes.collections_url %}

<div
  class="maison-finder section section--page-width"
  id="finder"
  data-root="maison-finder-root"
  data-mt-document-navigation
  data-mt-chapter
  data-forge-url="{{ forge_url }}"
  data-fry-url="{{ all_products['forge-frying-pan'].url | default: forge_url }}"
  data-tawa-url="{{ all_products['forge-tawa'].url | default: forge_url }}"
  data-stockpot-url="{{ all_products['forge-stockpot'].url | default: forge_url }}"
  data-saute-url="{{ all_products['forge-saute'].url | default: forge_url }}"
  data-clay-url="{{ collections.chulha.url | default: routes.collections_url }}"
  data-prep-url="{{ collections.forge.url | default: routes.collections_url }}"
>
  <div class="maison-finder__container">
    <header class="maison-finder__header" data-mt-scroll="chapter">
      <div class="maison-finder__kicker-row">
        <span class="maison-finder__step-indicator" id="finder-progress-text" role="status" hidden>QUESTION 1 OF 5</span>
      </div>
      <h1 class="maison-finder__title" data-mt-scroll="kinetic" aria-label="Find your cookware">Find your cookware</h1>
      <p class="maison-finder__lede">
        Start with your hob and the dishes you make most often.
      </p>
      
      <!-- Progress bell marks (5 rings) -->
      <div class="maison-finder__progress-bells" aria-hidden="true">
        <span class="bell-mark is-active" data-step-idx="0">●</span>
        <span class="bell-mark" data-step-idx="1">○</span>
        <span class="bell-mark" data-step-idx="2">○</span>
        <span class="bell-mark" data-step-idx="3">○</span>
        <span class="bell-mark" data-step-idx="4">○</span>
      </div>
    </header>

    <p data-finder-fallback><a href="{{ forge_url }}">Browse Forge and check each piece's hob specifications.</a></p>

    <!-- QUESTIONS WRAPPER -->
    <div class="maison-finder__questions" id="finder-questions-box" data-mt-scroll="beat" hidden>
      <!-- Q1 -->
      <div class="finder-q-card is-active" data-q="0">
        <h2 class="finder-q-title" id="finder-question-{{ section.id }}-1" tabindex="-1">What do you cook on?</h2>
        <div class="finder-options" role="group" aria-labelledby="finder-question-{{ section.id }}-1">
          <button class="finder-opt-btn" data-answer="induction" data-strike>
            <span class="opt-label">Induction cooktop</span>
          </button>
          <button class="finder-opt-btn" data-answer="gas" data-strike>
            <span class="opt-label">Gas hob</span>
          </button>
          <button class="finder-opt-btn" data-answer="electric" data-strike>
            <span class="opt-label">Electric or ceramic hob</span>
          </button>
          <button class="finder-opt-btn" data-answer="oven" data-strike>
            <span class="opt-label">Oven &amp; hearth roasting</span>
          </button>
        </div>
      </div>

      <!-- Q2 -->
      <div class="finder-q-card" data-q="1">
        <h2 class="finder-q-title" id="finder-question-{{ section.id }}-2" tabindex="-1">What do you cook most often?</h2>
        <div class="finder-options" role="group" aria-labelledby="finder-question-{{ section.id }}-2">
          <button class="finder-opt-btn" data-answer="dosa" data-strike>
            <span class="opt-label">Dosa, roti, flatbreads &amp; pancakes</span>
          </button>
          <button class="finder-opt-btn" data-answer="sear" data-strike>
            <span class="opt-label">High-heat searing &amp; pan-basting</span>
          </button>
          <button class="finder-opt-btn" data-answer="braise" data-strike>
            <span class="opt-label">Slow braising, curries &amp; biryani</span>
          </button>
          <button class="finder-opt-btn" data-answer="prep" data-strike>
            <span class="opt-label">Precision prep &amp; vegetable craft</span>
          </button>
        </div>
      </div>

      <!-- Q3 -->
      <div class="finder-q-card" data-q="2">
        <h2 class="finder-q-title" id="finder-question-{{ section.id }}-3" tabindex="-1">Is there a material you prefer?</h2>
        <div class="finder-options" role="group" aria-labelledby="finder-question-{{ section.id }}-3">
          <button class="finder-opt-btn" data-answer="steel" data-strike>
            <span class="opt-label">Stainless steel</span>
          </button>
          <button class="finder-opt-btn" data-answer="clay" data-strike>
            <span class="opt-label">Terracotta</span>
          </button>
          <button class="finder-opt-btn" data-answer="any" data-strike>
            <span class="opt-label">No preference</span>
          </button>
        </div>
      </div>

      <!-- Q4 -->
      <div class="finder-q-card" data-q="3">
        <h2 class="finder-q-title" id="finder-question-{{ section.id }}-4" tabindex="-1">How many do you usually cook for?</h2>
        <div class="finder-options" role="group" aria-labelledby="finder-question-{{ section.id }}-4">
          <button class="finder-opt-btn" data-answer="single" data-strike>
            <span class="opt-label">One or two</span>
          </button>
          <button class="finder-opt-btn" data-answer="family" data-strike>
            <span class="opt-label">Three or more</span>
          </button>
        </div>
      </div>

      <!-- Q5 -->
      <div class="finder-q-card" data-q="4">
        <h2 class="finder-q-title" id="finder-question-{{ section.id }}-5" tabindex="-1">What kind of care suits you?</h2>
        <div class="finder-options" role="group" aria-labelledby="finder-question-{{ section.id }}-5">
          <button class="finder-opt-btn" data-answer="ritual" data-strike>
            <span class="opt-label">I enjoy looking after the surface</span>
          </button>
          <button class="finder-opt-btn" data-answer="simple" data-strike>
            <span class="opt-label">I prefer a simple wash and dry</span>
          </button>
        </div>
      </div>
      <button type="button" class="finder-restart-btn finder-back-btn" id="finder-back-btn" hidden>Previous question</button>
    </div>

    <!-- RESULTS BOX -->
    <div class="maison-finder__results" id="finder-results-box" style="display: none;">
      <div class="finder-result-card">
        <div class="finder-result-pill">Where to start</div>
        <h2 class="finder-result-title" id="result-title" tabindex="-1"></h2>
        <p class="finder-result-desc" id="result-desc"></p>

        <!-- Reasoning chips -->
        <div class="finder-reasoning-chips" id="result-chips"></div>

        <div class="finder-result-actions">
          <a href="{{ forge_url }}" class="finder-view-btn" id="result-link" data-strike>
            View the catalogue
          </a>
          <button type="button" class="finder-restart-btn" id="finder-result-back-btn">Previous question</button>
          <button class="finder-restart-btn" id="finder-restart-btn">Start Over</button>
        </div>
      </div>
    </div>
  </div>
</div>

{% stylesheet %}
  .shopify-section:not(.header-section) .maison-finder.section {
    padding-block: 4rem 5.5rem;
    color: #f8fafc;
    background: #0f1115;
    border-block: 1px solid var(--color-border);
  }

  .maison-finder__container {
    max-width: 48rem;
    margin-inline: auto;
  }

  .maison-finder__header {
    margin-block-end: 2.5rem;
  }

  .maison-finder__kicker-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-block-end: 0.75rem;
  }

  .maison-finder__step-indicator {
    font-family: var(--mt-type-family-mono);
    font-size: var(--mt-type-mono);
    color: #cbd5e1;
    letter-spacing: 0.1em;
  }

  .maison-finder__title {
    margin: 0 0 0.85rem;
    font-family: var(--mt-type-family-heading);
    font-size: var(--mt-type-display);
    font-weight: var(--font-heading--weight);
    letter-spacing: 0.02em;
    line-height: 1.1;
    color: #f8fafc;
  }

  .maison-finder__lede {
    margin: 0 0 1.5rem;
    font-size: var(--mt-type-body);
    line-height: 1.6;
    color: #cbd5e1;
  }

  .maison-finder__progress-bells {
    display: flex;
    gap: 0.75rem;
    font-size: var(--mt-type-body);
    color: #475569;
  }

  .bell-mark.is-active {
    color: var(--bell, #b8893a);
  }

  /* Questions */
  .finder-q-card {
    display: none;
    animation: finder-fade-in 0.3s ease;
  }

  .finder-q-card.is-active {
    display: block;
  }

  @keyframes finder-fade-in {
    from { opacity: 0; transform: translateY(8px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .finder-q-title {
    margin: 0 0 1.5rem;
    font-family: var(--mt-type-family-heading);
    font-size: var(--mt-type-title);
    color: #f8fafc;
  }

  .finder-options {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.85rem;
  }

  .finder-opt-btn {
    background: var(--glass-surface-dark, rgba(20, 17, 15, 0.75));
    backdrop-filter: var(--glass-blur, blur(14px));
    -webkit-backdrop-filter: var(--glass-blur, blur(14px));
    border: 1px solid #aab1bc;
    padding: 1.25rem 1.6rem;
    border-radius: var(--radius-card-sm, 0.875rem);
    text-align: left;
    cursor: pointer;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    transition: all 0.25s var(--ease-strike);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.2);
  }

  .finder-opt-btn:hover {
    background: var(--glass-surface-dark-elevated, rgba(30, 26, 23, 0.82));
    border-color: var(--bell, #b8893a);
    transform: translateX(6px);
    box-shadow: var(--glass-shadow-glow, 0 0 30px rgba(184, 137, 58, 0.25));
  }

  .finder-opt-btn[aria-pressed='true'] {
    box-shadow: inset 0 0 0 2px #ffe1ab;
  }

  .finder-opt-btn [data-finder-selected] {
    color: #ffe1ab;
    font-weight: 600;
  }

  .opt-label {
    font-size: var(--mt-type-body);
    font-weight: 600;
    color: #f1f5f9;
  }

  /* Results Card */
  .finder-result-card {
    background: var(--glass-surface-dark, rgba(20, 17, 15, 0.75));
    backdrop-filter: var(--glass-blur, blur(14px));
    -webkit-backdrop-filter: var(--glass-blur, blur(14px));
    border: 1.5px solid var(--bell, #b8893a);
    border-radius: var(--radius-card, 1.5rem);
    padding: 2.5rem;
    box-shadow: var(--glass-shadow-lg, 0 20px 50px rgba(20, 17, 15, 0.22)),
                var(--glass-shadow-glow, 0 0 30px rgba(184, 137, 58, 0.25));
    animation: finder-fade-in 0.4s var(--ease-strike);
  }

  .finder-result-pill {
    font-family: var(--mt-type-family-mono);
    font-size: var(--mt-type-mono);
    letter-spacing: 0.12em;
    color: #ffe1ab;
    margin-block-end: 0.75rem;
  }

  .finder-result-title {
    margin: 0 0 0.85rem;
    font-family: var(--mt-type-family-heading);
    font-size: var(--mt-type-heading);
    color: #f8fafc;
  }

  .finder-result-desc {
    font-size: var(--mt-type-body);
    line-height: 1.65;
    color: #cbd5e1;
    margin: 0 0 1.5rem;
  }

  .finder-reasoning-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
    margin-block-end: 2rem;
  }

  .maison-finder .r-chip {
    font-family: var(--mt-type-family-mono);
    font-size: var(--mt-type-accent);
    letter-spacing: var(--mt-type-tracking-accent);
    background: var(--glass-surface-bronze, rgba(184, 137, 58, 0.16));
    border: 1px solid var(--glass-border-bronze, rgba(184, 137, 58, 0.35));
    color: #ffe1ab;
    padding: 0.35rem 0.85rem;
    border-radius: var(--radius-pill, 62.5rem);
  }

  .finder-result-actions {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  .finder-view-btn {
    background: #ffe1ab;
    color: #111;
    font-weight: 700;
    text-decoration: none;
    padding: 0.85rem 1.85rem;
    border-radius: var(--radius-pill, 62.5rem);
    font-size: var(--mt-type-body);
    transition: background 0.2s, transform 0.2s var(--ease-strike), box-shadow 0.2s;
  }

  .finder-view-btn:hover {
    background: #ffe1ab;
    text-decoration: underline;
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(184, 137, 58, 0.35);
  }

  .finder-restart-btn {
    background: transparent;
    border: none;
    color: #cbd5e1;
    text-decoration: underline;
    cursor: pointer;
    font-size: var(--mt-type-accent);
  }

  .finder-restart-btn:hover {
    color: #f1f5f9;
  }

  .finder-back-btn {
    margin-block-start: 1rem;
  }

  .finder-result-actions {
    flex-wrap: wrap;
  }

  @media (prefers-reduced-motion: reduce) {
    .maison-finder [data-mt-scroll],
    .maison-finder [data-mt-chapter] {
      opacity: 1 !important;
      transform: none !important;
      visibility: visible !important;
    }
  }

  html[data-reduced-motion='true'] .maison-finder [data-mt-scroll],
  html[data-reduced-motion='true'] .maison-finder [data-mt-chapter] {
    opacity: 1 !important;
    transform: none !important;
    visibility: visible !important;
  }
{% endstylesheet %}

{% javascript %}
  function initializeFinder() {
    const root = document.querySelector('[data-root="maison-finder-root"]');
    if (!root || root.dataset.finderReady === 'true') return;

    let currentQ = 0;
    const answers = {};

    const qCards = root.querySelectorAll('.finder-q-card');
    const bells = root.querySelectorAll('.bell-mark');
    const progressText = document.getElementById('finder-progress-text');
    const resultsBox = document.getElementById('finder-results-box');
    const questionsBox = document.getElementById('finder-questions-box');

    const resultTitle = document.getElementById('result-title');
    const resultDesc = document.getElementById('result-desc');
    const resultChips = document.getElementById('result-chips');
    const resultLink = document.getElementById('result-link');
    const restartBtn = document.getElementById('finder-restart-btn');
    const backBtn = document.getElementById('finder-back-btn');
    const resultBackBtn = document.getElementById('finder-result-back-btn');
    const fallback = root.querySelector('[data-finder-fallback]');

    const suggestions = {
      fry: ['Forge frying pan', 'Sloped sides give you room to turn and lift food.'],
      tawa: ['Forge tawa', 'A low edge gives you room to spread dosa batter and turn flatbread.'],
      stockpot: ['Forge stockpot', 'Tall sides leave room for stock, curries and batch cooking.'],
      saute: ['Forge sauté pan', 'Straight sides give a braise room for liquid.'],
      clay: ['Chulha terracotta', 'Explore terracotta forms for the dishes you make. Hob compatibility is still being tested.'],
      prep: ['Choose the cooking vessel', 'The current range does not include knives. Explore Forge for the pan that follows your preparation.'],
      forge: ['Check the oven rating first', 'Look for an explicit oven rating for the vessel, handles and lid before you choose.'],
    };

    function updateView() {
      qCards.forEach((c, idx) => c.classList.toggle('is-active', idx === currentQ));
      bells.forEach((b, idx) => {
        b.classList.toggle('is-active', idx <= currentQ);
        b.textContent = idx <= currentQ ? '●' : '○';
      });
      if (progressText) progressText.textContent = `QUESTION ${currentQ + 1} OF 5`;
      if (backBtn) backBtn.hidden = currentQ === 0;
      qCards[currentQ]?.querySelector('h2')?.focus();
    }

    function calculateResult() {
      questionsBox.style.display = 'none';
      resultsBox.style.display = 'block';
      if (progressText) progressText.textContent = 'RECOMMENDATION';

      let pick = 'fry';
      if (answers[1] === 'prep') {
        pick = 'prep';
      } else if (answers[0] === 'oven') {
        pick = 'forge';
      } else if (answers[0] === 'gas' && answers[2] === 'clay') {
        pick = 'clay';
      } else if (answers[1] === 'dosa') {
        pick = 'tawa';
      } else if (answers[1] === 'braise') {
        pick = answers[3] === 'family' ? 'stockpot' : 'saute';
      }

      const [title, description] = suggestions[pick];
      const hobs = { induction: 'Check induction fit', gas: 'Check gas fit', electric: 'Check electric hob fit', oven: 'Check the oven rating' };
      const care = answers[4] === 'ritual' ? 'Check surface care' : 'Check cleaning instructions';
      const tags = pick === 'prep' ? [care] : [hobs[answers[0]], care];

      resultTitle.textContent = title;
      resultDesc.textContent = description;
      resultLink.href = root.dataset[`${pick}Url`] || root.dataset.forgeUrl;
      resultChips.replaceChildren(...tags.map((tag) => {
        const chip = document.createElement('span');
        chip.className = 'r-chip';
        chip.textContent = tag;
        return chip;
      }));
      resultTitle.focus();
    }

    root.querySelectorAll('.finder-opt-btn').forEach(btn => {
      btn.setAttribute('aria-pressed', 'false');
      const selectedLabel = document.createElement('span');
      selectedLabel.dataset.finderSelected = '';
      selectedLabel.setAttribute('aria-hidden', 'true');
      selectedLabel.textContent = 'Selected';
      selectedLabel.hidden = true;
      btn.appendChild(selectedLabel);
      btn.addEventListener('click', () => {
        qCards[currentQ].querySelectorAll('.finder-opt-btn').forEach(option => {
          const selected = option === btn;
          option.setAttribute('aria-pressed', String(selected));
          option.querySelector('[data-finder-selected]').hidden = !selected;
        });
        answers[currentQ] = btn.dataset.answer;
        if (currentQ < 4) {
          currentQ++;
          updateView();
        } else {
          calculateResult();
        }
      });
    });

    backBtn?.addEventListener('click', () => {
      if (currentQ > 0) {
        currentQ--;
        updateView();
      }
    });

    resultBackBtn?.addEventListener('click', () => {
      questionsBox.style.display = 'block';
      resultsBox.style.display = 'none';
      updateView();
    });

    if (restartBtn) {
      restartBtn.addEventListener('click', () => {
        currentQ = 0;
        Object.keys(answers).forEach(key => delete answers[key]);
        root.querySelectorAll('.finder-opt-btn').forEach(btn => {
          btn.setAttribute('aria-pressed', 'false');
          btn.querySelector('[data-finder-selected]').hidden = true;
        });
        questionsBox.style.display = 'block';
        resultsBox.style.display = 'none';
        updateView();
      });
    }
    root.dataset.finderReady = 'true';
    questionsBox.hidden = false;
    if (progressText) progressText.hidden = false;
    if (fallback) fallback.hidden = true;
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initializeFinder, { once: true });
  } else {
    initializeFinder();
  }
{% endjavascript %}

{% schema %}
{
  "name": "Finder as Ceremony",
  "tag": "section",
  "class": "section-wrapper",
  "settings": [],
  "presets": [
    {
      "name": "Finder as Ceremony (V6)",
      "category": "Maison Tavo"
    }
  ]
}
{% endschema %}
