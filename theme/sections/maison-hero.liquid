{% comment %}
  Maison Tavo — Post-splash full-bleed hero.
  First viewport: brand + Instrument Serif headline + house tagline + CTA.
  Art-directed crops via <picture> (optional mobile/tablet images) + CSS object-fit.
  Media: section pickers → Forge Hybrid product → assets/maison-hero.svg (swap for maison-hero.jpg).
{% endcomment %}

{% liquid
  assign hero_desktop = section.settings.image
  assign hero_tablet = section.settings.image_tablet
  assign hero_mobile = section.settings.image_mobile
  assign hero_alt = section.settings.image_alt | strip
  assign headline = section.settings.headline | default: 'Live with cookware that outlasts you.'
  assign tagline = section.settings.tagline | default: 'Know what fits your hob, how it was made and how to keep it.'
  assign brand_label = section.settings.brand | default: 'Maison Tavo'
  assign media_mode = 'asset'
  assign forge_collection = collections['forge']
  assign forge_url = routes.collections_url
  if forge_collection != blank and forge_collection.products_count > 0
    assign forge_url = forge_collection.url
  endif

  if hero_desktop == blank
    if forge_collection != blank and forge_collection.products_count > 0
      assign hero_product = forge_collection.products.first
      if hero_product.featured_image != blank
        assign hero_desktop = hero_product.featured_image
        if hero_alt == blank
          assign hero_alt = hero_product.featured_image.alt | default: hero_product.title
        endif
      endif
    endif
  endif

  if hero_desktop != blank
    assign media_mode = 'image'
  endif

  if hero_alt == blank
    assign hero_alt = 'Maison Tavo hand-forged dual-mass cookware'
  endif

  if hero_tablet == blank
    assign hero_tablet = hero_desktop
  endif
  if hero_mobile == blank
    assign hero_mobile = hero_desktop
  endif
%}

<section class="maison-hero" data-section-id="{{ section.id }}">
  <div class="maison-hero__stage">
    <div class="maison-hero__media" data-mt-scroll="image" data-mt-when="load">
      {% if media_mode == 'image' %}
        <picture class="maison-hero__picture" data-mt-scrub="16">
          {% if section.settings.image_mobile != blank %}
            <source
              media="(max-width: 749px)"
              srcset="
                {{ hero_mobile | image_url: width: 750 }} 750w,
                {{ hero_mobile | image_url: width: 1100 }} 1100w,
                {{ hero_mobile | image_url: width: 1500 }} 1500w
              "
              sizes="100vw"
              width="{{ hero_mobile.width }}"
              height="{{ hero_mobile.height }}"
            >
          {% endif %}
          {% if section.settings.image_tablet != blank %}
            <source
              media="(min-width: 750px) and (max-width: 1199px)"
              srcset="
                {{ hero_tablet | image_url: width: 1200 }} 1200w,
                {{ hero_tablet | image_url: width: 1600 }} 1600w,
                {{ hero_tablet | image_url: width: 2000 }} 2000w
              "
              sizes="100vw"
              width="{{ hero_tablet.width }}"
              height="{{ hero_tablet.height }}"
            >
          {% endif %}
          <source
            media="(min-width: 1200px)"
            srcset="
              {{ hero_desktop | image_url: width: 1600 }} 1600w,
              {{ hero_desktop | image_url: width: 2000 }} 2000w,
              {{ hero_desktop | image_url: width: 2400 }} 2400w,
              {{ hero_desktop | image_url: width: 2880 }} 2880w
            "
            sizes="100vw"
            width="{{ hero_desktop.width }}"
            height="{{ hero_desktop.height }}"
          >
          {{
            hero_desktop
            | image_url: width: 2400
            | image_tag:
              class: 'maison-hero__img',
              widths: '750, 1100, 1500, 1800, 2400, 2880',
              sizes: '100vw',
              loading: 'eager',
              fetchpriority: 'high',
              alt: hero_alt,
              width: hero_desktop.width,
              height: hero_desktop.height
          }}
        </picture>
      {% else %}
        <picture class="maison-hero__picture" data-mt-scrub="16">
          <source
            media="(max-width: 749px)"
            srcset="{{ 'maison-kadai-topdown.webp' | asset_url }}"
            width="823"
            height="823"
          >
          <source
            media="(min-width: 750px) and (max-width: 1199px)"
            srcset="{{ 'maison-hero-kadai.webp' | asset_url }}"
            width="823"
            height="823"
          >
          <source
            media="(min-width: 1200px)"
            srcset="{{ 'maison-hero.webp' | asset_url }}"
            width="823"
            height="823"
          >
          <img
            class="maison-hero__img maison-hero__img--asset"
            src="{{ 'maison-hero.webp' | asset_url }}"
            alt="{{ hero_alt | escape }}"
            width="823"
            height="823"
            loading="eager"
            fetchpriority="high"
            decoding="async"
            data-mt-scrub="16"
            onerror="if(this.src!=='{{ 'maison-hero.svg' | asset_url }}'){this.src='{{ 'maison-hero.svg' | asset_url }}';}"
          >
        </picture>
      {% endif %}
    </div>

    <div class="maison-hero__scrim" aria-hidden="true"></div>

    <div class="maison-hero__content">
      <p class="maison-hero__brand" data-mt-scroll data-mt-when="load">{{ brand_label | escape }}</p>

      <h1
        class="maison-hero__headline"
        id="maisonHeroTitle"
        data-mt-scroll="beat"
        data-mt-when="load"
      >
        {{ headline | escape }}
      </h1>

      <p class="maison-hero__tagline" data-mt-scroll data-mt-when="load">
        {{ tagline | escape }}
      </p>

      <div class="maison-hero__actions" data-mt-scroll="beat" data-mt-when="load">
        <a href="{{ routes.collections_url }}" class="maison-btn maison-btn--primary">
          <span>Shop the catalogue</span>
          <span class="maison-btn__arrow" aria-hidden="true">→</span>
        </a>
        <a href="/pages/releases" class="maison-btn maison-btn--ghost">
          <span>Releases</span>
        </a>
      </div>
    </div>
  </div>

  <div class="maison-hero__below">
    <form
      class="maison-hero__search"
      action="{{ routes.search_url }}"
      method="get"
      role="search"
      data-maison-open-predictive
      data-mt-scroll="beat"
    >
      <label class="visually-hidden" for="MaisonHeroSearch">Search the catalogue</label>
      <input
        id="MaisonHeroSearch"
        type="search"
        name="q"
        placeholder="Skillet, tava, terre…"
        autocomplete="off"
        enterkeyhint="search"
      >
      <button type="submit" class="maison-btn maison-btn--primary">Search</button>
    </form>

    <div class="maison-hero__provenance-strip" id="lineups" data-mt-scroll="stagger">
      <a class="provenance-col" data-mt-scroll-item href="{{ forge_url }}">
        <span class="provenance-num">01</span>
        <h2 class="provenance-title">Forge</h2>
        <p class="provenance-desc">Stainless steel cookware in grouped sizes, with matched sets.</p>
      </a>
      <a class="provenance-col" data-mt-scroll-item href="{{ collections['chulha'].url | default: '/collections/chulha' }}">
        <span class="provenance-num">02</span>
        <h2 class="provenance-title">Chulha</h2>
        <p class="provenance-desc">Terracotta forms for flatbreads, chai and slow-cooked meals.</p>
      </a>
      <a class="provenance-col" data-mt-scroll-item href="{{ collections['maintenance'].url | default: '/collections/maintenance' }}">
        <span class="provenance-num">03</span>
        <h2 class="provenance-title">Maintenance</h2>
        <p class="provenance-desc">Care supplies and replacement parts that keep a piece in use.</p>
      </a>
      <a class="provenance-col" data-mt-scroll-item href="/pages/kansa">
        <span class="provenance-num">04</span>
        <h2 class="provenance-title">Kansa</h2>
        <p class="provenance-desc">Living will of the house — care, heat, sight, and memory for the piece in hand.</p>
      </a>
    </div>
  </div>
</section>

{% stylesheet %}
  .maison-hero {
    position: relative;
    color: var(--soot, #14110f);
    background: var(--limewash, #efe8dc);
  }

  .maison-hero__stage {
    position: relative;
    isolation: isolate;
    display: grid;
    align-items: end;
    min-height: min(100svh, 48rem);
    width: 100%;
    overflow: hidden;
    color: var(--bone, #f7f2e9);
  }

  .maison-hero__media,
  .maison-hero__picture,
  .maison-hero__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .maison-hero__img {
    display: block;
    object-fit: cover;
    object-position: 58% 42%;
    filter: contrast(1.04) brightness(0.92);
  }

  .maison-hero__img--asset {
    filter: none;
  }

  .maison-hero__scrim {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background:
      linear-gradient(
        180deg,
        rgba(20, 17, 15, 0.28) 0%,
        rgba(20, 17, 15, 0.18) 38%,
        rgba(20, 17, 15, 0.72) 100%
      ),
      linear-gradient(
        90deg,
        rgba(20, 17, 15, 0.35) 0%,
        rgba(20, 17, 15, 0.08) 55%,
        rgba(20, 17, 15, 0.2) 100%
      );
  }

  .maison-hero__content {
    position: relative;
    z-index: 2;
    width: min(49rem, 100%);
    padding:
      clamp(3rem, 12svh, 8rem)
      clamp(1rem, 4vw, 4rem)
      clamp(1.5rem, 5svh, 4rem);
  }

  .maison-hero__brand {
    margin: 0 0 0.85rem;
    font-family: var(--mt-type-family-accent);
    font-size: max(0.875rem, var(--mt-type-nav));
    font-weight: 500;
    letter-spacing: 0.035em;
    line-height: 1.4;
    color: var(--bone, #f7f2e9);
  }

  .maison-hero .maison-hero__headline {
    margin: 0 0 0.85rem;
    max-inline-size: 23ch;
    font-family: var(--mt-type-family-heading);
    font-size: clamp(2.625rem, 1.95rem + 3.2vw, 4.75rem);
    font-weight: 400;
    line-height: 1.04;
    letter-spacing: var(--mt-type-tracking-heading, -0.02em);
    font-kerning: normal;
    font-variant-ligatures: common-ligatures contextual no-discretionary-ligatures;
    text-transform: none;
    text-wrap: balance;
    overflow-wrap: anywhere;
    color: var(--bone, #f7f2e9);
  }

  .maison-hero__tagline {
    margin: 0 0 clamp(1.25rem, 3vw, 2rem);
    max-inline-size: 43ch;
    font-family: var(--mt-type-family-body);
    font-size: clamp(1.0625rem, 0.98rem + 0.35vw, 1.25rem);
    font-weight: 400;
    line-height: 1.55;
    letter-spacing: normal;
    color: var(--bone, #f7f2e9);
  }

  .maison-hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--mt-space-3) var(--mt-space-5);
  }

  .maison-hero .maison-btn {
    display: inline-flex;
    align-items: center;
    gap: var(--mt-space-2);
    padding: var(--mt-space-4) var(--mt-space-6);
    border-radius: 0.125rem;
    font-family: var(--mt-type-family-accent, var(--font-accent--family, sans-serif));
    font-size: var(--mt-type-button, var(--font-size--brand-button, 0.75rem));
    letter-spacing: var(--mt-type-tracking-accent, 0.1em);
    text-transform: uppercase;
    text-decoration: none;
    cursor: pointer;
    transition:
      transform var(--dur-mid, 420ms) var(--ease-strike, cubic-bezier(0.2, 0.8, 0.2, 1)),
      background-color var(--dur-mid, 420ms) var(--ease-strike, cubic-bezier(0.2, 0.8, 0.2, 1)),
      border-color var(--dur-mid, 420ms) var(--ease-strike, cubic-bezier(0.2, 0.8, 0.2, 1)),
      color var(--dur-mid, 420ms) var(--ease-strike, cubic-bezier(0.2, 0.8, 0.2, 1));
  }

  .maison-hero .maison-btn--primary {
    background: var(--bone, #f7f2e9);
    color: var(--soot, #14110f);
    border: 0.0625rem solid var(--bell, #b8893a);
  }

  .maison-hero .maison-btn--primary:hover {
    background: var(--ember, #e2552b);
    border-color: var(--ember, #e2552b);
    color: #fff;
    transform: translateY(-0.0625rem);
  }

  .maison-hero .maison-btn--ghost {
    background: transparent;
    color: var(--bone, #f7f2e9);
    border: 0.0625rem solid color-mix(in srgb, var(--bone, #f7f2e9) 42%, transparent);
  }

  .maison-hero .maison-btn--ghost:hover {
    border-color: var(--bell, #b8893a);
    color: var(--bell, #b8893a);
  }

  .maison-hero a:focus-visible,
  .maison-hero button:focus-visible,
  .maison-hero input:focus-visible {
    outline: 0.125rem solid var(--bell, #b8893a);
    outline-offset: 0.1875rem;
  }

  .maison-hero__below {
    width: min(87.5rem, 100%);
    margin-inline: auto;
    padding:
      clamp(var(--mt-space-6), 5vw, var(--mt-space-8))
      clamp(var(--mt-space-5), 4vw, var(--mt-space-8))
      clamp(var(--mt-space-7), 6vw, var(--mt-space-8));
  }

  .maison-hero__search {
    display: flex;
    flex-wrap: wrap;
    align-items: stretch;
    gap: var(--mt-space-3);
    max-width: min(36rem, 100%);
    margin: 0 0 clamp(var(--mt-space-6), 4vw, var(--mt-space-7));
  }

  .maison-hero__search input[type='search'] {
    flex: 1 1 14rem;
    min-height: var(--mt-space-7);
    padding: var(--mt-space-3) var(--mt-space-4);
    border: 0.0625rem solid color-mix(in srgb, var(--soot, #14110f) 22%, transparent);
    background: transparent;
    color: inherit;
    font-family: var(--mt-type-family-body, var(--font-body--family, sans-serif));
    font-size: var(--mt-type-body, 1rem);
    letter-spacing: 0.01em;
  }

  .maison-hero__search input[type='search']::placeholder {
    color: color-mix(in srgb, var(--soot, #14110f) 42%, transparent);
  }

  .maison-hero__provenance-strip {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--mt-space-5) var(--mt-space-6);
    border-top: 0.0625rem solid color-mix(in srgb, var(--soot, #14110f) 15%, transparent);
    padding-top: var(--mt-space-6);
  }

  a.provenance-col {
    display: block;
    color: inherit;
    text-decoration: none;
    padding: var(--mt-space-4) var(--mt-space-1) var(--mt-space-2);
    border-top: 0.0625rem solid color-mix(in srgb, var(--soot, #14110f) 15%, transparent);
    transition: transform var(--dur-mid, 420ms) var(--ease-strike, cubic-bezier(0.2, 0.8, 0.2, 1));
  }

  a.provenance-col:hover {
    transform: translateY(-0.2rem);
  }

  .provenance-num {
    display: block;
    margin-bottom: var(--mt-space-2);
    font-family: var(--mt-type-family-mono, var(--font-mono--family, monospace));
    font-size: var(--mt-type-mono);
    letter-spacing: 0.1em;
    color: var(--bell, #b8893a);
  }

  .provenance-title {
    margin: 0 0 var(--mt-space-2);
    font-family: var(--mt-type-family-heading, var(--font-heading--family, 'Instrument Serif', Georgia, serif));
    font-size: var(--mt-type-lede);
    font-weight: 400;
    color: var(--soot, #14110f);
  }

  .provenance-desc {
    margin: 0;
    font-family: var(--mt-type-family-body, var(--font-body--family, sans-serif));
    font-size: var(--mt-type-body, 1rem);
    line-height: var(--mt-type-leading-body, 1.6);
    color: color-mix(in srgb, var(--soot, #14110f) 75%, transparent);
  }

  @media (max-width: 1199px) {
    .maison-hero__img {
      object-position: 52% 38%;
    }
  }

  @media (max-width: 749px) {
    .maison-hero__img {
      object-position: 46% 32%;
    }

    .maison-hero__provenance-strip {
      grid-template-columns: 1fr;
      gap: var(--mt-space-6);
    }
  }

  @media (min-width: 750px) and (max-width: 1199px) {
    .maison-hero__provenance-strip {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--mt-space-6) var(--mt-space-5);
    }
  }

  @media (min-width: 1200px) {
    .maison-hero__img {
      object-position: 58% 42%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .maison-hero [data-mt-scroll],
    .maison-hero [data-mt-scroll-item],
    .maison-hero [data-mt-scrub] {
      opacity: 1 !important;
      transform: none !important;
      visibility: visible !important;
    }
  }

  html[data-reduced-motion='true'] .maison-hero [data-mt-scroll],
  html[data-reduced-motion='true'] .maison-hero [data-mt-scroll-item],
  html[data-reduced-motion='true'] .maison-hero [data-mt-scrub] {
    opacity: 1 !important;
    transform: none !important;
    visibility: visible !important;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Maison V2 Hero",
  "tag": "section",
  "class": "section-maison-hero",
  "settings": [
    {
      "type": "text",
      "id": "brand",
      "label": "Brand",
      "default": "Maison Tavo"
    },
    {
      "type": "text",
      "id": "headline",
      "label": "Headline",
      "default": "Live with cookware that outlasts you."
    },
    {
      "type": "text",
      "id": "tagline",
      "label": "Tagline",
      "default": "Know what fits your hob, how it was made and how to keep it."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Hero image (desktop)",
      "info": "Full-bleed. Falls back to Forge Hybrid media, then theme asset maison-hero.svg (replace with maison-hero.jpg when ready)."
    },
    {
      "type": "image_picker",
      "id": "image_tablet",
      "label": "Hero image (tablet crop)",
      "info": "Optional art-directed crop for 750–1199px. Uses desktop image when blank."
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Hero image (mobile crop)",
      "info": "Optional art-directed crop for ≤749px. Uses desktop image when blank."
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Image alt text",
      "default": "Maison Tavo hand-forged dual-mass cookware"
    }
  ],
  "presets": [
    {
      "name": "Maison V2 Hero"
    }
  ]
}
{% endschema %}
