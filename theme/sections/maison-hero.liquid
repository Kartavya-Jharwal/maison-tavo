{% comment %}
  Maison Tavo — V2 Signature Hero: "Heat takes shape."
  Art Direction: "The forge, the kitchen, the temple bell."
  Asymmetric editorial layout, Fraunces serif display, Devanagari signature,
  tactile provenance indicators, and direct exploration pathways.
{% endcomment %}

<section class="maison-hero" data-section-id="{{ section.id }}">
  <div class="maison-hero__container">
    <div class="maison-hero__grid">
      <!-- Left Editorial Column -->
      <div class="maison-hero__editorial">
        <div class="maison-hero__eyebrow-row">
          <span class="maison-hero__kicker">Atelier &amp; Fonderie</span>
          <span class="maison-hero__divider">/</span>
          <span class="maison-hero__devanagari">कांसे की गूँज · रसोई की साधना</span>
        </div>

        <h1 class="maison-hero__headline" id="maisonHeroTitle">
          <span class="clip-line"><span class="hero-word">Heat takes</span></span><br>
          <span class="clip-line"><span class="hero-word maison-hero__headline--italic">shape.</span></span>
        </h1>

        <p class="maison-hero__lede">
          Modern heirlooms for the working kitchen — metallurgy you can parse, craft you can live with.
          Forged dual-mass carbon steel, hand-beaten bell bronze, and refractory cast clay.
        </p>

        <form class="maison-hero__search" action="{{ routes.search_url }}" method="get" role="search">
          <label class="visually-hidden" for="MaisonHeroSearch">Search the catalogue</label>
          <input
            id="MaisonHeroSearch"
            type="search"
            name="q"
            placeholder="Search skillets, kansa, clay"
            autocomplete="off"
          >
          <button type="submit" class="maison-btn maison-btn--primary">Search</button>
        </form>

        <div class="maison-hero__actions">
          <a href="{{ routes.collections_url }}" class="maison-btn maison-btn--primary">
            <span>Shop the catalogue</span>
            <span class="maison-btn__arrow">→</span>
          </a>
          <a href="/pages/new-arrivals" class="maison-btn maison-btn--subtle">
            <span>New arrivals</span>
          </a>
          <a href="/pages/kansa" class="maison-btn maison-btn--text">Ask Kansa</a>
        </div>
      </div>

      <!-- Right Visual Column -->
      <div class="maison-hero__visual">
        <div class="maison-hero__image-frame">
          <img
            src="https://images.unsplash.com/photo-1584269600464-37b1b58a9fe7?q=85&w=1200&auto=format&fit=crop"
            alt="Maison Tavo Hand-Forged Dual-Mass Cookware"
            class="maison-hero__img"
            loading="eager"
            width="1200"
            height="900"
          >
          <div class="maison-hero__provenance-tag">
            <span class="tag-label">SPEC NO. 01</span>
            <span class="tag-title">Forge Relay 280 · Dual-Mass Carbon Steel</span>
            <span class="tag-meta">Induction Ready · Bell-Bronze Rivets · 2.4kg</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Metallurgy Provenance Strip -->
    <div class="maison-hero__provenance-strip" id="lineups">
      <a class="provenance-col" href="{{ collections['forge-hybrid'].url | default: '/collections/forge-hybrid' }}">
        <span class="provenance-num">01</span>
        <h4 class="provenance-title">Forge Hybrid</h4>
        <p class="provenance-desc">Carbon-steel cookline concepts. Dual-mass heat retention with lightweight hospitality handling.</p>
      </a>
      <a class="provenance-col" href="{{ collections['terre-clay'].url | default: '/collections/terre-clay' }}">
        <span class="provenance-num">02</span>
        <h4 class="provenance-title">Terre Clay</h4>
        <p class="provenance-desc">Refractory cast clay vessels and table service. Ancient thermal memory with modern kitchen durability.</p>
      </a>
      <a class="provenance-col" href="{{ collections['kuro-strip'].url | default: '/collections/kuro-strip' }}">
        <span class="provenance-num">03</span>
        <h4 class="provenance-title">Kuro Strip</h4>
        <p class="provenance-desc">Hybrid-edge blade geometry. Precision edge retention inspired by traditional forge craft.</p>
      </a>
      <a class="provenance-col" href="/pages/kansa">
        <span class="provenance-num">04</span>
        <h4 class="provenance-title">Kansa</h4>
        <p class="provenance-desc">Its own room. Ask the bell-bronze companion about heat, care, and the piece in your hand.</p>
      </a>
    </div>
  </div>
</section>

<style>
  .maison-hero {
    background-color: var(--limewash, #EFE8DC);
    color: var(--soot, #14110F);
    padding-top: clamp(3rem, 6vw, 6.5rem);
    padding-bottom: clamp(4rem, 8vw, 7.5rem);
    position: relative;
    overflow: hidden;
  }

  .maison-hero__container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 clamp(1.5rem, 4vw, 4rem);
  }

  .maison-hero__grid {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    gap: clamp(2.5rem, 5vw, 6rem);
    align-items: center;
    margin-bottom: clamp(4rem, 8vw, 7rem);
  }

  .maison-hero__eyebrow-row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1.5rem;
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--bell, #B8893A);
  }

  .maison-hero__divider {
    opacity: 0.4;
  }

  .maison-hero__devanagari {
    font-family: var(--font-devanagari--family, 'Noto Serif Devanagari', serif);
    letter-spacing: 0.15em;
    font-size: 0.85rem;
    color: var(--bell, #B8893A);
  }

  .maison-hero__headline {
    font-family: var(--font-heading--family, 'Fraunces', serif);
    font-size: clamp(3.2rem, 8vw, 7.5rem);
    font-weight: 400;
    line-height: 0.95;
    letter-spacing: -0.025em;
    margin: 0 0 2rem 0;
    color: var(--soot, #14110F);
  }

  .hero-word {
    display: inline-block;
    transform: translateY(115%);
    opacity: 0;
    will-change: transform, opacity;
  }

  .maison-hero.is-revealed .hero-word,
  .maison-hero.revealed .hero-word {
    transform: translateY(0);
    opacity: 1;
    transition:
      transform 1.1s cubic-bezier(0.16, 1, 0.3, 1),
      opacity 0.8s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .maison-hero.is-revealed .clip-line:nth-of-type(2) .hero-word,
  .maison-hero.revealed .clip-line:nth-of-type(2) .hero-word {
    transition-delay: 0.16s;
  }

  .maison-hero__headline--italic {
    font-style: italic;
    font-weight: 300;
    color: var(--bell, #B8893A);
  }

  .maison-hero__lede {
    font-size: clamp(1.05rem, 1.4vw, 1.25rem);
    line-height: 1.65;
    color: rgba(20, 17, 15, 0.82);
    max-width: 48ch;
    margin: 0 0 2.5rem 0;
  }

  .maison-hero__actions {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    flex-wrap: wrap;
  }

  .maison-hero__search {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    max-width: 36rem;
    margin: 0 0 1.25rem;
  }

  .maison-hero__search input[type='search'] {
    flex: 1 1 14rem;
    min-height: 48px;
    padding: 0 1rem;
    border: 1px solid rgba(20, 17, 15, 0.25);
    background: transparent;
    color: inherit;
    font: inherit;
  }

  .maison-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.9rem 1.8rem;
    border-radius: 2px;
    font-family: var(--font-body--family, sans-serif);
    font-size: 0.82rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    cursor: pointer;
    transition: all var(--dur-mid, 420ms) var(--ease-strike, cubic-bezier(.2, .8, .2, 1));
  }

  .maison-btn--primary {
    background: var(--soot, #14110F);
    color: var(--bone, #F7F2E9);
    border: 1px solid var(--bell, #B8893A);
  }

  .maison-btn--primary:hover {
    background: var(--ember, #E2552B);
    border-color: var(--ember, #E2552B);
    color: #fff;
    transform: translateY(-1px);
    box-shadow: 0 8px 24px rgba(226, 85, 43, 0.25);
  }

  .maison-btn--subtle {
    background: transparent;
    color: var(--soot, #14110F);
    border: 1px solid rgba(20, 17, 15, 0.25);
  }

  .maison-btn--subtle:hover {
    border-color: var(--bell, #B8893A);
    color: var(--bell, #B8893A);
  }

  .maison-btn--text {
    padding-inline: 0;
    background: transparent;
    color: var(--soot, #14110F);
    border: 0;
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .maison-hero a:focus-visible,
  .maison-hero button:focus-visible,
  .maison-hero input:focus-visible {
    outline: 2px solid var(--bell, #B8893A);
    outline-offset: 3px;
  }

  a.provenance-col {
    display: block;
    color: inherit;
    text-decoration: none;
  }

  .maison-btn__dot {
    color: var(--bell, #B8893A);
    font-size: 0.7rem;
  }

  /* Right Visual */
  .maison-hero__visual {
    position: relative;
  }

  .maison-hero__image-frame {
    position: relative;
    border-radius: 2px;
    overflow: hidden;
    background: var(--bone, #F7F2E9);
    box-shadow: 0 24px 60px rgba(20, 17, 15, 0.12);
  }

  .maison-hero__img {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3.2;
    object-fit: cover;
    display: block;
    filter: contrast(1.04) brightness(0.98);
    transition: transform var(--dur-slow, 900ms) var(--ease-strike, cubic-bezier(.2, .8, .2, 1));
  }

  .maison-hero__image-frame:hover .maison-hero__img {
    transform: scale(1.02);
  }

  .maison-hero__provenance-tag {
    position: absolute;
    bottom: 1.25rem;
    left: 1.25rem;
    right: 1.25rem;
    background: var(--glass-surface-dark, rgba(20, 17, 15, 0.75));
    backdrop-filter: var(--glass-blur, blur(14px));
    -webkit-backdrop-filter: var(--glass-blur, blur(14px));
    padding: 1rem 1.25rem;
    border: 1px solid var(--glass-border-dark, rgba(247, 242, 233, 0.14));
    border-left: 3px solid var(--bell, #B8893A);
    border-radius: var(--radius-card-sm, 0.875rem);
    box-shadow: var(--glass-shadow, 0 10px 35px rgba(20, 17, 15, 0.12));
    color: var(--bone, #F7F2E9);
  }

  .tag-label {
    display: block;
    font-family: var(--font-mono--family, monospace);
    font-size: 0.68rem;
    letter-spacing: 0.14em;
    color: var(--bell, #B8893A);
    margin-bottom: 0.2rem;
  }

  .tag-title {
    display: block;
    font-family: var(--font-heading--family, 'Fraunces', serif);
    font-size: 1.05rem;
    margin-bottom: 0.2rem;
  }

  .tag-meta {
    display: block;
    font-family: var(--font-mono--family, monospace);
    font-size: 0.72rem;
    color: #A39B8F;
    letter-spacing: 0.04em;
  }

  /* Provenance 4-Column Strip */
  .maison-hero__provenance-strip {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 2rem;
    border-top: 1px solid rgba(20, 17, 15, 0.15);
    padding-top: 3rem;
  }

  .provenance-col {
    position: relative;
    padding: 1.25rem 1rem;
    border-top: 1px solid var(--hairline, rgba(20, 17, 15, 0.15));
    border-radius: var(--radius-card-sm, 0.875rem);
    transition: transform var(--dur-mid, 420ms) var(--ease-strike, cubic-bezier(.2, .8, .2, 1)),
                background 0.3s ease,
                box-shadow 0.3s ease;
  }

  .provenance-col:hover {
    background: var(--glass-surface-light, rgba(247, 242, 233, 0.72));
    backdrop-filter: var(--glass-blur-sm, blur(8px));
    -webkit-backdrop-filter: var(--glass-blur-sm, blur(8px));
    transform: translateY(-4px);
    box-shadow: var(--glass-shadow, 0 10px 35px rgba(20, 17, 15, 0.12));
  }

  .provenance-num {
    display: block;
    font-family: var(--font-mono--family, monospace);
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    color: var(--bell, #B8893A);
    margin-bottom: 0.6rem;
  }

  .provenance-title {
    font-family: var(--font-heading--family, 'Fraunces', serif);
    font-size: 1.25rem;
    margin: 0 0 0.5rem 0;
    color: var(--soot, #14110F);
  }

  .provenance-desc {
    font-size: 0.86rem;
    line-height: 1.6;
    color: rgba(20, 17, 15, 0.75);
    margin: 0;
  }

  @media (max-width: 960px) {
    .maison-hero__grid {
      grid-template-columns: 1fr;
      gap: 3rem;
    }
    .maison-hero__provenance-strip {
      grid-template-columns: repeat(2, 1fr);
      gap: 2.5rem 1.5rem;
    }
  }

  @media (max-width: 600px) {
    .maison-hero__provenance-strip {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }
</style>

{% schema %}
{
  "name": "Maison V2 Hero",
  "settings": []
}
{% endschema %}
