{% comment %}
  V7 Last-Call Section (Thread B2 / S8 / S2).
  Soot-black closing band with ember glow bleed, bell strike interaction,
  and waitlist pre-order field for upcoming foundry heats.
{% endcomment %}

<div class="maison-last-call section" data-section-id="{{ section.id }}" data-mt-chapter>
  <div class="maison-last-call__inner section--page-width">
    <!-- Bell Icon Strike Trigger -->
    <div class="maison-last-call__bell-wrap" data-mt-scroll="beat">
      <button class="maison-last-call__bell-btn" id="last-call-bell" aria-label="Strike the Temple Bell at Last Call" data-strike>
        <span class="bell-glyph"><i class="fa-solid fa-bell" aria-hidden="true"></i></span>
        <span class="bell-ring-pulse"></span>
      </button>
      <span class="maison-last-call__devanagari">अंतिम पुकार · The Pass is Called</span>
    </div>

    <div class="maison-last-call__content" data-mt-scroll="chapter">
      <h2 class="maison-last-call__heading" data-mt-scroll="kinetic">The next heat opens soon.</h2>
      <p class="maison-last-call__copy">
        Limited craft heats between Jaipur and London. Register once — we signal the next drop.
      </p>

      <!-- Pre-order / Waitlist Form -->
      <form class="maison-last-call__form" id="last-call-waitlist-form" data-mt-scroll="beat">
        <div class="maison-last-call__input-row">
          <input
            type="email"
            class="maison-last-call__email"
            placeholder="Enter your email for the next furnace allocation…"
            required
            aria-label="Email address for allocation"
          />
          <button type="submit" class="maison-last-call__submit-btn" data-strike>
            Reserve Allocation
          </button>
        </div>
        <p class="maison-last-call__note">
          No marketing spam. Only single batch announcements with verified metallurgy reports.
        </p>
      </form>

      <div class="maison-last-call__success" id="last-call-success" style="display: none;">
        <i class="fa-solid fa-check" aria-hidden="true"></i> Your seat at the pass is recorded. We will signal when the next heat is struck.
      </div>
    </div>
  </div>
</div>

{% stylesheet %}
  /* Editorial band — Maison footer owns chrome + signup */
  .maison-last-call {
    background: var(--soot, #14110F);
    color: #f7f2e9;
    padding-block: clamp(3rem, 6vw, 4.5rem) clamp(2.5rem, 5vw, 3.5rem);
    position: relative;
    overflow: hidden;
    border-block-start: 1px solid #282420;
    border-block-end: 0;
  }

  .maison-last-call::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 25%;
    right: 25%;
    height: 64px;
    background: radial-gradient(ellipse at bottom, rgba(226, 85, 43, 0.1) 0%, rgba(226, 85, 43, 0) 75%);
    pointer-events: none;
  }

  .maison-last-call .bell-ring-pulse {
    position: absolute;
    inset: -8px;
    border-radius: 50%;
    border: 1px solid rgba(184, 137, 58, 0.35);
    opacity: 0;
    pointer-events: none;
    animation: mt-bell-pulse 2.8s ease-out infinite;
  }

  @keyframes mt-bell-pulse {
    0% { transform: scale(0.85); opacity: 0.35; }
    70% { transform: scale(1.35); opacity: 0; }
    100% { transform: scale(1.35); opacity: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .maison-last-call .bell-ring-pulse { animation: none; }

    .maison-last-call [data-mt-scroll],
    .maison-last-call [data-mt-chapter] {
      opacity: 1 !important;
      transform: none !important;
      visibility: visible !important;
    }
  }

  html[data-reduced-motion='true'] .maison-last-call .bell-ring-pulse {
    animation: none !important;
  }

  html[data-reduced-motion='true'] .maison-last-call [data-mt-scroll],
  html[data-reduced-motion='true'] .maison-last-call [data-mt-chapter] {
    opacity: 1 !important;
    transform: none !important;
    visibility: visible !important;
  }

  .maison-last-call__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    position: relative;
    z-index: 1;
  }

  .maison-last-call__bell-wrap {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.85rem;
    margin-block-end: 2rem;
  }

  .maison-last-call__bell-btn {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background: #1f1b18;
    border: 1.5px solid var(--bell, #B8893A);
    color: var(--bell, #B8893A);
    font-size: var(--mt-type-title);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    transition: transform 0.25s var(--ease-strike), background 0.25s;
    box-shadow: 0 0 24px rgba(184, 137, 58, 0.2);
  }

  .maison-last-call__bell-btn:hover {
    transform: scale(1.08);
    background: var(--bell, #B8893A);
    color: #14110F;
  }

  .maison-last-call__devanagari {
    font-family: var(--mt-type-family-body);
    font-size: var(--mt-type-accent);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--bell, #B8893A);
  }

  .maison-last-call__content {
    max-width: 44rem;
  }

  .maison-last-call__heading {
    margin: 0 0 0.75rem;
    font-family: var(--mt-type-family-heading);
    font-size: var(--mt-type-heading);
    font-weight: 400;
    letter-spacing: var(--mt-type-tracking-heading);
    line-height: 1.1;
    color: var(--bone, #F7F2E9);
  }

  .maison-last-call__copy {
    margin: 0 0 1.75rem;
    max-width: 36ch;
    margin-inline: auto;
    font-size: var(--mt-type-body);
    line-height: 1.5;
    color: color-mix(in srgb, var(--bone, #F7F2E9) 68%, transparent);
  }

  /* Form */
  .maison-last-call__form {
    max-width: 34rem;
    margin-inline: auto;
  }

  .maison-last-call__input-row {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  @media screen and (min-width: 600px) {
    .maison-last-call__input-row {
      flex-wrap: nowrap;
    }
  }

  .maison-last-call__email {
    flex: 1;
    min-width: 240px;
    background: var(--glass-surface-dark, rgba(20, 17, 15, 0.75));
    backdrop-filter: var(--glass-blur, blur(14px));
    -webkit-backdrop-filter: var(--glass-blur, blur(14px));
    border: 1px solid var(--glass-border-dark, rgba(247, 242, 233, 0.14));
    padding: 0.85rem 1.4rem;
    color: var(--bone, #f7f2e9);
    font-size: var(--mt-type-body);
    border-radius: var(--radius-pill, 62.5rem);
    transition: border-color 0.25s ease, box-shadow 0.25s ease;
  }

  .maison-last-call__email:focus-visible {
    outline: 2px solid var(--bell, #B8893A);
    outline-offset: 3px;
    border-color: var(--bell, #B8893A);
    box-shadow: 0 0 16px rgba(184, 137, 58, 0.3);
  }

  .maison-last-call__submit-btn:focus-visible {
    outline: 2px solid var(--bone, #F7F2E9);
    outline-offset: 3px;
  }

  .maison-last-call__bell-btn:focus-visible {
    outline: 2px solid var(--bell, #B8893A);
    outline-offset: 3px;
  }

  .maison-last-call__submit-btn {
    background: var(--ember, #E2552B);
    color: #fff;
    border: none;
    font-weight: 600;
    padding: 0.85rem 1.75rem;
    border-radius: var(--radius-pill, 62.5rem);
    font-size: var(--mt-type-body);
    cursor: pointer;
    transition: background 0.2s, transform 0.2s var(--ease-strike), box-shadow 0.2s;
  }

  .maison-last-call__submit-btn:hover {
    background: #ff6838;
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(226, 85, 43, 0.35);
  }

  .maison-last-call__note {
    margin-block-start: 0.75rem;
    font-size: var(--mt-type-accent);
    color: color-mix(in srgb, var(--bone, #F7F2E9) 58%, transparent);
  }

  .maison-last-call__success {
    margin-block-start: 1.5rem;
    padding: 1rem 1.5rem;
    background: #1f2e24;
    border: 1px solid var(--verdigris, #4F7F72);
    color: #86efac;
    font-size: var(--mt-type-body);
    border-radius: 4px;
  }
{% endstylesheet %}

{% javascript %}
  document.addEventListener('DOMContentLoaded', () => {
    const form = document.getElementById('last-call-waitlist-form');
    const success = document.getElementById('last-call-success');

    if (form) {
      form.addEventListener('submit', (e) => {
        e.preventDefault();
        form.style.display = 'none';
        if (success) success.style.display = 'block';
        document.dispatchEvent(new CustomEvent('maison:mail-primary-convert'));
        document.dispatchEvent(
          new CustomEvent('maison:toast', {
            detail: {
              type: 'success',
              icon: 'mail',
              message: 'You are on the list for the next heat.',
            },
          }),
        );
      });
    }
  });
{% endjavascript %}

