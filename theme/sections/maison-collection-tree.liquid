{% comment %}
  Polyhierarchical paths for a collection page.
  Departments link to material lineups and to tagged type pages
  (/collections/{handle}/{tag}). Forge × Terre is filed under both
  Cookware and Tableware. Kansa stays a separate room.
{% endcomment %}

{% liquid
  assign active_tag = ''
  if current_tags.size > 0
    assign active_tag = current_tags.first | handleize
  endif

  assign scope = collection.handle
  assign family = 'catalogue'
  assign parent_handle = ''

  case collection.handle
    when 'cookware'
      assign family = 'cookware'
    when 'forge-hybrid'
      assign family = 'cookware'
      assign parent_handle = 'cookware'
    when 'kuro-strip'
      assign family = 'cookware'
      assign parent_handle = 'cookware'
    when 'forge-terre'
      assign family = 'forge-terre'
    when 'tableware-pottery'
      assign family = 'tableware'
    when 'terre-clay'
      assign family = 'tableware'
      assign parent_handle = 'tableware-pottery'
    when 'care-sets'
      assign family = 'care'
  endcase

  assign cookware_url = collections['cookware'].url | default: '/collections/cookware'
  assign tableware_url = collections['tableware-pottery'].url | default: '/collections/tableware-pottery'
  assign care_url = collections['care-sets'].url | default: '/collections/care-sets'
  assign forge_url = collections['forge-hybrid'].url | default: '/collections/forge-hybrid'
  assign terre_url = collections['terre-clay'].url | default: '/collections/terre-clay'
  assign kuro_url = collections['kuro-strip'].url | default: '/collections/kuro-strip'
  assign hybrid_url = collections['forge-terre'].url | default: '/collections/forge-terre'

  case scope
    when 'cookware'
      assign type_items = 'Skillets|' | append: cookware_url | append: '/skillet|skillet,Tavas|' | append: cookware_url | append: '/tava|tava,Kadais|' | append: cookware_url | append: '/kadai|kadai,Saucepots|' | append: cookware_url | append: '/saucepot|saucepot,Planchas|' | append: cookware_url | append: '/plancha|plancha,Roasters|' | append: cookware_url | append: '/roaster|roaster,Tagines|' | append: cookware_url | append: '/tagine|tagine,Tongs|' | append: cookware_url | append: '/tongs|tongs,Chef knives|' | append: cookware_url | append: '/chef-knife|chef-knife,Utility knives|' | append: cookware_url | append: '/utility-knife|utility-knife'
    when 'forge-hybrid'
      assign type_items = 'Skillets|' | append: forge_url | append: '/skillet|skillet,Tavas|' | append: forge_url | append: '/tava|tava,Kadais|' | append: forge_url | append: '/kadai|kadai,Saucepots|' | append: forge_url | append: '/saucepot|saucepot,Planchas|' | append: forge_url | append: '/plancha|plancha'
      assign care_items = 'Seasoning oil|' | append: forge_url | append: '/seasoning-oil|seasoning-oil,Care kits|' | append: forge_url | append: '/care-kit|care-kit,Lids|' | append: forge_url | append: '/replacement-lid|replacement-lid'
    when 'kuro-strip'
      assign type_items = 'Chef knives|' | append: kuro_url | append: '/chef-knife|chef-knife,Utility knives|' | append: kuro_url | append: '/utility-knife|utility-knife'
    when 'forge-terre'
      assign type_items = 'Roasters|' | append: hybrid_url | append: '/roaster|roaster,Tagines|' | append: hybrid_url | append: '/tagine|tagine,Tongs|' | append: hybrid_url | append: '/tongs|tongs'
    when 'tableware-pottery'
      assign type_items = 'Kulhads|' | append: tableware_url | append: '/kulhad|kulhad,Platters|' | append: tableware_url | append: '/serving-platter|serving-platter,Chai bowls|' | append: tableware_url | append: '/chai-bowl|chai-bowl,Dinner plates|' | append: tableware_url | append: '/dinner-plate|dinner-plate,Bowl sets|' | append: tableware_url | append: '/bowl-set|bowl-set,Serving bowls|' | append: tableware_url | append: '/serving-bowl|serving-bowl'
    when 'terre-clay'
      assign type_items = 'Kulhads|' | append: terre_url | append: '/kulhad|kulhad,Platters|' | append: terre_url | append: '/serving-platter|serving-platter,Chai bowls|' | append: terre_url | append: '/chai-bowl|chai-bowl,Dinner plates|' | append: terre_url | append: '/dinner-plate|dinner-plate,Bowl sets|' | append: terre_url | append: '/bowl-set|bowl-set,Serving bowls|' | append: terre_url | append: '/serving-bowl|serving-bowl,Steamers|' | append: terre_url | append: '/bamboo-steamer|bamboo-steamer'
    when 'care-sets'
      assign type_items = 'Seasoning oil|' | append: care_url | append: '/seasoning-oil|seasoning-oil,Care kits|' | append: care_url | append: '/care-kit|care-kit,Lids|' | append: care_url | append: '/replacement-lid|replacement-lid,Steamers|' | append: care_url | append: '/bamboo-steamer|bamboo-steamer'
  endcase

  case family
    when 'cookware'
      assign material_items = 'Forge Hybrid|' | append: forge_url | append: '|forge-hybrid,Kuro Strip|' | append: kuro_url | append: '|kuro-strip,Forge × Terre|' | append: hybrid_url | append: '|forge-terre'
    when 'tableware'
      assign material_items = 'Terre Clay|' | append: terre_url | append: '|terre-clay,Forge × Terre|' | append: hybrid_url | append: '|forge-terre'
    when 'care'
      assign material_items = 'Forge Hybrid|' | append: forge_url | append: '|forge-hybrid,Terre Clay|' | append: terre_url | append: '|terre-clay'
    when 'forge-terre'
      assign material_items = 'Cookware|' | append: cookware_url | append: '|cookware,Tableware & Pottery|' | append: tableware_url | append: '|tableware-pottery'
  endcase

  assign department_items = 'Cookware|' | append: cookware_url | append: '|cookware,Tableware & Pottery|' | append: tableware_url | append: '|tableware-pottery,Care & Sets|' | append: care_url | append: '|care-sets'
  assign dept_active = ''
  assign lineup_active = collection.handle
  if active_tag == blank
    assign dept_active = collection.handle
  endif

  assign parent_collection = blank
  if parent_handle != blank
    assign parent_collection = collections[parent_handle]
  endif
%}

<div
  class="section section--page-width spacing-style maison-tree"
  style="{% render 'spacing-style', settings: section.settings %}"
  data-mt-scroll
>
  <nav class="maison-tree__crumb" aria-label="Breadcrumb">
    <ol>
      <li><a href="{{ routes.root_url }}">Home</a></li>
      <li><a href="{{ routes.collections_url }}">Catalogue</a></li>
      {% if parent_collection != blank %}
        <li><a href="{{ parent_collection.url }}">{{ parent_collection.title | escape }}</a></li>
      {% endif %}
      {% if active_tag != blank %}
        <li><a href="{{ collection.url }}">{{ collection.title | escape }}</a></li>
        <li aria-current="page">{{ current_tags.first | escape }}</li>
      {% else %}
        <li aria-current="page">{{ collection.title | escape }}</li>
      {% endif %}
    </ol>
  </nav>

  <header class="maison-tree__header">
    <p class="maison-tree__eyebrow">
      {% if section.settings.eyebrow != blank %}
        {{ section.settings.eyebrow | escape }}
      {% elsif family == 'catalogue' %}
        Catalogue
      {% else %}
        Paths
      {% endif %}
    </p>
    <h2 class="maison-tree__title">
      {% if section.settings.heading != blank %}
        {{ section.settings.heading | escape }}
      {% elsif family == 'catalogue' %}
        Shop by department
      {% else %}
        Narrow {{ collection.title | escape }}
      {% endif %}
    </h2>
  </header>

  {% render 'maison-link-row', label: 'Departments', items: department_items, active: dept_active %}
  {% render 'maison-link-row', label: 'By type', items: type_items, active: active_tag %}
  {% render 'maison-link-row', label: 'Care in this metal', items: care_items, active: active_tag %}
  {% if family == 'forge-terre' %}
    {% render 'maison-link-row', label: 'Filed under', items: material_items, active: '' %}
  {% else %}
    {% render 'maison-link-row', label: 'Material lineups', items: material_items, active: lineup_active %}
  {% endif %}

  <p class="maison-tree__kansa">
    <a href="/pages/kansa">Kansa</a>
    is a room of its own — the companion for a piece you already hold.
    <a href="/pages/new-arrivals">New arrivals</a>
    keeps the current heat.
  </p>
</div>

{% stylesheet %}
  .maison-tree {
    color: var(--color-foreground);
  }

  .maison-tree__crumb ol {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 0.5rem;
    margin: 0 0 1.5rem;
    padding: 0;
    list-style: none;
    font-family: var(--font-mono--family, ui-monospace, monospace);
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .maison-tree__crumb li:not(:last-child)::after {
    content: "/";
    margin-inline-start: 0.5rem;
    color: var(--color-foreground-muted);
  }

  .maison-tree__crumb a {
    color: inherit;
    text-decoration: none;
  }

  .maison-tree__crumb a:hover {
    text-decoration: underline;
    text-underline-offset: 0.18em;
  }

  .maison-tree__eyebrow {
    margin: 0;
    font-family: var(--font-mono--family, ui-monospace, monospace);
    font-size: 0.75rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-foreground-muted);
  }

  .maison-tree__title {
    margin: 0.4rem 0 1.25rem;
    font-family: var(--font-heading--family);
    font-size: clamp(1.5rem, 1.1rem + 1.2vw, 2.25rem);
    font-weight: 400;
  }

  .maison-tree__group + .maison-tree__group {
    margin-block-start: 1.25rem;
  }

  .maison-tree__label {
    margin: 0 0 0.55rem;
    font-family: var(--font-mono--family, ui-monospace, monospace);
    font-size: 0.6875rem;
    font-weight: 400;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-foreground-muted);
  }

  .maison-tree__list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .maison-tree__list a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0.35rem 0.8rem;
    border: 1px solid var(--color-border);
    color: inherit;
    text-decoration: none;
  }

  .maison-tree__list a[aria-current='page'] {
    border-color: var(--color-foreground);
    background: var(--color-foreground);
    color: var(--color-background);
  }

  .maison-tree__list a:hover {
    border-color: var(--color-foreground);
  }

  .maison-tree a:focus-visible {
    outline: 2px solid var(--color-foreground);
    outline-offset: 3px;
  }

  .maison-tree__kansa {
    max-width: 42rem;
    margin: 1.5rem 0 0;
    color: var(--color-foreground-muted);
  }

  .maison-tree__kansa a {
    color: var(--color-foreground);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.maison_collection_tree",
  "tag": "section",
  "class": "section-wrapper",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:settings.maison_eyebrow"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:settings.heading"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 8
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 8
    }
  ],
  "presets": [
    {
      "name": "t:names.maison_collection_tree",
      "category": "t:categories.collection"
    }
  ]
}
{% endschema %}
