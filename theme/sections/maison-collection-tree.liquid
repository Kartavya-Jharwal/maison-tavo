{% liquid
  assign forge = collections['forge']
  assign chulha = collections['chulha']
  assign maintenance = collections['maintenance']
%}

<nav
  class="section section--page-width spacing-style maison-tree"
  style="{% render 'spacing-style', settings: section.settings %}"
  aria-label="Browse the ranges"
>
  <span class="maison-tree__label">Browse the ranges</span>
  <ul class="maison-tree__list" role="list">
    {% if forge != blank %}
      <li><a href="{{ forge.url }}"{% if collection.handle == 'forge' %} aria-current="page"{% endif %}>Forge</a></li>
    {% endif %}
    {% if chulha != blank %}
      <li><a href="{{ chulha.url }}"{% if collection.handle == 'chulha' %} aria-current="page"{% endif %}>Chulha</a></li>
    {% endif %}
    {% if maintenance != blank %}
      <li><a href="{{ maintenance.url }}"{% if collection.handle == 'maintenance' %} aria-current="page"{% endif %}>Maintenance</a></li>
    {% endif %}
  </ul>
</nav>

{% stylesheet %}
  .maison-tree {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--mt-space-3);
  }

  .maison-tree__label {
    font-family: var(--mt-type-family-mono);
    font-size: var(--mt-type-mono);
    letter-spacing: var(--mt-type-tracking-accent);
    text-transform: uppercase;
  }

  .maison-tree__list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--mt-space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .maison-tree__list a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding: 0.5rem 1rem;
    border: 1px solid currentColor;
    color: var(--color-foreground);
    text-decoration: none;
  }

  .maison-tree__list a[aria-current='page'] {
    color: var(--color-background);
    background: var(--color-foreground);
  }

  .maison-tree__list a:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 3px;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.maison_collection_tree",
  "tag": "section",
  "class": "section-wrapper",
  "disabled_on": {"groups": ["header", "footer"]},
  "settings": [
    {"type": "range", "id": "padding-block-start", "label": "t:settings.top", "min": 0, "max": 100, "step": 1, "unit": "px", "default": 12},
    {"type": "range", "id": "padding-block-end", "label": "t:settings.bottom", "min": 0, "max": 100, "step": 1, "unit": "px", "default": 20}
  ],
  "presets": [{"name": "t:names.maison_collection_tree"}]
}
{% endschema %}
