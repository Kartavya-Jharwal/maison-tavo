{% comment %}
  Release cycles — popup drops, not a perpetual new-arrivals rail.
  Merchants define cycles as blocks (name / window / collection or products).
  All product links are real PDP / collection URLs (Jakob's Law).
{% endcomment %}

<div
  class="section section--page-width spacing-style maison-releases"
  style="{% render 'spacing-style', settings: section.settings %}"
>
  <header class="maison-releases__header">
    {% if section.settings.eyebrow != blank %}
      <p class="maison-releases__eyebrow">{{ section.settings.eyebrow | escape }}</p>
    {% endif %}
    <h1 class="maison-releases__title">
      {% if section.settings.heading != blank %}
        {{ section.settings.heading | escape }}
      {% else %}
        {{ page.title | default: 'Releases' | escape }}
      {% endif %}
    </h1>
    {% if section.settings.lede != blank %}
      <div class="maison-releases__lede rte">{{ section.settings.lede }}</div>
    {% endif %}
    {% if section.settings.mail_link %}
      <p class="maison-releases__actions">
        <a class="button" href="/pages/mail">Join the release list</a>
        <a href="{{ routes.collections_url }}">Browse the catalogue</a>
      </p>
    {% endif %}
  </header>

  {% if section.blocks.size == 0 %}
    <p class="maison-releases__empty">
      No release cycles are configured yet. In the theme editor, add a cycle with a window and products or a collection.
    </p>
  {% else %}
    <ol class="maison-releases__cycles" role="list">
      {% for block in section.blocks %}
        {% if block.type == 'cycle' %}
          {% liquid
            assign cycle_collection = block.settings.collection
            assign cycle_products = block.settings.products
            assign status = block.settings.status | default: 'upcoming'
          %}
          <li
            class="maison-releases__cycle maison-releases__cycle--{{ status }}"
            id="cycle-{{ block.id }}"
            {{ block.shopify_attributes }}
          >
            <header class="maison-releases__cycle-head">
              <p class="maison-releases__status">
                {% case status %}
                  {% when 'open' %}Open now
                  {% when 'closed' %}Closed
                  {% else %}Upcoming
                {% endcase %}
              </p>
              <h2 class="maison-releases__cycle-title">
                {{ block.settings.name | default: 'Release cycle' | escape }}
              </h2>
              {% if block.settings.window != blank %}
                <p class="maison-releases__window">{{ block.settings.window | escape }}</p>
              {% endif %}
              {% if block.settings.note != blank %}
                <p class="maison-releases__note">{{ block.settings.note | escape }}</p>
              {% endif %}
              {% if cycle_collection != blank %}
                <p class="maison-releases__shop">
                  <a class="button button-secondary" href="{{ cycle_collection.url }}">
                    Shop {{ cycle_collection.title | escape }}
                  </a>
                </p>
              {% endif %}
            </header>

            {% if cycle_products != blank and cycle_products.size > 0 %}
              <ul class="maison-releases__grid" role="list">
                {% for product in cycle_products %}
                  <li>
                    <a class="maison-releases__card" href="{{ product.url }}">
                      {% if product.featured_image %}
                        {% assign image_alt = product.featured_image.alt | default: product.title %}
                        {{
                          product.featured_image
                          | image_url: width: 900
                          | image_tag:
                            widths: '300, 450, 600, 900',
                            sizes: '(min-width: 990px) 25vw, (min-width: 750px) 33vw, 100vw',
                            alt: image_alt,
                            loading: 'lazy'
                        }}
                      {% else %}
                        {% render 'maison-concept-image', product: product %}
                      {% endif %}
                      <span class="maison-releases__name">{{ product.title | escape }}</span>
                      <span class="maison-releases__price">{{ product.price | money }}</span>
                    </a>
                  </li>
                {% endfor %}
              </ul>
            {% elsif cycle_collection != blank and cycle_collection.products_count > 0 %}
              <ul class="maison-releases__grid" role="list">
                {% for product in cycle_collection.products limit: block.settings.limit %}
                  <li>
                    <a class="maison-releases__card" href="{{ product.url }}">
                      {% if product.featured_image %}
                        {% assign image_alt = product.featured_image.alt | default: product.title %}
                        {{
                          product.featured_image
                          | image_url: width: 900
                          | image_tag:
                            widths: '300, 450, 600, 900',
                            sizes: '(min-width: 990px) 25vw, (min-width: 750px) 33vw, 100vw',
                            alt: image_alt,
                            loading: 'lazy'
                        }}
                      {% else %}
                        {% render 'maison-concept-image', product: product %}
                      {% endif %}
                      <span class="maison-releases__name">{{ product.title | escape }}</span>
                      <span class="maison-releases__price">{{ product.price | money }}</span>
                    </a>
                  </li>
                {% endfor %}
              </ul>
            {% else %}
              <ul class="maison-releases__grid" role="list">
                {% if status == 'open' %}
                  <li>
                    <a class="maison-releases__card" href="/collections/forge">
                      <img
                        src="{{ 'maison-flagship-kadai.webp' | asset_url }}"
                        alt="The Flagship Kadhai"
                        width="900"
                        height="900"
                        loading="lazy"
                      >
                      <span class="maison-releases__name">The Flagship Kadhai (28cm)</span>
                      <span class="maison-releases__price">$385</span>
                    </a>
                  </li>
                  <li>
                    <a class="maison-releases__card" href="/collections/forge">
                      <img
                        src="{{ 'maison-pan-set.jpg' | asset_url }}"
                        alt="Forge Relay Pan Set"
                        width="900"
                        height="900"
                        loading="lazy"
                      >
                      <span class="maison-releases__name">Forge Relay Pan Set (3-Piece)</span>
                      <span class="maison-releases__price">$540</span>
                    </a>
                  </li>
                  <li>
                    <a class="maison-releases__card" href="/collections/forge">
                      <img
                        src="{{ 'maison-highpot-set.webp' | asset_url }}"
                        alt="The Foundry High Pot"
                        width="900"
                        height="900"
                        loading="lazy"
                      >
                      <span class="maison-releases__name">The Foundry High Pot (5.2L)</span>
                      <span class="maison-releases__price">$410</span>
                    </a>
                  </li>
                  <li>
                    <a class="maison-releases__card" href="/collections/forge">
                      <img
                        src="{{ 'maison-saucier-lid.jpg' | asset_url }}"
                        alt="Spun Bronze Saucier"
                        width="900"
                        height="900"
                        loading="lazy"
                      >
                      <span class="maison-releases__name">Spun Bronze Saucier with Lid</span>
                      <span class="maison-releases__price">$320</span>
                    </a>
                  </li>
                {% else %}
                  <li>
                    <a class="maison-releases__card" href="/collections/chulha">
                      <img
                        src="{{ 'maison-clay-openpot.webp' | asset_url }}"
                        alt="Illustrative clay vessel"
                        width="1200"
                        height="1200"
                        loading="lazy"
                      >
                      <span class="maison-releases__name">Terre Refractory Open Vessel</span>
                      <span class="maison-releases__price">$165</span>
                    </a>
                  </li>
                  <li>
                    <a class="maison-releases__card" href="/collections/chulha">
                      <img
                        src="{{ 'maison-dining-set-6pc.webp' | asset_url }}"
                        alt="Full Kansa Dining Service"
                        width="900"
                        height="900"
                        loading="lazy"
                      >
                      <span class="maison-releases__name">Full Kansa Dining Service (6-Piece)</span>
                      <span class="maison-releases__price">$620</span>
                    </a>
                  </li>
                  <li>
                    <a class="maison-releases__card" href="/collections/forge">
                      <img
                        src="{{ 'maison-saucepot.webp' | asset_url }}"
                        alt="Hand-Turned Sauce Pot"
                        width="900"
                        height="900"
                        loading="lazy"
                      >
                      <span class="maison-releases__name">Hand-Turned Sauce Pot</span>
                      <span class="maison-releases__price">$240</span>
                    </a>
                  </li>
                  <li>
                    <a class="maison-releases__card" href="/collections/forge">
                      <img
                        src="{{ 'maison-pan-stacked-showcase.webp' | asset_url }}"
                        alt="The Atelier Nesting Suite"
                        width="900"
                        height="900"
                        loading="lazy"
                      >
                      <span class="maison-releases__name">The Atelier Nesting Suite</span>
                      <span class="maison-releases__price">$890</span>
                    </a>
                  </li>
                {% endif %}
              </ul>
            {% endif %}
          </li>
        {% endif %}
      {% endfor %}
    </ol>
  {% endif %}
</div>

{% stylesheet %}
  .maison-releases__header {
    max-width: 42rem;
    margin-block-end: 2.5rem;
  }

  .maison-releases__eyebrow,
  .maison-releases__status {
    margin: 0;
    font-family: var(--mt-type-family-mono);
    font-size: var(--mt-type-accent);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-foreground-muted, rgb(var(--color-foreground-rgb) / 0.65));
  }

  .maison-releases__title {
    margin: 0.5rem 0 1rem;
    font-family: var(--mt-type-family-heading);
    font-size: var(--mt-type-display);
    font-weight: 400;
    line-height: 1.05;
  }

  .maison-releases__lede {
    margin: 0 0 1.25rem;
    color: var(--color-foreground-muted, rgb(var(--color-foreground-rgb) / 0.75));
  }

  .maison-releases__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 1.5rem;
    align-items: center;
  }

  .maison-releases__actions a {
    color: inherit;
  }

  .maison-releases__cycles {
    display: grid;
    gap: 3rem;
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: mt-cycle;
  }

  .maison-releases__cycle {
    padding-block-start: 1.5rem;
    border-block-start: 1px solid rgb(var(--color-foreground-rgb) / 0.12);
  }

  .maison-releases__cycle--closed {
    opacity: 0.72;
  }

  .maison-releases__cycle-head {
    max-width: 40rem;
    margin-block-end: 1.5rem;
  }

  .maison-releases__cycle-title {
    margin: 0.35rem 0 0.5rem;
    font-family: var(--mt-type-family-heading);
    font-size: var(--mt-type-title, 1.75rem);
    font-weight: 400;
  }

  .maison-releases__window,
  .maison-releases__note {
    margin: 0.35rem 0 0;
    color: var(--color-foreground-muted, rgb(var(--color-foreground-rgb) / 0.75));
  }

  .maison-releases__shop {
    margin: 1rem 0 0;
  }

  .maison-releases__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem 1.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media screen and (min-width: 750px) {
    .maison-releases__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media screen and (min-width: 990px) {
    .maison-releases__grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .maison-releases__card {
    display: grid;
    gap: 0.45rem;
    color: inherit;
    text-decoration: none;
  }

  .maison-releases__card img {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
  }

  .maison-releases__name {
    font-family: var(--mt-type-family-heading);
  }

  .maison-releases__card:focus-visible {
    outline: 2px solid var(--color-foreground);
    outline-offset: 3px;
  }

  .maison-releases__empty {
    margin: 0;
    color: var(--color-foreground-muted, rgb(var(--color-foreground-rgb) / 0.75));
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.maison_releases",
  "tag": "section",
  "class": "section-wrapper",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:settings.maison_eyebrow",
      "default": "Inventory cycles"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:settings.heading",
      "default": "Releases"
    },
    {
      "type": "richtext",
      "id": "lede",
      "label": "Introduction",
      "default": "<p>Maison opens inventory in timed heats — not a perpetual new-arrivals rail. Each cycle has a window; when it closes, the pieces leave this room.</p>"
    },
    {
      "type": "checkbox",
      "id": "mail_link",
      "label": "Show mail list link",
      "default": true
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 64
    }
  ],
  "blocks": [
    {
      "type": "cycle",
      "name": "t:names.maison_release_cycle",
      "settings": [
        {
          "type": "text",
          "id": "name",
          "label": "Cycle name",
          "default": "Heat 01"
        },
        {
          "type": "text",
          "id": "window",
          "label": "Window",
          "default": "Opens with the next foundry allocation"
        },
        {
          "type": "select",
          "id": "status",
          "label": "Status",
          "options": [
            { "value": "open", "label": "Open now" },
            { "value": "upcoming", "label": "Upcoming" },
            { "value": "closed", "label": "Closed" }
          ],
          "default": "upcoming"
        },
        {
          "type": "textarea",
          "id": "note",
          "label": "Note"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "t:settings.collection"
        },
        {
          "type": "product_list",
          "id": "products",
          "label": "Products in this cycle",
          "limit": 12
        },
        {
          "type": "range",
          "id": "limit",
          "label": "Collection product limit",
          "min": 2,
          "max": 16,
          "step": 1,
          "default": 8
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:names.maison_releases",
      "category": "t:categories.collection",
      "blocks": [
        {
          "type": "cycle",
          "settings": {
            "name": "Current heat",
            "window": "Live while allocation lasts",
            "status": "open"
          }
        }
      ]
    }
  ]
}
{% endschema %}
