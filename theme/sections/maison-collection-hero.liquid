{% doc %}
  Collection hero — editorial-grade header for lineup room pages.
  Replaces the generic `section` text block on collection.json with a
  purpose-built hero that carries lineup voice: kicker, display title,
  description, and an optional full-bleed background image.

  Usage: set as the first section in collection.json (or any template).
  Works standalone — no image required; gracefully text-only.
{% enddoc %}

{% liquid
  assign has_image = false
  if section.settings.background_image != blank
    assign has_image = true
  endif
  assign has_overlay = section.settings.overlay_enabled
%}

<div
  class="maison-collection-hero{% if has_image %} maison-collection-hero--has-image{% endif %}"
  data-section-id="{{ section.id }}"
  style="{% render 'spacing-style', settings: section.settings %}"
>
  {%- comment -%} Background image {%- endcomment -%}
  {% if has_image %}
    <div class="maison-collection-hero__media" aria-hidden="true">
      {% render 'image',
        image: section.settings.background_image,
        class: 'maison-collection-hero__bg',
        widths: '750, 1100, 1600, 2200',
        sizes: '100vw',
        loading: 'eager',
        fetchpriority: 'high'
      %}
      {% if has_overlay %}
        <div class="maison-collection-hero__overlay"></div>
      {% endif %}
    </div>
  {% endif %}

  {%- comment -%} Content {%- endcomment -%}
  <div class="maison-collection-hero__content section--page-width">

    {% if section.settings.kicker != blank %}
      <p class="maison-collection-hero__kicker">{{ section.settings.kicker | escape }}</p>
    {% endif %}

    {% if section.settings.heading != blank %}
      <h1 class="maison-collection-hero__title">{{ section.settings.heading | escape }}</h1>
    {% else %}
      {%- comment -%} Fallback to collection title if on a collection page {%- endcomment -%}
      {% if collection != blank %}
        <h1 class="maison-collection-hero__title">{{ collection.title | escape }}</h1>
      {% endif %}
    {% endif %}

    {% if section.settings.description != blank %}
      <p class="maison-collection-hero__description">{{ section.settings.description | escape }}</p>
    {% else %}
      {% if collection != blank and collection.description != blank %}
        <div class="maison-collection-hero__description rte">{{ collection.description }}</div>
      {% endif %}
    {% endif %}

    {% if section.settings.cta_label != blank and section.settings.cta_link != blank %}
      <a
        class="maison-collection-hero__cta button-secondary"
        href="{{ section.settings.cta_link }}"
        {% if section.settings.cta_new_tab %}target="_blank" rel="noopener"{% endif %}
      >
        {{ section.settings.cta_label | escape }}
      </a>
    {% endif %}

  </div>
</div>

{% stylesheet %}
  /* ── Root ────────────────────────────────────────────────────────────────── */
  .maison-collection-hero {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    min-height: 22rem;
    overflow: hidden;
    background: var(--color-background);
    color: var(--color-foreground);
  }

  .maison-collection-hero--has-image {
    min-height: clamp(22rem, 40vw, 34rem);
    color: #fff;
  }

  /* ── Background image ───────────────────────────────────────────────────── */
  .maison-collection-hero__media {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .maison-collection-hero__bg {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .maison-collection-hero__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgb(0 0 0 / 0.62) 0%,
      rgb(0 0 0 / 0.28) 50%,
      rgb(0 0 0 / 0.08) 100%
    );
  }

  /* ── Content ────────────────────────────────────────────────────────────── */
  .maison-collection-hero__content {
    position: relative;
    z-index: 1;
    display: grid;
    gap: 0.75rem;
    padding-block-start: 3rem;
    padding-block-end: 2.5rem;
  }

  .maison-collection-hero--has-image .maison-collection-hero__content {
    padding-block-start: 2rem;
    padding-block-end: 3rem;
  }

  /* ── Typography ─────────────────────────────────────────────────────────── */
  .maison-collection-hero__kicker {
    margin: 0;
    font-family: var(--font-heading--family);
    font-size: 0.6875rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--brand-color-aged-bronze, var(--color-foreground-muted));
  }

  .maison-collection-hero--has-image .maison-collection-hero__kicker {
    color: rgb(255 255 255 / 0.65);
  }

  .maison-collection-hero__title {
    margin: 0;
    font-family: var(--font-fraunces--family, var(--font-heading--family));
    font-weight: var(--font-heading--weight);
    font-variation-settings: 'opsz' 144;
    font-size: clamp(2rem, 1.5rem + 2vw, 3.5rem);
    letter-spacing: 0.02em;
    line-height: 1.08;
  }

  .maison-collection-hero__description {
    margin: 0;
    max-width: 40rem;
    font-size: 1.0625rem;
    line-height: 1.65;
    color: var(--color-foreground-muted);
  }

  .maison-collection-hero--has-image .maison-collection-hero__description {
    color: rgb(255 255 255 / 0.75);
  }

  .maison-collection-hero__cta {
    align-self: start;
    margin-block-start: 0.5rem;
  }

  .maison-collection-hero--has-image .maison-collection-hero__cta {
    border-color: rgb(255 255 255 / 0.55);
    color: #fff;
  }

  .maison-collection-hero--has-image .maison-collection-hero__cta:hover {
    border-color: #fff;
    background: rgb(255 255 255 / 0.1);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Collection hero",
  "tag": "section",
  "class": "section-wrapper",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "info": "Small uppercase label above the title. Auto-fills from collection if blank.",
      "default": "The room"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Title",
      "info": "Leave blank to use the collection title."
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "info": "Leave blank to use the collection description."
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background image",
      "info": "Optional. Full-bleed image behind the text."
    },
    {
      "type": "checkbox",
      "id": "overlay_enabled",
      "label": "Dark gradient overlay",
      "default": true,
      "info": "Improves text legibility over the image."
    },
    {
      "type": "header",
      "content": "Call to action"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button label"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Button link"
    },
    {
      "type": "checkbox",
      "id": "cta_new_tab",
      "label": "Open in new tab",
      "default": false
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Collection hero",
      "category": "Maison Tavo",
      "settings": {
        "kicker": "The room",
        "overlay_enabled": true
      }
    }
  ]
}
{% endschema %}
