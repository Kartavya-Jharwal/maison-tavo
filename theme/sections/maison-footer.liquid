                    </svg>
    </a>
    <a class="maison-footer__ai-link" role="listitem" href="https://gemini.google.com" target="_blank" rel="noopener noreferrer" aria-label="Ask Gemini (opens in a new tab)" data-tooltip="Ask Gemini">
      <svg class="maison-footer__ai-logo" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
                      <path d="M12 24A14.304 14.304 0 0 0 0 12 14.304 14.304 0 0 0 12 0a14.305 14.305 0 0 0 12 12 14.305 14.305 0 0 0-12 12" fill="currentColor"/>
                    </svg>
    </a>
    <a class="maison-footer__ai-link" role="listitem" href="https://www.perplexity.ai" target="_blank" rel="noopener noreferrer" aria-label="Ask Perplexity (opens in a new tab)" data-tooltip="Ask Perplexity">
      <svg class="maison-footer__ai-logo" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
                      <path d="M18.73 3.42l-5.73 5.5V3.42H11.5v5.5L5.78 3.42H3.44l7.56 7.26v.3L4.6 17.26l1.74 1.3 5.16-4.96v7.98H13v-7.98l5.16 4.96 1.74-1.3-6.4-6.28v-.3l7.56-7.26h-2.33z" fill="currentColor"/>
                    </svg>
    </a>
    <a class="maison-footer__ai-link" role="listitem" href="https://copilot.microsoft.com" target="_blank" rel="noopener noreferrer" aria-label="Ask Copilot (opens in a new tab)" data-tooltip="Ask Copilot">
      <svg class="maison-footer__ai-logo" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
                      <path d="M12 2C6.477 2 2 6.477 2 12s4.477 10 10 10 10-4.477 10-10S17.523 2 12 2zm4.95 7.05a7.07 7.07 0 0 1 0 9.9L7.05 9.05a7.07 7.07 0 0 1 9.9 0z" fill="currentColor"/>
                    </svg>
    </a>
    <a class="maison-footer__ai-link" role="listitem" href="https://ai.meta.com" target="_blank" rel="noopener noreferrer" aria-label="Ask Meta AI (opens in a new tab)" data-tooltip="Ask Meta AI">
      <svg class="maison-footer__ai-logo" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
                      <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069z" fill="currentColor"/>
                    </svg>
    </a>
    <a class="maison-footer__ai-link" role="listitem" href="https://grok.com" target="_blank" rel="noopener noreferrer" aria-label="Ask Grok (opens in a new tab)" data-tooltip="Ask Grok">
      <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false"><path d="M4 4h4.2l4.3 5.7L17.2 4H21l-6.6 8 6.8 8h-4.3l-4.7-5.6L7.5 20H3.7l6.7-8.1z" fill="currentColor"/></svg>
    </a>
    <a class="maison-footer__ai-link" role="listitem" href="https://chat.deepseek.com" target="_blank" rel="noopener noreferrer" aria-label="Ask DeepSeek (opens in a new tab)" data-tooltip="Ask DeepSeek">
      <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false"><path d="M2 13.5c2.2-5.3 6-8 10.2-8 4.4 0 7.5 2.4 9.8 6.5-2.3 4.1-5.4 6.5-9.8 6.5-4.2 0-8-2.7-10.2-5zm6.2 0a4 4 0 1 0 8 0 4 4 0 0 0-8 0z" fill="currentColor"/></svg>
    </a>
      </div>

      <div class="maison-footer__augo-meta">
        <span class="maison-footer__augo-meta-label">Explore the prototype</span>
        <a href="/robots.txt" class="maison-footer__augo-meta-link">robots.txt</a>
        <span aria-hidden="true">·</span>
        <a href="/pages/ucp" class="maison-footer__augo-meta-link">Commerce protocol demo</a>
        <span aria-hidden="true">·</span>
        <a href="/pages/kansa" class="maison-footer__augo-meta-link">Kansa</a>
      </div>
    </div>
  {%- endif -%}
  <div class="maison-footer__cta maison-footer__wrap">
    <h2 class="maison-footer__headline">{{ section.settings.headline | escape }}</h2>
    <div class="maison-footer__signup">
      {%- form 'customer', id: 'MaisonFooterSignup', class: 'maison-footer__form' -%}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <label class="maison-footer__email-label" for="MaisonFooterEmail">Email address</label>
        <input
          id="MaisonFooterEmail"
          type="email"
          name="contact[email]"
          autocomplete="email"
          placeholder="Email address"
          value="{{ form.email | escape }}"
          required
          {% if form.errors contains 'email' %}
            aria-invalid="true"
            aria-describedby="MaisonFooterError"
          {% endif %}
          {% if form.errors %}autofocus{% endif %}
        >
        <button type="submit" class="button button--primary">{{ section.settings.button_label | escape }}</button>
        {%- if form.posted_successfully? -%}
          <p class="maison-footer__note" data-mt-newsletter-success role="status" tabindex="-1" autofocus>You're on the list.</p>
        {%- elsif form.errors -%}
          <div class="maison-footer__note" id="MaisonFooterError" role="alert">{{ form.errors | default_errors }}</div>
        {%- endif -%}
      {%- endform -%}
    </div>
  </div>

  <div class="maison-footer__grid maison-footer__wrap">
    <address class="maison-footer__edge">
      <a href="/pages/contact">{{ section.settings.address | newline_to_br }}</a>
      <span class="maison-footer__accent">{{ section.settings.tagline | escape }}</span>
    </address>

    <nav class="maison-footer__menus" aria-label="Footer">
      {%- for i in (1..3) -%}
        {%- assign key = 'menu_' | append: i -%}
        {%- assign menu = section.settings[key] -%}
        {%- assign label_key = 'label_' | append: i -%}
        <div class="maison-footer__col">
          <h3 class="maison-footer__label">{{ section.settings[label_key] | default: menu.title | escape }}</h3>
          <ul role="list">
            {%- if menu != blank -%}
              {%- for link in menu.links -%}
                <li><a href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>{{ link.title | escape }}</a></li>
              {%- endfor -%}
            {%- elsif i == 1 -%}
              <li><a href="{{ routes.collections_url }}">Catalogue</a></li>
              <li><a href="{{ collections['forge'].url | default: '/collections/forge' }}">Forge</a></li>
              <li><a href="{{ collections['chulha'].url | default: '/collections/chulha' }}">Chulha</a></li>
              <li><a href="{{ collections['maintenance'].url | default: '/collections/maintenance' }}">Maintenance</a></li>
              <li><a href="/pages/releases">Releases</a></li>
              <li><a href="/pages/department">Department</a></li>
              <li><a href="/pages/kitchen">Kitchen</a></li>
              <li><a href="/pages/kansa">Kansa</a></li>
            {%- elsif i == 2 -%}
              <li><a href="/pages/about">About us</a></li>
              <li><a href="/pages/building">How it works</a></li>
              <li><a href="/pages/journal">Journal</a></li>
              <li><a href="/pages/heat">Heat</a></li>
              <li><a href="/pages/finder">Finder</a></li>
              <li><a href="/pages/reviews">Reviews</a></li>
            {%- else -%}
              <li><a href="/pages/mail">Mail</a></li>
              <li><a href="{{ routes.search_url }}">Search</a></li>
              {%- if shop.customer_accounts_enabled -%}
                <li>
                  {%- if customer -%}
                    <a href="{{ routes.account_url }}">Account</a>
                  {%- else -%}
                    <a href="{{ routes.account_login_url }}">Account</a>
                  {%- endif -%}
                </li>
              {%- endif -%}
            {%- endif -%}
          </ul>
        </div>
      {%- endfor -%}
      <div class="maison-footer__col">
        <h3 class="maison-footer__label">Support</h3>
        <ul role="list">
          <li><a href="/pages/contact">Contact Us</a></li>
          <li><a href="/pages/track-order">Track Order</a></li>
          <li><a href="/pages/start-a-return">Start a Return</a></li>
          <li><a href="/pages/faq">FAQs</a></li>
          <li><a href="/pages/refund-returns-policy">Refund and Returns Policy</a></li>
        </ul>
      </div>
      <div class="maison-footer__col">
        <h3 class="maison-footer__label">Legal</h3>
        <ul role="list">
          <li><a href="/pages/privacy-policy">Privacy Policy</a></li>
          <li><a href="/pages/cookie-policy">Cookie Policy</a></li>
          <li><a href="/pages/terms-of-service">Terms &amp; Conditions</a></li>
          <li><a href="/pages/intellectual-property">Intellectual property</a></li>
          {%- comment -%} Explicit legal links above; skip shop policies that duplicate those titles {%- endcomment -%}
          {%- for policy in shop.policies -%}
            {%- assign policy_title_down = policy.title | downcase -%}
            {%- if policy_title_down contains 'privacy'
              or policy_title_down contains 'terms'
              or policy_title_down contains 'cookie'
              or policy_title_down contains 'intellectual'
              or policy_title_down contains 'refund'
              or policy_title_down contains 'shipping'
            -%}
              {%- continue -%}
            {%- endif -%}
            <li><a href="{{ policy.url }}">{{ policy.title | escape }}</a></li>
          {%- endfor -%}
        </ul>
      </div>
    </nav>

    <div class="maison-footer__edge maison-footer__edge--end">
      {%- if section.settings.phone != blank -%}
        <a href="tel:{{ section.settings.phone | remove: ' ' | remove: '-' }}">{{ section.settings.phone | escape }}</a>
      {%- endif -%}
      {%- if section.settings.email != blank -%}
        <a href="mailto:{{ section.settings.email }}">{{ section.settings.email | escape }}</a>
      {%- endif -%}
      <a class="maison-footer__accent maison-footer__credit" href="https://kartavya.tech/">
        <span>{{ section.settings.credit | escape }}</span>
        <img src="{{ 'logo-kj-light-256.png' | asset_url }}" alt="Kartavya Jharwal" width="256" height="256" loading="lazy">
      </a>
    </div>
  </div>

  <div class="maison-footer__utilities maison-footer__wrap">
    <ul class="mt-coda__arrows" role="list">
      <li><a href="/pages/kansa">Ask Kansa — care, heat, sight →</a></li>
      <li><a href="/agents.md">Read the agent manifest ↗</a></li>
      <li><a href="/pages/care">The care covenant ↓</a></li>
    </ul>
    <p class="mt-coda__legal">
      © {{ 'now' | date: '%Y' }} {{ shop.name | escape }}
      <span aria-hidden="true">·</span>
      <button type="button" class="mt-reset" data-mt-profile-open>{{ 'accessibility.cooking_preferences' | t }}</button>
      <button type="button" class="mt-reset" data-mt-reduced-motion-toggle aria-label="Reduced motion" aria-pressed="false">Reduced motion: <span data-mt-motion-label>OFF</span></button>
      <span data-mt-sound-controls></span>
      <button type="button" class="mt-reset" data-mt-reset>[ Reset Session &amp; Storage ]</button>
    </p>
  </div>

  <div class="mt-coda" aria-label="{{ section.settings.wordmark | escape }}">
    <p class="mt-coda__word" data-mt-scroll="coda" aria-hidden="true">{{ section.settings.wordmark | escape }}</p>

  </div>
</div>

{% stylesheet %}
  .maison-footer {
    --footer-mono: var(--font-mono--family, ui-monospace, monospace);
    color: var(--bone, #f7f2e9);
    background: var(--soot, #14110f);
  }

  .maison-footer a {
    color: inherit;
    text-decoration: none;
  }

  .maison-footer a:hover {
    color: var(--footer-accent);
  }

  .maison-footer a:focus-visible,
  .maison-footer button:focus-visible,
  .maison-footer input:focus-visible {
    outline: 2px solid var(--footer-accent);
    outline-offset: 3px;
  }

  .maison-footer__wrap {
    width: 100%;
    max-width: var(--page-width, 90rem);
    margin-inline: auto;
    padding-inline: var(--page-margin, clamp(var(--mt-space-5), 4vw, var(--mt-space-7)));
  }

  .maison-footer__cta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--mt-space-xs) var(--mt-space-md);
    align-items: center;
    padding-block: var(--mt-space-md);
    border-block-end: 1px solid rgb(247 242 233 / 0.14);
  }

  .maison-footer__headline {
    margin: 0;
    color: var(--mt-surface-raised);
    font-family: var(--mt-type-family-heading);
    font-size: var(--mt-type-title);
    font-weight: 400;
    line-height: 1.15;
    letter-spacing: -0.025em;
  }

  .maison-footer__signup {
    flex: 1 1 18rem;
    min-inline-size: 0;
    max-inline-size: 26rem;
  }

  .maison-footer__form {
    display: grid;
    grid-template-columns: minmax(0, 1fr) fit-content(52%);
  }

  .maison-footer__email-label {
    grid-column: 1 / -1;
    margin-block-end: var(--mt-space-xs);
  }

  .maison-footer__form input[type='email'] {
    min-inline-size: 0;
    min-block-size: var(--minimum-touch-target);
    padding-inline: var(--mt-space-sm);
    border: 1px solid var(--mt-surface-raised);
    border-inline-end: 0;
    background: var(--mt-surface-raised);
    color: var(--mt-surface-ink);
    border-radius: var(--style-border-radius-inputs);
    border-start-end-radius: 0;
    border-end-end-radius: 0;
    font-family: var(--mt-type-family-body);
    font-size: max(1rem, var(--mt-type-nav));
  }

  .maison-footer__form input[type='email']::placeholder {
    color: color-mix(in srgb, var(--mt-surface-ink) 75%, var(--mt-surface-raised));
    opacity: 1;
  }

  .maison-footer__form .button {
    min-inline-size: 0;
    min-block-size: var(--minimum-touch-target);
    padding: var(--mt-space-xs) var(--mt-space-sm);
    background: var(--mt-surface-ink);
    color: var(--mt-surface-raised);
    border: 1px solid var(--mt-surface-raised);
    border-radius: var(--style-border-radius-inputs);
    border-start-start-radius: 0;
    border-end-start-radius: 0;
    line-height: 1.2;
    white-space: normal;
    overflow-wrap: anywhere;
  }

  .maison-footer__form :is(input, button):focus-visible {
    z-index: 1;
    outline: 2px solid var(--mt-surface-raised);
    outline-offset: 3px;
  }

  .maison-footer__note {
    grid-column: 1 / -1;
    margin: var(--mt-space-xs) 0 0;
    font-family: var(--footer-mono);
    font-size: var(--mt-type-accent);
  }

  .maison-footer__grid {
    display: grid;
    gap: var(--mt-space-6);
    padding-block: clamp(var(--mt-space-6), 5vw, var(--mt-space-8));
    font-size: var(--mt-type-body);
  }

  @media screen and (min-width: 990px) {
    .maison-footer__grid {
      grid-template-columns: 1fr 2.2fr 1fr;
      align-items: start;
    }
  }

  .maison-footer__edge {
    display: grid;
    gap: var(--mt-space-1);
    font-family: var(--footer-mono);
    font-size: var(--mt-type-accent);
    font-style: normal;
    letter-spacing: 0.1em;
    line-height: 1.6;
    text-transform: uppercase;
  }

  @media screen and (min-width: 990px) {
    .maison-footer__edge--end {
      justify-items: end;
      text-align: end;
    }
  }

  .maison-footer__accent {
    margin-block-start: var(--mt-space-4);
    color: var(--footer-accent);
  }

  .maison-footer__menus {
    display: grid;
    gap: var(--mt-space-4);
    grid-template-columns: repeat(auto-fit, minmax(8.5rem, 1fr));
  }

  .maison-footer .maison-footer__label {
    margin: 0 0 var(--mt-space-2);
    font-family: var(--footer-mono);
    font-size: var(--mt-type-mono);
    font-weight: 400;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgb(247 242 233 / 0.55);
  }

  .maison-footer__col a {
    font-size: var(--mt-type-body);
    line-height: 1.25;
    display: inline-block;
    padding-block: 0.2rem;
  }

  .maison-footer__col ul {
    display: grid;
    gap: 0;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .mt-coda {
    container-type: inline-size;
    overflow: hidden;
    padding-block: clamp(var(--mt-space-6), 5vw, var(--mt-space-8)) var(--mt-space-5);
    background: var(--footer-accent);
    color: #f7f5f0;
    text-align: center;
  }

  .mt-coda__word {
    margin: 0;
    font-family: var(--mt-type-family-wordmark);
    font-weight: var(--font-weight--wordmark, 100);
    font-size: var(--mt-type-wordmark-display, var(--font-size--brand-wordmark-display, clamp(2.75rem, 1.4rem + 9cqi, 9rem)));
    line-height: 0.85;
    letter-spacing: var(--mt-type-tracking-wordmark, var(--letter-spacing--wordmark, -0.07em));
    font-kerning: normal;
    font-feature-settings: 'kern' 1, 'liga' 1;
    white-space: nowrap;
    translate: -2cqi 0;
  }

  .mt-coda__arrows {
    display: grid;
    gap: var(--mt-space-2);
    justify-content: center;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .mt-coda a:hover {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .mt-coda__legal {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--mt-space-2) var(--mt-space-3);
    margin: var(--mt-space-3) 0 0;
    font-family: var(--footer-mono);
    font-size: var(--mt-type-mono);
    letter-spacing: var(--mt-type-tracking-accent);
    opacity: 0.8;
  }

  .maison-footer__credit { display: grid; gap: 0.65rem; justify-items: inherit; }
  .maison-footer__credit img { display: block; width: 4rem; height: 4rem; object-fit: contain; }
  .maison-footer__utilities { padding-block: var(--mt-space-4); border-block-start: 1px solid rgb(247 242 233 / 0.14); }
  .maison-footer__utilities .mt-coda__arrows { display: flex; flex-wrap: wrap; gap: 0.35rem 1.25rem; }
  .maison-footer__utilities .mt-coda__legal { align-items: center; line-height: 1.4; }
  .maison-footer__utilities .mt-reset { color: inherit; background: transparent; border: 0; font: inherit; padding: 0.35rem 0; cursor: pointer; }
  .maison-footer__col li { margin: 0; padding: 0; }

  /* Compact Ask AI rail */
  .maison-footer__augo { padding-block: var(--mt-space-4); border-block-end: 1px solid rgb(247 242 233 / 0.14); }
  .maison-footer__augo-header { margin-block-end: var(--mt-space-3); }
  .maison-footer__augo-heading { margin: 0; font-family: var(--mt-type-family-heading); font-weight: 400; }
  .maison-footer__augo-lede { display: none; }
  .maison-footer__ai-grid { display: flex; flex-wrap: wrap; align-items: center; gap: var(--mt-space-2); }
  .maison-footer__ai-link { position: relative; display: inline-flex; align-items: center; justify-content: center; width: 2.75rem; height: 2.75rem; color: #f7f2e9; text-decoration: none; }
  .maison-footer__ai-logo { display: block; width: 1.45rem; height: 1.45rem; }
  .maison-footer__ai-link:hover { color: var(--footer-accent); }
  .maison-footer__ai-link:focus-visible { outline: 2px solid currentColor; outline-offset: 2px; }
  .maison-footer__ai-link::after { content: attr(data-tooltip); position: absolute; bottom: calc(100% + 0.35rem); left: 50%; transform: translateX(-50%); white-space: nowrap; padding: 0.3rem 0.5rem; background: #f7f2e9; color: #1d1d1d; font-family: var(--footer-mono); font-size: var(--mt-type-mono); opacity: 0; pointer-events: none; }
  .maison-footer__ai-link:hover::after, .maison-footer__ai-link:focus-visible::after { opacity: 1; }

  .maison-footer__augo-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--mt-space-2) var(--mt-space-3);
    font-family: var(--footer-mono);
    font-size: var(--mt-type-mono);
    letter-spacing: 0.08em;
    color: rgb(247 242 233 / 0.6);
    margin-top: var(--mt-space-4);
  }

  .maison-footer__augo-meta-link {
    color: var(--footer-accent);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
{% endstylesheet %}

