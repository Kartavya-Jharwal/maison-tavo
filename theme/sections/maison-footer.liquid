{% comment %}
  Maison Tavo footer: CTA band, mono-labelled menu columns flanked by address and contact,
  then a cropped display wordmark band with arrow links and the evaluator reset.
{% endcomment %}

<div class="maison-footer" style="--footer-accent: {{ section.settings.accent }};">
  <div class="maison-footer__cta maison-footer__wrap">
    <h2 class="maison-footer__headline">{{ section.settings.headline | escape }}</h2>
    <div class="maison-footer__signup">
      {%- form 'customer', id: 'MaisonFooterSignup', class: 'maison-footer__form' -%}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <label class="visually-hidden" for="MaisonFooterEmail">Email</label>
        <input
          id="MaisonFooterEmail"
          type="email"
          name="contact[email]"
          autocomplete="email"
          placeholder="Email for the next furnace heat"
          required
        >
        <button type="submit" class="button">{{ section.settings.button_label | escape }}</button>
        {%- if form.posted_successfully? -%}
          <p class="maison-footer__note" role="status">You're on the list.</p>
        {%- elsif form.errors -%}
          <p class="maison-footer__note" role="alert">{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</p>
        {%- endif -%}
      {%- endform -%}
    </div>
  </div>

  <div class="maison-footer__grid maison-footer__wrap">
    <address class="maison-footer__edge">
      <a href="/pages/contact">{{ section.settings.address | newline_to_br }}</a>
      <span class="maison-footer__accent">{{ section.settings.tagline | escape }}</span>
    </address>

    <nav class="maison-footer__menus" aria-label="Footer">
      {%- for i in (1..3) -%}
        {%- assign key = 'menu_' | append: i -%}
        {%- assign menu = section.settings[key] -%}
        {%- assign label_key = 'label_' | append: i -%}
        <div class="maison-footer__col">
          <h3 class="maison-footer__label">{{ section.settings[label_key] | default: menu.title | escape }}</h3>
          <ul role="list">
            {%- if menu != blank -%}
              {%- for link in menu.links -%}
                <li><a href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>{{ link.title | escape }}</a></li>
              {%- endfor -%}
            {%- elsif i == 1 -%}
              <li><a href="{{ routes.collections_url }}">Catalogue</a></li>
              <li><a href="{{ collections['cookware'].url | default: '/collections/cookware' }}">Cookware</a></li>
              <li><a href="{{ collections['tableware-pottery'].url | default: '/collections/tableware-pottery' }}">Tableware &amp; Pottery</a></li>
              <li><a href="{{ collections['care-sets'].url | default: '/collections/care-sets' }}">Care &amp; Sets</a></li>
              <li><a href="/pages/new-arrivals">New arrivals</a></li>
              <li><a href="/pages/kansa">Kansa</a></li>
            {%- elsif i == 2 -%}
              <li><a href="/pages/about">About us</a></li>
              <li><a href="/pages/our-story">Our story</a></li>
              <li><a href="/pages/building">Building of</a></li>
              <li><a href="/blogs/journal">Journal</a></li>
              <li><a href="/pages/reviews">Reviews</a></li>
            {%- else -%}
              <li><a href="/pages/contact">Contact &amp; locations</a></li>
              <li><a href="/pages/faq">FAQ</a></li>
              <li><a href="/pages/delivery-returns">Delivery &amp; returns</a></li>
              <li><a href="{{ routes.search_url }}">Search</a></li>
              <li><a href="{{ routes.account_login_url }}">Account</a></li>
            {%- endif -%}
          </ul>
        </div>
      {%- endfor -%}
      <div class="maison-footer__col">
        <h3 class="maison-footer__label">Legal</h3>
        <ul role="list">
          <li><a href="/pages/privacy-policy">Privacy policy</a></li>
          <li><a href="/pages/terms-of-service">Terms of service</a></li>
          <li><a href="/pages/cookie-policy">Cookie policy</a></li>
          <li><a href="/pages/intellectual-property">Intellectual property</a></li>
          {%- for policy in shop.policies -%}
            <li><a href="{{ policy.url }}">{{ policy.title | escape }}</a></li>
          {%- endfor -%}
        </ul>
      </div>
    </nav>

    <div class="maison-footer__edge maison-footer__edge--end">
      {%- if section.settings.phone != blank -%}
        <a href="tel:{{ section.settings.phone | remove: ' ' | remove: '-' }}">{{ section.settings.phone | escape }}</a>
      {%- endif -%}
      {%- if section.settings.email != blank -%}
        <a href="mailto:{{ section.settings.email }}">{{ section.settings.email | escape }}</a>
      {%- endif -%}
      <span class="maison-footer__accent">{{ section.settings.credit | escape }}</span>
    </div>
  </div>

  <div class="mt-coda">
    <p class="mt-coda__word" data-mt-scroll aria-hidden="true">{{ section.settings.wordmark | escape }}</p>
    <ul class="mt-coda__arrows" role="list">
      <li><a href="/pages/kansa">Ask Kansa a care question →</a></li>
      <li><a href="/pages/ucp">Read the agent spec ↗</a></li>
      <li><a href="/pages/care">The care covenant ↓</a></li>
    </ul>
    <p class="mt-coda__legal">
      © {{ 'now' | date: '%Y' }} {{ shop.name | escape }}
      <span aria-hidden="true">·</span>
      <button type="button" class="mt-reset" data-mt-reset>[ Reset Session &amp; Storage ]</button>
    </p>
  </div>
</div>

{% stylesheet %}
  .maison-footer {
    --footer-mono: var(--font-mono--family, ui-monospace, monospace);
    color: var(--color-foreground);
    background: var(--color-background);
  }

  .maison-footer a {
    color: inherit;
    text-decoration: none;
  }

  .maison-footer a:hover {
    color: var(--footer-accent);
  }

  .maison-footer a:focus-visible,
  .maison-footer button:focus-visible,
  .maison-footer input:focus-visible {
    outline: 2px solid var(--footer-accent);
    outline-offset: 3px;
  }

  .maison-footer__wrap {
    width: 100%;
    max-width: var(--page-width, 90rem);
    margin-inline: auto;
    padding-inline: var(--page-margin, clamp(1.25rem, 4vw, 3rem));
  }

  .maison-footer__cta {
    display: grid;
    gap: 2rem;
    align-items: end;
    padding-block: clamp(4rem, 9vw, 8rem) clamp(2.5rem, 5vw, 4rem);
    border-block-end: 1px solid rgb(var(--color-foreground-rgb) / 0.12);
  }

  @media screen and (min-width: 750px) {
    .maison-footer__cta {
      grid-template-columns: 1.4fr 1fr;
    }
  }

  .maison-footer__headline {
    margin: 0;
    max-width: 14ch;
    font-family: var(--font-heading--family);
    font-size: clamp(2.25rem, 1.4rem + 3.6vw, 4.75rem);
    font-weight: 400;
    line-height: 1;
    letter-spacing: -0.025em;
  }

  .maison-footer__form {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .maison-footer__form input[type='email'] {
    flex: 1 1 14rem;
    min-height: 48px;
    padding: 0 1rem;
    border: 1px solid rgb(var(--color-foreground-rgb) / 0.25);
    background: transparent;
    color: inherit;
    font: inherit;
  }

  .maison-footer__note {
    flex-basis: 100%;
    margin: 0;
    font-family: var(--footer-mono);
    font-size: 0.75rem;
  }

  .maison-footer__grid {
    display: grid;
    gap: 2.5rem;
    padding-block: clamp(2.5rem, 5vw, 4rem);
    font-size: 0.9375rem;
  }

  @media screen and (min-width: 990px) {
    .maison-footer__grid {
      grid-template-columns: 1fr 2.2fr 1fr;
      align-items: start;
    }
  }

  .maison-footer__edge {
    display: grid;
    gap: 0.35rem;
    font-family: var(--footer-mono);
    font-size: 0.75rem;
    font-style: normal;
    letter-spacing: 0.1em;
    line-height: 1.6;
    text-transform: uppercase;
  }

  @media screen and (min-width: 990px) {
    .maison-footer__edge--end {
      justify-items: end;
      text-align: end;
    }
  }

  .maison-footer__accent {
    margin-block-start: 1rem;
    color: var(--footer-accent);
  }

  .maison-footer__menus {
    display: grid;
    gap: 2rem;
    grid-template-columns: repeat(auto-fit, minmax(8.5rem, 1fr));
  }

  .maison-footer .maison-footer__label {
    margin: 0 0 1rem;
    font-family: var(--footer-mono);
    font-size: 0.6875rem;
    font-weight: 400;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgb(var(--color-foreground-rgb) / 0.6);
  }

  .maison-footer__col a {
    font-size: 0.9375rem;
    line-height: 1.4;
  }

  .maison-footer__col ul {
    display: grid;
    gap: 0.6rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .mt-coda {
    container-type: inline-size;
    overflow: hidden;
    padding-block: clamp(2rem, 5vw, 4rem) 1.5rem;
    background: var(--footer-accent);
    color: #f7f5f0;
    text-align: center;
  }

  .mt-coda__word {
    margin: 0;
    font-family: var(--font-heading--family);
    font-size: 21cqi;
    line-height: 0.85;
    letter-spacing: -0.04em;
    white-space: nowrap;
    translate: -2cqi 0;
  }

  .mt-coda__arrows {
    display: grid;
    gap: 0.5rem;
    justify-content: center;
    margin: clamp(2rem, 5vw, 3.5rem) 0 0;
    padding: 0;
    list-style: none;
  }

  .mt-coda a:hover {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .mt-coda__legal {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem 0.75rem;
    margin: 2rem 0 0;
    font-family: var(--footer-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    opacity: 0.8;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Maison footer",
  "tag": "div",
  "class": "maison-footer-section",
  "enabled_on": { "groups": ["footer"] },
  "settings": [
    { "type": "text", "id": "headline", "label": "Headline", "default": "Cook with something that outlasts you" },
    { "type": "text", "id": "button_label", "label": "Sign-up button", "default": "Join the next heat" },
    { "type": "header", "content": "Menus" },
    { "type": "link_list", "id": "menu_1", "label": "Column 1", "default": "main-menu" },
    { "type": "text", "id": "label_1", "label": "Column 1 label", "default": "Shop" },
    { "type": "link_list", "id": "menu_2", "label": "Column 2" },
    { "type": "text", "id": "label_2", "label": "Column 2 label" },
    { "type": "link_list", "id": "menu_3", "label": "Column 3", "default": "footer" },
    { "type": "text", "id": "label_3", "label": "Column 3 label", "default": "House" },
    { "type": "header", "content": "Edges" },
    { "type": "textarea", "id": "address", "label": "Address", "default": "Foundry · Jaipur, Rajasthan\nKitchen workshop · London" },
    { "type": "text", "id": "tagline", "label": "Accent tagline", "default": "Kansa, kansa." },
    { "type": "text", "id": "phone", "label": "Phone" },
    { "type": "text", "id": "email", "label": "Email" },
    { "type": "text", "id": "credit", "label": "Accent credit", "default": "Built on Horizon" },
    { "type": "header", "content": "Wordmark band" },
    { "type": "text", "id": "wordmark", "label": "Display word", "default": "Maison Tavo" },
    { "type": "color", "id": "accent", "label": "Band colour", "default": "#A45A3D" }
  ],
  "presets": [{ "name": "Maison footer" }]
}
{% endschema %}
