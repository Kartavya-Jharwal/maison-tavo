{% comment %}
  Maison Tavo footer: CTA band, mono-labelled menu columns flanked by address and contact,
  then a cropped display wordmark band with arrow links and the evaluator reset.
{% endcomment %}

<div class="maison-footer" style="--footer-accent: {{ section.settings.accent }};">
  {%- comment -%} ── Ask AI / AUGO Section in unified footer ── {%- endcomment -%}
  {%- if section.settings.enable_ask_ai != false -%}
    <div class="maison-footer__augo maison-footer__wrap" id="FooterAskAI">
      <header class="maison-footer__augo-header">
        <h2 class="maison-footer__augo-heading">
          {{ section.settings.ask_ai_heading | default: 'What can an assistant find?' | escape }}
        </h2>
        <p class="maison-footer__augo-lede">
          {{ section.settings.ask_ai_lede | default: 'Try a prompt and check which facts the assistant can source. Since this store is gated, it may only see public references.' | escape }}
        </p>
      </header>

      <div class="maison-footer__ai-grid" role="list" aria-label="AI assistants to try">
        <a class="maison-footer__ai-link" role="listitem" href="https://chatgpt.com" target="_blank" rel="noopener noreferrer" aria-label="Ask ChatGPT (opens in a new tab)" data-tooltip="Ask ChatGPT">
      <svg class="maison-footer__ai-logo" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
                      <path d="M22.282 9.821a5.985 5.985 0 0 0-.516-4.91 6.046 6.046 0 0 0-6.51-2.9A6.065 6.065 0 0 0 4.981 4.18a5.985 5.985 0 0 0-3.998 2.9 6.046 6.046 0 0 0 .743 7.097 5.98 5.98 0 0 0 .51 4.911 6.051 6.051 0 0 0 6.515 2.9A5.985 5.985 0 0 0 13.26 24a6.056 6.056 0 0 0 5.772-4.206 5.99 5.99 0 0 0 3.997-2.9 6.056 6.056 0 0 0-.747-7.073zM13.26 22.43a4.476 4.476 0 0 1-2.876-1.04l.141-.081 4.779-2.758a.795.795 0 0 0 .392-.681v-6.737l2.02 1.168a.071.071 0 0 1 .038.052v5.583a4.504 4.504 0 0 1-4.494 4.494zM3.6 18.304a4.47 4.47 0 0 1-.535-3.014l.142.085 4.783 2.759a.771.771 0 0 0 .78 0l5.843-3.369v2.332a.08.08 0 0 1-.033.062L9.74 19.95a4.5 4.5 0 0 1-6.14-1.646zM2.34 7.896a4.485 4.485 0 0 1 2.366-1.973V11.6a.766.766 0 0 0 .388.676l5.815 3.355-2.02 1.168a.076.076 0 0 1-.071 0l-4.83-2.786A4.504 4.504 0 0 1 2.34 7.886zm16.597 3.855l-5.843-3.369 2.02-1.168a.076.076 0 0 1 .071 0l4.83 2.786a4.504 4.504 0 0 1-.676 8.137v-5.677a.79.79 0 0 0-.402-.69zm2.01-3.023l-.141-.085-4.774-2.782a.776.776 0 0 0-.785 0L9.409 9.23V6.897a.066.066 0 0 1 .028-.061l4.83-2.787a4.5 4.5 0 0 1 6.68 4.66zm-12.64 4.135l-2.02-1.164a.08.08 0 0 1-.038-.057v-5.583a4.5 4.5 0 0 1 7.375-3.453l-.142.08-4.778 2.758a.795.795 0 0 0-.393.681zm1.097-2.365l2.602-1.5 2.607 1.5v2.999l-2.597 1.5-2.607-1.5z" fill="currentColor"/>
                    </svg>
    </a>
    <a class="maison-footer__ai-link" role="listitem" href="https://claude.ai" target="_blank" rel="noopener noreferrer" aria-label="Ask Claude (opens in a new tab)" data-tooltip="Ask Claude">
      <svg class="maison-footer__ai-logo" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
                      <path d="M4.709 15.955l4.72-2.647.08-.23-.08-.128H9.2l-.79-.048-2.698-.073-2.339-.097-1.785-.121-.952-.17-.436-.244-.194-.316.097-.389.388-.316.753-.146 1.056.097 1.396.243 1.785.389 1.736.389.146-.049.072-.121-.049-.146-1.08-1.65-1.396-2.078-1.08-1.712-.802-1.395-.389-.947-.048-.656.169-.437.389-.242.583.048.607.34 1.056.874 1.736 1.396 2.236 1.42 2.164.073.146.097-.024.049-.121-.121-.316-.559-1.542-.947-2.527-.607-1.712-.34-1.2-.049-.826.146-.559.413-.34.607-.072.729.218.608.486.486.729.729 1.566.826 2.284.608 1.566.34.729.097.049.072-.049.025-.146-.025-.243-.146-1.396-.316-2.746-.218-2.43v-1.517l.17-.753.413-.413.559-.169.656.097.559.413.34.656.388 1.517.316 2.139.17 1.882.072 1.323.049.146.097.049.097-.049.025-.146-.025-.462V3.996l.17-1.079.413-.753.608-.413.729-.072.607.218.486.559.17.802-.025.802-.218 2.188-.413 2.527-.17 1.517-.024.17.072.097h.121l.146-.146.364-.656.705-1.323.923-1.712.705-1.2.656-.874.68-.607.705-.243.607.072.486.389.218.608-.049.729-.316.826-.656 1.153-1.153 1.69-.923 1.396-.462.753-.049.17.072.097.146-.049 1.42-.437 2.455-.704 1.858-.462 1.153-.194.364.097.364.364.291.534.097.534-.194.413-.437.316-.656.146-.753.024-1.42-.218-1.955-.413-1.736-.437-.656-.049-.17.097-.17.316-.146.729-.291 1.882-.437 1.882-.316 1.08-.218.413.17.364.097.097.364-.049.267-.413.218-.607.097-.729-.049-.559-.218-.413-.413-.316-.656.049-1.323.413-2.527.413-1.712.316-1.517.049-.146-.024-.121-.097.024-.17.243-1.323 2.236-1.834 2.818-.947 1.274-.802.874-.826.583-.753.267-.656-.024-.559-.243-.316-.437v-.559l.267-.413.364-.243.729-.146 1.153.097 1.47.364 1.882.583.802.316.17.024.146-.097-.024-.17-.291-.559-.656-1.323-1.153-2.188-.704-1.566-.316-1.08v-.8l.218-.559.413-.316.607-.097.656.218.413.437.729 1.323 1.08 2.188.947 2.139.607 1.566.146.364.097.049.097-.024.049-.146-.025-.316-.218-1.396-.389-2.964-.194-2.139v-1.153l.194-.753.437-.486.656-.194.656.097.559.437.291.729.146 1.323V9.49l-.291 2.43-.17 1.567v.17l.097.097.121-.049.146-.243 1.08-1.785 1.4