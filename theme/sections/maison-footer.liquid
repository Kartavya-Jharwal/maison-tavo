{% comment %}
  Maison Tavo footer: CTA band, mono-labelled menu columns flanked by address and contact,
  then a cropped display wordmark band with arrow links and the evaluator reset.
{% endcomment %}

<div class="maison-footer" style="--footer-accent: {{ section.settings.accent }};">
  {%- comment -%} ── Ask AI / AUGO Section in unified footer ── {%- endcomment -%}
  {%- if section.settings.enable_ask_ai != false -%}
    <div class="maison-footer__augo maison-footer__wrap" id="FooterAskAI">
      <header class="maison-footer__augo-header">
        <h2 class="maison-footer__augo-heading">
          {{ section.settings.ask_ai_heading | default: 'What can an assistant find?' | escape }}
        </h2>
        <p class="maison-footer__augo-lede">
          {{ section.settings.ask_ai_lede | default: 'Try a prompt and check which facts the assistant can source. Since this store is gated, it may only see public references.' | escape }}
        </p>
      </header>

      <div class="maison-footer__ai-grid" role="list" aria-label="AI assistants to try">
        {%- assign ai_systems = "ChatGPT,Claude,Gemini,Perplexity,Copilot,Meta AI" | split: "," -%}
        {%- assign ai_crawlers = "GPTBot,ClaudeBot,Google-Extended,PerplexityBot,Bingbot,FacebookBot" | split: "," -%}
        {%- assign ai_colors = "#10a37f,#d4a853,#4285f4,#20b2aa,#0078d4,#1877f2" | split: "," -%}
        {%- assign ai_urls = "https://chat.openai.com,https://claude.ai,https://gemini.google.com,https://www.perplexity.ai,https://copilot.microsoft.com,https://ai.meta.com" | split: "," -%}
        {%- assign ai_queries = "What is the Maison Tavo project?,What is Chulha by Maison Tavo?,What is Maison Tavo's Kansa companion?,What cookware does Maison Tavo preview?,What does Maison Tavo say about hob compatibility?,What care guidance can you find for Maison Tavo?" | split: "," -%}

        {%- for system in ai_systems -%}
          {%- assign idx = forloop.index0 -%}
          {%- assign crawler = ai_crawlers[idx] -%}
          {%- assign color = ai_colors[idx] -%}
          {%- assign ai_url = ai_urls[idx] -%}
          {%- assign query = ai_queries[idx] -%}

          <article class="maison-footer__ai-card" role="listitem" data-ai="{{ system | downcase | replace: ' ', '-' }}">
            <div class="maison-footer__ai-header">
              <div class="maison-footer__ai-logo-wrap" style="--ai-color: {{ color }};" aria-hidden="true">
                {%- case system -%}
                  {%- when 'ChatGPT' -%}
                    <svg class="maison-footer__ai-logo" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
                      <path d="M22.282 9.821a5.985 5.985 0 0 0-.516-4.91 6.046 6.046 0 0 0-6.51-2.9A6.065 6.065 0 0 0 4.981 4.18a5.985 5.985 0 0 0-3.998 2.9 6.046 6.046 0 0 0 .743 7.097 5.98 5.98 0 0 0 .51 4.911 6.051 6.051 0 0 0 6.515 2.9A5.985 5.985 0 0 0 13.26 24a6.056 6.056 0 0 0 5.772-4.206 5.99 5.99 0 0 0 3.997-2.9 6.056 6.056 0 0 0-.747-7.073zM13.26 22.43a4.476 4.476 0 0 1-2.876-1.04l.141-.081 4.779-2.758a.795.795 0 0 0 .392-.681v-6.737l2.02 1.168a.071.071 0 0 1 .038.052v5.583a4.504 4.504 0 0 1-4.494 4.494zM3.6 18.304a4.47 4.47 0 0 1-.535-3.014l.142.085 4.783 2.759a.771.771 0 0 0 .78 0l5.843-3.369v2.332a.08.08 0 0 1-.033.062L9.74 19.95a4.5 4.5 0 0 1-6.14-1.646zM2.34 7.896a4.485 4.485 0 0 1 2.366-1.973V11.6a.766.766 0 0 0 .388.676l5.815 3.355-2.02 1.168a.076.076 0 0 1-.071 0l-4.83-2.786A4.504 4.504 0 0 1 2.34 7.886zm16.597 3.855l-5.843-3.369 2.02-1.168a.076.076 0 0 1 .071 0l4.83 2.786a4.504 4.504 0 0 1-.676 8.137v-5.677a.79.79 0 0 0-.402-.69zm2.01-3.023l-.141-.085-4.774-2.782a.776.776 0 0 0-.785 0L9.409 9.23V6.897a.066.066 0 0 1 .028-.061l4.83-2.787a4.5 4.5 0 0 1 6.68 4.66zm-12.64 4.135l-2.02-1.164a.08.08 0 0 1-.038-.057v-5.583a4.5 4.5 0 0 1 7.375-3.453l-.142.08-4.778 2.758a.795.795 0 0 0-.393.681zm1.097-2.365l2.602-1.5 2.607 1.5v2.999l-2.597 1.5-2.607-1.5z" fill="currentColor"/>
                    </svg>
                  {%- when 'Claude' -%}
                    <svg class="maison-footer__ai-logo" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
                      <path d="M4.709 15.955l4.72-2.647.08-.23-.08-.128H9.2l-.79-.048-2.698-.073-2.339-.097-1.785-.121-.952-.17-.436-.244-.194-.316.097-.389.388-.316.753-.146 1.056.097 1.396.243 1.785.389 1.736.389.146-.049.072-.121-.049-.146-1.08-1.65-1.396-2.078-1.08-1.712-.802-1.395-.389-.947-.048-.656.169-.437.389-.242.583.048.607.34 1.056.874 1.736 1.396 2.236 1.42 2.164.073.146.097-.024.049-.121-.121-.316-.559-1.542-.947-2.527-.607-1.712-.34-1.2-.049-.826.146-.559.413-.34.607-.072.729.218.608.486.486.729.729 1.566.826 2.284.608 1.566.34.729.097.049.072-.049.025-.146-.025-.243-.146-1.396-.316-2.746-.218-2.43v-1.517l.17-.753.413-.413.559-.169.656.097.559.413.34.656.388 1.517.316 2.139.17 1.882.072 1.323.049.146.097.049.097-.049.025-.146-.025-.462V3.996l.17-1.079.413-.753.608-.413.729-.072.607.218.486.559.17.802-.025.802-.218 2.188-.413 2.527-.17 1.517-.024.17.072.097h.121l.146-.146.364-.656.705-1.323.923-1.712.705-1.2.656-.874.68-.607.705-.243.607.072.486.389.218.608-.049.729-.316.826-.656 1.153-1.153 1.69-.923 1.396-.462.753-.049.17.072.097.146-.049 1.42-.437 2.455-.704 1.858-.462 1.153-.194.364.097.364.364.291.534.097.534-.194.413-.437.316-.656.146-.753.024-1.42-.218-1.955-.413-1.736-.437-.656-.049-.17.097-.17.316-.146.729-.291 1.882-.437 1.882-.316 1.08-.218.413.17.364.097.097.364-.049.267-.413.218-.607.097-.729-.049-.559-.218-.413-.413-.316-.656.049-1.323.413-2.527.413-1.712.316-1.517.049-.146-.024-.121-.097.024-.17.243-1.323 2.236-1.834 2.818-.947 1.274-.802.874-.826.583-.753.267-.656-.024-.559-.243-.316-.437v-.559l.267-.413.364-.243.729-.146 1.153.097 1.47.364 1.882.583.802.316.17.024.146-.097-.024-.17-.291-.559-.656-1.323-1.153-2.188-.704-1.566-.316-1.08v-.8l.218-.559.413-.316.607-.097.656.218.413.437.729 1.323 1.08 2.188.947 2.139.607 1.566.146.364.097.049.097-.024.049-.146-.025-.316-.218-1.396-.389-2.964-.194-2.139v-1.153l.194-.753.437-.486.656-.194.656.097.559.437.291.729.146 1.323V9.49l-.291 2.43-.17 1.567v.17l.097.097.121-.049.146-.243 1.08-1.785 1.42-2.188.923-1.323.802-.996.68-.607.656-.291.656-.024.534.316.316.583-.024.729-.316.826-.826 1.517-1.323 2.139-.923 1.517-.437.802-.049.17.097.097h.17l.316-.097 1.42-.437 1.882-.462 1.47-.316 1.056-.097.68.097.437.316.194.559-.049.607-.316.437-.607.316-1.056.218-1.858.316-1.712.316-.899.194-.194.097-.024.17.049.097.364.17.364-.049.364-.49.388.049.364.267.267.437.097.656-.194.583-.437.413-.656.242-.802.049-1.08-.218-1.542-.462-1.76-.535z" fill="currentColor"/>
                    </svg>
                  {%- when 'Gemini' -%}
                    <svg class="maison-footer__ai-logo" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
                      <path d="M12 24A14.304 14.304 0 0 0 0 12 14.304 14.304 0 0 0 12 0a14.305 14.305 0 0 0 12 12 14.305 14.305 0 0 0-12 12" fill="currentColor"/>
                    </svg>
                  {%- when 'Perplexity' -%}
                    <svg class="maison-footer__ai-logo" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
                      <path d="M18.73 3.42l-5.73 5.5V3.42H11.5v5.5L5.78 3.42H3.44l7.56 7.26v.3L4.6 17.26l1.74 1.3 5.16-4.96v7.98H13v-7.98l5.16 4.96 1.74-1.3-6.4-6.28v-.3l7.56-7.26h-2.33z" fill="currentColor"/>
                    </svg>
                  {%- when 'Copilot' -%}
                    <svg class="maison-footer__ai-logo" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
                      <path d="M12 2C6.477 2 2 6.477 2 12s4.477 10 10 10 10-4.477 10-10S17.523 2 12 2zm4.95 7.05a7.07 7.07 0 0 1 0 9.9L7.05 9.05a7.07 7.07 0 0 1 9.9 0z" fill="currentColor"/>
                    </svg>
                  {%- else -%}
                    <svg class="maison-footer__ai-logo" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
                      <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069z" fill="currentColor"/>
                    </svg>
                {%- endcase -%}
              </div>
              <div class="maison-footer__ai-info">
                <span class="maison-footer__ai-name">{{ system }}</span>
                <span class="maison-footer__ai-crawler">{{ crawler }}</span>
              </div>
            </div>

            <div class="maison-footer__ai-body">
              <span class="maison-footer__ai-prompt-label">Try asking:</span>
              <p class="maison-footer__ai-prompt">“{{ query }}”</p>
            </div>

            <a
              href="{{ ai_url }}"
              target="_blank"
              rel="noopener noreferrer"
              class="maison-footer__ai-btn"
              aria-label="Open {{ system }} to ask about Maison Tavo"
              style="--ai-color: {{ color }};"
            >
              Ask on {{ system }} →
            </a>
          </article>
        {%- endfor -%}
      </div>

      <div class="maison-footer__augo-meta">
        <span class="maison-footer__augo-meta-label">Explore the prototype</span>
        <a href="/robots.txt" class="maison-footer__augo-meta-link">robots.txt</a>
        <span aria-hidden="true">·</span>
        <a href="/pages/ucp" class="maison-footer__augo-meta-link">Commerce protocol demo</a>
        <span aria-hidden="true">·</span>
        <a href="/pages/kansa" class="maison-footer__augo-meta-link">Kansa</a>
      </div>
    </div>
  {%- endif -%}
  <div class="maison-footer__cta maison-footer__wrap">
    <h2 class="maison-footer__headline">{{ section.settings.headline | escape }}</h2>
    <div class="maison-footer__signup">
      <p class="maison-footer__signup-copy">Get cookware care notes and hear when the next release opens.</p>
      {%- form 'customer', id: 'MaisonFooterSignup', class: 'maison-footer__form' -%}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <label class="visually-hidden" for="MaisonFooterEmail">Email</label>
        <input
          id="MaisonFooterEmail"
          type="email"
          name="contact[email]"
          autocomplete="email"
          placeholder="Email for the next heat"
          required
        >
        <button type="submit" class="button button--primary">{{ section.settings.button_label | escape }}</button>
        {%- if form.posted_successfully? -%}
          <p class="maison-footer__note" data-mt-newsletter-success role="status">You're on the list.</p>
        {%- elsif form.errors -%}
          <p class="maison-footer__note" role="alert">{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</p>
        {%- endif -%}
      {%- endform -%}
    </div>
  </div>

  <div class="maison-footer__grid maison-footer__wrap">
    <address class="maison-footer__edge">
      <a href="/pages/contact">{{ section.settings.address | newline_to_br }}</a>
      <span class="maison-footer__accent">{{ section.settings.tagline | escape }}</span>
    </address>

    <nav class="maison-footer__menus" aria-label="Footer">
      {%- for i in (1..3) -%}
        {%- assign key = 'menu_' | append: i -%}
        {%- assign menu = section.settings[key] -%}
        {%- assign label_key = 'label_' | append: i -%}
        <div class="maison-footer__col">
          <h3 class="maison-footer__label">{{ section.settings[label_key] | default: menu.title | escape }}</h3>
          <ul role="list">
            {%- if menu != blank -%}
              {%- for link in menu.links -%}
                <li><a href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>{{ link.title | escape }}</a></li>
              {%- endfor -%}
            {%- elsif i == 1 -%}
              <li><a href="{{ routes.collections_url }}">Catalogue</a></li>
              <li><a href="{{ collections['cookware'].url | default: '/collections/cookware' }}">Cookware</a></li>
              <li><a href="{{ collections['tableware-pottery'].url | default: '/collections/tableware-pottery' }}">Tableware &amp; Pottery</a></li>
              <li><a href="{{ collections['care-sets'].url | default: '/collections/care-sets' }}">Care &amp; Sets</a></li>
              <li><a href="/pages/releases">Releases</a></li>
              <li><a href="/pages/department">Department</a></li>
              <li><a href="/pages/kitchen">Kitchen</a></li>
              <li><a href="/pages/kansa">Kansa</a></li>
            {%- elsif i == 2 -%}
              <li><a href="/pages/about">About us</a></li>
              <li><a href="/pages/our-story">Our story</a></li>
              <li><a href="/pages/building">How it works</a></li>
              <li><a href="/pages/journal">Journal</a></li>
              <li><a href="/pages/heat">Heat</a></li>
              <li><a href="/pages/finder">Finder</a></li>
              <li><a href="/pages/reviews">Reviews</a></li>
            {%- else -%}
              <li><a href="/pages/contact">Contact &amp; locations</a></li>
              <li><a href="/pages/mail">Mail</a></li>
              <li><a href="/pages/faq">FAQ</a></li>
              <li><a href="/pages/delivery-returns">Delivery &amp; returns</a></li>
              <li><a href="{{ routes.search_url }}">Search</a></li>
              {%- if shop.customer_accounts_enabled -%}
                <li>
                  {%- if customer -%}
                    <a href="{{ routes.account_url }}">Account</a>
                  {%- else -%}
                    <a href="{{ routes.account_login_url }}">Account</a>
                  {%- endif -%}
                </li>
              {%- endif -%}
            {%- endif -%}
          </ul>
        </div>
      {%- endfor -%}
      <div class="maison-footer__col">
        <h3 class="maison-footer__label">Legal</h3>
        <ul role="list">
          <li><a href="/pages/privacy-policy">Privacy policy</a></li>
          <li><a href="/pages/terms-of-service">Terms of service</a></li>
          <li><a href="/pages/cookie-policy">Cookie policy</a></li>
          <li><a href="/pages/intellectual-property">Intellectual property</a></li>
          {%- comment -%} Explicit legal links above; skip shop policies that duplicate those titles {%- endcomment -%}
          {%- for policy in shop.policies -%}
            {%- assign policy_title_down = policy.title | downcase -%}
            {%- if policy_title_down contains 'privacy'
              or policy_title_down contains 'terms'
              or policy_title_down contains 'cookie'
              or policy_title_down contains 'intellectual'
              or policy_title_down contains 'refund'
              or policy_title_down contains 'shipping'
            -%}
              {%- continue -%}
            {%- endif -%}
            <li><a href="{{ policy.url }}">{{ policy.title | escape }}</a></li>
          {%- endfor -%}
        </ul>
      </div>
    </nav>

    <div class="maison-footer__edge maison-footer__edge--end">
      {%- if section.settings.phone != blank -%}
        <a href="tel:{{ section.settings.phone | remove: ' ' | remove: '-' }}">{{ section.settings.phone | escape }}</a>
      {%- endif -%}
      {%- if section.settings.email != blank -%}
        <a href="mailto:{{ section.settings.email }}">{{ section.settings.email | escape }}</a>
      {%- endif -%}
      <span class="maison-footer__accent">{{ section.settings.credit | escape }}</span>
    </div>
  </div>

  <div class="mt-coda" aria-label="{{ section.settings.wordmark | escape }}">
    <p class="mt-coda__word" data-mt-scroll="coda" aria-hidden="true">{{ section.settings.wordmark | escape }}</p>
    <ul class="mt-coda__arrows" role="list">
      <li><a href="/pages/kansa">Ask Kansa — care, heat, sight →</a></li>
      <li><a href="/pages/ucp">Read the agent spec ↗</a></li>
      <li><a href="/pages/care">The care covenant ↓</a></li>
    </ul>
    <p class="mt-coda__legal">
      © {{ 'now' | date: '%Y' }} {{ shop.name | escape }}
      <span aria-hidden="true">·</span>
      <button type="button" class="mt-reset" data-mt-reset>[ Reset Session &amp; Storage ]</button>
    </p>
  </div>
</div>

{% stylesheet %}
  .maison-footer {
    --footer-mono: var(--font-mono--family, ui-monospace, monospace);
    color: var(--bone, #f7f2e9);
    background: var(--soot, #14110f);
  }

  .maison-footer a {
    color: inherit;
    text-decoration: none;
  }

  .maison-footer a:hover {
    color: var(--footer-accent);
  }

  .maison-footer a:focus-visible,
  .maison-footer button:focus-visible,
  .maison-footer input:focus-visible {
    outline: 2px solid var(--footer-accent);
    outline-offset: 3px;
  }

  .maison-footer__wrap {
    width: 100%;
    max-width: var(--page-width, 90rem);
    margin-inline: auto;
    padding-inline: var(--page-margin, clamp(var(--mt-space-5), 4vw, var(--mt-space-7)));
  }

  .maison-footer__cta {
    display: grid;
    gap: clamp(var(--mt-space-5), 3vw, var(--mt-space-6));
    align-items: end;
    padding-block: clamp(var(--mt-space-7), 7vw, var(--mt-space-9)) clamp(var(--mt-space-6), 4vw, var(--mt-space-7));
    border-block-end: 1px solid rgb(247 242 233 / 0.14);
  }

  @media screen and (min-width: 750px) {
    .maison-footer__cta {
      grid-template-columns: 1.2fr 1fr;
      column-gap: clamp(var(--mt-space-6), 5vw, var(--mt-space-8));
    }
  }

  .maison-footer__headline {
    margin: 0;
    max-width: 11ch;
    font-family: var(--mt-type-family-heading);
    font-size: var(--mt-type-heading);
    font-weight: 400;
    line-height: 1.05;
    letter-spacing: -0.025em;
  }

  .maison-footer__form {
    display: flex;
    flex-wrap: wrap;
    gap: var(--mt-space-2);
  }

  .maison-footer__form input[type='email'] {
    flex: 1 1 14rem;
    min-height: 48px;
    padding: 0 var(--mt-space-4);
    border: 1px solid var(--mt-surface-raised);
    background: var(--mt-surface-raised);
    color: var(--mt-surface-ink);
    border-radius: var(--style-border-radius-inputs);
    font: inherit;
  }

  .maison-footer__form input[type='email']::placeholder {
    color: color-mix(in srgb, var(--mt-surface-ink) 75%, var(--mt-surface-raised));
    opacity: 1;
  }

  .maison-footer__form .button {
    background: var(--mt-surface-raised);
    color: var(--mt-surface-ink);
    border: 1px solid var(--mt-surface-raised);
  }

  .maison-footer__form :is(input, button):focus-visible {
    outline: 2px solid var(--mt-surface-raised);
    outline-offset: 3px;
  }

  .maison-footer__signup-copy {
    margin: 0 0 var(--mt-space-xs);
    color: var(--mt-surface-raised);
  }

  .maison-footer__note {
    flex-basis: 100%;
    margin: 0;
    font-family: var(--footer-mono);
    font-size: var(--mt-type-accent);
  }

  .maison-footer__grid {
    display: grid;
    gap: var(--mt-space-6);
    padding-block: clamp(var(--mt-space-6), 5vw, var(--mt-space-8));
    font-size: var(--mt-type-body);
  }

  @media screen and (min-width: 990px) {
    .maison-footer__grid {
      grid-template-columns: 1fr 2.2fr 1fr;
      align-items: start;
    }
  }

  .maison-footer__edge {
    display: grid;
    gap: var(--mt-space-1);
    font-family: var(--footer-mono);
    font-size: var(--mt-type-accent);
    font-style: normal;
    letter-spacing: 0.1em;
    line-height: 1.6;
    text-transform: uppercase;
  }

  @media screen and (min-width: 990px) {
    .maison-footer__edge--end {
      justify-items: end;
      text-align: end;
    }
  }

  .maison-footer__accent {
    margin-block-start: var(--mt-space-4);
    color: var(--footer-accent);
  }

  .maison-footer__menus {
    display: grid;
    gap: var(--mt-space-6);
    grid-template-columns: repeat(auto-fit, minmax(8.5rem, 1fr));
  }

  .maison-footer .maison-footer__label {
    margin: 0 0 var(--mt-space-4);
    font-family: var(--footer-mono);
    font-size: var(--mt-type-mono);
    font-weight: 400;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgb(247 242 233 / 0.55);
  }

  .maison-footer__col a {
    font-size: var(--mt-type-body);
    line-height: 1.4;
  }

  .maison-footer__col ul {
    display: grid;
    gap: var(--mt-space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .mt-coda {
    container-type: inline-size;
    overflow: hidden;
    padding-block: clamp(var(--mt-space-6), 5vw, var(--mt-space-8)) var(--mt-space-5);
    background: var(--footer-accent);
    color: #f7f5f0;
    text-align: center;
  }

  .mt-coda__word {
    margin: 0;
    font-family: var(--mt-type-family-wordmark);
    font-weight: var(--font-weight--wordmark, 100);
    font-size: var(--mt-type-wordmark-display, var(--font-size--brand-wordmark-display, clamp(2.75rem, 1.4rem + 9cqi, 9rem)));
    line-height: 0.85;
    letter-spacing: var(--mt-type-tracking-wordmark, var(--letter-spacing--wordmark, -0.07em));
    font-kerning: normal;
    font-feature-settings: 'kern' 1, 'liga' 1;
    white-space: nowrap;
    translate: -2cqi 0;
  }

  .mt-coda__arrows {
    display: grid;
    gap: var(--mt-space-2);
    justify-content: center;
    margin: clamp(var(--mt-space-6), 5vw, var(--mt-space-7)) 0 0;
    padding: 0;
    list-style: none;
  }

  .mt-coda a:hover {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .mt-coda__legal {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--mt-space-2) var(--mt-space-3);
    margin: var(--mt-space-6) 0 0;
    font-family: var(--footer-mono);
    font-size: var(--mt-type-mono);
    letter-spacing: var(--mt-type-tracking-accent);
    opacity: 0.8;
  }

  /* Ask AI / AUGO in footer */
  .maison-footer__augo {
    padding-block: clamp(var(--mt-space-7), 6vw, var(--mt-space-9)) clamp(var(--mt-space-5), 3vw, var(--mt-space-6));
    border-block-end: 1px solid rgb(247 242 233 / 0.14);
  }

  .maison-footer__augo-header {
    margin-block-end: clamp(var(--mt-space-4), 3vw, var(--mt-space-6));
  }

  .maison-footer__augo-heading {
    margin: 0 0 var(--mt-space-2);
    font-family: var(--mt-type-family-heading);
    font-size: clamp(1.4rem, 1.1rem + 1.2vw, 2.2rem);
    font-weight: 400;
    line-height: 1.15;
    letter-spacing: -0.02em;
  }

  .maison-footer__augo-lede {
    margin: 0;
    max-width: 48ch;
    font-size: var(--mt-type-body);
    color: rgb(247 242 233 / 0.7);
    line-height: 1.5;
  }

  .maison-footer__ai-grid {
    display: grid;
    gap: var(--mt-space-4);
    grid-template-columns: repeat(auto-fill, minmax(18rem, 1fr));
    margin-block: var(--mt-space-5);
  }

  .maison-footer__ai-card {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--mt-space-3);
    padding: var(--mt-space-4);
    background: rgb(247 242 233 / 0.035);
    border: 1px solid rgb(247 242 233 / 0.1);
    border-radius: 4px;
    transition: border-color 0.2s ease, background 0.2s ease;
  }

  .maison-footer__ai-card:hover {
    border-color: rgb(247 242 233 / 0.28);
    background: rgb(247 242 233 / 0.06);
  }

  .maison-footer__ai-header {
    display: flex;
    align-items: center;
    gap: var(--mt-space-3);
  }

  .maison-footer__ai-logo-wrap {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 6px;
    background: rgb(247 242 233 / 0.08);
    color: var(--ai-color, #f7f2e9);
    flex-shrink: 0;
  }

  .maison-footer__ai-logo {
    width: 1.25rem;
    height: 1.25rem;
  }

  .maison-footer__ai-info {
    display: flex;
    flex-direction: column;
    flex-grow: 1;
    min-width: 0;
  }

  .maison-footer__ai-name {
    font-weight: 600;
    font-size: var(--mt-type-body);
    line-height: 1.2;
  }

  .maison-footer__ai-crawler {
    font-family: var(--footer-mono);
    font-size: 0.75rem;
    color: rgb(247 242 233 / 0.55);
  }

  .maison-footer__ai-body {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .maison-footer__ai-prompt-label {
    font-family: var(--footer-mono);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgb(247 242 233 / 0.5);
  }

  .maison-footer__ai-prompt {
    margin: 0;
    font-style: italic;
    font-size: var(--mt-type-body);
    line-height: 1.4;
    color: rgb(247 242 233 / 0.9);
  }

  .maison-footer__ai-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.45rem 0.85rem;
    border: 1px solid rgb(247 242 233 / 0.18);
    border-radius: 3px;
    font-family: var(--footer-mono);
    font-size: var(--mt-type-mono);
    letter-spacing: 0.06em;
    color: var(--ai-color, #f7f2e9);
    background: transparent;
    text-decoration: none;
    transition: background 0.2s ease, border-color 0.2s ease;
    margin-top: auto;
  }

  .maison-footer__ai-btn:hover {
    background: rgb(247 242 233 / 0.1);
    border-color: var(--ai-color, #f7f2e9);
  }

  .maison-footer__augo-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--mt-space-2) var(--mt-space-3);
    font-family: var(--footer-mono);
    font-size: var(--mt-type-mono);
    letter-spacing: 0.08em;
    color: rgb(247 242 233 / 0.6);
    margin-top: var(--mt-space-4);
  }

  .maison-footer__augo-meta-link {
    color: var(--footer-accent);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
{% endstylesheet %}

