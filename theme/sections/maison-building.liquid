{% liquid
  if section.settings.background_color != blank
    render 'contrast-override', background_color: section.settings.background_color, section_id: section.id
  endif
%}

<div
  class="section-background{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
></div>
<div
  class="section section--page-width spacing-style maison-editorial maison-building{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
  style="{% render 'spacing-style', settings: section.settings %}"
  data-maison-reveal-root
>
  <header class="maison-editorial__header maison-building__header" data-maison-reveal>
    {% if section.settings.eyebrow != blank %}
      <p class="maison-editorial__eyebrow">{{ section.settings.eyebrow | escape }}</p>
    {% endif %}
    {% if section.settings.heading != blank %}
      <h1 class="maison-editorial__title">{{ section.settings.heading | escape }}</h1>
    {% endif %}
    {% if section.settings.lede != blank %}
      <p class="maison-editorial__lede">{{ section.settings.lede | escape }}</p>
    {% endif %}
  </header>

  {% if section.blocks.size > 0 %}
    <div class="maison-building__log">
      {% for block in section.blocks %}
        <article
          class="maison-building__entry"
          data-maison-reveal
          style="--maison-reveal-delay: {{ forloop.index0 | times: 60 }}ms"
          {{ block.shopify_attributes }}
        >
          <div class="maison-building__rail" aria-hidden="true"></div>
          <div class="maison-building__meta">
            {% if block.settings.date_label != blank %}
              <p class="maison-editorial__eyebrow">{{ block.settings.date_label | escape }}</p>
            {% endif %}
          </div>
          <div class="maison-building__body">
            {% if block.settings.heading != blank %}
              <h2 class="maison-editorial__card-title">{{ block.settings.heading | escape }}</h2>
            {% endif %}
            {% if block.settings.text != blank %}
              <div class="maison-editorial__rte rte">{{ block.settings.text }}</div>
            {% endif %}
          </div>
        </article>
      {% endfor %}
    </div>
  {% endif %}
</div>

{% stylesheet %}
  .maison-editorial {
    color: var(--color-foreground);
  }

  .maison-editorial__header {
    max-width: 42rem;
    margin-block-end: 3rem;
  }

  .maison-editorial__eyebrow {
    margin: 0;
    font-family: var(--font-heading--family);
    font-size: 0.75rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-foreground-muted);
  }

  .maison-editorial__title {
    margin-block: 0.75rem 1rem;
    font-family: var(--font-fraunces--family, var(--font-heading--family));
    font-weight: var(--font-heading--weight);
    letter-spacing: 0.04em;
    font-variation-settings: 'opsz' 144;
    font-size: clamp(2.25rem, 1.6rem + 2.2vw, 3.5rem);
    line-height: 1.1;
  }

  .maison-editorial__lede {
    margin: 0;
    max-width: 40rem;
    color: var(--color-foreground-muted);
    font-size: 1.125rem;
    line-height: 1.6;
  }

  .maison-editorial__card-title {
    margin: 0 0 0.75rem;
    font-family: var(--font-fraunces--family, var(--font-heading--family));
    font-size: clamp(1.2rem, 1.05rem + 0.5vw, 1.4rem);
    letter-spacing: 0.03em;
    font-variation-settings: 'opsz' 72;
  }

  .maison-editorial__rte,
  .maison-editorial__rte p {
    color: var(--color-foreground-muted);
  }

  .maison-building__log {
    display: grid;
    gap: 0;
    border-block-start: 1px solid var(--color-border);
  }

  .maison-building__entry {
    position: relative;
    display: grid;
    gap: 0.5rem;
    padding-block: 1.85rem;
    padding-inline-start: 1.25rem;
    border-block-end: 1px solid var(--color-border);
  }

  .maison-building__rail {
    position: absolute;
    inset-block: 1.85rem;
    inset-inline-start: 0;
    width: 2px;
    background: var(--brand-color-raw-copper, var(--color-border));
    opacity: 0.55;
  }

  .maison-building__entry .maison-editorial__eyebrow {
    color: var(--brand-color-aged-bronze, var(--color-foreground-muted));
  }

  @media screen and (min-width: 750px) {
    .maison-building__entry {
      grid-template-columns: 8.5rem minmax(0, 1fr);
      column-gap: 2.25rem;
      align-items: start;
      padding-inline-start: 1.5rem;
    }

    .maison-building__meta {
      grid-column: 1;
      padding-block-start: 0.15rem;
    }

    .maison-building__body {
      grid-column: 2;
      max-width: 40rem;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .maison-building [data-maison-reveal] {
      opacity: 0;
      transform: translateY(0.7rem);
      transition:
        opacity 0.7s cubic-bezier(0.16, 1, 0.3, 1),
        transform 0.7s cubic-bezier(0.16, 1, 0.3, 1);
      transition-delay: var(--maison-reveal-delay, 0ms);
    }

    .maison-building [data-maison-reveal].is-revealed {
      opacity: 1;
      transform: none;
    }

    .maison-building__rail {
      transform-origin: top;
      transform: scaleY(0);
      transition: transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
      transition-delay: var(--maison-reveal-delay, 0ms);
    }

    .maison-building__entry.is-revealed .maison-building__rail {
      transform: scaleY(1);
    }
  }
{% endstylesheet %}

{% javascript %}
  (() => {
    const root = document.querySelector('.maison-building[data-maison-reveal-root]');
    if (!root) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    const items = root.querySelectorAll('[data-maison-reveal]');
    if (!items.length || !('IntersectionObserver' in window)) {
      items.forEach((el) => el.classList.add('is-revealed'));
      return;
    }

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          entry.target.classList.add('is-revealed');
          observer.unobserve(entry.target);
        });
      },
      { rootMargin: '0px 0px -6% 0px', threshold: 0.12 }
    );

    items.forEach((el) => observer.observe(el));
  })();
{% endjavascript %}

{% schema %}
{
  "name": "t:names.maison_building",
  "tag": "section",
  "class": "section-wrapper",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:settings.maison_eyebrow",
      "default": "Kitchen"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:settings.heading",
      "default": "Building of"
    },
    {
      "type": "textarea",
      "id": "lede",
      "label": "t:settings.maison_lede",
      "default": "A making-of journal for the house: how hotel F&B and restaurant menus became a product house, and how the storefront is composed. These notes are living copy, sourced from published work."
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 80
    }
  ],
  "blocks": [
    {
      "type": "entry",
      "name": "t:names.maison_journal_entry",
      "settings": [
        {
          "type": "text",
          "id": "date_label",
          "label": "t:settings.maison_date_label",
          "default": "Note 01"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "t:settings.heading",
          "default": "The mixed-revenue kitchen"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "t:settings.content",
          "default": "<p>At Savi, rooms only held after corporate MICE banquets ran morning to evening and walk-in family lunches shared the same kitchen and service spine. Mixed revenue, not a single hero dish.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:names.maison_building",
      "category": "t:categories.storytelling"
    }
  ]
}
{% endschema %}
