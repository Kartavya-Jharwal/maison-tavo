{% liquid
  if section.settings.background_color != blank
    render 'contrast-override', background_color: section.settings.background_color, section_id: section.id
  endif
%}

<div
  class="section-background{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
></div>
<div
  class="section section--page-width spacing-style maison-reading maison-building{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
  style="{% render 'spacing-style', settings: section.settings %}"
>
  <header class="maison-editorial__header" data-mt-scroll="chapter">
    {% if section.settings.eyebrow != blank %}
      <p class="maison-editorial__eyebrow">{{ section.settings.eyebrow | escape }}</p>
    {% endif %}
    {% if section.settings.heading != blank %}
      <h1 class="maison-editorial__title">{{ section.settings.heading | escape }}</h1>
    {% endif %}
    {% if section.settings.lede != blank %}
      <p class="maison-editorial__lede">{{ section.settings.lede | escape }}</p>
    {% endif %}
  </header>

  {% if section.blocks.size > 0 %}
    <div class="maison-building__log">
      {% for block in section.blocks %}
        <article
          class="maison-building__entry"
          data-mt-scroll="chapter"
          {{ block.shopify_attributes }}
        >
          {% if block.settings.date_label != blank %}
            <p class="maison-editorial__eyebrow maison-building__meta">{{ block.settings.date_label | escape }}</p>
          {% endif %}
          {% liquid
            assign editorial_asset = blank
            assign editorial_alt = blank
            case block.settings.editorial_asset
              when 'craft'
                assign editorial_asset = 'maison-clay-potter-craft.webp'
                assign editorial_alt = 'Hands shaping a clay vessel on a potter’s wheel'
                assign editorial_width = 3072
                assign editorial_height = 4096
              when 'handle'
                assign editorial_asset = 'maison-handle-engineering.webp'
                assign editorial_alt = 'Close view of a metal cookware handle'
                assign editorial_width = 493
                assign editorial_height = 493
              when 'pans'
                assign editorial_asset = 'maison-pan-stacked-showcase.webp'
                assign editorial_alt = 'Well-used pans stacked beside a kitchen stove'
                assign editorial_width = 1080
                assign editorial_height = 1350
            endcase
          %}
          <div class="maison-building__main{% if editorial_asset != blank %} maison-building__main--illustrated{% endif %}">
            <div class="maison-building__body">
              {% if block.settings.heading != blank %}
                <h2 class="maison-editorial__card-title">{{ block.settings.heading | escape }}</h2>
              {% endif %}
              {% if block.settings.text != blank %}
                <div class="maison-editorial__rte rte">{{ block.settings.text }}</div>
              {% endif %}
            </div>
            {% if editorial_asset != blank %}
              <figure class="maison-building__image-wrap">
                <img src="{{ editorial_asset | asset_url }}" alt="{{ editorial_alt | escape }}" width="{{ editorial_width }}" height="{{ editorial_height }}" loading="lazy" decoding="async">
              </figure>
            {% endif %}
          </div>
        </article>
      {% endfor %}
    </div>
  {% endif %}
  {% if page.handle == 'building' %}
    <aside class="maison-building__care">
      <h2 class="maison-editorial__card-title">Keep the pan in use</h2>
      <p>Learn how to season, clean and store your pieces in the <a href="/pages/care">cookware care guide</a>.</p>
      {% form 'customer', id: 'MaisonBuildingSignup', class: 'maison-building__signup' %}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <label for="MaisonBuildingEmail">Email for future care notes and release updates</label>
        <input type="email" name="contact[email]" id="MaisonBuildingEmail" autocomplete="email" value="{{ form.email | escape }}" required {% if form.errors contains 'email' %}aria-invalid="true" aria-describedby="MaisonBuildingError"{% endif %} {% if form.errors %}autofocus{% endif %}>
        <button type="submit" class="button">Subscribe</button>
        {% if form.posted_successfully? %}
          <p data-mt-newsletter-success role="status" tabindex="-1" autofocus>You're on the list.</p>
        {% elsif form.errors %}
          <div id="MaisonBuildingError" role="alert">{{ form.errors | default_errors }}</div>
        {% endif %}
      {% endform %}
    </aside>
  {% endif %}
</div>

{% stylesheet %}
  .maison-building__care {
    max-inline-size: var(--maison-reading-measure);
    margin-block-start: var(--maison-reading-gap);
  }

  .maison-building__signup {
    display: flex;
    flex-wrap: wrap;
    gap: var(--mt-space-xs);
  }

  .maison-building__signup label { flex-basis: 100%; }
  .maison-building__signup input[type='email'] {
    flex: 1 1 15rem;
    min-inline-size: 0;
    min-block-size: var(--minimum-touch-target);
    padding: var(--mt-space-xs);
    border: 1px solid var(--color-foreground);
    border-radius: var(--style-border-radius-inputs);
    background: var(--color-background);
    color: var(--color-foreground);
    font: inherit;
  }

  .maison-building__log {
    border-block-start: 1px solid var(--color-border);
  }

  .maison-building__entry {
    display: grid;
    gap: 0.5rem var(--maison-reading-gap);
    padding-block: var(--maison-reading-gap);
    border-block-end: 1px solid var(--color-border);
  }

  .maison-building__main--illustrated {
    display: grid;
    gap: clamp(1rem, 3vw, 2.5rem);
  }

  .maison-building__image-wrap { margin: 0; }
  .maison-building__image-wrap img {
    display: block;
    width: 100%;
    height: auto;
    max-height: 28rem;
    object-fit: cover;
  }

  @media (min-width: 48rem) {
    .maison-building__main--illustrated {
      grid-template-columns: minmax(0, 1fr) minmax(12rem, 0.72fr);
      align-items: start;
    }
  }

  @media (min-width: 56rem) {
    .maison-building__entry {
      grid-template-columns: minmax(7rem, 1fr) minmax(0, 4fr);
      align-items: start;
    }

    .maison-building__meta {
      padding-block-start: 0.38rem;
    }

    .maison-building__main {
      grid-column: 2;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.maison_building",
  "tag": "section",
  "class": "section-wrapper",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:settings.maison_eyebrow",
      "default": "Kitchen"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:settings.heading",
      "default": "Building of"
    },
    {
      "type": "textarea",
      "id": "lede",
      "label": "t:settings.maison_lede",
      "default": "A making-of journal for the house: how hotel F&B and restaurant menus became a product house, and how the storefront is composed. These notes are living copy, sourced from published work."
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 80
    }
  ],
  "blocks": [
    {
      "type": "entry",
      "name": "t:names.maison_journal_entry",
      "settings": [
        {
          "type": "text",
          "id": "date_label",
          "label": "t:settings.maison_date_label",
          "default": "Note 01"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "t:settings.heading",
          "default": "The mixed-revenue kitchen"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "t:settings.content",
          "default": "<p>At Savi, rooms only held after corporate MICE banquets ran morning to evening and walk-in family lunches shared the same kitchen and service spine. Mixed revenue, not a single hero dish.</p>"
        },
        {
          "type": "select",
          "id": "editorial_asset",
          "label": "Editorial image from theme assets",
          "options": [
            { "value": "none", "label": "None" },
            { "value": "craft", "label": "Clay craft" },
            { "value": "handle", "label": "Handle detail" },
            { "value": "pans", "label": "Working kitchen pans" }
          ],
          "default": "none"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:names.maison_building",
      "category": "t:categories.storytelling"
    }
  ]
}
{% endschema %}
