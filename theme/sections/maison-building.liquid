{% liquid
  if section.settings.background_color != blank
    render 'contrast-override', background_color: section.settings.background_color, section_id: section.id
  endif
%}

<div
  class="section-background{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
></div>
<div
  class="section section--page-width spacing-style maison-editorial maison-building{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
  style="{% render 'spacing-style', settings: section.settings %}"
>
  <header class="maison-editorial__header">
    {% if section.settings.eyebrow != blank %}
      <p class="maison-editorial__eyebrow">{{ section.settings.eyebrow | escape }}</p>
    {% endif %}
    {% if section.settings.heading != blank %}
      <h1 class="maison-editorial__title">{{ section.settings.heading | escape }}</h1>
    {% endif %}
    {% if section.settings.lede != blank %}
      <p class="maison-editorial__lede">{{ section.settings.lede | escape }}</p>
    {% endif %}
  </header>

  {% if section.blocks.size > 0 %}
    <div class="maison-building__log">
      {% for block in section.blocks %}
        <article
          class="maison-building__entry"
          {{ block.shopify_attributes }}
        >
          {% if block.settings.date_label != blank %}
            <p class="maison-editorial__eyebrow">{{ block.settings.date_label | escape }}</p>
          {% endif %}
          {% if block.settings.heading != blank %}
            <h2 class="maison-editorial__card-title">{{ block.settings.heading | escape }}</h2>
          {% endif %}
          {% if block.settings.text != blank %}
            <div class="maison-editorial__rte rte">{{ block.settings.text }}</div>
          {% endif %}
        </article>
      {% endfor %}
    </div>
  {% endif %}
</div>

{% stylesheet %}
  .maison-editorial {
    color: var(--color-foreground);
  }

  .maison-editorial__header {
    max-width: 42rem;
    margin-block-end: 3rem;
  }

  .maison-editorial__eyebrow {
    margin: 0;
    font-family: var(--font-heading--family);
    font-size: 0.75rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-foreground-muted);
  }

  .maison-editorial__title {
    margin-block: 0.75rem 1rem;
    font-family: var(--font-heading--family);
    font-weight: var(--font-heading--weight);
    letter-spacing: 0.04em;
  }

  .maison-editorial__lede {
    margin: 0;
    max-width: 40rem;
    color: var(--color-foreground-muted);
    font-size: 1.125rem;
    line-height: 1.6;
  }

  .maison-editorial__card-title {
    margin: 0 0 0.75rem;
    font-family: var(--font-heading--family);
    font-size: 1.125rem;
    letter-spacing: 0.03em;
  }

  .maison-editorial__rte,
  .maison-editorial__rte p {
    color: var(--color-foreground-muted);
  }

  .maison-building__log {
    display: grid;
    gap: 0;
    border-block-start: 1px solid var(--color-border);
  }

  .maison-building__entry {
    display: grid;
    gap: 0.35rem;
    padding-block: 1.75rem;
    border-block-end: 1px solid var(--color-border);
  }

  @media screen and (min-width: 750px) {
    .maison-building__entry {
      grid-template-columns: 8rem minmax(0, 1fr);
      column-gap: 2rem;
      align-items: start;
    }

    .maison-building__entry .maison-editorial__card-title,
    .maison-building__entry .maison-editorial__rte {
      grid-column: 2;
    }

    .maison-building__entry .maison-editorial__eyebrow {
      grid-row: 1 / span 2;
      padding-block-start: 0.2rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.maison_building",
  "tag": "section",
  "class": "section-wrapper",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:settings.maison_eyebrow",
      "default": "Kitchen"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:settings.heading",
      "default": "Building of"
    },
    {
      "type": "textarea",
      "id": "lede",
      "label": "t:settings.maison_lede",
      "default": "A making-of journal for the house: how hotel F&B and restaurant menus became a product house, and how the storefront is composed. These notes are living copy, sourced from published work."
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 80
    }
  ],
  "blocks": [
    {
      "type": "entry",
      "name": "t:names.maison_journal_entry",
      "settings": [
        {
          "type": "text",
          "id": "date_label",
          "label": "t:settings.maison_date_label",
          "default": "Note 01"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "t:settings.heading",
          "default": "The mixed-revenue kitchen"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "t:settings.content",
          "default": "<p>At Savi, rooms only held after corporate MICE banquets ran morning to evening and walk-in family lunches shared the same kitchen and service spine. Mixed revenue, not a single hero dish.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:names.maison_building",
      "category": "t:categories.storytelling"
    }
  ]
}
{% endschema %}
