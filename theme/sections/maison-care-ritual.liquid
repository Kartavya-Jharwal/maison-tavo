    letter-spacing: 0.06em;
    color: var(--color-foreground-muted);
    border-top: 1px solid var(--color-border, rgba(110, 90, 61, 0.15));
  }

  /* ── Rites list ──────────────────────────────────────── */
  .maison-ritual-v7__rites {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0;
  }

  .ritual-rite {
    display: grid;
    grid-template-columns: 5rem 1fr;
    gap: 2rem;
    padding: 2.25rem 1.25rem;
    border-bottom: 1px solid var(--color-border, rgba(26,23,20,0.08));
