    box-shadow: var(--glass-shadow, 0 10px 35px rgba(20, 17, 15, 0.08));
  }

  /* Stagger each rite */
  .ritual-rite[data-rite="1"] { animation-delay: 0.05s; }
  .ritual-rite[data-rite="2"] { animation-delay: 0.12s; }
