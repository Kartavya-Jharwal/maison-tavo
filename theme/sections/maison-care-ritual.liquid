  }

  .kuro-pill {
    font-family: var(--mt-type-family-mono);
    font-size: var(--mt-type-mono);
    font-weight: 700;
    letter-spacing: 0.12em;
    padding: 0.2rem 0.45rem;
    background: var(--ritual-silver, #9A9B9E);
    color: var(--ritual-ink, #1A1714);
    border-radius: 2px;
    white-space: nowrap;
    flex-shrink: 0;
    margin-top: 0.1rem;
  }

  /* ── Covenant footer ─────────────────────────────────── */
  .maison-ritual-v7__covenant {
    margin-block-start: 4rem;
    padding-block-start: 2.5rem;
    border-block-start: 1px solid var(--color-border, rgba(26,23,20,0.1));
  }

  .covenant__rule {
    width: 3rem;
    height: 2px;
    background: var(--ritual-metal-accent);
    margin-block-end: 1.5rem;
  }

  .covenant__copy {
    font-size: var(--mt-type-body);
    line-height: 1.65;
    color: var(--color-foreground-muted, rgba(26,23,20,0.7));
    max-width: 55ch;
    margin: 0 0 1.5rem;
  }

  .covenant__copy strong {
    color: var(--color-foreground);
    font-weight: 600;
  }

  .covenant__links {
    display: flex;
    gap: 2rem;
    flex-wrap: wrap;
  }

  .covenant-link {
    font-family: var(--mt-type-family-mono);
    font-size: var(--mt-type-accent);
    letter-spacing: var(--mt-type-tracking-accent);
    text-transform: uppercase;
    color: var(--ritual-metal-accent);
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: border-color 0.2s ease;
  }

  .covenant-link:hover {
    border-bottom-color: var(--ritual-metal-accent);
  }

  /* ── Responsive ──────────────────────────────────────── */
  @media (max-width: 749px) {
    .ritual-rite {
      grid-template-columns: 3.5rem 1fr;
      gap: 1rem;
    }

    .ritual-rite__numeral {
      font-size: var(--mt-type-heading);
    }

    .spec-dl__row {
      grid-template-columns: 4rem 1fr;
    }

    .maison-ritual-v7__tab {
      padding-inline-end: 1rem;
    }

    .tab-sub {
      display: none;
    }

    .ritual-rite__kuro-note {
      flex-direction: column;
    }
  }

  @media (max-width: 479px) {
    .ritual-rite {
      grid-template-columns: 1fr;
    }

    .ritual-rite__num-col {
      flex-direction: row;
      align-items: center;
    }

    .ritual-rite__connector {
      display: none;
    }
  }
{% endstylesheet %}

