    max-width: 54rem;
    margin-block-end: 3rem;
  }

  .maison-ritual-v7__kicker-row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-block-end: 1rem;
    flex-wrap: wrap;
  }

  .maison-ritual-v7__badge {
    font-family: var(--mt-type-family-mono);
    font-size: var(--mt-type-mono);
    letter-spacing: 0.14em;
    padding: 0.22rem 0.6rem;
    background: var(--ritual-metal-accent);
    color: var(--ritual-canvas);
    font-weight: 700;
    border-radius: 2px;
  }

  .maison-ritual-v7__kicker {
    font-family: var(--mt-type-family-mono);
    font-size: var(--mt-type-mono);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ritual-silver);
  }

  .maison-ritual-v7__title {
    margin: 0 0 0.75rem;
    font-family: var(--mt-type-family-heading);
    font-size: var(--mt-type-display);
    font-weight: var(--font-heading--weight, 400);
    line-height: 1.08;
    letter-spacing: -0.01em;
    color: var(--color-foreground);
  }

  .maison-ritual-v7__lede {
    margin: 0;
    font-size: var(--mt-type-body);
    line-height: 1.65;
    color: var(--color-foreground-muted, rgba(26,23,20,0.7));
