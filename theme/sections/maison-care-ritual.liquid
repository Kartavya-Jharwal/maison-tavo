{%- comment -%} ── Tab interaction script ───────────────────────────────── {%- endcomment -%}
<script>
(function () {
  var section = document.querySelector('[data-section-id="{{ section.id }}"]');
  if (!section) return;

  var tabs = section.querySelectorAll('.maison-ritual-v7__tab');
  var tracks = section.querySelectorAll('.maison-ritual-v7__track');
  var rites = section.querySelectorAll('.ritual-rite');

  // --- Tab switch ---
  tabs.forEach(function (tab) {
    tab.addEventListener('click', function () {
      var target = tab.dataset.track;

      tabs.forEach(function (t) {
        t.classList.remove('is-active');
        t.setAttribute('aria-selected', 'false');
      });
      tab.classList.add('is-active');
      tab.setAttribute('aria-selected', 'true');

      tracks.forEach(function (track) {
        if (track.id === 'ritual-track-' + target) {
          track.classList.add('is-active');
          track.removeAttribute('hidden');
          // Stagger-animate rites in view
          if (window.MaisonRuntime && window.MaisonRuntime.animate) {
            var activeRites = track.querySelectorAll('.ritual-rite');
            activeRites.forEach(function (rite, i) {
              rite.style.opacity = '0';
              rite.style.transform = 'translateY(1.2rem)';
              window.setTimeout(function () {
                window.MaisonRuntime.animate(
                  rite,
                  { opacity: [0, 1], transform: ['translateY(1.2rem)', 'none'] },
                  { duration: 0.4, easing: [0.16, 1, 0.3, 1] }
                );
              }, i * 60);
            });
          }
        } else {
          track.classList.remove('is-active');
          track.setAttribute('hidden', '');
        }
      });
    });
  });

  // --- inView stagger on page load ---
  if (window.MaisonRuntime && window.MaisonRuntime.inView) {
    window.MaisonRuntime.inView(
      '[data-ritual-track="metal"] .ritual-rite',
      function (el) {
        window.MaisonRuntime.animate(
          el,
          { opacity: [0, 1], transform: ['translateX(-1rem)', 'none'] },
          { duration: 0.5, easing: [0.16, 1, 0.3, 1] }
        );
      },
      { amount: 0.15 }
    );
  }

  // Activate track from ?track=metal|clay (Kansa handoff)
  try {
    var params = new URLSearchParams(window.location.search);
    var trackParam = params.get('track');
    if (trackParam === 'metal' || trackParam === 'clay') {
      var targetTab = section.querySelector('.maison-ritual-v7__tab[data-track="' + trackParam + '"]');
      if (targetTab && !targetTab.classList.contains('is-active')) {
        targetTab.click();
      }
    }
  } catch (e) {}
})();
</script>

{% stylesheet %}
  /* ── Root overrides ─────────────────────────────────── */
  .maison-ritual-v7 {
    padding-block: clamp(4rem, 7vw, 7rem) clamp(5rem, 9vw, 9rem);
    border-block-start: 1px solid var(--color-border, rgba(26,23,20,0.12));
    --ritual-metal-accent: var(--brand-color-raw-copper, #C4784A);
    --ritual-clay-accent:  var(--brand-color-aged-bronze, #6E5A3D);
    --ritual-ink:          var(--brand-color-obsidian-charcoal, #1A1714);
    --ritual-canvas:       var(--brand-color-cast-clay, #E8DFD4);
    --ritual-silver:       var(--brand-color-damascus-silver, #9A9B9E);
