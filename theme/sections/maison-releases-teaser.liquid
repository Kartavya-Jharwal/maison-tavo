{% comment %}
  Homepage / room teaser for release cycles.
  The preview opens from its button.
{% endcomment %}

{% liquid
  assign cycle_name = section.settings.cycle_name | default: 'Current heat'
  assign cycle_window = section.settings.cycle_window
  assign teaser_collection = section.settings.collection
  assign teaser_products = section.settings.products
  assign releases_url = section.settings.releases_url | default: '/pages/releases'
%}

<div
  class="section section--page-width spacing-style maison-releases-teaser"
  style="{% render 'spacing-style', settings: section.settings %}"
  data-mt-release-teaser
>
  <div class="maison-releases-teaser__inner">
    <div class="maison-releases-teaser__copy">
      {% if section.settings.eyebrow != blank %}
        <p class="maison-releases-teaser__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {% endif %}
      <h2 class="maison-releases-teaser__title">{{ section.settings.heading | escape }}</h2>
      {% if section.settings.lede != blank %}
        <p class="maison-releases-teaser__lede">{{ section.settings.lede | escape }}</p>
      {% endif %}
      {% if cycle_window != blank %}
        <p class="maison-releases-teaser__window">
          <span>{{ cycle_name | escape }}</span>
          <span aria-hidden="true"> · </span>
          <span>{{ cycle_window | escape }}</span>
        </p>
      {% endif %}
      <p class="maison-releases-teaser__actions">
        <a class="button" href="{{ releases_url }}">{{ section.settings.cta_label | default: 'View releases' | escape }}</a>
        {% if section.settings.enable_drawer %}
          <button
            type="button"
            class="button button-secondary"
            data-mt-release-open
            aria-haspopup="dialog"
          >
            {{ section.settings.drawer_label | default: 'Preview this heat' | escape }}
          </button>
        {% endif %}
        {% if section.settings.show_mail_link %}
          <a href="/pages/mail">Get cycle notices</a>
        {% endif %}
      </p>
    </div>

    {% if teaser_products != blank and teaser_products.size > 0 %}
      <ul class="maison-releases-teaser__strip" role="list">
        {% for product in teaser_products limit: 3 %}
          <li>
            <a class="maison-releases-teaser__card" href="{{ product.url }}">
              {% if product.featured_image %}
                {% assign image_alt = product.featured_image.alt | default: product.title %}
                {{
                  product.featured_image
                  | image_url: width: 600
                  | image_tag:
                    widths: '240, 360, 480, 600',
                    sizes: '(min-width: 750px) 12vw, 33vw',
                    alt: image_alt,
                    loading: 'lazy'
                }}
              {% endif %}
              <span>{{ product.title | escape }}</span>
            </a>
          </li>
        {% endfor %}
      </ul>
    {% elsif teaser_collection != blank %}
      <ul class="maison-releases-teaser__strip" role="list">
        {% for product in teaser_collection.products limit: 3 %}
          <li>
            <a class="maison-releases-teaser__card" href="{{ product.url }}">
              {% if product.featured_image %}
                {% assign image_alt = product.featured_image.alt | default: product.title %}
                {{
                  product.featured_image
                  | image_url: width: 600
                  | image_tag:
                    widths: '240, 360, 480, 600',
                    sizes: '(min-width: 750px) 12vw, 33vw',
                    alt: image_alt,
                    loading: 'lazy'
                }}
              {% endif %}
              <span>{{ product.title | escape }}</span>
            </a>
          </li>
        {% endfor %}
      </ul>
    {% endif %}
  </div>

  <dialog
    class="maison-releases-teaser__dialog"
    id="MaisonReleaseDialog-{{ section.id }}"
    data-mt-release-dialog
    aria-labelledby="MaisonReleaseDialogTitle-{{ section.id }}"
  >
    <div class="maison-releases-teaser__dialog-panel">
      <p class="maison-releases-teaser__eyebrow">Release cycle</p>
      <h2 id="MaisonReleaseDialogTitle-{{ section.id }}">{{ cycle_name | escape }}</h2>
      {% if cycle_window != blank %}
        <p class="maison-releases-teaser__window">{{ cycle_window | escape }}</p>
      {% endif %}
      {% if section.settings.popup_copy != blank %}
        <p>{{ section.settings.popup_copy | escape }}</p>
      {% endif %}
      <p class="maison-releases-teaser__actions">
        <a class="button" href="{{ releases_url }}" data-mt-release-dismiss>Shop this cycle</a>
        {% if teaser_collection != blank %}
          <a href="{{ teaser_collection.url }}" data-mt-release-dismiss>Open collection</a>
        {% endif %}
        <button type="button" class="button button-secondary" data-mt-release-dismiss>
          Not now
        </button>
      </p>
    </div>
  </dialog>
</div>

{% javascript %}
  (() => {
    const root = document.querySelector('[data-mt-release-teaser]');
    if (!root || root.dataset.bound === 'true') return;
    root.dataset.bound = 'true';

    const dialog = root.querySelector('[data-mt-release-dialog]');
    const openDialog = () => {
      if (!dialog || dialog.open) return;
      if (typeof dialog.showModal === 'function') {
        dialog.showModal();
      } else {
        dialog.setAttribute('open', '');
      }
    };

    const closeDialog = () => {
      if (!dialog) return;
      if (typeof dialog.close === 'function') {
        dialog.close();
      } else {
        dialog.removeAttribute('open');
      }
    };

    root.querySelectorAll('[data-mt-release-open]').forEach((btn) => {
      btn.addEventListener('click', () => openDialog());
    });

    root.querySelectorAll('[data-mt-release-dismiss]').forEach((el) => {
      el.addEventListener('click', () => closeDialog());
    });

    if (dialog) {
      dialog.addEventListener('cancel', (event) => {
        event.preventDefault();
        closeDialog();
      });
      dialog.addEventListener('click', (event) => {
        if (event.target === dialog) closeDialog();
      });
    }

  })();
{% endjavascript %}

{% stylesheet %}
  .maison-releases-teaser__inner {
    display: grid;
    gap: 1.75rem;
  }

  @media screen and (min-width: 990px) {
    .maison-releases-teaser__inner {
      grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
      align-items: end;
      gap: 2.5rem;
    }
  }

  .maison-releases-teaser__eyebrow,
  .maison-releases-teaser__window {
    margin: 0;
    font-family: var(--mt-type-family-mono);
    font-size: var(--mt-type-accent);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-foreground-muted, rgb(var(--color-foreground-rgb) / 0.65));
  }

  .maison-releases-teaser__title {
    margin: 0.4rem 0 0.75rem;
    font-family: var(--mt-type-family-heading);
    font-size: var(--mt-type-title, clamp(1.75rem, 3vw, 2.5rem));
    font-weight: 400;
    line-height: 1.1;
  }

  .maison-releases-teaser__lede {
    margin: 0 0 1rem;
    max-width: 36rem;
    color: var(--color-foreground-muted, rgb(var(--color-foreground-rgb) / 0.75));
  }

  .maison-releases-teaser__window {
    margin-block-end: 1rem;
  }

  .maison-releases-teaser__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.25rem;
    align-items: center;
    margin: 0;
  }

  .maison-releases-teaser__actions a:not(.button) {
    color: inherit;
  }

  .maison-releases-teaser__strip {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .maison-releases-teaser__card {
    display: grid;
    gap: 0.35rem;
    color: inherit;
    text-decoration: none;
    font-size: 0.875rem;
  }

  .maison-releases-teaser__card img {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
  }

  .maison-releases-teaser__card:focus-visible {
    outline: 2px solid var(--color-foreground);
    outline-offset: 3px;
  }

  .maison-releases-teaser__dialog {
    max-width: min(28rem, calc(100vw - 2rem));
    padding: 0;
    border: 1px solid rgb(var(--color-foreground-rgb) / 0.18);
    background: var(--color-background);
    color: var(--color-foreground);
  }

  .maison-releases-teaser__dialog::backdrop {
    background: rgb(0 0 0 / 0.45);
  }

  .maison-releases-teaser__dialog-panel {
    display: grid;
    gap: 0.75rem;
    padding: clamp(1.25rem, 3vw, 1.75rem);
  }

  .maison-releases-teaser__dialog-panel h2 {
    margin: 0;
    font-family: var(--mt-type-family-heading);
    font-weight: 400;
    font-size: var(--mt-type-title, 1.75rem);
  }

  @media (prefers-reduced-motion: reduce) {
    .maison-releases-teaser__dialog {
      transition: none;
    }
  }

  html[data-reduced-motion='true'] .maison-releases-teaser__dialog {
    transition: none;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.maison_releases_teaser",
  "tag": "section",
  "class": "section-wrapper",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:settings.maison_eyebrow",
      "default": "Release cycle"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:settings.heading",
      "default": "Inventory opens in heats"
    },
    {
      "type": "textarea",
      "id": "lede",
      "label": "Introduction",
      "default": "Maison does not keep a perpetual new-arrivals rail. Pieces enter through timed release cycles — then the window closes."
    },
    {
      "type": "text",
      "id": "cycle_name",
      "label": "Current cycle name",
      "default": "Current heat"
    },
    {
      "type": "text",
      "id": "cycle_window",
      "label": "Current cycle window",
      "default": "Allocation open while stock lasts"
    },
    {
      "type": "text",
      "id": "releases_url",
      "label": "Releases page URL",
      "default": "/pages/releases"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Primary CTA label",
      "default": "View releases"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "t:settings.collection"
    },
    {
      "type": "product_list",
      "id": "products",
      "label": "Featured cycle products",
      "limit": 3
    },
    {
      "type": "checkbox",
      "id": "show_mail_link",
      "label": "Show mail page link",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_drawer",
      "label": "Show preview dialog button",
      "default": true
    },
    {
      "type": "text",
      "id": "drawer_label",
      "label": "Preview button label",
      "default": "Preview this heat"
    },
    {
      "type": "textarea",
      "id": "popup_copy",
      "label": "Popup copy",
      "default": "A limited allocation is open. Browse real product pages — checkout stays Shopify-native."
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 48
    }
  ],
  "presets": [
    {
      "name": "t:names.maison_releases_teaser",
      "category": "t:categories.collection"
    }
  ]
}
{% endschema %}
