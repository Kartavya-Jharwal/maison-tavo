{% javascript %}
  (function () {
    // ── Clock
    var clock = document.getElementById('mt-tui-clock');
    var ts = document.getElementById('mt-tui-ts');
    function pad(n) { return String(n).padStart(2, '0'); }
    function tick() {
      var d = new Date();
      var str = pad(d.getUTCHours()) + ':' + pad(d.getUTCMinutes()) + ':' + pad(d.getUTCSeconds()) + ' UTC';
      if (clock) clock.textContent = str;
      if (ts) ts.textContent = pad(d.getHours()) + ':' + pad(d.getMinutes()) + ':' + pad(d.getSeconds());
    }
    tick();
    setInterval(tick, 1000);

    // ── Ping animation
    var ping = document.getElementById('mt-tui-ping');
    if (ping) {
      setInterval(function () {
        var ms = Math.floor(Math.random() * 18 + 8);
        ping.textContent = 'PING ' + ms + 'ms';
      }, 4000);
    }

    // ── Tabs
    var URLS = {
      wellknown: { method: 'GET', url: 'https://maison-tavo.myshopify.com/.well-known/ucp', status: '200 OK' },
      catalog:   { method: 'POST', url: 'https://maison-tavo.myshopify.com/api/ucp/mcp', status: '200 OK' },
      a2a:       { method: 'POST', url: 'https://maison-tavo.myshopify.com/a2a/agent-broker', status: '200 OK' },
      molbhav:   { method: 'POST', url: 'https://maison-tavo.myshopify.com/a2a/mol-bhav-trace.json', status: '200 OK' },
      augo:      { method: 'GET',  url: 'https://maison-tavo.myshopify.com/pages/agents.json', status: '200 OK' },
    };
    var methodEl = document.getElementById('mt-tui-method');
    var urlEl = document.getElementById('mt-tui-url');
    var statusEl = document.getElementById('mt-tui-status');
    var tabs = document.querySelectorAll('.mt-tui__tab');
    var panels = document.querySelectorAll('.mt-tui__panel');

    tabs.forEach(function (tab) {
      tab.addEventListener('click', function () {
        var id = tab.dataset.tuiTab;
        tabs.forEach(function (t) {
          t.classList.remove('is-active');
          t.setAttribute('aria-selected', 'false');
        });
        panels.forEach(function (p) {
          p.classList.remove('is-active');
          p.hidden = true;
        });
        tab.classList.add('is-active');
        tab.setAttribute('aria-selected', 'true');
        var panel = document.getElementById('tui-panel-' + id);
        if (panel) { panel.classList.add('is-active'); panel.hidden = false; }
        var info = URLS[id] || {};
        if (methodEl) methodEl.textContent = info.method || 'GET';
        if (urlEl) urlEl.textContent = info.url || '';
        if (statusEl) statusEl.textContent = info.status || '200 OK';
      });
    });

    // ── Copy
    var copyBtn = document.getElementById('mt-tui-copy');
    if (copyBtn) {
      copyBtn.addEventListener('click', function () {
        var active = document.querySelector('.mt-tui__panel.is-active code');
        if (!active) return;
        navigator.clipboard && navigator.clipboard.writeText(active.textContent || '').then(function () {
          copyBtn.textContent = '[ copied! ]';
          setTimeout(function () { copyBtn.textContent = '[ copy ]'; }, 1800);
        });
      });
    }

    // ── Streaming log entries
    var log = document.getElementById('mt-tui-log');
    var logMessages = [
      { type: 'info', text: 'Agent handshake validated — UCP schema 2026-08-25' },
      { type: 'ok', text: 'Catalog MCP endpoint responding — 25 deterministic SKUs' },
      { type: 'ok', text: 'AUGO manifest served to GPTBot crawl index' },
      { type: 'info', text: 'A2A session opened: urn:buyer-agent:client-77a' },
      { type: 'ok', text: 'Kansa companion inference: flaxseed_oil → beeswax_lipid_blend' },
      { type: 'info', text: 'MolBhav 7-agent bazaar initialized — round 1 of 4' },
      { type: 'ok', text: 'Settlement accepted: EUR 5990.00 · escrow 0x7822c58b' },
      { type: 'ok', text: 'Foundry allocation HEAT-2026-NOV-24 confirmed' },
    ];
    var logIdx = 0;
    function appendLog() {
      if (!log || logIdx >= logMessages.length) return;
      var msg = logMessages[logIdx++];
      var d = new Date();
      var timeStr = pad(d.getHours()) + ':' + pad(d.getMinutes()) + ':' + pad(d.getSeconds());
      var line = document.createElement('div');
      line.className = 'mt-tui__log-line';
      line.innerHTML = '<span class="mt-tui__log-ts">' + timeStr + '</span> '
        + '<span class="mt-tui__log-' + (msg.type === 'ok' ? 'ok' : 'info') + '">'
        + (msg.type === 'ok' ? '●' : '◈') + '</span> '
        + msg.text;
      var cursor = log.querySelector('.mt-tui__log-cursor');
      if (cursor) { log.insertBefore(line, cursor); } else { log.appendChild(line); }
      log.scrollTop = log.scrollHeight;
    }
    setTimeout(function () {
      var int = setInterval(function () {
        appendLog();
        if (logIdx >= logMessages.length) clearInterval(int);
      }, 2800);
    }, 2000);
  })();
{% endjavascript %}

