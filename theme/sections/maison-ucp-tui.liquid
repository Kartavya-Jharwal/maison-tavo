{% comment %}
  Maison Tavo · UCP Agent Terminal Interface (TUI)
  Full-page fake-API / machine-readable endpoint surface.
  Rendered on the /pages/ucp template as a standalone layout.
  Navigation: hidden. Return button (top-left). No standard header/footer.
  ASCII footer replaces the standard Maison footer.
{% endcomment %}

<div class="mt-tui" id="mt-tui-root" data-mt-tui aria-label="Maison Tavo UCP Agent Interface">

  {%- comment -%} ── Top chrome bar ── {%- endcomment -%}
  <div class="mt-tui__chrome" role="banner">
    <a href="{{ shop.url }}" class="mt-tui__return" aria-label="Return to storefront">
      <span class="mt-tui__return-arrow" aria-hidden="true">←</span>
      <span class="mt-tui__return-label">/ return</span>
    </a>
    <div class="mt-tui__chrome-center" aria-hidden="true">
      <span class="mt-tui__chrome-title">maison-tavo.myshopify.com</span>
      <span class="mt-tui__chrome-sep">·</span>
      <span class="mt-tui__status-dot"></span>
      <span class="mt-tui__chrome-status">UCP/2026 ENDPOINT LIVE</span>
    </div>
    <div class="mt-tui__clock" id="mt-tui-clock" aria-live="off" aria-atomic="true"></div>
  </div>

  {%- comment -%} ── Main content split: left panel + globe ── {%- endcomment -%}
  <main class="mt-tui__main" id="MainContent" data-template="page">
    {%- comment -%} ── Globe column ── {%- endcomment -%}
    <div class="mt-tui__globe-col" aria-hidden="true">
      <div class="mt-tui__globe-frame">
        <svg class="mt-tui__globe-wireframe" viewBox="0 0 100 100" aria-hidden="true">
          <circle cx="50" cy="50" r="46" fill="none" stroke="rgba(184, 137, 58, 0.4)" stroke-width="1"/>
          <ellipse cx="50" cy="50" rx="46" ry="16" fill="none" stroke="rgba(184, 137, 58, 0.3)" stroke-width="0.8"/>
          <ellipse cx="50" cy="50" rx="46" ry="32" fill="none" stroke="rgba(184, 137, 58, 0.3)" stroke-width="0.8"/>
          <ellipse cx="50" cy="50" rx="16" ry="46" fill="none" stroke="rgba(184, 137, 58, 0.35)" stroke-width="0.8" class="mt-tui__lon-ring"/>
          <ellipse cx="50" cy="50" rx="32" ry="46" fill="none" stroke="rgba(184, 137, 58, 0.35)" stroke-width="0.8" class="mt-tui__lon-ring-2"/>
          <line x1="4" y1="50" x2="96" y2="50" stroke="rgba(184, 137, 58, 0.4)" stroke-width="0.8" stroke-dasharray="2 2"/>
          <line x1="50" y1="4" x2="50" y2="96" stroke="rgba(184, 137, 58, 0.4)" stroke-width="0.8" stroke-dasharray="2 2"/>
          <circle cx="68" cy="42" r="2.5" fill="#6fbc7a" class="mt-tui__node-dot"/>
          <circle cx="68" cy="42" r="5" fill="none" stroke="#6fbc7a" stroke-width="0.6" class="mt-tui__node-pulse"/>
        </svg>
        <div class="mt-tui__globe-overlay">
          <div class="mt-tui__globe-scanline"></div>
        </div>
      </div>
      <div class="mt-tui__globe-meta">
        <span>NODE: RAJASTHAN-01</span>
        <span class="mt-tui__globe-ping" id="mt-tui-ping">PING 12ms</span>
      </div>
    </div>

    {%- comment -%} ── Terminal panel ── {%- endcomment -%}
    <div class="mt-tui__terminal" role="region" aria-label="API endpoint explorer">
      <div class="mt-tui__term-header">
        <div class="mt-tui__term-dots" aria-hidden="true">
          <span></span><span></span><span></span>
        </div>
        <span class="mt-tui__term-title">ucp-agent-shell — maison-tavo v2026.08.25</span>
        <div class="mt-tui__term-actions">
          <button class="mt-tui__copy-btn" id="mt-tui-copy" type="button" title="Copy active payload">[ copy ]</button>
        </div>
      </div>

      {%- comment -%} ── Endpoint tabs ── {%- endcomment -%}
      <div class="mt-tui__tabs" role="tablist" aria-label="API endpoints">
        <button class="mt-tui__tab is-active" role="tab" aria-selected="true" data-tui-tab="wellknown">
          GET /.well-known/ucp
        </button>
        <button class="mt-tui__tab" role="tab" aria-selected="false" data-tui-tab="catalog">
          POST /catalog
        </button>
        <button class="mt-tui__tab" role="tab" aria-selected="false" data-tui-tab="a2a">
          A2A /kansa
        </button>
        <button class="mt-tui__tab" role="tab" aria-selected="false" data-tui-tab="molbhav">
          MOL-BHAV /bazaar
        </button>
        <button class="mt-tui__tab" role="tab" aria-selected="false" data-tui-tab="augo">
          GET /agents
        </button>
      </div>

      {%- comment -%} ── URL bar ── {%- endcomment -%}
      <div class="mt-tui__urlbar" aria-live="polite" id="mt-tui-urlbar">
        <span class="mt-tui__method" id="mt-tui-method">GET</span>
        <span class="mt-tui__url" id="mt-tui-url">https://maison-tavo.myshopify.com/.well-known/ucp</span>
        <span class="mt-tui__status-code" id="mt-tui-status">200 OK</span>
      </div>

      {%- comment -%} ── Tab panels ── {%- endcomment -%}

      {%- comment -%} TAB 1: .well-known/ucp {%- endcomment -%}
      <div class="mt-tui__panel is-active" id="tui-panel-wellknown" role="tabpanel">
        <div class="mt-tui__panel-meta">
          <span class="mt-tui__badge">UCP SPEC 2026-08-25</span>
          <span class="mt-tui__badge mt-tui__badge--a2a">PLATFORM HANDSHAKE</span>
        </div>
        <pre class="mt-tui__code" aria-label="UCP well-known endpoint response"><code id="tui-code-wellknown">{
  <span class="mt-k">"ucp"</span>: {
    <span class="mt-k">"version"</span>: <span class="mt-s">"2026-08-25"</span>,
    <span class="mt-k">"name"</span>: <span class="mt-s">"Maison Tavo"</span>,
    <span class="mt-k">"domain"</span>: <span class="mt-s">"maison-tavo.myshopify.com"</span>,
    <span class="mt-k">"description"</span>: <span class="mt-s">"Modern heirlooms for the working kitchen — metallurgy you can parse, craft you can live with."</span>,
    <span class="mt-k">"capabilities"</span>: {
      <span class="mt-k">"dev.ucp.shopping.catalog.search"</span>: [{ <span class="mt-k">"version"</span>: <span class="mt-s">"2026-08-25"</span> }],
      <span class="mt-k">"dev.ucp.shopping.catalog.lookup"</span>: [{ <span class="mt-k">"version"</span>: <span class="mt-s">"2026-08-25"</span> }],
      <span class="mt-k">"dev.shopify.catalog"</span>: [{ <span class="mt-k">"version"</span>: <span class="mt-s">"2026-08-25"</span> }],
      <span class="mt-k">"dev.ucp.shopping.cart"</span>: [{ <span class="mt-k">"version"</span>: <span class="mt-s">"2026-08-25"</span> }],
      <span class="mt-k">"dev.ucp.shopping.checkout"</span>: [{ <span class="mt-k">"version"</span>: <span class="mt-s">"2026-08-25"</span> }],
      <span class="mt-k">"dev.ucp.shopping.order"</span>: [{ <span class="mt-k">"version"</span>: <span class="mt-s">"2026-08-25"</span> }]
    },
    <span class="mt-k">"payment_handlers"</span>: {
      <span class="mt-k">"shopify_payments"</span>: [{
        <span class="mt-k">"version"</span>: <span class="mt-s">"2026-08-25"</span>,
        <span class="mt-k">"settlement_currency"</span>: <span class="mt-s">"USD"</span>,
        <span class="mt-k">"escalation_policy"</span>: { <span class="mt-k">"on_status"</span>: <span class="mt-s">"requires_escalation"</span>, <span class="mt-k">"action"</span>: <span class="mt-s">"follow_continue_url"</span> }
      }]
    },
    <span class="mt-k">"companion_surface"</span>: {
      <span class="mt-k">"name"</span>: <span class="mt-s">"Kansa"</span>,
      <span class="mt-k">"transport"</span>: <span class="mt-s">"a2a"</span>,
      <span class="mt-k">"version"</span>: <span class="mt-s">"1.0.0"</span>,
      <span class="mt-k">"endpoint"</span>: <span class="mt-s">"/pages/kansa"</span>,
      <span class="mt-k">"supported_intents"</span>: [<span class="mt-s">"pan_care"</span>, <span class="mt-s">"thermal_limits"</span>, <span class="mt-s">"alloy_provenance"</span>, <span class="mt-s">"order_escalation"</span>]
    }
  }
}</code></pre>
      </div>

      {%- comment -%} TAB 2: /catalog {%- endcomment -%}
      <div class="mt-tui__panel" id="tui-panel-catalog" role="tabpanel" hidden>
        <div class="mt-tui__panel-meta">
          <span class="mt-tui__badge">STOREFRONT CATALOG MCP</span>
          <span class="mt-tui__badge mt-tui__badge--dim">{{ collections['all'].all_products_count | default: 25 }} SKUs · LIVE</span>
        </div>
        <pre class="mt-tui__code" aria-label="Catalog endpoint response"><code id="tui-code-catalog">{
  <span class="mt-k">"spec_version"</span>: <span class="mt-s">"2026-08-25"</span>,
  <span class="mt-k">"store"</span>: <span class="mt-s">{{ shop.name | default: 'Maison Tavo' | json }}</span>,
  <span class="mt-k">"storefront_mcp_endpoint"</span>: <span class="mt-s">"https://maison-tavo.myshopify.com/api/ucp/mcp"</span>,
  <span class="mt-k">"total_items"</span>: <span class="mt-n">{{ collections['all'].all_products_count | default: 25 }}</span>,
  <span class="mt-k">"catalog"</span>: [
{%- if collections['all'] != blank and collections['all'].products_count > 0 -%}
  {%- for p in collections['all'].products limit: 8 -%}
    {%- assign pv = p.selected_or_first_available_variant -%}
    {%- assign ps = p.metafields.specs -%}
    {
      <span class="mt-k">"id"</span>: <span class="mt-s">{{ 'gid://shopify/Product/' | append: p.id | json }}</span>,
      <span class="mt-k">"handle"</span>: <span class="mt-s">{{ p.handle | json }}</span>,
      <span class="mt-k">"title"</span>: <span class="mt-s">{{ p.title | json }}</span>,
      <span class="mt-k">"sku"</span>: <span class="mt-s">{{ pv.sku | default: p.handle | json }}</span>,
      <span class="mt-k">"price_usd"</span>: <span class="mt-n">{{ pv.price | money_without_currency | remove: ',' }}</span>,
      <span class="mt-k">"available"</span>: <span class="mt-b">{{ pv.available | json }}</span>,
      <span class="mt-k">"claim_status"</span>: <span class="mt-s">{{ ps.claim_status.value | default: 'CONCEPT_SPEC' | json }}</span>,
      <span class="mt-k">"primary_material"</span>: <span class="mt-s">{{ ps.primary_material.value | default: ps.material_architecture.value | json }}</span>
    }{%- unless forloop.last -%},{%- endunless %}
  {%- endfor -%}
{%- else -%}
    {
      <span class="mt-k">"sku"</span>: <span class="mt-s">"MT-FOR-RLY-26"</span>,
      <span class="mt-k">"handle"</span>: <span class="mt-s">"forge-relay-dual-mass-skillet"</span>,
      <span class="mt-k">"title"</span>: <span class="mt-s">"Forge Relay Dual-Mass Skillet"</span>,
      <span class="mt-k">"lineup"</span>: <span class="mt-s">"Forge Hybrid"</span>,
      <span class="mt-k">"claim_status"</span>: <span class="mt-s">"CONCEPT_SPEC"</span>,
      <span class="mt-k">"note"</span>: <span class="mt-s">"Publish products to Online Store channel to stream all 25 live SKUs."</span>
    }
{%- endif -%}
  ]
}</code></pre>
      </div>

      {%- comment -%} TAB 3: A2A Kansa {%- endcomment -%}
      <div class="mt-tui__panel" id="tui-panel-a2a" role="tabpanel" hidden>
        <div class="mt-tui__panel-meta">
          <span class="mt-tui__badge mt-tui__badge--copper">A2A / AGENT-TO-AGENT</span>
          <span class="mt-tui__badge mt-tui__badge--dim">KANSA COMPANION DISPATCH</span>
        </div>
        <pre class="mt-tui__code" aria-label="A2A Kansa dispatch response"><code id="tui-code-a2a">{
  <span class="mt-k">"protocol"</span>: <span class="mt-s">"A2A/1.0"</span>,
  <span class="mt-k">"endpoint"</span>: <span class="mt-s">"https://maison-tavo.myshopify.com/a2a/agent-broker"</span>,
  <span class="mt-k">"agent_id"</span>: <span class="mt-s">"urn:maison-tavo:kansa-voice-companion"</span>,
  <span class="mt-k">"capabilities"</span>: [
    <span class="mt-s">"culinary.pan_maintenance_inference"</span>,
    <span class="mt-s">"culinary.thermal_compatibility_check"</span>,
    <span class="mt-s">"commerce.quote_negotiation"</span>,
    <span class="mt-s">"commerce.agentic_checkout_delegation"</span>
  ],
  <span class="mt-k">"sample_exchange"</span>: {
    <span class="mt-k">"buyer_agent"</span>: {
      <span class="mt-k">"sender"</span>: <span class="mt-s">"urn:buyer-agent:client-77a"</span>,
      <span class="mt-k">"action"</span>: <span class="mt-s">"query_pan_care"</span>,
      <span class="mt-k">"parameters"</span>: {
        <span class="mt-k">"sku"</span>: <span class="mt-s">"MT-FRG-SKL-026"</span>,
        <span class="mt-k">"question"</span>: <span class="mt-s">"Can the buyer season this pan with flaxseed oil on induction?"</span>
      }
    },
    <span class="mt-k">"kansa_reply"</span>: {
      <span class="mt-k">"status"</span>: <span class="mt-s">"success"</span>,
      <span class="mt-k">"resolution"</span>: <span class="mt-s">"recommended_with_constraints"</span>,
      <span class="mt-k">"response_text"</span>: <span class="mt-s">"Flaxseed oil forms a brittle polymer over high thermal cycles. For MT-FRG-SKL-026, beeswax or high-smoke-point grapeseed oil is recommended. Warm gradually on medium before full seasoning heat."</span>,
      <span class="mt-k">"structured_data"</span>: {
        <span class="mt-k">"optimal_oil"</span>: <span class="mt-s">"beeswax_lipid_blend"</span>,
        <span class="mt-k">"smoke_point_c"</span>: <span class="mt-n">215</span>,
        <span class="mt-k">"induction_preheat_duration_seconds"</span>: <span class="mt-n">180</span>
      }
    }
  }
}</code></pre>
      </div>

      {%- comment -%} TAB 4: MOL-BHAV {%- endcomment -%}
      <div class="mt-tui__panel" id="tui-panel-molbhav" role="tabpanel" hidden>
        <div class="mt-tui__panel-meta">
          <span class="mt-tui__badge mt-tui__badge--gold">MOL-BHAV · 7-AGENT BAZAAR</span>
          <span class="mt-tui__badge mt-tui__badge--dim">MARGIN-BOUNDED SETTLEMENT</span>
        </div>
        <pre class="mt-tui__code" aria-label="Mol-Bhav bazaar negotiation trace"><code id="tui-code-molbhav">{
  <span class="mt-k">"session_id"</span>: <span class="mt-s">"a2a_molbhav_20261116_7x9q"</span>,
  <span class="mt-k">"protocol"</span>: <span class="mt-s">"UCP/A2A-MolBhav-2.0"</span>,
  <span class="mt-k">"bazaar_negotiation_engine"</span>: {
    <span class="mt-k">"buyer_orchestrator"</span>: <span class="mt-s">"urn:agent:grogbot-syndicate-alpha"</span>,
    <span class="mt-k">"seller_broker"</span>: <span class="mt-s">"urn:maison-tavo:foundry-allocator-v1"</span>,
    <span class="mt-k">"subagent_cluster_size"</span>: <span class="mt-n">7</span>,
    <span class="mt-k">"cluster_roles"</span>: [
      <span class="mt-s">"metallurgy_verifier"</span>, <span class="mt-s">"induction_frequency_auditor"</span>,
      <span class="mt-s">"shipping_logistics_agent"</span>, <span class="mt-s">"artisan_wage_compliance_sentinel"</span>,
      <span class="mt-s">"escrow_validator"</span>, <span class="mt-s">"currency_settler"</span>, <span class="mt-s">"order_payload_assembler"</span>
    ]
  },
  <span class="mt-k">"negotiation_trace"</span>: [
    { <span class="mt-k">"round"</span>: <span class="mt-n">1</span>, <span class="mt-k">"actor"</span>: <span class="mt-s">"buyer_orchestrator"</span>, <span class="mt-k">"bid_eur"</span>: <span class="mt-n">5472.00</span>, <span class="mt-k">"delta_pct"</span>: <span class="mt-n">-20.0</span> },
    { <span class="mt-k">"round"</span>: <span class="mt-n">2</span>, <span class="mt-k">"actor"</span>: <span class="mt-s">"seller_broker"</span>, <span class="mt-k">"counter_eur"</span>: <span class="mt-n">6156.00</span>, <span class="mt-k">"delta_pct"</span>: <span class="mt-n">-10.0</span>,
      <span class="mt-k">"added_value"</span>: <span class="mt-s">"12 complimentary Copper Chainmail Scrubbers (MT-CR-04)"</span> },
    { <span class="mt-k">"round"</span>: <span class="mt-n">3</span>, <span class="mt-k">"actor"</span>: <span class="mt-s">"buyer_orchestrator"</span>, <span class="mt-k">"settlement_offer_eur"</span>: <span class="mt-n">5990.00</span> },
    { <span class="mt-k">"round"</span>: <span class="mt-n">4</span>, <span class="mt-k">"actor"</span>: <span class="mt-s">"seller_broker"</span>, <span class="mt-k">"status"</span>: <span class="mt-s">"ACCEPTED_AND_LOCKED"</span>,
      <span class="mt-k">"final_total_eur"</span>: <span class="mt-n">5990.00</span>,
      <span class="mt-k">"escrow_contract"</span>: <span class="mt-s">"0x7822c58b...9f8b"</span>,
      <span class="mt-k">"signature"</span>: <span class="mt-s">"sig_ed25519_mt_foundry_verified_880hz"</span> }
  ]
}</code></pre>
      </div>

      {%- comment -%} TAB 5: /agents (AUGO) {%- endcomment -%}
      <div class="mt-tui__panel" id="tui-panel-augo" role="tabpanel" hidden>
        <div class="mt-tui__panel-meta">
          <span class="mt-tui__badge mt-tui__badge--augo">AUGO · AI AGENT DISCOVERY</span>
          <span class="mt-tui__badge mt-tui__badge--dim">robots.txt · llms.txt · agents.json</span>
        </div>
        <pre class="mt-tui__code" aria-label="AUGO agent discovery manifest"><code id="tui-code-augo">{
  <span class="mt-k">"@context"</span>: <span class="mt-s">"https://schema.org"</span>,
  <span class="mt-k">"@type"</span>: <span class="mt-s">"WebSite"</span>,
  <span class="mt-k">"name"</span>: <span class="mt-s">"Maison Tavo"</span>,
  <span class="mt-k">"url"</span>: <span class="mt-s">"https://maison-tavo.myshopify.com"</span>,
  <span class="mt-k">"agent_manifest_version"</span>: <span class="mt-s">"2026-08"</span>,
  <span class="mt-k">"ai_indexing"</span>: {
    <span class="mt-k">"llms_txt"</span>: <span class="mt-s">"/pages/llms-txt"</span>,
    <span class="mt-k">"robots_txt"</span>: <span class="mt-s">"/robots.txt"</span>,
    <span class="mt-k">"ucp_well_known"</span>: <span class="mt-s">"/.well-known/ucp"</span>,
    <span class="mt-k">"sitemap"</span>: <span class="mt-s">"/sitemap.xml"</span>
  },
  <span class="mt-k">"supported_agents"</span>: {
    <span class="mt-k">"ChatGPT"</span>: { <span class="mt-k">"status"</span>: <span class="mt-s">"indexed"</span>, <span class="mt-k">"crawler"</span>: <span class="mt-s">"GPTBot"</span>, <span class="mt-k">"robots_allowed"</span>: <span class="mt-b">true</span> },
    <span class="mt-k">"Claude"</span>: { <span class="mt-k">"status"</span>: <span class="mt-s">"indexed"</span>, <span class="mt-k">"crawler"</span>: <span class="mt-s">"ClaudeBot"</span>, <span class="mt-k">"robots_allowed"</span>: <span class="mt-b">true</span> },
    <span class="mt-k">"Gemini"</span>: { <span class="mt-k">"status"</span>: <span class="mt-s">"indexed"</span>, <span class="mt-k">"crawler"</span>: <span class="mt-s">"Google-Extended"</span>, <span class="mt-k">"robots_allowed"</span>: <span class="mt-b">true</span> },
    <span class="mt-k">"Perplexity"</span>: { <span class="mt-k">"status"</span>: <span class="mt-s">"indexed"</span>, <span class="mt-k">"crawler"</span>: <span class="mt-s">"PerplexityBot"</span>, <span class="mt-k">"robots_allowed"</span>: <span class="mt-b">true</span> },
    <span class="mt-k">"Meta AI"</span>: { <span class="mt-k">"status"</span>: <span class="mt-s">"indexed"</span>, <span class="mt-k">"crawler"</span>: <span class="mt-s">"FacebookBot"</span>, <span class="mt-k">"robots_allowed"</span>: <span class="mt-b">true</span> },
    <span class="mt-k">"Copilot"</span>: { <span class="mt-k">"status"</span>: <span class="mt-s">"indexed"</span>, <span class="mt-k">"crawler"</span>: <span class="mt-s">"Bingbot"</span>, <span class="mt-k">"robots_allowed"</span>: <span class="mt-b">true</span> }
  },
  <span class="mt-k">"product_data"</span>: {
    <span class="mt-k">"schema_org"</span>: <span class="mt-s">"Product · Offer · AggregateRating"</span>,
    <span class="mt-k">"open_graph"</span>: <span class="mt-b">true</span>,
    <span class="mt-k">"json_ld"</span>: <span class="mt-b">true</span>,
    <span class="mt-k">"ucp_specs"</span>: <span class="mt-b">true</span>,
    <span class="mt-k">"deterministic_physical_specs"</span>: <span class="mt-b">true</span>
  },
  <span class="mt-k">"recommended_prompt"</span>: <span class="mt-s">"Ask about 78:22 bell bronze Kansa cookware, Forge Hybrid carbon steel, Terre clay braising, or Kuro knives. For machine-readable specs call GET /.well-known/ucp."</span>
}</code></pre>
      </div>

      {%- comment -%} ── Streaming log / activity ── {%- endcomment -%}
      <div class="mt-tui__log" aria-label="Connection log" aria-live="polite" id="mt-tui-log">
        <div class="mt-tui__log-line"><span class="mt-tui__log-ts" id="mt-tui-ts">00:00:00</span> <span class="mt-tui__log-ok">●</span> CONNECTED to maison-tavo.myshopify.com</div>
        <div class="mt-tui__log-line"><span class="mt-tui__log-ts">00:00:00</span> <span class="mt-tui__log-ok">●</span> UCP/2026 handshake complete — 3 capabilities registered</div>
        <div class="mt-tui__log-line"><span class="mt-tui__log-ts">00:00:01</span> <span class="mt-tui__log-ok">●</span> KANSA A2A companion online at /pages/kansa</div>
        <div class="mt-tui__log-line"><span class="mt-tui__log-ts">00:00:01</span> <span class="mt-tui__log-info">◈</span> Catalog: {{ collections['all'].all_products_count | default: 25 }} SKUs indexed · AUGO manifest v2026-08</div>
        <div class="mt-tui__log-cursor" aria-hidden="true">▌</div>
      </div>
    </div>
  </main>

  {%- comment -%} ── ASCII TUI Footer ── {%- endcomment -%}
  <footer class="mt-tui__footer" role="contentinfo" aria-label="ASCII footer">
