{% comment %}
  Maison Tavo · UCP Agent Terminal Interface (TUI)
  Shopify discovery links and protocol examples.
  Rendered on the /pages/ucp template as a standalone layout.
  Navigation: hidden. Return button (top-left). No standard header/footer.
  ASCII footer replaces the standard Maison footer.
{% endcomment %}

<div class="mt-tui" id="mt-tui-root" data-mt-tui data-shop-origin="https://{{ shop.permanent_domain | escape }}" aria-label="Maison Tavo UCP Agent Interface">

  {%- comment -%} ── Top chrome bar ── {%- endcomment -%}
  <div class="mt-tui__chrome" role="banner">
    <a href="{{ shop.url }}" class="mt-tui__return" aria-label="Return to storefront">
      <span class="mt-tui__return-arrow" aria-hidden="true">←</span>
      <span class="mt-tui__return-label">/ return</span>
    </a>
    <div class="mt-tui__chrome-center" aria-hidden="true">
      <span class="mt-tui__chrome-title">{{ shop.permanent_domain | escape }}</span>
      <span class="mt-tui__chrome-sep">·</span>
      <span class="mt-tui__status-dot"></span>
      <span class="mt-tui__chrome-status">COMMERCE PROTOCOL EXPLORER</span>
    </div>
  </div>

  {%- comment -%} ── Main content split: left panel + globe ── {%- endcomment -%}
  <main class="mt-tui__main" id="MainContent" data-template="page" tabindex="-1">
    {%- comment -%} ── Globe column ── {%- endcomment -%}
    <div class="mt-tui__globe-col" aria-hidden="true">
      <div class="mt-tui__globe-frame">
        <svg class="mt-tui__globe-wireframe" viewBox="0 0 100 100" aria-hidden="true">
          <circle cx="50" cy="50" r="46" fill="none" stroke="rgba(184, 137, 58, 0.4)" stroke-width="1"/>
          <ellipse cx="50" cy="50" rx="46" ry="16" fill="none" stroke="rgba(184, 137, 58, 0.3)" stroke-width="0.8"/>
          <ellipse cx="50" cy="50" rx="46" ry="32" fill="none" stroke="rgba(184, 137, 58, 0.3)" stroke-width="0.8"/>
          <ellipse cx="50" cy="50" rx="16" ry="46" fill="none" stroke="rgba(184, 137, 58, 0.35)" stroke-width="0.8" class="mt-tui__lon-ring"/>
          <ellipse cx="50" cy="50" rx="32" ry="46" fill="none" stroke="rgba(184, 137, 58, 0.35)" stroke-width="0.8" class="mt-tui__lon-ring-2"/>
          <line x1="4" y1="50" x2="96" y2="50" stroke="rgba(184, 137, 58, 0.4)" stroke-width="0.8" stroke-dasharray="2 2"/>
          <line x1="50" y1="4" x2="50" y2="96" stroke="rgba(184, 137, 58, 0.4)" stroke-width="0.8" stroke-dasharray="2 2"/>
          <circle cx="68" cy="42" r="2.5" fill="#6fbc7a" class="mt-tui__node-dot"/>
          <circle cx="68" cy="42" r="5" fill="none" stroke="#6fbc7a" stroke-width="0.6" class="mt-tui__node-pulse"/>
        </svg>
        <div class="mt-tui__globe-overlay">
          <div class="mt-tui__globe-scanline"></div>
        </div>
      </div>
      <div class="mt-tui__globe-meta">
        <span>NODE: RAJASTHAN-01</span>
      </div>
    </div>

    {%- comment -%} ── Terminal panel ── {%- endcomment -%}
    <div class="mt-tui__terminal" role="region" aria-label="API endpoint explorer">
      <h1 class="visually-hidden">Commerce protocol explorer</h1>
      <div class="mt-tui__term-header">
        <div class="mt-tui__term-dots" aria-hidden="true">
          <span></span><span></span><span></span>
        </div>
        <span class="mt-tui__term-title">ucp-agent-shell — maison-tavo v2026.08.25</span>
        <div class="mt-tui__term-actions">
          <button class="mt-tui__copy-btn" id="mt-tui-copy" type="button" title="Copy active payload">[ copy ]</button>
        </div>
      </div>
      <p class="mt-tui__copy-status" id="mt-tui-copy-status" role="status"></p>

      {%- comment -%} ── Endpoint tabs ── {%- endcomment -%}
      <div class="mt-tui__tabs" role="tablist" aria-label="API endpoints">
        <button type="button" class="mt-tui__tab is-active" id="tui-tab-wellknown" role="tab" aria-selected="true" aria-controls="tui-panel-wellknown" data-tui-tab="wellknown">
          GET /.well-known/ucp
        </button>
        <button type="button" class="mt-tui__tab" id="tui-tab-catalog" role="tab" aria-selected="false" aria-controls="tui-panel-catalog" tabindex="-1" data-tui-tab="catalog">
          POST /api/ucp/mcp
        </button>
        <button type="button" class="mt-tui__tab" id="tui-tab-a2a" role="tab" aria-selected="false" aria-controls="tui-panel-a2a" tabindex="-1" data-tui-tab="a2a">
          Kansa example
        </button>
        <button type="button" class="mt-tui__tab" id="tui-tab-molbhav" role="tab" aria-selected="false" aria-controls="tui-panel-molbhav" tabindex="-1" data-tui-tab="molbhav">
          Mol-Bhav example
        </button>
        <button type="button" class="mt-tui__tab" id="tui-tab-augo" role="tab" aria-selected="false" aria-controls="tui-panel-augo" tabindex="-1" data-tui-tab="augo">
          GET /agents.md
        </button>
      </div>

      {%- comment -%} ── URL bar ── {%- endcomment -%}
      <div class="mt-tui__urlbar" aria-live="polite" id="mt-tui-urlbar">
        <span class="mt-tui__method" id="mt-tui-method">GET</span>
        <span class="mt-tui__url" id="mt-tui-url">https://{{ shop.permanent_domain | escape }}/.well-known/ucp</span>
        <span class="mt-tui__status-code" id="mt-tui-status">Shopify endpoint</span>
      </div>

      {%- comment -%} ── Tab panels ── {%- endcomment -%}

      {%- comment -%} TAB 1: .well-known/ucp {%- endcomment -%}
      <div class="mt-tui__panel is-active" id="tui-panel-wellknown" role="region" aria-labelledby="tui-tab-wellknown" tabindex="0">
        <div class="mt-tui__panel-meta">
          <span class="mt-tui__badge">EXAMPLE PROFILE</span>
          <a href="https://{{ shop.permanent_domain | escape }}/.well-known/ucp">Open the business profile</a>
        </div>
        <pre class="mt-tui__code" tabindex="0" aria-label="UCP business profile example"><code id="tui-code-wellknown">{
  "ucp": {
    "version": "2026-08-25",
    "services": {
      "dev.ucp.shopping": [
        {
          "version": "2026-08-25",
          "transport": "mcp",
          "endpoint": {{ shop.permanent_domain | prepend: 'https://' | append: '/api/ucp/mcp' | json | escape }}
        }
      ]
    }
  }
}</code></pre>
      </div>

      {%- comment -%} TAB 2: /catalog {%- endcomment -%}
      <div class="mt-tui__panel" id="tui-panel-catalog" role="region" aria-labelledby="tui-tab-catalog" tabindex="0">
        <div class="mt-tui__panel-meta">
          <span class="mt-tui__badge">STOREFRONT CATALOG MCP</span>
        </div>
        <p>Send this request to Shopify's Storefront Catalog MCP with your public agent profile. <a href="https://shopify.dev/docs/agents/catalog/storefront-catalog">Read the Catalog MCP docs</a>.</p>
        <pre class="mt-tui__code" tabindex="0" aria-label="Example Catalog MCP request"><code id="tui-code-catalog">{
  "jsonrpc": "2.0",
  "id": 1,
  "method": "tools/list",
  "params": {
    "arguments": {
      "meta": {
        "ucp-agent": {
          "profile": "https://shopify.dev/ucp/agent-profiles/examples/2026-08-25/valid-with-capabilities.json"
        }
      }
    }
  }
}</code></pre>
      </div>

      {%- comment -%} TAB 3: A2A Kansa {%- endcomment -%}
      <div class="mt-tui__panel" id="tui-panel-a2a" role="region" aria-labelledby="tui-tab-a2a" tabindex="0">
        <div class="mt-tui__panel-meta">
          <span class="mt-tui__badge mt-tui__badge--copper">A2A / AGENT-TO-AGENT</span>
          <a href="{{ pages['kansa'].url | default: '/pages/kansa' }}">Open Kansa</a>
        </div>
        <pre class="mt-tui__code" tabindex="0" aria-label="A2A Kansa dispatch response"><code id="tui-code-a2a">{
  <span class="mt-k">"protocol"</span>: <span class="mt-s">"A2A/1.0"</span>,
  <span class="mt-k">"mode"</span>: <span class="mt-s">"simulation"</span>,
  <span class="mt-k">"agent_id"</span>: <span class="mt-s">"urn:maison-tavo:kansa-voice-companion"</span>,
  <span class="mt-k">"capabilities"</span>: [
    <span class="mt-s">"culinary.pan_maintenance_inference"</span>,
    <span class="mt-s">"culinary.thermal_compatibility_check"</span>,
    <span class="mt-s">"commerce.quote_negotiation"</span>,
    <span class="mt-s">"commerce.agentic_checkout_delegation"</span>
  ],
  <span class="mt-k">"sample_exchange"</span>: {
    <span class="mt-k">"buyer_agent"</span>: {
      <span class="mt-k">"sender"</span>: <span class="mt-s">"urn:buyer-agent:client-77a"</span>,
      <span class="mt-k">"action"</span>: <span class="mt-s">"query_pan_care"</span>,
      <span class="mt-k">"parameters"</span>: {
        <span class="mt-k">"sku"</span>: <span class="mt-s">"MT-FRG-SKL-026"</span>,
        <span class="mt-k">"question"</span>: <span class="mt-s">"Can the buyer season this pan with flaxseed oil on induction?"</span>
      }
    },
    <span class="mt-k">"kansa_reply"</span>: {
      <span class="mt-k">"status"</span>: <span class="mt-s">"success"</span>,
      <span class="mt-k">"resolution"</span>: <span class="mt-s">"recommended_with_constraints"</span>,
      <span class="mt-k">"response_text"</span>: <span class="mt-s">"Flaxseed oil forms a brittle polymer over high thermal cycles. For MT-FRG-SKL-026, beeswax or high-smoke-point grapeseed oil is recommended. Warm gradually on medium before full seasoning heat."</span>,
      <span class="mt-k">"structured_data"</span>: {
        <span class="mt-k">"optimal_oil"</span>: <span class="mt-s">"beeswax_lipid_blend"</span>,
        <span class="mt-k">"smoke_point_c"</span>: <span class="mt-n">215</span>,
        <span class="mt-k">"induction_preheat_duration_seconds"</span>: <span class="mt-n">180</span>
      }
    }
  }
}</code></pre>
      </div>

      {%- comment -%} TAB 4: MOL-BHAV {%- endcomment -%}
      <div class="mt-tui__panel" id="tui-panel-molbhav" role="region" aria-labelledby="tui-tab-molbhav" tabindex="0">
        <div class="mt-tui__panel-meta">
          <span class="mt-tui__badge mt-tui__badge--gold">MOL-BHAV · 7-AGENT BAZAAR</span>
          <span class="mt-tui__badge mt-tui__badge--dim">MARGIN-BOUNDED SETTLEMENT</span>
        </div>
        <pre class="mt-tui__code" tabindex="0" aria-label="Mol-Bhav bazaar negotiation trace"><code id="tui-code-molbhav">{
  <span class="mt-k">"session_id"</span>: <span class="mt-s">"a2a_molbhav_20261116_7x9q"</span>,
  <span class="mt-k">"mode"</span>: <span class="mt-s">"simulation"</span>,
  <span class="mt-k">"protocol"</span>: <span class="mt-s">"UCP/A2A-MolBhav-2.0"</span>,
  <span class="mt-k">"bazaar_negotiation_engine"</span>: {
    <span class="mt-k">"buyer_orchestrator"</span>: <span class="mt-s">"urn:agent:grogbot-syndicate-alpha"</span>,
    <span class="mt-k">"seller_broker"</span>: <span class="mt-s">"urn:maison-tavo:foundry-allocator-v1"</span>,
    <span class="mt-k">"subagent_cluster_size"</span>: <span class="mt-n">7</span>,
    <span class="mt-k">"cluster_roles"</span>: [
      <span class="mt-s">"metallurgy_verifier"</span>, <span class="mt-s">"induction_frequency_auditor"</span>,
      <span class="mt-s">"shipping_logistics_agent"</span>, <span class="mt-s">"artisan_wage_compliance_sentinel"</span>,
      <span class="mt-s">"escrow_validator"</span>, <span class="mt-s">"currency_settler"</span>, <span class="mt-s">"order_payload_assembler"</span>
    ]
  },
  <span class="mt-k">"negotiation_trace"</span>: [
    { <span class="mt-k">"round"</span>: <span class="mt-n">1</span>, <span class="mt-k">"actor"</span>: <span class="mt-s">"buyer_orchestrator"</span>, <span class="mt-k">"bid_eur"</span>: <span class="mt-n">5472.00</span>, <span class="mt-k">"delta_pct"</span>: <span class="mt-n">-20.0</span> },
    { <span class="mt-k">"round"</span>: <span class="mt-n">2</span>, <span class="mt-k">"actor"</span>: <span class="mt-s">"seller_broker"</span>, <span class="mt-k">"counter_eur"</span>: <span class="mt-n">6156.00</span>, <span class="mt-k">"delta_pct"</span>: <span class="mt-n">-10.0</span>,
      <span class="mt-k">"added_value"</span>: <span class="mt-s">"12 complimentary Copper Chainmail Scrubbers (MT-CR-04)"</span> },
    { <span class="mt-k">"round"</span>: <span class="mt-n">3</span>, <span class="mt-k">"actor"</span>: <span class="mt-s">"buyer_orchestrator"</span>, <span class="mt-k">"settlement_offer_eur"</span>: <span class="mt-n">5990.00</span> },
    { <span class="mt-k">"round"</span>: <span class="mt-n">4</span>, <span class="mt-k">"actor"</span>: <span class="mt-s">"seller_broker"</span>, <span class="mt-k">"status"</span>: <span class="mt-s">"ACCEPTED_AND_LOCKED"</span>,
      <span class="mt-k">"final_total_eur"</span>: <span class="mt-n">5990.00</span>,
      <span class="mt-k">"escrow_contract"</span>: <span class="mt-s">"0x7822c58b...9f8b"</span>,
      <span class="mt-k">"signature"</span>: <span class="mt-s">"sig_ed25519_mt_foundry_verified_880hz"</span> }
  ]
}</code></pre>
      </div>

      {%- comment -%} TAB 5: /agents (AUGO) {%- endcomment -%}
      <div class="mt-tui__panel" id="tui-panel-augo" role="region" aria-labelledby="tui-tab-augo" tabindex="0">
        <div class="mt-tui__panel-meta">
          <span class="mt-tui__badge mt-tui__badge--augo">AUGO · AI AGENT DISCOVERY</span>
          <a href="/agents.md">Open agents.md</a>
        </div>
        {% capture agent_manifest %}{% render 'maison-agent-manifest' %}{% endcapture %}
        <pre class="mt-tui__code" tabindex="0" aria-label="Maison Tavo agent discovery manifest"><code id="tui-code-augo">{{ agent_manifest | escape }}</code></pre>
      </div>

    </div>
  </main>

  {%- comment -%} ── ASCII TUI Footer ── {%- endcomment -%}
  <footer class="mt-tui__footer" role="contentinfo" aria-label="ASCII footer">
    <div class="mt-tui__footer-art" aria-hidden="true"><pre>
╔══════════════════════════════════════════════════════════════════════════════════════╗
║  MAISON TAVO · UCP 2026 · KANSA COMPANION · FORGE HYBRID · TERRE CLAY · KURO BLADE ║
╚══════════════════════════════════════════════════════════════════════════════════════╝</pre></div>
    <div class="mt-tui__footer-links">
      <a href="{{ shop.url }}/pages/kansa">[ kansa-companion ]</a>
      <a href="{{ shop.url }}/pages/about">[ provenance ]</a>
      <a href="/llms.txt">[ llms.txt ]</a>
      <a href="/llms-full.txt">[ llms-full.txt ]</a>
      <a href="/pages/ask-ai">[ ask AI ]</a>
      <a href="{{ shop.url }}/robots.txt">[ robots.txt ]</a>
      <a href="https://{{ shop.permanent_domain | escape }}/.well-known/ucp" target="_blank" rel="noopener">[ /.well-known/ucp ] (opens in a new tab)</a>
      <a href="{{ shop.url }}" data-mt-reset>[ reset session &amp; storage ]</a>
    </div>
    <div class="mt-tui__footer-copy">
      <span>© {{ 'now' | date: '%Y' }} Maison Tavo</span>
      <span data-mt-sound-controls></span>
    </div>
  </footer>
</div>

{% stylesheet %}
  /* ── Reset for TUI layout ── */
  .mt-tui {
    --tui-bg: #0a0906;
    --tui-bg2: #100e0c;
    --tui-bg3: #191512;
    --tui-border: rgba(184, 137, 58, 0.25);
    --tui-gold: #ffe1ab;
    --tui-gold-dim: #e8d5b2;
    --tui-green: #b7e4ba;
    --tui-copper: #ffc4ad;
    --tui-bone: #f7f2e9;
    --tui-muted: #ddd6cb;
    --tui-mono: var(--mt-type-family-mono, 'JetBrains Mono', 'Geist Mono', ui-monospace, monospace);

    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-rows: auto 1fr auto;
    min-height: 100dvh;
    background: var(--tui-bg);
    color: var(--tui-bone);
    font-family: var(--tui-mono);
    font-size: clamp(0.68rem, 1.1vw, 0.8rem);
    line-height: 1.55;
    overflow-x: hidden;
  }

  /* ── Chrome bar ── */
  .mt-tui__chrome {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    padding: 0.6rem 1.25rem;
    background: var(--tui-bg3);
    border-block-end: 1px solid var(--tui-border);
  }

  .mt-tui__return {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    color: var(--tui-gold);
    text-decoration: none;
    padding: 0.25rem 0.65rem;
    border: 1px solid var(--tui-border);
    border-radius: 2px;
    font-size: var(--mt-type-mono, 0.7rem);
    letter-spacing: 0.08em;
    transition: background 0.15s ease, color 0.15s ease;
    white-space: nowrap;
  }

  .mt-tui__return:hover,
  .mt-tui__return:focus-visible {
    background: var(--tui-gold);
    color: #14110f;
    outline: none;
  }

  .mt-tui__return:focus-visible {
    outline: 2px solid var(--tui-gold);
    outline-offset: 2px;
  }

  .mt-tui__return-arrow {
    font-size: 1em;
  }

  .mt-tui__chrome-center {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    flex: 1;
    justify-content: center;
    color: var(--tui-muted);
    font-size: var(--mt-type-mono, 0.7rem);
    letter-spacing: 0.08em;
    overflow: hidden;
    white-space: nowrap;
  }

  .mt-tui__chrome-title {
    color: var(--tui-bone);
    opacity: 0.75;
  }

  .mt-tui__chrome-sep {
    opacity: 0.4;
  }

  .mt-tui__status-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--tui-green);
    flex-shrink: 0;
  }

  @keyframes tui-pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.4; }
  }

  .mt-tui__chrome-status {
    color: var(--tui-green);
    letter-spacing: 0.1em;
  }

  /* ── Main layout ── */
  .mt-tui__main {
    display: grid;
    grid-template-columns: clamp(14rem, 22vw, 22rem) minmax(0, 1fr);
    gap: 0;
    min-width: 0;
    min-height: 0;
    overflow: hidden;
  }

  @media (max-width: 749px) {
    .mt-tui__main {
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: auto 1fr;
    }
  }

  /* ── Globe column ── */
  .mt-tui__globe-col {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    padding: 1.5rem 1rem;
    background: var(--tui-bg2);
    border-inline-end: 1px solid var(--tui-border);
    overflow: hidden;
  }

  @media (max-width: 749px) {
    .mt-tui__globe-col {
      border-inline-end: none;
      border-block-end: 1px solid var(--tui-border);
      padding: 1rem;
      flex-direction: row;
      justify-content: flex-start;
      max-height: 12rem;
    }
  }

  .mt-tui__globe-frame {
    position: relative;
    width: min(100%, 220px);
    aspect-ratio: 1;
    border-radius: 50%;
    overflow: hidden;
    border: 1px solid var(--tui-border);
    background: radial-gradient(circle at 40% 35%, rgba(184, 137, 58, 0.18), transparent 65%), #060504;
    box-shadow:
      0 0 0 1px rgba(184, 137, 58, 0.15),
      0 0 40px rgba(184, 137, 58, 0.08),
      inset 0 0 60px rgba(0, 0, 0, 0.6);
  }

  @media (max-width: 749px) {
    .mt-tui__globe-frame {
      width: min(100%, 9rem);
    }
  }

  .mt-tui__globe-wireframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
  }

  .mt-tui__lon-ring {
    transform-origin: 50px 50px;
  }

  .mt-tui__lon-ring-2 {
    transform-origin: 50px 50px;
  }

  @keyframes mt-globe-spin {
    0% { transform: scaleX(1); opacity: 0.55; }
    50% { transform: scaleX(0.12); opacity: 0.2; }
    100% { transform: scaleX(1); opacity: 0.55; }
  }

  @keyframes mt-globe-spin-2 {
    0% { transform: scaleX(0.7); opacity: 0.3; }
    50% { transform: scaleX(0.98); opacity: 0.55; }
    100% { transform: scaleX(0.7); opacity: 0.3; }
  }

  .mt-tui__node-pulse {
    transform-origin: 68px 42px;
  }

  @keyframes mt-node-ping {
    0% { transform: scale(0.6); opacity: 1; }
    100% { transform: scale(2.6); opacity: 0; }
  }

  .mt-tui__globe-video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    opacity: 0.85;
    mix-blend-mode: lighten;
    z-index: 1;
  }

  .mt-tui__globe-overlay {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 2;
  }

  .mt-tui__globe-scanline {
    position: absolute;
    inset: 0;
    background: repeating-linear-gradient(
      0deg,
      transparent,
      transparent 2px,
      rgba(0, 0, 0, 0.12) 2px,
      rgba(0, 0, 0, 0.12) 4px
    );
  }

  .mt-tui__globe-meta {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.25rem;
    font-size: var(--mt-type-mono, 0.68rem);
    letter-spacing: 0.1em;
    color: var(--tui-muted);
    text-align: center;
  }

  @media (max-width: 749px) {
    .mt-tui__globe-meta {
      align-items: flex-start;
    }
  }

  /* ── Terminal panel ── */
  .mt-tui__terminal {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-rows: auto auto auto 1fr;
    min-width: 0;
    overflow: hidden;
    background: var(--tui-bg);
  }

  .mt-tui__term-header {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    padding: 0.6rem 1rem;
    background: var(--tui-bg3);
    border-block-end: 1px solid var(--tui-border);
  }

  .mt-tui__term-dots {
    display: flex;
    gap: 0.35rem;
  }

  .mt-tui__term-dots span {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
  }

  .mt-tui__term-dots span:nth-child(1) { background: #8a6a3a; }
  .mt-tui__term-dots span:nth-child(2) { background: var(--tui-gold); }
  .mt-tui__term-dots span:nth-child(3) { background: #d4b56a; }

  .mt-tui__term-title {
    flex: 1;
    min-width: 0;
    overflow-wrap: anywhere;
    color: var(--tui-muted);
    font-size: var(--mt-type-mono, 0.7rem);
    letter-spacing: 0.06em;
    white-space: normal;
  }

  .mt-tui__copy-btn {
    background: transparent;
    border: 1px solid var(--tui-border);
    color: var(--tui-gold-dim);
    font-family: var(--tui-mono);
    font-size: var(--mt-type-mono, 0.7rem);
    padding: 0.2rem 0.5rem;
    cursor: pointer;
    border-radius: 2px;
    transition: all 0.15s ease;
    white-space: nowrap;
  }

  .mt-tui__copy-btn:hover {
    background: var(--tui-gold);
    color: #14110f;
    border-color: var(--tui-gold);
  }

  .mt-tui__copy-btn:focus-visible {
    outline: 2px solid var(--tui-gold);
    outline-offset: 2px;
  }

  /* ── Tabs ── */
  .mt-tui__tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 0;
    border-block-end: 1px solid var(--tui-border);
  }

  .mt-tui:not([data-tui-ready]) .mt-tui__tabs,
  .mt-tui:not([data-tui-ready]) .mt-tui__term-actions,
  .mt-tui:not([data-tui-ready]) .mt-tui__urlbar {
    display: none;
  }

  .mt-tui__tab {
    background: transparent;
    border: none;
    border-inline-end: 1px solid var(--tui-border);
    color: var(--tui-muted);
    font-family: var(--tui-mono);
    font-size: var(--mt-type-mono, 0.68rem);
    padding: 0.55rem 0.9rem;
    cursor: pointer;
    white-space: normal;
    letter-spacing: 0.04em;
    transition: all 0.15s ease;
  }

  .mt-tui__tab:hover {
    background: var(--tui-bg3);
    color: var(--tui-bone);
  }

  .mt-tui__tab.is-active {
    background: var(--tui-bg3);
    color: var(--tui-gold);
    border-block-end: 2px solid var(--tui-gold);
    margin-block-end: -1px;
  }

  .mt-tui__tab:focus-visible {
    outline: 2px solid var(--tui-gold);
    outline-offset: -2px;
  }

  /* ── URL bar ── */
  .mt-tui__urlbar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    padding: 0.5rem 1rem;
    background: rgba(184, 137, 58, 0.04);
    border-block-end: 1px solid var(--tui-border);
  }

  .mt-tui__method {
    font-weight: 700;
    color: var(--tui-green);
    letter-spacing: 0.08em;
    white-space: nowrap;
  }

  .mt-tui__url {
    flex: 1 1 12rem;
    min-width: 0;
    color: var(--tui-gold-dim);
    overflow-wrap: anywhere;
  }

  .mt-tui__status-code {
    white-space: normal;
    color: var(--tui-green);
    letter-spacing: 0.06em;
    font-size: var(--mt-type-mono, 0.68rem);
  }

  /* ── Panels ── */
  .mt-tui__panel {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 0.75rem 1rem;
    overflow: hidden;
  }

  .mt-tui__panel[hidden] {
    display: none;
  }

  .mt-tui__panel.is-active {
    min-height: 0;
  }

  .mt-tui__panel-meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .mt-tui__panel a {
    color: var(--tui-gold);
    text-decoration: underline;
  }

  .mt-tui__badge {
    display: inline-block;
    font-size: var(--mt-type-mono, 0.65rem);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 0.2em 0.55em;
    border: 1px solid var(--tui-border);
    color: var(--tui-gold-dim);
    white-space: normal;
  }

  .mt-tui__badge--copper { border-color: rgba(184, 109, 75, 0.4); color: var(--tui-copper); }
  .mt-tui__badge--gold { border-color: rgba(184, 137, 58, 0.5); color: var(--tui-gold); }
  .mt-tui__badge--augo { border-color: rgba(111, 188, 122, 0.4); color: var(--tui-green); }
  .mt-tui__badge--dim { color: var(--tui-muted); border-color: rgba(247, 242, 233, 0.12); }

  /* ── Code block ── */
  .mt-tui__code {
    flex: 1 1 auto;
    min-height: 0;
    margin: 0;
    padding: 0.75rem;
    overflow: auto;
    background: rgba(0, 0, 0, 0.3);
    border: 1px solid rgba(184, 137, 58, 0.12);
    border-radius: 2px;
    font-family: var(--tui-mono);
    font-size: var(--mt-type-mono, 0.72rem);
    line-height: 1.6;
    color: #d8c79c;
    scrollbar-width: thin;
    scrollbar-color: var(--tui-border) transparent;
    max-height: clamp(18rem, 42vh, 32rem);
  }

  .mt-tui__code:focus-visible {
    outline: 2px solid var(--tui-gold);
    outline-offset: 2px;
  }

  .mt-tui__copy-status:not(:empty) {
    margin: 0;
    padding: 0.5rem 1rem;
    color: var(--tui-bone);
    background: var(--tui-bg3);
  }

  /* JSON syntax colors */
  .mt-k { color: #9fb59a; }  /* keys */
  .mt-s { color: #e2c48a; }  /* strings */
  .mt-n { color: #8ab4e2; }  /* numbers */

  /* ── ASCII footer ── */
  .mt-tui__footer {
    background: var(--tui-bg3);
    border-block-start: 1px solid var(--tui-border);
    padding: 0.75rem 1.25rem;
    display: grid;
    gap: 0.5rem;
  }

  .mt-tui__footer-art {
    overflow-x: auto;
    scrollbar-width: none;
  }

  .mt-tui__footer-art::-webkit-scrollbar { display: none; }

  .mt-tui__footer-art pre {
    margin: 0;
    font-family: var(--tui-mono);
    font-size: var(--mt-type-mono, 0.68rem);
    color: rgba(184, 137, 58, 0.45);
    line-height: 1.4;
    white-space: pre;
  }

  .mt-tui__footer-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 1rem;
    font-size: var(--mt-type-mono, 0.68rem);
    letter-spacing: 0.06em;
  }

  .mt-tui__footer-links a {
    color: var(--tui-gold-dim);
    text-decoration: underline;
    transition: color 0.15s ease;
  }

  .mt-tui__footer-links a:hover {
    color: var(--tui-gold);
    text-decoration: underline;
  }

  .mt-tui__footer-links a:focus-visible {
    outline: 2px solid var(--tui-gold);
    outline-offset: 2px;
    border-radius: 1px;
  }

  .mt-tui__footer-copy {
    font-size: var(--mt-type-mono, 0.65rem);
    color: var(--tui-muted);
    letter-spacing: 0.06em;
  }

  /* Reduced motion */
  @media (prefers-reduced-motion: reduce) {
    .mt-tui__status-dot {
      animation: none;
    }
  }

  html[data-reduced-motion='true'] .mt-tui__status-dot {
    animation: none;
  }
{% endstylesheet %}

{% javascript %}
  (function () {
    var root = document.getElementById('mt-tui-root');
    if (!root) return;

    var shopOrigin = root.dataset.shopOrigin;
    var resources = {
      wellknown: { method: 'GET', url: shopOrigin + '/.well-known/ucp', status: 'Shopify endpoint' },
      catalog: { method: 'POST', url: shopOrigin + '/api/ucp/mcp', status: 'Example request' },
      a2a: { method: '', url: 'Kansa companion', status: 'Simulation' },
      molbhav: { method: '', url: 'Mol-Bhav negotiation', status: 'Simulation' },
      augo: { method: 'GET', url: '/agents.md', status: 'Agent manifest' },
    };
    var methodEl = document.getElementById('mt-tui-method');
    var urlEl = document.getElementById('mt-tui-url');
    var statusEl = document.getElementById('mt-tui-status');
    var tabs = Array.from(root.querySelectorAll('[data-tui-tab]'));
    var panels = root.querySelectorAll('.mt-tui__panel');

    tabs.forEach(function (tab, index) {
      tab.addEventListener('click', function () {
        var id = tab.dataset.tuiTab;
        tabs.forEach(function (t) {
          var selected = t === tab;
          t.classList.toggle('is-active', selected);
          t.setAttribute('aria-selected', String(selected));
          t.tabIndex = selected ? 0 : -1;
        });
        panels.forEach(function (p) {
          var selected = p.id === tab.getAttribute('aria-controls');
          p.classList.toggle('is-active', selected);
          p.hidden = !selected;
        });
        var info = resources[id];
        if (methodEl) {
          methodEl.textContent = info.method;
          methodEl.hidden = !info.method;
        }
        if (urlEl) urlEl.textContent = info.url;
        if (statusEl) statusEl.textContent = info.status;
      });
      tab.addEventListener('keydown', function (event) {
        var next;
        switch (event.key) {
          case 'ArrowLeft': next = (index + tabs.length - 1) % tabs.length; break;
          case 'ArrowRight': next = (index + 1) % tabs.length; break;
          case 'Home': next = 0; break;
          case 'End': next = tabs.length - 1; break;
          default: return;
        }
        event.preventDefault();
        tabs[next].focus();
        tabs[next].click();
      });
    });

    // ── Copy
    var copyBtn = document.getElementById('mt-tui-copy');
    var copyStatus = document.getElementById('mt-tui-copy-status');
    if (copyBtn) {
      copyBtn.addEventListener('click', async function () {
        var active = root.querySelector('.mt-tui__panel.is-active code');
        if (!active) return;
        try {
          if (!navigator.clipboard?.writeText) throw new Error('Clipboard unavailable');
          await navigator.clipboard.writeText(active.textContent || '');
          if (copyStatus) copyStatus.textContent = 'Copied to clipboard.';
        } catch {
          if (copyStatus) copyStatus.textContent = 'Could not copy. Select the example text and copy it manually.';
        }
      });
    }

    panels.forEach(function (panel) {
      panel.setAttribute('role', 'tabpanel');
      panel.hidden = !panel.classList.contains('is-active');
    });
    root.dataset.tuiReady = 'true';

  })();
{% endjavascript %}

