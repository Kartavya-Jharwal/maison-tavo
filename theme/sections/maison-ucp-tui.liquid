{% stylesheet %}
  /* ── Reset for TUI layout ── */
  .mt-tui {
    --tui-bg: #0a0906;
    --tui-bg2: #100e0c;
    --tui-bg3: #191512;
    --tui-border: rgba(184, 137, 58, 0.25);
    --tui-gold: #b8893a;
    --tui-gold-dim: rgba(184, 137, 58, 0.55);
    --tui-green: #6fbc7a;
    --tui-copper: #b86d4b;
    --tui-bone: #f7f2e9;
    --tui-muted: rgba(247, 242, 233, 0.45);
    --tui-mono: var(--mt-type-family-mono, 'JetBrains Mono', 'Geist Mono', ui-monospace, monospace);

    display: grid;
    grid-template-rows: auto 1fr auto;
    min-height: 100dvh;
    background: var(--tui-bg);
    color: var(--tui-bone);
    font-family: var(--tui-mono);
    font-size: clamp(0.68rem, 1.1vw, 0.8rem);
    line-height: 1.55;
    overflow-x: hidden;
  }

  /* ── Chrome bar ── */
  .mt-tui__chrome {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    padding: 0.6rem 1.25rem;
    background: var(--tui-bg3);
    border-block-end: 1px solid var(--tui-border);
    position: sticky;
    top: 0;
    z-index: 100;
  }

  .mt-tui__return {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    color: var(--tui-gold);
    text-decoration: none;
    padding: 0.25rem 0.65rem;
    border: 1px solid var(--tui-border);
    border-radius: 2px;
    font-size: var(--mt-type-mono, 0.7rem);
    letter-spacing: 0.08em;
    transition: background 0.15s ease, color 0.15s ease;
    white-space: nowrap;
  }

  .mt-tui__return:hover,
  .mt-tui__return:focus-visible {
    background: var(--tui-gold);
    color: #14110f;
    outline: none;
  }

  .mt-tui__return:focus-visible {
    outline: 2px solid var(--tui-gold);
    outline-offset: 2px;
  }

  .mt-tui__return-arrow {
    font-size: 1em;
  }

  .mt-tui__chrome-center {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    flex: 1;
    justify-content: center;
    color: var(--tui-muted);
    font-size: var(--mt-type-mono, 0.7rem);
    letter-spacing: 0.08em;
    overflow: hidden;
    white-space: nowrap;
  }

  .mt-tui__chrome-title {
    color: var(--tui-bone);
    opacity: 0.75;
  }

  .mt-tui__chrome-sep {
    opacity: 0.4;
  }

  .mt-tui__status-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--tui-green);
    flex-shrink: 0;
    animation: tui-pulse 2.4s ease-in-out infinite;
  }

  @keyframes tui-pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.4; }
  }

  .mt-tui__chrome-status {
    color: var(--tui-green);
    letter-spacing: 0.1em;
  }

  .mt-tui__clock {
    font-size: var(--mt-type-mono, 0.7rem);
    letter-spacing: 0.08em;
    color: var(--tui-gold-dim);
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }

  /* ── Main layout ── */
  .mt-tui__main {
    display: grid;
    grid-template-columns: clamp(14rem, 22vw, 22rem) 1fr;
    gap: 0;
    min-height: 0;
    overflow: hidden;
  }

  @media (max-width: 749px) {
    .mt-tui__main {
      grid-template-columns: 1fr;
      grid-template-rows: auto 1fr;
    }
  }

  /* ── Globe column ── */
  .mt-tui__globe-col {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    padding: 1.5rem 1rem;
    background: var(--tui-bg2);
    border-inline-end: 1px solid var(--tui-border);
    overflow: hidden;
  }

  @media (max-width: 749px) {
    .mt-tui__globe-col {
      border-inline-end: none;
      border-block-end: 1px solid var(--tui-border);
      padding: 1rem;
      flex-direction: row;
      justify-content: flex-start;
      max-height: 12rem;
    }
  }

  .mt-tui__globe-frame {
    position: relative;
    width: min(100%, 220px);
    aspect-ratio: 1;
    border-radius: 50%;
    overflow: hidden;
    border: 1px solid var(--tui-border);
    background: radial-gradient(circle at 40% 35%, rgba(184, 137, 58, 0.18), transparent 65%), #060504;
    box-shadow:
      0 0 0 1px rgba(184, 137, 58, 0.15),
      0 0 40px rgba(184, 137, 58, 0.08),
      inset 0 0 60px rgba(0, 0, 0, 0.6);
  }

  @media (max-width: 749px) {
    .mt-tui__globe-frame {
      width: min(100%, 9rem);
    }
  }

  .mt-tui__globe-wireframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
  }

  .mt-tui__lon-ring {
    animation: mt-globe-spin 9s linear infinite;
    transform-origin: 50px 50px;
  }

  .mt-tui__lon-ring-2 {
    animation: mt-globe-spin-2 9s linear infinite;
    transform-origin: 50px 50px;
  }

  @keyframes mt-globe-spin {
    0% { transform: scaleX(1); opacity: 0.55; }
    50% { transform: scaleX(0.12); opacity: 0.2; }
    100% { transform: scaleX(1); opacity: 0.55; }
  }

  @keyframes mt-globe-spin-2 {
    0% { transform: scaleX(0.7); opacity: 0.3; }
    50% { transform: scaleX(0.98); opacity: 0.55; }
    100% { transform: scaleX(0.7); opacity: 0.3; }
  }

  .mt-tui__node-pulse {
    animation: mt-node-ping 2.2s cubic-bezier(0, 0, 0.2, 1) infinite;
    transform-origin: 68px 42px;
  }

  @keyframes mt-node-ping {
    0% { transform: scale(0.6); opacity: 1; }
    100% { transform: scale(2.6); opacity: 0; }
  }

  .mt-tui__globe-video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    opacity: 0.85;
    mix-blend-mode: lighten;
    z-index: 1;
  }

  .mt-tui__globe-overlay {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 2;
  }

  .mt-tui__globe-scanline {
    position: absolute;
    inset: 0;
    background: repeating-linear-gradient(
      0deg,
      transparent,
      transparent 2px,
      rgba(0, 0, 0, 0.12) 2px,
      rgba(0, 0, 0, 0.12) 4px
    );
  }

  .mt-tui__globe-meta {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.25rem;
    font-size: var(--mt-type-mono, 0.68rem);
    letter-spacing: 0.1em;
    color: var(--tui-muted);
    text-align: center;
  }

  @media (max-width: 749px) {
    .mt-tui__globe-meta {
      align-items: flex-start;
    }
  }

  .mt-tui__globe-ping {
    color: var(--tui-green);
    animation: tui-pulse 3s ease-in-out infinite;
  }

  /* ── Terminal panel ── */
  .mt-tui__terminal {
    display: grid;
    grid-template-rows: auto auto auto 1fr auto;
    overflow: hidden;
    background: var(--tui-bg);
  }

  .mt-tui__term-header {
