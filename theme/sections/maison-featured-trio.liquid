{% comment %}
  Homepage featured trio — merchant picks three products in the theme editor:
  (1) flagship pan, (2) service / maintenance kit, (3) secondary flagship from
  a secondary pod. No hard-coded SKUs.
{% endcomment %}

{% liquid
  assign product_1 = section.settings.product_1
  assign product_2 = section.settings.product_2
  assign product_3 = section.settings.product_3
  assign has_any = false
  if product_1 != blank or product_2 != blank or product_3 != blank
    assign has_any = true
  endif
%}

<div
  class="section section--page-width spacing-style maison-featured-trio"
  style="{% render 'spacing-style', settings: section.settings %}"
  data-mt-chapter
>
  <header class="maison-featured-trio__header" data-mt-scroll="chapter">
    {% if section.settings.eyebrow != blank %}
      <p class="maison-featured-trio__eyebrow">{{ section.settings.eyebrow | escape }}</p>
    {% endif %}
    {% if section.settings.heading != blank %}
      <h2
        class="maison-featured-trio__heading"
        data-mt-scroll="kinetic"
        aria-label="{{ section.settings.heading | escape }}"
      >
        {{ section.settings.heading | escape }}
      </h2>
    {% endif %}
    {% if section.settings.lede != blank %}
      <p class="maison-featured-trio__lede">{{ section.settings.lede | escape }}</p>
    {% endif %}
  </header>

  {% if has_any %}
    <ul class="maison-featured-trio__grid" role="list" data-mt-scroll="stagger">
      {% for i in (1..3) %}
        {% liquid
          case i
            when 1
              assign product = product_1
              assign role_label = section.settings.label_1
            when 2
              assign product = product_2
              assign role_label = section.settings.label_2
            else
              assign product = product_3
              assign role_label = section.settings.label_3
          endcase
        %}
        {% if product != blank %}
          <li class="maison-featured-trio__item" data-mt-scroll-item>
            {% if role_label != blank %}
              <p class="maison-featured-trio__role">{{ role_label | escape }}</p>
            {% endif %}
            {% render 'resource-card',
              resource: product,
              resource_type: 'product',
              image_aspect_ratio: '4 / 5',
              image_sizes: '(min-width: 990px) 28vw, (min-width: 750px) 40vw, 90vw'
            %}
          </li>
        {% endif %}
      {% endfor %}
    </ul>
  {% else %}
    <ul class="maison-featured-trio__grid" role="list" data-mt-scroll="stagger">
      <li class="maison-featured-trio__item" data-mt-scroll-item>
        <p class="maison-featured-trio__role">{{ section.settings.label_1 | default: 'Flagship Pan' | escape }}</p>
        <div class="resource-card">
          <a class="resource-card__link" href="/collections/cookware">
            <span class="visually-hidden">The Flagship Kadhai</span>
          </a>
          <div class="resource-card__media" style="--image-aspect-ratio: 4 / 5;">
            <img
              class="resource-card__image"
              src="{{ 'maison-flagship-kadai.webp' | asset_url }}"
              alt="The Flagship Kadhai — Bell Bronze and Carbon Steel"
              width="1200"
              height="1500"
              loading="lazy"
            >
          </div>
          <div class="resource-card__content">
            <h3 class="resource-card__title">The Flagship Kadhai</h3>
            <p class="resource-card__subtitle">78:22 Bell Bronze &amp; Carbon Steel</p>
          </div>
        </div>
      </li>
      <li class="maison-featured-trio__item" data-mt-scroll-item>
        <p class="maison-featured-trio__role">{{ section.settings.label_2 | default: 'Slow-Heat Clay' | escape }}</p>
        <div class="resource-card">
          <a class="resource-card__link" href="/collections/cookware">
            <span class="visually-hidden">Terre Clay Open Vessel</span>
          </a>
          <div class="resource-card__media" style="--image-aspect-ratio: 4 / 5;">
            <img
              class="resource-card__image"
              src="{{ 'maison-clay-openpot.webp' | asset_url }}"
              alt="Terre Clay Open Vessel — Refractory Stoneware"
              width="1200"
              height="1500"
              loading="lazy"
            >
          </div>
          <div class="resource-card__content">
            <h3 class="resource-card__title">Terre Clay Open Vessel</h3>
            <p class="resource-card__subtitle">Hand-Turned Refractory Stoneware</p>
          </div>
        </div>
      </li>
      <li class="maison-featured-trio__item" data-mt-scroll-item>
        <p class="maison-featured-trio__role">{{ section.settings.label_3 | default: 'Secondary Flagship' | escape }}</p>
        <div class="resource-card">
          <a class="resource-card__link" href="/collections/cookware">
            <span class="visually-hidden">The Foundry High Pot</span>
          </a>
          <div class="resource-card__media" style="--image-aspect-ratio: 4 / 5;">
            <img
              class="resource-card__image"
              src="{{ 'maison-highpot-set.webp' | asset_url }}"
              alt="The Foundry High Pot — Dual-Mass Lathe Spun with Lid"
              width="1200"
              height="1500"
              loading="lazy"
            >
          </div>
          <div class="resource-card__content">
            <h3 class="resource-card__title">The Foundry High Pot</h3>
            <p class="resource-card__subtitle">Dual-Mass Lathe Spun with Lid</p>
          </div>
        </div>
      </li>
    </ul>
  {% endif %}
</div>

{% stylesheet %}
  .maison-featured-trio {
    color: var(--color-foreground);
  }

  .maison-featured-trio__header {
    max-width: 40rem;
    margin-block-end: clamp(1.5rem, 3vw, 2.25rem);
  }

  .maison-featured-trio__eyebrow {
    margin: 0;
    font-family: var(--mt-type-family-mono, var(--font-mono--family));
    font-size: var(--mt-type-accent, var(--font-size--xs));
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-foreground-muted);
  }

  .maison-featured-trio__heading {
    margin-block: 0.75rem 1rem;
    font-family: var(--mt-type-family-heading, var(--font-heading--family));
    font-weight: var(--font-heading--weight);
  }

  .maison-featured-trio__lede {
    margin: 0;
    color: var(--color-foreground-muted);
    line-height: 1.55;
    max-width: 36rem;
  }

  .maison-featured-trio__grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1.75rem 1.5rem;
    grid-template-columns: 1fr;
  }

  @media screen and (min-width: 750px) {
    .maison-featured-trio__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .maison-featured-trio__role {
    margin: 0 0 0.65rem;
    font-family: var(--mt-type-family-mono, var(--font-mono--family));
    font-size: var(--mt-type-accent, var(--font-size--xs));
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-foreground-muted);
  }

  .maison-featured-trio__empty {
    margin: 0;
    color: var(--color-foreground-muted);
  }

  @media (prefers-reduced-motion: reduce) {
    .maison-featured-trio [data-mt-scroll],
    .maison-featured-trio [data-mt-scroll-item] {
      opacity: 1 !important;
      transform: none !important;
      visibility: visible !important;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.maison_featured_trio",
  "tag": "section",
  "class": "section-wrapper",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:settings.maison_eyebrow",
      "default": "Three for the pass"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:settings.heading",
      "default": "Featured pieces"
    },
    {
      "type": "textarea",
      "id": "lede",
      "label": "t:settings.maison_lede",
      "default": "A flagship pan, the care kit that keeps it honest, and one secondary piece from another pod."
    },
    {
      "type": "header",
      "content": "Product 1 · Flagship pan"
    },
    {
      "type": "text",
      "id": "label_1",
      "label": "Role label",
      "default": "Flagship pan"
    },
    {
      "type": "product",
      "id": "product_1",
      "label": "Product"
    },
    {
      "type": "header",
      "content": "Product 2 · Service kit"
    },
    {
      "type": "text",
      "id": "label_2",
      "label": "Role label",
      "default": "Service & maintenance"
    },
    {
      "type": "product",
      "id": "product_2",
      "label": "Product"
    },
    {
      "type": "header",
      "content": "Product 3 · Secondary flagship"
    },
    {
      "type": "text",
      "id": "label_3",
      "label": "Role label",
      "default": "Secondary pod"
    },
    {
      "type": "product",
      "id": "product_3",
      "label": "Product"
    },
    {
      "type": "paragraph",
      "content": "Pick products in the theme editor. Leave blank until catalogue SKUs are ready — nothing is hard-coded."
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 48
    }
  ],
  "presets": [
    {
      "name": "t:names.maison_featured_trio",
      "category": "t:categories.collection"
    }
  ]
}
{% endschema %}
