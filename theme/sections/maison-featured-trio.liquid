<div
  class="section section--page-width spacing-style maison-featured-trio"
  style="{% render 'spacing-style', settings: section.settings %}"
  data-mt-chapter
>
  <header class="maison-featured-trio__header" data-mt-scroll="chapter">
    {% if section.settings.eyebrow != blank %}
      <p class="maison-featured-trio__eyebrow">{{ section.settings.eyebrow | escape }}</p>
    {% endif %}
    {% if section.settings.heading != blank %}
      <h2
        class="maison-featured-trio__heading"
        data-mt-scroll="kinetic"
        aria-label="{{ section.settings.heading | escape }}"
      >
        {{ section.settings.heading | escape }}
      </h2>
    {% endif %}
    {% if section.settings.lede != blank %}
      <p class="maison-featured-trio__lede">{{ section.settings.lede | escape }}</p>
    {% endif %}
  </header>

  <ul class="maison-featured-trio__grid" role="list" data-mt-scroll="stagger">
    {% assign range_handles = 'forge,chulha,maintenance' | split: ',' %}
    {% for handle in range_handles %}
      {% liquid
        assign product_key = 'product_' | append: forloop.index
        assign label_key = 'label_' | append: forloop.index
        assign featured_product = section.settings[product_key]
        assign role_label = section.settings[label_key]
        assign range_url = collections[handle].url | default: routes.collections_url

        case handle
          when 'forge'
            assign range_title = 'Forge'
            assign range_description = 'Clad steel for the hot work.'
            assign range_image = 'maison-range-forge.webp'
            assign image_alt = 'Nested stainless steel pans on a working stove'
            assign image_width = 720
            assign image_height = 900
          when 'chulha'
            assign range_title = 'Chulha'
            assign range_description = 'Terracotta studies for chai, rice and the table.'
            assign range_image = 'maison-range-chulha.webp'
            assign image_alt = 'Two hands holding an unglazed terracotta vessel'
            assign image_width = 900
            assign image_height = 900
          when 'maintenance'
            assign range_title = 'Maintenance'
            assign range_description = 'The right lid. The right care for the surface.'
            assign range_image = 'maison-concept-care-kit.jpg'
            assign image_alt = 'Illustrative care kit with balm, brush, cloth and scraper'
            assign image_width = 447
            assign image_height = 447
        endcase
      %}
      <li class="maison-featured-trio__item" data-mt-scroll-item>
        {% if role_label != blank %}
          <p class="maison-featured-trio__role">{{ role_label | escape }}</p>
        {% endif %}
        {% if featured_product != blank %}
            {% render 'resource-card',
              resource: featured_product,
              resource_type: 'product',
              image_aspect_ratio: '4 / 5',
              image_sizes: '(min-width: 990px) 28vw, (min-width: 750px) 40vw, 90vw'
            %}
        {% else %}
          <div class="resource-card">
            <a class="resource-card__link" href="{{ range_url }}">
              <span class="visually-hidden">{{ range_title }}</span>
            </a>
            <div class="resource-card__media" style="--image-aspect-ratio: 4 / 5;">
              <img
                class="resource-card__image"
                src="{{ range_image | asset_url }}"
                alt="{{ image_alt }}"
                width="{{ image_width }}"
                height="{{ image_height }}"
                loading="lazy"
                decoding="async"
              >
            </div>
            <div class="resource-card__content">
              <h3 class="resource-card__title">{{ range_title }}</h3>
              <p class="resource-card__subtitle">{{ range_description }}</p>
            </div>
          </div>
        {% endif %}
      </li>
    {% endfor %}
  </ul>
</div>

{% stylesheet %}
  .maison-featured-trio {
    color: var(--color-foreground);
  }

  .maison-featured-trio__header {
    max-width: 40rem;
    margin-block-end: clamp(1.5rem, 3vw, 2.25rem);
  }

  .maison-featured-trio__eyebrow {
    margin: 0;
    font-family: var(--mt-type-family-mono, var(--font-mono--family));
    font-size: var(--mt-type-accent, var(--font-size--xs));
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-foreground-muted);
  }

  .maison-featured-trio__heading {
    margin-block: 0.75rem 1rem;
    font-family: var(--mt-type-family-heading, var(--font-heading--family));
    font-weight: var(--font-heading--weight);
  }

  .maison-featured-trio__lede {
    margin: 0;
    color: var(--color-foreground-muted);
    line-height: 1.55;
    max-width: 36rem;
  }

  .maison-featured-trio__grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1.75rem 1.5rem;
    grid-template-columns: 1fr;
  }

  @media screen and (min-width: 750px) {
    .maison-featured-trio__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .maison-featured-trio__role {
    margin: 0 0 0.65rem;
    font-family: var(--mt-type-family-mono, var(--font-mono--family));
    font-size: var(--mt-type-accent, var(--font-size--xs));
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-foreground-muted);
  }

  .maison-featured-trio__empty {
    margin: 0;
    color: var(--color-foreground-muted);
  }

  @media (prefers-reduced-motion: reduce) {
    .maison-featured-trio [data-mt-scroll],
    .maison-featured-trio [data-mt-scroll-item] {
      opacity: 1 !important;
      transform: none !important;
      visibility: visible !important;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.maison_featured_trio",
  "tag": "section",
  "class": "section-wrapper",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:settings.maison_eyebrow",
      "default": "Three for the pass"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:settings.heading",
      "default": "Featured pieces"
    },
    {
      "type": "textarea",
      "id": "lede",
      "label": "t:settings.maison_lede",
      "default": "A flagship pan, the care kit that keeps it honest, and one secondary piece from another pod."
    },
    {
      "type": "header",
      "content": "Product 1 · Flagship pan"
    },
    {
      "type": "text",
      "id": "label_1",
      "label": "Role label",
      "default": "Flagship pan"
    },
    {
      "type": "product",
      "id": "product_1",
      "label": "Product"
    },
    {
      "type": "header",
      "content": "Product 2 · Service kit"
    },
    {
      "type": "text",
      "id": "label_2",
      "label": "Role label",
      "default": "Service & maintenance"
    },
    {
      "type": "product",
      "id": "product_2",
      "label": "Product"
    },
    {
      "type": "header",
      "content": "Product 3 · Secondary flagship"
    },
    {
      "type": "text",
      "id": "label_3",
      "label": "Role label",
      "default": "Secondary pod"
    },
    {
      "type": "product",
      "id": "product_3",
      "label": "Product"
    },
    {
      "type": "paragraph",
      "content": "Pick products to feature. An empty slot links to its material or care range."
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 48
    }
  ],
  "presets": [
    {
      "name": "t:names.maison_featured_trio",
      "category": "t:categories.collection"
    }
  ]
}
{% endschema %}
