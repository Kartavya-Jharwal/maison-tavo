{% comment %}
  Heat Made Visible — densified 2D FTCS heat maps + WebGPU FlameWrap / Blaze profile.
  First-frame rule: SVG posters / HTML content paint immediately; canvas & GPU take over after ready.
  Lazy asset: assets/maison-heat.js (only on this section / heat page).
{% endcomment %}

<script src="{{ 'maison-heat.js' | asset_url }}" defer></script>

<div class="maison-thermal section section--page-width" data-mt-chapter data-mt-heat-page data-mt-no-idle-blaze>
  <header class="maison-thermal__header" data-mt-scroll="chapter">
    {% if section.settings.kicker != blank %}
      <p class="maison-thermal__kicker">{{ section.settings.kicker | escape }}</p>
    {% endif %}
    <h2
      class="maison-thermal__heading"
      id="maison-thermal-heading-{{ section.id }}"
    >
      {{ section.settings.heading | escape }}
    </h2>
    <p class="maison-thermal__lede">{{ section.settings.lede | escape }}</p>
  </header>

  {%- comment -%} FlameWrap hero card — HTML poster first, GPU overlay after ready {%- endcomment -%}
  <div
    class="maison-thermal__flame mt-fx-stage"
    data-mt-flame-wrap
    data-mt-scroll="beat"
  >
    <canvas
      class="mt-fx-stage__source"
      data-mt-fx-source
      layoutsubtree
      aria-hidden="true"
    >
      <div class="mt-fx-stage__content" data-mt-fx-content aria-hidden="true" id="mt-heat-flame-content-{{ section.id }}">
        <article class="maison-thermal__flame-card">
          <p class="maison-thermal__flame-kicker">Comparative map</p>
          <h3 class="maison-thermal__flame-title">Heat on the base</h3>
          <p class="maison-thermal__flame-copy">
            Side-by-side automations of how a burner loads the pan — composite mass vs thin steel.
          </p>
        </article>
      </div>
    </canvas>
    <div class="mt-fx-stage__poster">
      <article class="maison-thermal__flame-card">
        <p class="maison-thermal__flame-kicker">Comparative map</p>
        <h3 class="maison-thermal__flame-title">Heat on the base</h3>
        <p class="maison-thermal__flame-copy">
          Side-by-side automations of how a burner loads the pan — composite mass vs thin steel.
        </p>
      </article>
    </div>
    <canvas class="mt-fx-stage__output" data-mt-fx-output aria-hidden="true"></canvas>
  </div>

  <maison-thermal
    class="maison-thermal__app"
    aria-labelledby="maison-thermal-heading-{{ section.id }}"
  >
    <fieldset class="maison-thermal__sources" data-mt-scroll="beat">
      <legend class="maison-thermal__legend">Stovetop profile</legend>
      <label>
        <input type="radio" name="thermal-src-{{ section.id }}" value="induction" checked>
        <span>Induction · flat ring</span>
      </label>
      <label>
        <input type="radio" name="thermal-src-{{ section.id }}" value="gas">
        <span>Gas · jet ring</span>
      </label>
      <label>
        <input type="radio" name="thermal-src-{{ section.id }}" value="coil">
        <span>Coil · spiral</span>
      </label>
      <label>
        <input type="radio" name="thermal-src-{{ section.id }}" value="ceramic">
        <span>Ceramic · radiant</span>
      </label>
      <label>
        <input type="radio" name="thermal-src-{{ section.id }}" value="charcoal">
        <span>Charcoal · bed</span>
      </label>
    </fieldset>

    <fieldset class="maison-thermal__modes" data-mt-scroll="beat">
      <legend class="maison-thermal__legend">Heat map mode</legend>
      <label>
        <input type="radio" name="thermal-mode-{{ section.id }}" value="central" checked>
        <span>Central ideal</span>
      </label>
      <label>
        <input type="radio" name="thermal-mode-{{ section.id }}" value="dead_spots">
        <span>Dead spots</span>
      </label>
      <label>
        <input type="radio" name="thermal-mode-{{ section.id }}" value="ring_edge">
        <span>Ring / edge bias</span>
      </label>
      <label>
        <input type="radio" name="thermal-mode-{{ section.id }}" value="uneven">
        <span>Uneven hotspots</span>
      </label>
    </fieldset>

    <div class="maison-thermal__plates" data-mt-scroll="stagger">
      <figure class="maison-thermal__plate" data-mt-scroll-item>
        <div class="maison-thermal__canvas-frame" data-mt-scrub="10">
          {%- comment -%} Static first-frame heatmap (correct 1:1 aspect) {%- endcomment -%}
          <svg
            class="maison-thermal__poster"
            viewBox="0 0 64 64"
            width="64"
            height="64"
            role="presentation"
            aria-hidden="true"
            focusable="false"
          >
            <defs>
              <radialGradient id="mt-poster-comp-{{ section.id }}" cx="50%" cy="48%" r="48%">
                <stop offset="0%" stop-color="#f7f5f0"/>
                <stop offset="35%" stop-color="#c58b43"/>
                <stop offset="70%" stop-color="#a45a3d"/>
                <stop offset="100%" stop-color="#121212"/>
              </radialGradient>
            </defs>
            <circle cx="32" cy="32" r="31" fill="url(#mt-poster-comp-{{ section.id }})"/>
          </svg>
          <canvas
            width="64"
            height="64"
            data-plate="composite"
            role="img"
            aria-label="Heat map: kansa and clay composite base"
          ></canvas>
        </div>
        <figcaption>
          <span>Kansa × clay</span>
          <output data-spread="composite" aria-live="polite">Spread index unavailable</output>
        </figcaption>
      </figure>
      <figure class="maison-thermal__plate" data-mt-scroll-item>
        <div class="maison-thermal__canvas-frame" data-mt-scrub="10">
          <svg
            class="maison-thermal__poster"
            viewBox="0 0 64 64"
            width="64"
            height="64"
            role="presentation"
            aria-hidden="true"
            focusable="false"
          >
            <defs>
              <radialGradient id="mt-poster-steel-{{ section.id }}" cx="42%" cy="40%" r="55%">
                <stop offset="0%" stop-color="#f7f5f0"/>
                <stop offset="18%" stop-color="#e2552b"/>
                <stop offset="45%" stop-color="#5a281e"/>
                <stop offset="100%" stop-color="#121212"/>
              </radialGradient>
            </defs>
            <circle cx="32" cy="32" r="31" fill="url(#mt-poster-steel-{{ section.id }})"/>
          </svg>
          <canvas
            width="64"
            height="64"
            data-plate="steel"
            role="img"
            aria-label="Heat map: thin commercial steel base"
          ></canvas>
        </div>
        <figcaption>
          <span>1 mm steel</span>
          <output data-spread="steel" aria-live="polite">Spread index unavailable</output>
        </figcaption>
      </figure>
    </div>
    <p class="maison-thermal__note">
      The maps simulate conduction across each pan base. The spread index describes the model on a relative scale.
    </p>
  </maison-thermal>

  {%- comment -%} Blaze profile — bottom-heat rising through a short read {%- endcomment -%}
  <div
    class="maison-thermal__blaze mt-fx-stage mt-fx-stage--blaze"
    data-mt-blaze-profile
    data-mt-heat-blaze
    data-mt-scroll="beat"
  >
    <canvas
      class="mt-fx-stage__source"
      data-mt-fx-source
      layoutsubtree
      aria-hidden="true"
    >
      <div class="mt-fx-stage__content" data-mt-fx-content aria-hidden="true" id="mt-heat-blaze-content-{{ section.id }}">
        <div class="maison-thermal__blaze-copy">
          <p class="maison-thermal__flame-kicker">Profile · bottom heat</p>
          <h3 class="maison-thermal__flame-title">Mass spreads. Thin steel concentrates.</h3>
          <p>
            Under the same burner profile, the composite base equalizes surface ΔT; thin steel keeps a sharp hotspot that scorches first.
          </p>
        </div>
      </div>
    </canvas>
    <div class="mt-fx-stage__poster">
      <div class="maison-thermal__blaze-copy">
        <p class="maison-thermal__flame-kicker">Profile · bottom heat</p>
        <h3 class="maison-thermal__flame-title">Mass spreads. Thin steel concentrates.</h3>
        <p>
          Under the same burner profile, the composite base equalizes surface ΔT; thin steel keeps a sharp hotspot that scorches first.
        </p>
      </div>
    </div>
    <canvas class="mt-fx-stage__output" data-mt-fx-output aria-hidden="true"></canvas>
  </div>
</div>

{% stylesheet %}
  .maison-thermal {
    padding-block: clamp(1.75rem, 4vw, 3.5rem);
  }

  .maison-thermal__header {
    display: grid;
    gap: 0.65rem;
    max-width: 36rem;
    margin-block-end: clamp(1.5rem, 3vw, 2.5rem);
  }

  .maison-thermal__kicker,
  .maison-thermal__note,
  .maison-thermal__plate figcaption,
  .maison-thermal__legend,
  .maison-thermal__flame-kicker {
    margin: 0;
    font-family: var(--mt-type-family-mono);
    font-size: var(--mt-type-accent);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgb(var(--color-foreground-rgb) / 0.68);
    font-variant-numeric: tabular-nums;
  }

  .maison-thermal__heading {
    margin: 0;
    font-family: var(--mt-type-family-heading);
    font-size: var(--mt-type-heading);
    font-weight: 400;
    line-height: 1.12;
    letter-spacing: var(--mt-type-tracking-heading);
    font-kerning: normal;
    font-variant-ligatures: common-ligatures contextual no-discretionary-ligatures;
    text-wrap: balance;
    overflow-wrap: anywhere;
  }

  .maison-thermal__lede {
    margin: 0;
    max-inline-size: 58ch;
    font-size: clamp(1.0625rem, 1rem + 0.25vw, 1.1875rem);
    line-height: var(--mt-type-leading-body);
  }

  @media (prefers-reduced-motion: reduce) {
    .maison-thermal [data-mt-scroll] {
      opacity: 1 !important;
      transform: none !important;
      visibility: visible !important;
    }
  }

  html[data-reduced-motion='true'] .maison-thermal [data-mt-scroll] {
    opacity: 1 !important;
    transform: none !important;
    visibility: visible !important;
  }

  .maison-thermal__sources,
  .maison-thermal__modes {
    display: flex;
    flex-wrap: wrap;
    min-inline-size: 0;
    gap: 0.45rem;
    margin: 0 0 1rem;
    padding: 0;
    border: 0;
  }

  .maison-thermal__legend {
    flex: 0 0 100%;
    margin-block-end: 0.35rem;
  }

  .maison-thermal__sources label,
  .maison-thermal__modes label {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    min-height: 44px;
    padding: 0 1rem;
    border: 1px solid rgb(var(--color-foreground-rgb) / 0.22);
    border-radius: 999px;
    font-size: max(0.875rem, var(--mt-type-nav));
    letter-spacing: 0.01em;
    cursor: pointer;
    transition: background 160ms ease, color 160ms ease, border-color 160ms ease;
  }

  .maison-thermal__sources label:has(:checked),
  .maison-thermal__modes label:has(:checked) {
    background: var(--color-foreground);
    color: var(--color-background);
    border-color: var(--color-foreground);
  }

  .maison-thermal__sources label:has(:focus-visible),
  .maison-thermal__modes label:has(:focus-visible) {
    outline: 2px solid var(--bell, #b8893a);
    outline-offset: 2px;
  }

  .maison-thermal__sources input,
  .maison-thermal__modes input {
    position: absolute;
    opacity: 0;
    width: 1px;
    height: 1px;
    pointer-events: none;
  }

  .maison-thermal__plates {
    display: grid;
    gap: clamp(1.25rem, 3vw, 2.75rem);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 24rem));
    justify-content: center;
  }

  .maison-thermal__plate {
    display: grid;
    gap: 0.7rem;
    margin: 0;
  }

  .maison-thermal__canvas-frame {
    position: relative;
    aspect-ratio: 1;
    border-radius: 50%;
    background:
      radial-gradient(circle at 50% 42%, rgb(255 255 255 / 0.06), transparent 55%),
      var(--brand-color-obsidian-charcoal, #121212);
    box-shadow:
      inset 0 0 0 1px rgb(var(--color-foreground-rgb) / 0.18),
      inset 0 0 0 6px rgb(var(--color-foreground-rgb) / 0.04),
      0 12px 28px rgb(0 0 0 / 0.12);
    overflow: hidden;
  }

  .maison-thermal__canvas-frame::after {
    content: '';
    position: absolute;
    inset: 7%;
    border-radius: 50%;
    border: 1px solid rgb(var(--color-foreground-rgb) / 0.12);
    pointer-events: none;
    z-index: 3;
  }

  .maison-thermal__poster {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border-radius: 50%;
    z-index: 1;
    transition: opacity 220ms ease;
  }

  .maison-thermal__canvas-frame.is-sim-ready .maison-thermal__poster {
    opacity: 0;
    pointer-events: none;
  }

  .maison-thermal__plate canvas {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    border-radius: 50%;
    image-rendering: pixelated;
    image-rendering: crisp-edges;
    opacity: 0;
    z-index: 2;
    transition: opacity 220ms ease;
  }

  .maison-thermal__canvas-frame.is-sim-ready canvas {
    opacity: 1;
  }

  .maison-thermal__plate figcaption {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.35rem 0.75rem;
    font-size: max(0.75rem, var(--mt-type-mono));
    letter-spacing: 0.03em;
    text-transform: none;
  }

  .maison-thermal__plate output {
    color: var(--bell, #b8893a);
  }

  .maison-thermal__note {
    margin-block-start: 1.15rem;
    max-inline-size: 60ch;
    font-family: var(--mt-type-family-body);
    font-size: max(0.875rem, var(--mt-type-nav));
    line-height: var(--mt-type-leading-body);
    letter-spacing: normal;
    text-transform: none;
  }

  /* GPU stages — poster HTML first, output fades in when ready */
  .mt-fx-stage {
    position: relative;
    margin-block: clamp(1.5rem, 3vw, 2.75rem);
    min-height: 12rem;
  }

  .mt-fx-stage__source {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    pointer-events: none;
  }

  .mt-fx-stage__poster,
  .mt-fx-stage__content {
    position: relative;
    z-index: 1;
    width: 100%;
  }

  .mt-fx-stage__output {
    position: absolute;
    inset: -4rem -1.5rem -1.5rem;
    width: calc(100% + 3rem);
    height: calc(100% + 5.5rem);
    pointer-events: none;
    opacity: 0;
    z-index: 2;
    transition: opacity 320ms ease;
  }

  .mt-fx-stage--blaze .mt-fx-stage__output {
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .mt-fx-stage.is-fx-ready .mt-fx-stage__output {
    opacity: 1;
  }

  /* Keep the card poster visible so text, headings and kickers remain readable.
     Only hide the poster if experimental html-in-canvas actually captured the DOM into WebGPU. */
  .mt-fx-stage[data-mt-html-captured='true'] .mt-fx-stage__poster {
    opacity: 0;
    pointer-events: none;
  }

  /* Ambient glowing flame atmosphere on the card frames */
  .maison-thermal__flame-card,
  .maison-thermal__blaze-copy {
    position: relative;
    box-sizing: border-box;
    padding: clamp(1.25rem, 3vw, 2rem);
    border-radius: 1.75rem;
    background:
      radial-gradient(120% 80% at 50% 100%, rgba(226, 85, 43, 0.12) 0%, transparent 60%),
      rgb(var(--color-foreground-rgb) / 0.04);
    border: 1px solid rgba(184, 137, 58, 0.35);
    box-shadow:
      0 0 24px rgba(226, 85, 43, 0.12),
      inset 0 0 16px rgba(184, 137, 58, 0.08);
    max-width: 36rem;
    transition: box-shadow 0.4s ease, border-color 0.4s ease;
  }

  .mt-fx-stage.is-fx-ready .maison-thermal__flame-card,
  .mt-fx-stage.is-fx-ready .maison-thermal__blaze-copy {
    border-color: rgba(226, 85, 43, 0.55);
    box-shadow:
      0 0 36px rgba(226, 85, 43, 0.22),
      0 0 8px rgba(184, 137, 58, 0.35),
      inset 0 0 20px rgba(226, 85, 43, 0.1);
  }

  .maison-thermal__flame-title {
    margin: 0.4rem 0 0.65rem;
    font-family: var(--mt-type-family-heading);
    font-size: var(--mt-type-title, 1.5rem);
    font-weight: 400;
    line-height: 1.15;
  }

  .maison-thermal__flame-copy,
  .maison-thermal__blaze-copy p {
    margin: 0;
    line-height: 1.55;
    color: rgb(var(--color-foreground-rgb) / 0.88);
  }

  .mt-fx-stage--blaze {
    min-height: 16rem;
    padding-block-end: 2rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .maison-thermal__sources label,
    .maison-thermal__modes label,
    .maison-thermal__poster,
    .maison-thermal__plate canvas,
    .mt-fx-stage__output,
    .mt-fx-stage__poster {
      transition: none;
    }
  }
{% endstylesheet %}

{% javascript %}
  if (!customElements.get('maison-thermal')) {
    const N = 64;
    const RAMP = [
      [18, 18, 18],
      [90, 40, 30],
      [164, 90, 61],
      [197, 139, 67],
      [247, 245, 240],
    ];
    const MATERIALS = {
      composite: { alpha: 0.24, loss: 0.0016, label: 'kansa and clay composite' },
      steel: { alpha: 0.035, loss: 0.0016, label: 'thin commercial steel' },
    };
    const SOURCE_LABEL = {
      induction: 'induction flat ring',
      gas: 'gas jet ring',
      coil: 'electric coil',
      ceramic: 'ceramic radiant plate',
      charcoal: 'charcoal bed',
    };
    const MODE_LABEL = {
      central: 'central ideal',
      dead_spots: 'dead spots',
      ring_edge: 'ring and edge bias',
      uneven: 'uneven hotspots',
    };

    function sourceMap(kind, mode) {
      const map = new Float32Array(N * N);
      const c = (N - 1) / 2;
      for (let y = 0; y < N; y++) {
        for (let x = 0; x < N; x++) {
          const r = Math.hypot(x - c, y - c) / c;
          const a = Math.atan2(y - c, x - c);
          let q = 0;
          if (kind === 'induction') q = Math.exp(-((r - 0.42) ** 2) / 0.014);
          else if (kind === 'gas') q = Math.exp(-((r - 0.3) ** 2) / 0.005) * (0.55 + 0.45 * Math.cos(a * 12));
          else if (kind === 'coil') {
            const spiral = Math.abs(Math.sin((r * 9 + a * 0.35) * Math.PI));
            q = Math.exp(-(r ** 2) / 0.55) * (0.35 + 0.65 * spiral);
          } else if (kind === 'ceramic') q = Math.exp(-(r ** 2) / 0.28) * (0.85 + 0.15 * Math.cos(a * 2));
          else if (kind === 'charcoal') {
            q = Math.exp(-(r ** 2) / 0.05) * (0.7 + 0.3 * Math.sin(x * 1.7) * Math.cos(y * 1.3));
          }

          if (mode === 'central') q *= Math.exp(-(r ** 2) / 0.55);
          else if (mode === 'dead_spots') {
            const d1 = Math.hypot(x - c * 0.55, y - c * 1.15);
            const d2 = Math.hypot(x - c * 1.35, y - c * 0.7);
            q *= 1 - 0.85 * Math.exp(-(d1 ** 2) / 18) - 0.75 * Math.exp(-(d2 ** 2) / 22);
          } else if (mode === 'ring_edge') q *= 0.25 + 0.95 * Math.exp(-((r - 0.72) ** 2) / 0.03);
          else if (mode === 'uneven') {
            q *=
              0.55 +
              0.55 * Math.exp(-((x - c * 0.7) ** 2 + (y - c * 0.55) ** 2) / 40) +
              0.7 * Math.exp(-((x - c * 1.25) ** 2 + (y - c * 1.2) ** 2) / 28);
          }

          map[y * N + x] = r <= 1 ? Math.max(0, q) * 0.02 : 0;
        }
      }
      return map;
    }

    function inside(x, y) {
      const c = (N - 1) / 2;
      return Math.hypot(x - c, y - c) <= c;
    }

    function prefersReduced() {
      return (
        matchMedia('(prefers-reduced-motion: reduce)').matches ||
        document.documentElement.dataset.reducedMotion === 'true'
      );
    }

    customElements.define(
      'maison-thermal',
      class MaisonThermal extends HTMLElement {
        connectedCallback() {
          this.reduced = prefersReduced();
          this.sourceKind = 'induction';
          this.mapMode = 'central';
          this.plates = [...this.querySelectorAll('canvas[data-plate]')].map((canvas) => {
            const ctx = canvas.getContext('2d', { alpha: true });
            ctx.imageSmoothingEnabled = false;
            const frame = canvas.closest('.maison-thermal__canvas-frame');
            return {
              canvas,
              ctx,
              frame,
              image: ctx.createImageData(N, N),
              material: MATERIALS[canvas.dataset.plate],
              key: canvas.dataset.plate,
              output: this.querySelector(`[data-spread="${canvas.dataset.plate}"]`),
              t: new Float32Array(N * N),
              next: new Float32Array(N * N),
            };
          });

          // SVG poster is the first frame (correct 1:1 aspect). Canvas takes over
          // after the first draw — never leave an empty circle.
          this.setSource(
            this.querySelector('input[name^="thermal-src"]:checked')?.value || 'induction',
            this.querySelector('input[name^="thermal-mode"]:checked')?.value || 'central',
          );

          this.addEventListener('change', (event) => {
            const t = event.target;
            if (!t?.name) return;
            if (t.name.startsWith('thermal-src-')) this.setSource(t.value, this.mapMode);
            if (t.name.startsWith('thermal-mode-')) this.setSource(this.sourceKind, t.value);
          });

          this.motionQuery = matchMedia('(prefers-reduced-motion: reduce)');
          this.onMotionChange = () => {
            this.reduced = prefersReduced();
            this.setSource(this.sourceKind, this.mapMode);
          };
          this.motionQuery.addEventListener?.('change', this.onMotionChange);
          document.addEventListener('maison:reduced-motion', this.onMotionChange);

          this.observer = new IntersectionObserver(([entry]) => {
            this.visible = entry.isIntersecting;
            if (this.visible) this.start();
            else this.stop();
          });
          this.observer.observe(this);

          this.onPageLeave = () => this.stop();
          document.addEventListener('maison:page-leave', this.onPageLeave);
        }

        disconnectedCallback() {
          this.observer?.disconnect();
          this.motionQuery?.removeEventListener?.('change', this.onMotionChange);
          document.removeEventListener('maison:reduced-motion', this.onMotionChange);
          document.removeEventListener('maison:page-leave', this.onPageLeave);
          this.stop();
        }

        stop() {
          cancelAnimationFrame(this.frame);
          this.frame = 0;
          this.running = false;
        }

        setSource(kind, mode) {
          this.sourceKind = kind;
          this.mapMode = mode;
          this.source = sourceMap(kind, mode);
          this.plates.forEach((plate) => {
            plate.t.fill(0);
            plate.next.fill(0);
            plate.frame?.classList.remove('is-sim-ready');
          });
          this.stop();

          if (this.reduced) {
            for (let i = 0; i < 600; i++) this.step();
            this.draw();
            this.plates.forEach((plate) => plate.frame?.classList.add('is-sim-ready'));
            return;
          }

          // Warm a light first canvas frame on the next paint, then animate.
          for (let i = 0; i < 48; i++) this.step();
          this.draw();
          this.plates.forEach((plate) => plate.frame?.classList.add('is-sim-ready'));
          if (this.visible) this.start();
        }

        start() {
          if (this.reduced || this.running || !this.visible) return;
          this.running = true;
          this.ticks = 0;
          const loop = () => {
            if (!this.running) return;
            for (let i = 0; i < 4; i++) this.step();
            this.draw();
            this.plates.forEach((plate) => plate.frame?.classList.add('is-sim-ready'));
            this.ticks++;
            if (this.visible && this.ticks < 900) {
              this.frame = requestAnimationFrame(loop);
            } else {
              this.running = false;
            }
          };
          this.frame = requestAnimationFrame(loop);
        }

        step() {
          for (const plate of this.plates) {
            const { t, next, material } = plate;
            for (let y = 1; y < N - 1; y++) {
              for (let x = 1; x < N - 1; x++) {
                const i = y * N + x;
                if (!inside(x, y)) {
                  next[i] = 0;
                  continue;
                }
                const lap = t[i - 1] + t[i + 1] + t[i - N] + t[i + N] - 4 * t[i];
                next[i] = t[i] + material.alpha * lap + this.source[i] - material.loss * t[i];
              }
            }
            plate.t = next;
            plate.next = t;
          }
        }

        draw() {
          let peak = 1e-6;
          for (const plate of this.plates) {
            for (let i = 0; i < N * N; i++) if (plate.t[i] > peak) peak = plate.t[i];
          }

          const sourceName = SOURCE_LABEL[this.sourceKind] || 'heat source';
          const modeName = MODE_LABEL[this.mapMode] || 'map mode';

          for (const plate of this.plates) {
            const { t, image, ctx, output, canvas, material } = plate;
            let min = Infinity;
            let max = 0;
            for (let y = 0; y < N; y++) {
              for (let x = 0; x < N; x++) {
                if (!inside(x, y) || Math.hypot(x - 31.5, y - 31.5) > 28) continue;
                const v = t[y * N + x];
                if (v < min) min = v;
                if (v > max) max = v;
              }
            }

            for (let i = 0; i < N * N; i++) {
              const x = i % N;
              const y = (i / N) | 0;
              const px = i * 4;
              if (!inside(x, y)) {
                image.data[px] = 0;
                image.data[px + 1] = 0;
                image.data[px + 2] = 0;
                image.data[px + 3] = 0;
                continue;
              }
              const v = Math.min(1, t[i] / peak) * (RAMP.length - 1);
              const k = Math.min(RAMP.length - 2, Math.floor(v));
              const f = v - k;
              const a = RAMP[k];
              const b = RAMP[k + 1];
              image.data[px] = a[0] + (b[0] - a[0]) * f;
              image.data[px + 1] = a[1] + (b[1] - a[1]) * f;
              image.data[px + 2] = a[2] + (b[2] - a[2]) * f;
              image.data[px + 3] = 255;
            }
            ctx.putImageData(image, 0, 0);

            if (output && Number.isFinite(min)) {
              const spread = Math.round(((max - min) / peak) * 120);
              output.value = `Spread index ${spread}`;
              canvas.setAttribute(
                'aria-label',
                `Heat map of ${material.label} under ${sourceName}, ${modeName}. Relative spread index ${spread}.`,
              );
            }
          }
        }
      },
    );
  }
