<div class="kansa-shell section-{{ section.id }}-padding section--page-width" id="kansa">
  <div class="kansa-shell__header">
    <div class="kansa-badge-row">
      <span class="kansa-badge">KANSA A2A COMPANION</span>
      <span class="kansa-badge kansa-badge--voice">VOICE SYNTHESIS · ONLINE</span>
    </div>
    {%- if section.settings.heading != blank -%}
      <h1 class="kansa-shell__heading">{{ section.settings.heading | escape }}</h1>
    {%- endif -%}
    {%- if section.settings.subheading != blank -%}
      <p class="kansa-shell__subheading">{{ section.settings.subheading | escape }}</p>
    {%- endif -%}
  </div>

  <div id="kansa-root"></div>
</div>

<script src="{{ 'microapp-kansa.js' | asset_url }}" defer></script>

{% stylesheet %}
  .kansa-shell {
    padding-block: 3.5rem 5rem;
    color: var(--color-foreground);
  }

  .kansa-shell__header {
    margin-block-end: 2.5rem;
    max-width: 48rem;
  }

  .kansa-badge-row {
    display: flex;
    gap: 0.75rem;
    margin-block-end: 1rem;
    flex-wrap: wrap;
  }

  .kansa-badge {
    font-family: var(--font-mono--family, monospace);
    font-size: 0.6875rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    padding: 0.25rem 0.65rem;
    border: 1px solid var(--bell, #B8893A);
    color: var(--bell, #B8893A);
    border-radius: 2px;
  }

  .kansa-badge--voice {
    border-color: var(--ember, #E2552B);
    color: var(--ember, #E2552B);
  }

  .kansa-shell__heading {
    margin: 0 0 0.85rem;
    font-family: var(--font-heading--family, 'Fraunces', serif);
    font-size: clamp(2.4rem, 5vw, 4rem);
    font-weight: 400;
    letter-spacing: -0.02em;
    line-height: 1.08;
    color: var(--soot, #14110F);
  }

  .kansa-shell__subheading {
    margin: 0;
    color: rgba(20, 17, 15, 0.78);
    font-size: 1.1rem;
    line-height: 1.6;
    max-width: 54ch;
  }

  /* Kansa Container */
  .kansa-container {
    background: #14110F;
    border: 1px solid rgba(184, 137, 58, 0.35);
    border-radius: 4px;
    padding: 2.25rem;
    color: #F7F2E9;
    box-shadow: 0 20px 50px rgba(20, 17, 15, 0.15);
  }

  .kansa-piece-selector {
    margin-block-end: 2rem;
  }

  .kansa-label {
    display: block;
    font-family: var(--font-mono--family, monospace);
    font-size: 0.7rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #B8893A;
    margin-block-end: 0.85rem;
  }

  .kansa-piece-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .kansa-piece-btn {
    background: #1C1815;
    border: 1px solid rgba(184, 137, 58, 0.3);
    color: #C8BFB3;
    font-family: var(--font-body--family, sans-serif);
    font-size: 0.85rem;
    padding: 0.55rem 1.15rem;
    border-radius: 2px;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .kansa-piece-btn:hover {
    background: #241F1A;
    color: #F7F2E9;
    border-color: #B8893A;
  }

  .kansa-piece-btn.is-active {
    background: #B8893A;
    border-color: #B8893A;
    color: #14110F;
    font-weight: 600;
  }

  /* Mode Navigation */
  .kansa-mode-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    border-block-end: 1px solid rgba(184, 137, 58, 0.2);
    padding-block-end: 1.25rem;
    margin-block-end: 2.25rem;
  }

  .kansa-mode-btn {
    background: transparent;
    border: 1px solid transparent;
    color: #A39B8F;
    font-family: var(--font-body--family, sans-serif);
    font-size: 0.85rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 0.5rem 1.1rem;
    border-radius: 2px;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .kansa-mode-btn:hover {
    color: #F7F2E9;
  }

  .kansa-mode-btn.is-active {
    background: #1C1815;
    color: #B8893A;
    border-color: rgba(184, 137, 58, 0.4);
    font-weight: 500;
  }

  /* Voice Hero */
  .kansa-voice-hero {
    text-align: center;
    padding-block: 2rem 1.5rem;
  }

  .kansa-mic-action {
    display: inline-flex;
    align-items: center;
    gap: 0.85rem;
    background: #1C1815;
    border: 1.5px solid #B8893A;
    color: #F7F2E9;
    padding: 1rem 2.25rem;
    border-radius: 9999px;
    font-family: var(--font-body--family, sans-serif);
    font-size: 0.95rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    cursor: pointer;
    transition: all 0.25s cubic-bezier(.2, .8, .2, 1);
    box-shadow: 0 4px 20px rgba(184, 137, 58, 0.15);
  }

  .kansa-mic-action:hover {
    background: #B8893A;
    color: #14110F;
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(184, 137, 58, 0.25);
  }

  .kansa-mic-action.is-listening {
    border-color: #E2552B;
    background: #E2552B;
    color: #fff;
    animation: kansa-pulse 1.4s infinite;
  }

  @keyframes kansa-pulse {
    0% { box-shadow: 0 0 0 0 rgba(226, 85, 43, 0.5); }
    70% { box-shadow: 0 0 0 16px rgba(226, 85, 43, 0); }
    100% { box-shadow: 0 0 0 0 rgba(226, 85, 43, 0); }
  }

  .kansa-caption {
    margin-block-start: 1rem;
    font-size: 0.82rem;
    color: #A39B8F;
    font-family: var(--font-mono--family, monospace);
  }

  /* Form & Chips */
  .kansa-input-form {
    display: flex;
    gap: 0.5rem;
    margin-block: 1.5rem 1rem;
  }

  .kansa-text-input {
    flex: 1;
    background: #100E0C;
    border: 1px solid rgba(184, 137, 58, 0.35);
    padding: 0.85rem 1.15rem;
    color: #F7F2E9;
    font-family: var(--font-body--family, sans-serif);
    font-size: 0.95rem;
    border-radius: 2px;
    outline: none;
    transition: border-color 0.2s ease;
  }

  .kansa-text-input:focus {
    border-color: #B8893A;
  }

  .kansa-send-btn {
    background: #B8893A;
    color: #14110F;
    border: none;
    font-family: var(--font-body--family, sans-serif);
    font-weight: 600;
    font-size: 0.82rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 0 1.6rem;
    border-radius: 2px;
    cursor: pointer;
    transition: background 0.2s ease;
  }

  .kansa-send-btn:hover {
    background: #E2552B;
    color: #fff;
  }

  .kansa-chips {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin-block-end: 1.5rem;
  }

  .kansa-chips-label {
    font-size: 0.72rem;
    color: #B8893A;
    font-family: var(--font-mono--family, monospace);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .kansa-chip {
    background: #1C1815;
    border: 1px solid rgba(184, 137, 58, 0.25);
    color: #C8BFB3;
    font-size: 0.78rem;
    padding: 0.35rem 0.8rem;
    border-radius: 2px;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .kansa-chip:hover {
    border-color: #B8893A;
    color: #F7F2E9;
  }

  .kansa-transcript {
    background: #100E0C;
    border: 1px solid rgba(184, 137, 58, 0.2);
    padding: 0.85rem 1.15rem;
    border-radius: 2px;
    font-size: 0.9rem;
    color: #C8BFB3;
    margin-block-end: 1.25rem;
  }

  .kansa-transcript-tag {
    font-family: var(--font-mono--family, monospace);
    font-size: 0.7rem;
    color: #B8893A;
    margin-inline-end: 0.5rem;
  }

  /* Answer Card */
  .kansa-answer-card {
    background: #1C1815;
    border-left: 3px solid #B8893A;
    padding: 1.5rem 1.75rem;
    border-radius: 0 4px 4px 0;
    margin-block-end: 1.5rem;
  }

  .kansa-answer-badge {
    font-family: var(--font-mono--family, monospace);
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #B8893A;
    margin-block-end: 0.5rem;
  }

  .kansa-answer-text {
    font-size: 1.05rem;
    line-height: 1.7;
    color: #F7F2E9;
  }

  .kansa-replay-btn {
    margin-block-start: 1rem;
    background: transparent;
    border: 1px solid rgba(184, 137, 58, 0.35);
    color: #B8893A;
    font-family: var(--font-mono--family, monospace);
    font-size: 0.75rem;
    padding: 0.35rem 0.85rem;
    border-radius: 2px;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .kansa-replay-btn:hover {
    background: #B8893A;
    color: #14110F;
  }

  .kansa-error-banner {
    background: rgba(226, 85, 43, 0.15);
    border: 1px solid #E2552B;
    color: #FFA590;
    padding: 0.85rem 1.15rem;
    font-size: 0.88rem;
    border-radius: 2px;
  }

  /* Diagnostic Grid */
  .kansa-panel-heading {
    margin: 0 0 0.5rem;
    font-family: var(--font-heading--family, 'Fraunces', serif);
    font-size: 1.45rem;
    color: #F7F2E9;
  }

  .kansa-panel-sub {
    margin: 0 0 1.75rem;
    color: #A39B8F;
    font-size: 0.95rem;
  }

  .kansa-remedy-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }

  @media screen and (min-width: 750px) {
    .kansa-remedy-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .kansa-remedy-card {
    background: #1C1815;
    border: 1px solid rgba(184, 137, 58, 0.25);
    border-radius: 3px;
    padding: 1.5rem;
  }

  .kansa-remedy-title {
    margin: 0 0 0.5rem;
    font-family: var(--font-heading--family, 'Fraunces', serif);
    font-size: 1.15rem;
    color: #B8893A;
  }

  .kansa-remedy-cause {
    margin: 0 0 1rem;
    font-size: 0.9rem;
    color: #C8BFB3;
    line-height: 1.55;
  }

  .kansa-remedy-fix {
    font-size: 0.88rem;
    color: #F7F2E9;
    line-height: 1.6;
    background: #100E0C;
    padding: 0.85rem 1rem;
    border-radius: 2px;
    border-left: 2px solid #B8893A;
  }

  /* Spec Table */
  .kansa-spec-table {
    width: 100%;
    border-collapse: collapse;
    margin-block-start: 1rem;
  }

  .kansa-spec-table th,
  .kansa-spec-table td {
    padding: 0.95rem 1.15rem;
    border-block-end: 1px solid rgba(184, 137, 58, 0.15);
    text-align: left;
    font-size: 0.9rem;
  }

  .kansa-spec-table th {
    color: #B8893A;
    width: 28%;
    font-family: var(--font-mono--family, monospace);
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .kansa-spec-table td {
    color: #F7F2E9;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Kansa companion",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Kansa Culinary Companion"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Voice-guided cookware maintenance, seasoning diagnostics, and metallurgy."
    }
  ],
  "presets": [
    {
      "name": "Kansa companion",
      "category": "Maison Tavo"
    }
  ]
}
{% endschema %}
