{% stylesheet %}
.kansa-shell {
  background: var(--color-background);
  color: var(--color-foreground);
}

.kansa-shell__heading {
  font-family: var(--font-libre-baskerville--family, var(--font-heading--family));
  font-size: clamp(2rem, 1.5rem + 2vw, 3.5rem);
  margin-block-end: 0.5rem;
  font-variation-settings: 'opsz' 144;
  letter-spacing: 0.04em;
}

.kansa-shell__subheading {
  color: var(--color-foreground-muted);
  font-size: 1.125rem;
  margin-block-end: 2rem;
}

.kansa-ui {
  max-width: 48rem;
}

.kansa-ui__piece-bar {
  margin-block-end: 1.5rem;
}

.kansa-ui__piece-name {
  font-size: 1.1rem;
  margin: 0;
}

.kansa-badge {
  display: inline-block;
  font-family: var(--font-mono--family, monospace);
  font-size: 0.65rem;
  letter-spacing: 0.1em;
  padding: 0.2em 0.5em;
  border: 1px solid var(--brand-color-raw-copper);
  color: var(--brand-color-raw-copper);
  vertical-align: middle;
  margin-inline-start: 0.5rem;
}

.kansa-ui__search {
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
  max-width: 28rem;
}

.kansa-ui__search-label {
  font-size: 0.875rem;
  letter-spacing: 0.05em;
  color: var(--color-foreground-muted);
}

.kansa-ui__search-input {
  border: 1px solid var(--color-border);
  padding: 0.5rem 0.75rem;
  background: transparent;
  color: var(--color-foreground);
  font-size: 1rem;
  font-family: inherit;
}

.kansa-ui__search-input:focus-visible {
  outline: 2px solid var(--brand-color-raw-copper);
  outline-offset: 2px;
}

.kansa-thermal {
  width: 100%;
  border-collapse: collapse;
  font-family: var(--font-mono--family, monospace);
  font-size: 0.875rem;
  margin-block: 1.5rem;
}

.kansa-thermal caption {
  text-align: left;
  font-size: 0.75rem;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  margin-block-end: 0.5rem;
  color: var(--color-foreground-muted);
  caption-side: top;
}

.kansa-thermal th,
.kansa-thermal td {
  border: 1px solid var(--color-border);
  padding: 0.4rem 0.75rem;
  text-align: left;
}

.kansa-thermal th {
  color: var(--color-foreground-muted);
  font-weight: 600;
}

.kansa-ui__voice {
  margin-block: 1.5rem;
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
}

.kansa-ui__mic-btn {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  padding: 0.6rem 1.25rem;
  border: 1px solid var(--color-foreground);
  background: transparent;
  color: var(--color-foreground);
  font-size: 1rem;
  cursor: pointer;
  transition: background 0.2s, color 0.2s, border-color 0.2s;
  align-self: flex-start;
}

.kansa-ui__mic-btn:hover,
.kansa-ui__mic-btn--active {
  background: var(--brand-color-raw-copper);
  color: var(--color-background);
  border-color: var(--brand-color-raw-copper);
}

.kansa-ui__mic-btn:focus-visible {
  outline: 2px solid var(--brand-color-raw-copper);
  outline-offset: 2px;
}

.kansa-ui__voice-note {
  font-size: 0.75rem;
  color: var(--color-foreground-muted);
  margin: 0;
}

.kansa-ui__transcript {
  font-style: italic;
  color: var(--color-foreground-muted);
  margin-block: 1rem;
}

.kansa-ui__response {
  padding: 1rem 1.25rem;
  border-left: 2px solid var(--brand-color-raw-copper);
  margin-block: 1rem;
  font-size: 1rem;
  line-height: 1.6;
}

.kansa-ui__error {
  color: var(--brand-color-error, #8B0000);
  font-size: 0.875rem;
  margin-block: 0.5rem;
}

#kansa-cart-cta {
  margin-block-start: 1.5rem;
}
{% endstylesheet %}

<div class="kansa-shell section-{{ section.id }}-padding">
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <h1 class="kansa-shell__heading">{{ section.settings.heading | escape }}</h1>
    {%- endif -%}
    {%- if section.settings.subheading != blank -%}
      <p class="kansa-shell__subheading">{{ section.settings.subheading | escape }}</p>
    {%- endif -%}

    <div
      id="kansa-root"
      data-piece-handle="{{ section.settings.piece_handle | escape }}"
    ></div>
  </div>
</div>

<script src="{{ 'microapp-kansa.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Kansa companion",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Kansa"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Your piece, your guide."
    },
    {
      "type": "text",
      "id": "piece_handle",
      "label": "Default piece handle",
      "info": "Optional. Pre-load a specific product. The URL parameter ?piece= overrides this."
    }
  ],
  "presets": [
    {
      "name": "Kansa companion"
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  }
}
{% endschema %}
