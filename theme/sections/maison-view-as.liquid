{% comment %}
  Product-page Panopticon: the same Human / Engineer / Machine lenses as the cards,
  at full size and driven entirely by `specs.*` metafields.
{% endcomment %}

{%- liquid
  assign specs = product.metafields.specs
  case specs.claim_status.value
    when 'VERIFIED', 'PRODUCTION_VERIFIED'
      assign evidence = 'VERIFIED'
    when 'PROTOTYPE_VALIDATED'
      assign evidence = 'OBSERVED'
    else
      assign evidence = 'HYPOTHESIS'
  endcase
-%}

<div class="maison-panopticon section section--page-width">
  <maison-lens class="maison-panopticon__inner" data-lens="human">
    <header class="maison-panopticon__header">
      <p class="maison-panopticon__kicker">{{ section.settings.kicker | escape }}</p>
      <h2 class="maison-panopticon__heading">{{ section.settings.heading | escape }}</h2>
      <div class="maison-lens__bar" role="group" aria-label="View {{ product.title | escape }} as">
        <button type="button" class="maison-lens__option" data-lens-option="human" aria-pressed="true" aria-controls="panopticon-human-{{ section.id }}">Human</button>
        <button type="button" class="maison-lens__option" data-lens-option="engineer" aria-pressed="false" aria-controls="panopticon-engineer-{{ section.id }}">Engineer</button>
        <button type="button" class="maison-lens__option" data-lens-option="machine" aria-pressed="false" aria-controls="panopticon-machine-{{ section.id }}">Machine</button>
      </div>
    </header>

    <div class="maison-panopticon__panel" id="panopticon-human-{{ section.id }}" data-lens-panel="human">
      <div class="maison-panopticon__human">
        {%- if product.featured_media -%}
          {{ product.featured_media | image_url: width: 1600 | image_tag: loading: 'lazy', sizes: '(min-width: 750px) 50vw, 100vw', class: 'maison-panopticon__image' }}
        {%- endif -%}
        <div class="maison-panopticon__copy">
          <p class="maison-evidence maison-evidence--{{ evidence | downcase }}">[{{ evidence }}]</p>
          {%- if specs.concept_thesis.value != blank -%}
            <p class="maison-panopticon__lede">{{ specs.concept_thesis.value | escape }}</p>
          {%- else -%}
            <p class="maison-panopticon__lede">{{ section.settings.fallback_lede | escape }}</p>
          {%- endif -%}
          <dl class="maison-panopticon__facts">
            {%- if specs.material_architecture.value != blank -%}
              <dt>Material</dt><dd>{{ specs.material_architecture.value | escape }}</dd>
            {%- endif -%}
            {%- if specs.fabrication_route.value != blank -%}
              <dt>Made by</dt><dd>{{ specs.fabrication_route.value | escape }}</dd>
            {%- endif -%}
            {%- if specs.care_hypothesis.value != blank -%}
              <dt>Care</dt><dd>{{ specs.care_hypothesis.value | escape }}</dd>
            {%- endif -%}
          </dl>
        </div>
      </div>
    </div>

    <div class="maison-panopticon__panel" id="panopticon-engineer-{{ section.id }}" data-lens-panel="engineer" hidden>
      <div class="maison-panopticon__engineer">
        {% render 'maison-stratigraphy', product: product, id_prefix: section.id %}
      </div>
    </div>

    <div class="maison-panopticon__panel" id="panopticon-machine-{{ section.id }}" data-lens-panel="machine" hidden>
      {% render 'maison-machine-view', product: product, full: true %}
    </div>
  </maison-lens>
</div>

{% stylesheet %}
  .maison-panopticon {
    padding-block: clamp(3rem, 6vw, 6rem);
  }

  .maison-panopticon__header {
    display: grid;
    gap: 0.75rem;
    margin-block-end: clamp(1.5rem, 3vw, 2.5rem);
  }

  .maison-panopticon__kicker,
  .maison-evidence {
    margin: 0;
    font-family: var(--font-mono--family, ui-monospace, monospace);
    font-size: 0.75rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgb(var(--color-foreground-rgb) / 0.7);
  }

  .maison-evidence--verified { color: var(--brand-color-aged-bronze, #5a6b5c); }
  .maison-evidence--observed { color: var(--bell, #b8893a); }
  .maison-evidence--hypothesis { color: var(--brand-color-raw-copper, #a45a3d); }

  .maison-panopticon__heading {
    margin: 0;
    font-family: var(--font-heading--family);
    font-size: clamp(2rem, 1.4rem + 2.6vw, 3.75rem);
    font-weight: 400;
    line-height: 1.05;
    letter-spacing: -0.02em;
  }

  .maison-panopticon__panel[hidden] {
    display: none;
  }

  .maison-panopticon__human {
    display: grid;
    gap: clamp(1.5rem, 4vw, 4rem);
    align-items: center;
  }

  @media screen and (min-width: 750px) {
    .maison-panopticon__human {
      grid-template-columns: 1fr 1fr;
    }
  }

  .maison-panopticon__image {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
  }

  .maison-panopticon__copy {
    display: grid;
    gap: 1.25rem;
    max-width: 38rem;
  }

  .maison-panopticon__lede {
    margin: 0;
    font-family: var(--font-heading--family);
    font-size: clamp(1.25rem, 1.05rem + 0.8vw, 1.75rem);
    line-height: 1.4;
  }

  .maison-panopticon__facts {
    display: grid;
    grid-template-columns: max-content 1fr;
    gap: 0.75rem 1.5rem;
    margin: 0;
  }

  .maison-panopticon__facts dt {
    font-family: var(--font-mono--family, ui-monospace, monospace);
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgb(var(--color-foreground-rgb) / 0.65);
  }

  .maison-panopticon__facts dd {
    margin: 0;
    line-height: 1.6;
  }

  .maison-panopticon__engineer {
    max-width: 36rem;
    aspect-ratio: 4 / 5;
    margin-inline: auto;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Panopticon",
  "tag": "section",
  "class": "section-wrapper",
  "enabled_on": {
    "templates": ["product"]
  },
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "Three ways to read this object"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Human. Engineer. Machine."
    },
    {
      "type": "textarea",
      "id": "fallback_lede",
      "label": "Lede when no concept thesis is set",
      "default": "Your grandmother listened to the ring of the metal. We measured it. Nothing here is louder than the object."
    }
  ],
  "presets": [
    {
      "name": "Panopticon (Human / Engineer / Machine)",
      "category": "Maison Tavo"
    }
  ]
}
{% endschema %}
