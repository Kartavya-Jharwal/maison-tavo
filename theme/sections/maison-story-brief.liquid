{% comment %}
  Homepage short story + highlight cells. Keep the first viewport lean;
  this sits under the hero as a brief house thesis, not a full About page.
{% endcomment %}

<div
  class="section section--page-width spacing-style maison-story-brief"
  style="{% render 'spacing-style', settings: section.settings %}"
  data-mt-chapter
>
  <header class="maison-story-brief__header" data-mt-scroll="chapter">
    {% if section.settings.eyebrow != blank %}
      <p class="maison-story-brief__eyebrow">{{ section.settings.eyebrow | escape }}</p>
    {% endif %}
    {% if section.settings.heading != blank %}
      <h2
        class="maison-story-brief__heading"
        data-mt-scroll="kinetic"
        aria-label="{{ section.settings.heading | escape }}"
      >
        {{ section.settings.heading | escape }}
      </h2>
    {% endif %}
    {% if section.settings.lede != blank %}
      <p class="maison-story-brief__lede">{{ section.settings.lede | escape }}</p>
    {% endif %}
  </header>

  {% if section.blocks.size > 0 %}
    <ul class="maison-story-brief__highlights" role="list" data-mt-scroll="stagger">
      {% for block in section.blocks %}
        <li class="maison-story-brief__cell" data-mt-scroll-item {{ block.shopify_attributes }}>
          {% if block.settings.kicker != blank %}
            <p class="maison-story-brief__kicker">{{ block.settings.kicker | escape }}</p>
          {% endif %}
          {% if block.settings.heading != blank %}
            <h3 class="maison-story-brief__cell-title">{{ block.settings.heading | escape }}</h3>
          {% endif %}
          {% if block.settings.text != blank %}
            <p class="maison-story-brief__cell-text">{{ block.settings.text | escape }}</p>
          {% endif %}
        </li>
      {% endfor %}
    </ul>
  {% endif %}

  {% if section.settings.cta_label != blank and section.settings.cta_link != blank %}
    <p class="maison-story-brief__cta" data-mt-scroll="beat">
      <a href="{{ section.settings.cta_link }}">{{ section.settings.cta_label | escape }}</a>
    </p>
  {% endif %}
</div>

{% stylesheet %}
  .maison-story-brief {
    color: var(--color-foreground);
  }

  .maison-story-brief__header {
    max-width: 40rem;
    margin-block-end: clamp(1.75rem, 3vw, 2.5rem);
  }

  .maison-story-brief__eyebrow {
    margin: 0;
    font-family: var(--mt-type-family-mono, var(--font-mono--family));
    font-size: var(--mt-type-accent, var(--font-size--xs));
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-foreground-muted);
  }

  .maison-story-brief__heading {
    margin-block: 0.75rem 1rem;
    font-family: var(--mt-type-family-heading, var(--font-heading--family));
    font-weight: var(--font-heading--weight);
    letter-spacing: 0.02em;
  }

  .maison-story-brief__lede {
    margin: 0;
    max-width: 36rem;
    color: var(--color-foreground-muted);
    font-size: var(--mt-type-lede, var(--font-size--md));
    line-height: 1.6;
  }

  .maison-story-brief__highlights {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1.25rem 1.5rem;
    grid-template-columns: 1fr;
  }

  @media screen and (min-width: 750px) {
    .maison-story-brief__highlights {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .maison-story-brief__cell {
    border-block-start: 1px solid var(--color-border, rgba(0, 0, 0, 0.12));
    padding-block-start: 1rem;
  }

  .maison-story-brief__kicker {
    margin: 0 0 0.5rem;
    font-family: var(--mt-type-family-mono, var(--font-mono--family));
    font-size: var(--mt-type-accent, var(--font-size--xs));
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-foreground-muted);
  }

  .maison-story-brief__cell-title {
    margin: 0 0 0.5rem;
    font-family: var(--mt-type-family-heading, var(--font-heading--family));
    font-size: var(--font-size--md);
  }

  .maison-story-brief__cell-text {
    margin: 0;
    color: var(--color-foreground-muted);
    line-height: 1.55;
  }

  .maison-story-brief__cta {
    margin-block: 1.75rem 0;
  }

  .maison-story-brief__cta a {
    color: inherit;
    text-underline-offset: 0.2em;
  }

  .maison-story-brief__cta a:focus-visible {
    outline: 2px solid var(--color-foreground);
    outline-offset: 3px;
  }

  @media (prefers-reduced-motion: reduce) {
    .maison-story-brief [data-mt-scroll],
    .maison-story-brief [data-mt-scroll-item] {
      opacity: 1 !important;
      transform: none !important;
      visibility: visible !important;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.maison_story_brief",
  "tag": "section",
  "class": "section-wrapper",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:settings.maison_eyebrow",
      "default": "The house"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:settings.heading",
      "default": "Cook with what outlasts you."
    },
    {
      "type": "textarea",
      "id": "lede",
      "label": "t:settings.maison_lede",
      "default": "Dual-mass cookware, refractory clay, and care rituals built for the working kitchen — verified where we can, honest where we cannot."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Story link label",
      "default": "Read our story"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Story link",
      "default": "/"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "highlight",
      "name": "Highlight",
      "settings": [
        {
          "type": "text",
          "id": "kicker",
          "label": "Kicker",
          "default": "01"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "t:settings.heading",
          "default": "Heat with memory"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Mass where it matters. Control where the hand needs it."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:names.maison_story_brief",
      "category": "t:categories.storytelling",
      "blocks": [
        {
          "type": "highlight",
          "settings": {
            "kicker": "01",
            "heading": "Heat with memory",
            "text": "Mass where it matters. Control where the hand needs it."
          }
        },
        {
          "type": "highlight",
          "settings": {
            "kicker": "02",
            "heading": "Built for service",
            "text": "Hospitality handling, induction-ready bases, care that is a ritual not a chore."
          }
        },
        {
          "type": "highlight",
          "settings": {
            "kicker": "03",
            "heading": "Specs you can read",
            "text": "Alloy, thickness, and heat claims marked with evidence tiers — not marketing fog."
          }
        }
      ]
    }
  ]
}
{% endschema %}
