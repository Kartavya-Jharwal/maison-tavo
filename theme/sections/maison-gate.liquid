{% comment %}
  Maison Tavo — Private Atelier Gate (Thread S5)
  Art Direction: "The forge, the kitchen, the temple bell."
  Restrained luxury, Fraunces serif, quiet Devanagari signature,
  minimalist passphrase entry, zero tacky gimmicks.
{% endcomment %}

<div class="atelier-gate">
  <div class="atelier-gate__inner">
    <div class="atelier-gate__brand">
      <p class="atelier-gate__devanagari">कांसे की गूँज · रसोई की साधना</p>
      <h1 class="atelier-gate__title">MAISON TAVO</h1>
      <p class="atelier-gate__subhead">The forge, the kitchen, the temple bell.</p>
    </div>

    <div class="atelier-gate__rule"></div>

    <p class="atelier-gate__manifesto">
      Modern heirlooms for the working kitchen. Metallurgy you can parse, craft you can live with.
      Enter the foundry passphrase to access the catalogue and machine commerce endpoints.
    </p>

    {%- form 'storefront_password', class: 'atelier-gate__form' -%}
      <div class="atelier-gate__input-group">
        <label for="gatePassword" class="visually-hidden">Passphrase</label>
        <input
          type="password"
          name="password"
          id="gatePassword"
          class="atelier-gate__input"
          placeholder="Enter foundry passphrase"
          autocomplete="current-password"
          autofocus
          required
        >
        <button type="submit" class="atelier-gate__submit">
          <span>Enter Atelier</span>
          <span class="atelier-gate__arrow">→</span>
        </button>
      </div>

      {%- if form.errors -%}
        <p class="atelier-gate__error" role="alert">
          Passphrase unverified. Please check your credentials.
        </p>
      {%- endif -%}
    {%- endform -%}

    <footer class="atelier-gate__footer">
      <span class="footer-spec">UCP Spec 2026-08-25</span>
      <span class="footer-sep">·</span>
      <span class="footer-spec">11 Active Artifacts</span>
      <span class="footer-sep">·</span>
      <span class="footer-spec">Kansa Atelier Online</span>
    </footer>
  </div>
</div>

<style>
  .atelier-gate {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #14110F;
    color: #F7F2E9;
    padding: 3rem 1.5rem;
    box-sizing: border-box;
    font-family: var(--font-body--family, 'Hanken Grotesk', -apple-system, sans-serif);
  }

  .atelier-gate__inner {
    max-width: 520px;
    width: 100%;
    text-align: center;
  }

  .atelier-gate__devanagari {
    font-family: var(--font-devanagari--family, 'Noto Serif Devanagari', serif);
    font-size: 0.85rem;
    letter-spacing: 0.18em;
    color: #B8893A;
    margin: 0 0 1rem 0;
  }

  .atelier-gate__title {
    font-family: var(--font-heading--family, 'Fraunces', serif);
    font-size: clamp(2.5rem, 6vw, 4rem);
    font-weight: 400;
    letter-spacing: 0.12em;
    line-height: 1;
    margin: 0 0 0.75rem 0;
    color: #F7F2E9;
  }

  .atelier-gate__subhead {
    font-family: var(--font-heading--family, 'Fraunces', serif);
    font-style: italic;
    font-size: 1.05rem;
    color: #B8893A;
    margin: 0 0 2rem 0;
    letter-spacing: 0.02em;
  }

  .atelier-gate__rule {
    width: 60px;
    height: 1px;
    background: rgba(184, 137, 58, 0.4);
    margin: 0 auto 2rem auto;
  }

  .atelier-gate__manifesto {
    font-size: 0.95rem;
    line-height: 1.7;
    color: #BFB8AD;
    margin: 0 0 2.5rem 0;
  }

  .atelier-gate__form {
    margin-bottom: 3rem;
  }

  .atelier-gate__input-group {
    display: flex;
    border-bottom: 1px solid rgba(184, 137, 58, 0.45);
    padding-bottom: 0.5rem;
    transition: border-color 0.25s ease;
  }

  .atelier-gate__input-group:focus-within {
    border-color: #B8893A;
  }

  .atelier-gate__input {
    flex: 1;
    background: transparent;
    border: none;
    color: #F7F2E9;
    font-family: var(--font-mono--family, monospace);
    font-size: 0.95rem;
    padding: 0.5rem 0;
    outline: none;
  }

  .atelier-gate__input::placeholder {
    color: #6E675D;
    font-family: var(--font-body--family, sans-serif);
    font-size: 0.9rem;
  }

  .atelier-gate__submit {
    background: transparent;
    border: none;
    color: #B8893A;
    font-family: var(--font-body--family, sans-serif);
    font-size: 0.8rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.5rem 0.25rem;
    transition: color 0.2s ease;
  }

  .atelier-gate__submit:hover {
    color: #E2552B;
  }

  .atelier-gate__arrow {
    transition: transform 0.2s ease;
  }

  .atelier-gate__submit:hover .atelier-gate__arrow {
    transform: translateX(3px);
  }

  .atelier-gate__error {
    color: #E2552B;
    font-size: 0.82rem;
    margin-top: 1rem;
    text-align: left;
  }

  .atelier-gate__footer {
    font-family: var(--font-mono--family, monospace);
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    color: #6E675D;
    display: flex;
    justify-content: center;
    gap: 0.6rem;
    flex-wrap: wrap;
  }

  .footer-sep {
    opacity: 0.5;
  }
</style>

{% schema %}
{
  "name": "Maison Atelier Gate",
  "settings": []
}
{% endschema %}
