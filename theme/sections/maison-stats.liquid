{% comment %}
  Maison Tavo — Metallurgy Stats & Ledger
  Attribution & Kinetic Inspiration: [Abdughafur Khujzoda on CodePen](https://codepen.io/Abdughafur-Khujzoda)
  Minimalist score-keeping cells with tabular numerals, hairline borders, and soot/limewash material styling.
{% endcomment %}

<section
  class="maison-stats section--page-width"
  id="stats-{{ section.id }}"
  data-section-id="{{ section.id }}"
>
  <div class="maison-stats__container">
    <header class="maison-stats__header inview">
      {% if section.settings.eyebrow != blank %}
        <span class="eyebrow">{{ section.settings.eyebrow | escape }}</span>
      {% endif %}
      {% if section.settings.heading != blank %}
        <h2 class="maison-stats__title stacked-title">
          <span class="clip-line"><span>{{ section.settings.heading | escape }}</span></span>
        </h2>
      {% endif %}
      {% if section.settings.lede != blank %}
        <p class="maison-stats__lede">{{ section.settings.lede | escape }}</p>
      {% endif %}
    </header>

    <dl class="maison-stats__grid">
      {% for block in section.blocks %}
        <div class="maison-stat-cell inview" {{ block.shopify_attributes }}>
          <dt class="sr-only">{{ block.settings.label | escape }}</dt>
          <dd>
            <strong class="maison-stat-cell__figure">{{ block.settings.figure | escape }}</strong>
            <p class="maison-stat-cell__label">{{ block.settings.label | escape }}</p>
            {% if block.settings.caption != blank %}
              <span class="maison-stat-cell__caption">{{ block.settings.caption | escape }}</span>
            {% endif %}
          </dd>
        </div>
      {% endfor %}
    </dl>
  </div>
</section>

{% stylesheet %}
  .maison-stats {
    background-color: var(--soot, #14110F);
    color: var(--bone, #F7F2E9);
    padding-block: clamp(4rem, 6vw, 6.5rem);
    border-radius: var(--radius-card-lg, 2rem);
    margin-block: 2rem;
    position: relative;
    overflow: hidden;
  }

  /* Subtle background warm ambient glow */
  .maison-stats::before {
    content: "";
    position: absolute;
    top: -20%;
    right: -10%;
    width: 50vw;
    height: 50vw;
    background: radial-gradient(circle, rgba(184, 137, 58, 0.12) 0%, transparent 70%);
    pointer-events: none;
  }

  .maison-stats__container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 clamp(1.5rem, 4vw, 4rem);
    position: relative;
    z-index: 1;
  }

  .maison-stats__header {
    max-width: 48rem;
    margin-bottom: clamp(3rem, 5vw, 4.5rem);
  }

  .maison-stats__title {
    font-family: var(--font-heading--family, 'Fraunces', serif);
    font-size: clamp(2.5rem, 5vw, 4rem);
    font-weight: 400;
    line-height: 1.05;
    letter-spacing: -0.03em;
    margin: 1rem 0 1.25rem 0;
    color: var(--bone, #F7F2E9);
  }

  .maison-stats__lede {
    font-size: clamp(1rem, 1.2vw, 1.15rem);
    line-height: 1.65;
    color: rgba(247, 242, 233, 0.7);
    margin: 0;
  }

  .maison-stats__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 3rem 2rem;
    margin: 0;
    padding: 0;
  }

  @media (min-width: 1024px) {
    .maison-stats__grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .maison-stat-cell {
    border-top: 1px solid var(--hairline-light, rgba(247, 242, 233, 0.15));
    padding-top: 1.5rem;
    transition: transform var(--dur-mid, 420ms) var(--ease-strike), border-color 0.3s;
  }

  .maison-stat-cell:hover {
    border-color: var(--bell, #B8893A);
    transform: translateY(-4px);
  }

  .maison-stat-cell__figure {
    display: block;
    font-family: var(--font-heading--family, 'Fraunces', serif);
    font-size: clamp(3rem, 6vw, 4.5rem);
    line-height: 0.95;
    font-weight: 400;
    letter-spacing: -0.05em;
    color: var(--bone, #F7F2E9);
    font-variant-numeric: tabular-nums;
  }

  .maison-stat-cell__label {
    font-family: var(--font-body--family, sans-serif);
    font-size: 0.95rem;
    font-weight: 500;
    color: var(--bell, #B8893A);
    margin: 0.85rem 0 0.35rem 0;
    letter-spacing: 0.02em;
  }

  .maison-stat-cell__caption {
    display: block;
    font-family: var(--font-mono--family, monospace);
    font-size: 0.75rem;
    line-height: 1.5;
    color: rgba(247, 242, 233, 0.55);
  }

  @media (max-width: 640px) {
    .maison-stats__grid {
      grid-template-columns: 1fr;
      gap: 2.25rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Maison Metallurgy Stats",
  "tag": "section",
  "class": "section-wrapper",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "By the numbers"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Metallurgy that keeps score"
    },
    {
      "type": "textarea",
      "id": "lede",
      "label": "Lede",
      "default": "Every vessel carries verifiable data: alloy ratios, crucible pour temperatures, and deterministic schema fields for kitchen longevity."
    }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Stat Item",
      "settings": [
        {
          "type": "text",
          "id": "figure",
          "label": "Figure / Number",
          "default": "78:22"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Bell Bronze Formulation"
        },
        {
          "type": "textarea",
          "id": "caption",
          "label": "Technical Caption",
          "default": "Canonical copper to tin proportion tested for acoustic ring and non-reactive food safety."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Maison Metallurgy Stats",
      "blocks": [
        {
          "type": "stat",
          "settings": {
            "figure": "78:22",
            "label": "Bell Bronze Ratio",
            "caption": "Traditional Rajasthan alloy: 78% copper, 22% tin for pure bell resonance and thermal equilibrium."
          }
        },
        {
          "type": "stat",
          "settings": {
            "figure": "1400°C",
            "label": "Furnace Melt Point",
            "caption": "Refractory crucible casting temperature ensuring zero air voids and dense crystalline molecular packing."
          }
        },
        {
          "type": "stat",
          "settings": {
            "figure": "25",
            "label": "Curated Heirloom SKUs",
            "caption": "Three disciplined families: Forge Hybrid carbon steel, Terre refractory clay, and Kuro cutlery."
          }
        },
        {
          "type": "stat",
          "settings": {
            "figure": "100%",
            "label": "Machine-Readable",
            "caption": "Every specification exposed as structured UCP JSON-LD for autonomous culinary agent procurement."
          }
        }
      ]
    }
  ]
}
{% endschema %}
