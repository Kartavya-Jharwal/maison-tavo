{% liquid
  if section.settings.background_color != blank
    render 'contrast-override', background_color: section.settings.background_color, section_id: section.id
  endif
%}

<div
  class="section-background{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
></div>
<div
  class="section section--page-width spacing-style maison-editorial{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
  style="{% render 'spacing-style', settings: section.settings %}"
>
  <header class="maison-editorial__header">
    {% if section.settings.eyebrow != blank %}
      <p class="maison-editorial__eyebrow">{{ section.settings.eyebrow | escape }}</p>
    {% endif %}
    {% if section.settings.heading != blank %}
      <h1 class="maison-editorial__title">{{ section.settings.heading | escape }}</h1>
    {% endif %}
    {% if section.settings.lede != blank %}
      <p class="maison-editorial__lede">{{ section.settings.lede | escape }}</p>
    {% endif %}
  </header>

  {% if section.blocks.size > 0 %}
    <div class="maison-editorial__grid">
      {% for block in section.blocks %}
        <article
          class="maison-editorial__card"
          {{ block.shopify_attributes }}
        >
          {% if block.settings.heading != blank %}
            <h2 class="maison-editorial__card-title">{{ block.settings.heading | escape }}</h2>
          {% endif %}
          {% if block.settings.text != blank %}
            <div class="maison-editorial__rte rte">{{ block.settings.text }}</div>
          {% endif %}
        </article>
      {% endfor %}
    </div>
  {% endif %}

  {% if section.settings.closing != blank %}
    <p class="maison-editorial__closing">{{ section.settings.closing | escape }}</p>
  {% endif %}
</div>

{% stylesheet %}
  .maison-editorial {
    color: var(--color-foreground);
  }

  .maison-editorial__header {
    max-width: 42rem;
    margin-block-end: 3rem;
  }

  .maison-editorial__eyebrow {
    margin: 0;
    font-family: var(--font-heading--family);
    font-size: 0.75rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-foreground-muted);
  }

  .maison-editorial__title {
    margin-block: 0.75rem 1rem;
    font-family: var(--font-heading--family);
    font-weight: var(--font-heading--weight);
    letter-spacing: 0.04em;
  }

  .maison-editorial__lede,
  .maison-editorial__closing {
    margin: 0;
    max-width: 40rem;
    color: var(--color-foreground-muted);
    font-size: 1.125rem;
    line-height: 1.6;
  }

  .maison-editorial__closing {
    margin-block-start: 3rem;
    font-size: 1rem;
  }

  .maison-editorial__grid {
    display: grid;
    gap: 1.75rem;
    grid-template-columns: 1fr;
  }

  @media screen and (min-width: 750px) {
    .maison-editorial__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .maison-editorial__card {
    border-block-start: 1px solid var(--color-border);
    padding-block-start: 1.25rem;
  }

  .maison-editorial__card-title {
    margin: 0 0 0.75rem;
    font-family: var(--font-heading--family);
    font-size: 1.125rem;
    letter-spacing: 0.03em;
  }

  .maison-editorial__rte,
  .maison-editorial__rte p {
    color: var(--color-foreground-muted);
  }

  .maison-editorial__rte p:first-child {
    margin-block-start: 0;
  }

  .maison-editorial__rte p:last-child {
    margin-block-end: 0;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.maison_about",
  "tag": "section",
  "class": "section-wrapper",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:settings.maison_eyebrow",
      "default": "The house"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:settings.heading",
      "default": "Maison Tavo"
    },
    {
      "type": "textarea",
      "id": "lede",
      "label": "t:settings.maison_lede",
      "default": "A house of considered objects, made to be lived with and remembered. We work slowly, in small editions, for people who prefer presence to noise."
    },
    {
      "type": "textarea",
      "id": "closing",
      "label": "t:settings.maison_closing",
      "default": "Maison Tavo is not a season. It is a wardrobe built in chapters — each piece a quiet argument for lasting form."
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 80
    }
  ],
  "blocks": [
    {
      "type": "pillar",
      "name": "t:names.maison_pillar",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "t:settings.heading",
          "default": "Craft over spectacle"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "t:settings.content",
          "default": "<p>Every silhouette is cut for the body that will wear it, not the camera that might catch it. We edit until only the necessary line remains.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:names.maison_about",
      "category": "t:categories.storytelling"
    }
  ]
}
{% endschema %}
