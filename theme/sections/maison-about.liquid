{% liquid
  if section.settings.background_color != blank
    render 'contrast-override', background_color: section.settings.background_color, section_id: section.id
  endif
%}

<div
  class="section-background{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
></div>
<div
  class="section section--page-width spacing-style maison-editorial{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
  style="{% render 'spacing-style', settings: section.settings %}"
>
  <header class="maison-editorial__header">
    {% if section.settings.eyebrow != blank %}
      <p class="maison-editorial__eyebrow">{{ section.settings.eyebrow | escape }}</p>
    {% endif %}
    {% if section.settings.heading != blank %}
      <h1 class="maison-editorial__title">{{ section.settings.heading | escape }}</h1>
    {% endif %}
    {% if section.settings.lede != blank %}
      <p class="maison-editorial__lede">{{ section.settings.lede | escape }}</p>
    {% endif %}
  </header>

  {% if section.blocks.size > 0 %}
    <div class="maison-editorial__grid">
      {% for block in section.blocks %}
        <article
          class="maison-editorial__card"
          {{ block.shopify_attributes }}
        >
          {% if block.settings.evidence_tier != blank and block.settings.evidence_tier != 'none' %}
            <p class="maison-evidence maison-evidence--{{ block.settings.evidence_tier }}">
              <span class="maison-evidence__tag">{{ block.settings.evidence_tier | upcase }}</span>
            </p>
          {% endif %}
          {% if block.settings.heading != blank %}
            <h2 class="maison-editorial__card-title">{{ block.settings.heading | escape }}</h2>
          {% endif %}
          {% if block.settings.text != blank %}
            <div class="maison-editorial__rte rte">{{ block.settings.text }}</div>
          {% endif %}
        </article>
      {% endfor %}
    </div>
  {% endif %}

  {% if section.settings.closing != blank %}
    <p class="maison-editorial__closing">{{ section.settings.closing | escape }}</p>
  {% endif %}
</div>

{% stylesheet %}
  .maison-editorial {
    color: var(--color-foreground);
  }

  .maison-editorial__header {
    max-width: 42rem;
    margin-block-end: 3rem;
  }

  .maison-editorial__eyebrow {
    margin: 0;
    font-family: var(--font-heading--family);
    font-size: 0.75rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-foreground-muted);
  }

  .maison-editorial__title {
    margin-block: 0.75rem 1rem;
    font-family: var(--font-fraunces--family, var(--font-heading--family));
    font-weight: var(--font-heading--weight);
    letter-spacing: 0.04em;
    font-variation-settings: 'opsz' 144;
  }

  .maison-editorial__lede,
  .maison-editorial__closing {
    margin: 0;
    max-width: 40rem;
    color: var(--color-foreground-muted);
    font-size: 1.125rem;
    line-height: 1.6;
  }

  .maison-editorial__closing {
    margin-block-start: 3rem;
    font-size: 1rem;
  }

  .maison-editorial__grid {
    display: grid;
    gap: 1.75rem;
    grid-template-columns: 1fr;
  }

  @media screen and (min-width: 750px) {
    .maison-editorial__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .maison-editorial__card {
    border-block-start: 1px solid var(--brand-color-damascus-silver, var(--color-border));
    padding-block-start: 1.25rem;
  }

  .maison-editorial__card-title {
    margin: 0 0 0.75rem;
    font-family: var(--font-heading--family);
    font-size: 1.125rem;
    letter-spacing: 0.03em;
  }

  .maison-editorial__rte,
  .maison-editorial__rte p {
    color: var(--color-foreground-muted);
  }

  .maison-editorial__rte p:first-child {
    margin-block-start: 0;
  }

  .maison-editorial__rte p:last-child {
    margin-block-end: 0;
  }

  .maison-evidence {
    margin: 0 0 0.75rem;
  }

  .maison-evidence__tag {
    display: inline-block;
    font-family: var(--font-mono--family, var(--font-accent--family));
    font-size: 0.6875rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    padding: 0.2em 0.55em;
    border: 1px solid var(--brand-color-damascus-silver, var(--color-border));
    color: var(--brand-color-obsidian-charcoal, var(--color-foreground));
  }

  .maison-evidence--verified .maison-evidence__tag {
    border-color: var(--brand-color-aged-bronze, var(--color-foreground));
    color: var(--brand-color-aged-bronze, var(--color-foreground));
  }

  .maison-evidence--observed .maison-evidence__tag {
    border-color: var(--brand-color-raw-copper, var(--color-foreground));
    color: var(--brand-color-raw-copper, var(--color-foreground));
  }

  .maison-evidence--hypothesis .maison-evidence__tag {
    border-style: dashed;
    color: var(--color-foreground-muted);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.maison_about",
  "tag": "section",
  "class": "section-wrapper",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:settings.maison_eyebrow",
      "default": "The house"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:settings.heading",
      "default": "Maison Tavo"
    },
    {
      "type": "textarea",
      "id": "lede",
      "label": "t:settings.maison_lede",
      "default": "A food house of considered objects, made to be lived with and remembered. Kartavya Jharwal builds it between London and Jaipur — from hotel kitchens, restaurant menus, and the discipline of a well-run pass."
    },
    {
      "type": "textarea",
      "id": "closing",
      "label": "t:settings.maison_closing",
      "default": "Kartavya also builds software. This storefront is designed and developed at kartavya.tech. The house itself remains a product house for food."
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 80
    }
  ],
  "blocks": [
    {
      "type": "pillar",
      "name": "t:names.maison_pillar",
      "settings": [
        {
          "type": "select",
          "id": "evidence_tier",
          "label": "t:settings.maison_evidence_tier",
          "options": [
            { "value": "none", "label": "t:options.none" },
            { "value": "verified", "label": "t:options.verified" },
            { "value": "observed", "label": "t:options.observed" },
            { "value": "hypothesis", "label": "t:options.hypothesis" }
          ],
          "default": "none"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "t:settings.heading",
          "default": "Kitchen before spectacle"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "t:settings.content",
          "default": "<p>At Savi Hotels &amp; Resorts in Jaipur, Kartavya Jharwal took operating control of a leased property: banquet dayparts, walk-in family lunches, and rooms sharing one kitchen and service spine. We still edit until only the line that can hold volume remains.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:names.maison_about",
      "category": "t:categories.storytelling"
    }
  ]
}
{% endschema %}
