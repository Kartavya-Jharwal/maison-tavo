{% liquid
  assign section_heading_tag = 'h1'
  assign card_heading_tag = 'h2'
  if section.settings.secondary_heading
    assign section_heading_tag = 'h2'
    assign card_heading_tag = 'h3'
  endif

  if section.settings.background_color != blank
    render 'contrast-override', background_color: section.settings.background_color, section_id: section.id
  endif
%}

<div
  class="section-background{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
></div>
<div
  class="section section--page-width spacing-style maison-reading{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
  style="{% render 'spacing-style', settings: section.settings %}"
>
  <header class="maison-editorial__header">
    {% if section.settings.eyebrow != blank %}
      <p class="maison-editorial__eyebrow">{{ section.settings.eyebrow | escape }}</p>
    {% endif %}
    {% if section.settings.heading != blank %}
      <{{ section_heading_tag }} class="maison-editorial__title">{{ section.settings.heading | escape }}</{{ section_heading_tag }}>
    {% endif %}
    {% if section.settings.lede != blank %}
      <p class="maison-editorial__lede">{{ section.settings.lede | escape }}</p>
    {% endif %}
  </header>

  {% if section.blocks.size > 0 %}
    <div class="maison-editorial__grid">
      {% for block in section.blocks %}
        {% if block.type == 'testimonial' %}
          <figure class="maison-editorial__card maison-editorial__testimonial" {{ block.shopify_attributes }}>
            <blockquote class="maison-editorial__rte">
              <p>“{{ block.settings.quote | escape }}”</p>
            </blockquote>
            <figcaption>{{ block.settings.attribution | escape }}</figcaption>
          </figure>
        {% else %}
          <article class="maison-editorial__card" {{ block.shopify_attributes }}>
            {% if block.settings.evidence_tier != blank and block.settings.evidence_tier != 'none' %}
              <p class="maison-evidence maison-evidence--{{ block.settings.evidence_tier }}">
                {{ block.settings.evidence_tier | escape }}
              </p>
            {% endif %}
            {% if block.settings.heading != blank %}
              <{{ card_heading_tag }} class="maison-editorial__card-title">{{ block.settings.heading | escape }}</{{ card_heading_tag }}>
            {% endif %}
            {% if block.settings.text != blank %}
              <div class="maison-editorial__rte rte">{{ block.settings.text }}</div>
            {% endif %}
          </article>
        {% endif %}
      {% endfor %}
    </div>
  {% endif %}

  {% if section.settings.closing != blank %}
    <p class="maison-editorial__closing">{{ section.settings.closing | escape }}</p>
  {% endif %}
</div>

{% stylesheet %}
  .maison-editorial__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(1.25rem, 2.4vw, 2.5rem);
  }

  @media (min-width: 60rem) {
    .maison-editorial__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .maison-editorial__card {
    min-inline-size: 0;
    border-block-start: 1px solid var(--color-border);
    padding-block-start: clamp(0.85rem, 1.4vw, 1.25rem);
  }

  .maison-editorial__card > .maison-editorial__rte {
    max-inline-size: 52ch;
  }

  .maison-editorial__testimonial,
  .maison-editorial__testimonial blockquote {
    margin: 0;
  }

  .maison-editorial__testimonial figcaption,
  .maison-evidence {
    font-family: var(--mt-type-family-accent);
    font-size: var(--maison-reading-label);
    font-weight: 500;
    line-height: 1.4;
    color: var(--color-foreground-muted);
    overflow-wrap: anywhere;
  }

  .maison-editorial__testimonial figcaption {
    margin-block-start: 0.85rem;
  }

  .maison-evidence {
    margin: 0 0 0.5rem;
    text-transform: capitalize;
  }

  .maison-editorial__closing {
    margin-block: var(--maison-reading-gap) 0;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.maison_about",
  "tag": "section",
  "class": "section-wrapper",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:settings.maison_eyebrow",
      "default": "The house"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:settings.heading",
      "default": "Maison Tavo"
    },
    {
      "type": "checkbox",
      "id": "secondary_heading",
      "label": "Use a secondary heading",
      "default": false
    },
    {
      "type": "textarea",
      "id": "lede",
      "label": "t:settings.maison_lede",
      "default": "Cookware shaped by Indian kitchens, with guidance on how to choose a piece and keep it in use."
    },
    {
      "type": "textarea",
      "id": "closing",
      "label": "t:settings.maison_closing"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 80
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        {
          "type": "textarea",
          "id": "quote",
          "label": "Quote"
        },
        {
          "type": "text",
          "id": "attribution",
          "label": "Attribution"
        }
      ]
    },
    {
      "type": "pillar",
      "name": "t:names.maison_pillar",
      "settings": [
        {
          "type": "select",
          "id": "evidence_tier",
          "label": "t:settings.maison_evidence_tier",
          "options": [
            { "value": "none", "label": "t:options.none" },
            { "value": "verified", "label": "t:options.verified" },
            { "value": "observed", "label": "t:options.observed" },
            { "value": "hypothesis", "label": "t:options.hypothesis" }
          ],
          "default": "none"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "t:settings.heading",
          "default": "Choosing a piece"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "t:settings.content",
          "default": "<p>Check the cooking surface, dimensions and intended heat sources for the piece you’re considering.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:names.maison_about",
      "category": "t:categories.storytelling"
    }
  ]
}
{% endschema %}
