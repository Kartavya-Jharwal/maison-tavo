<div id="heirloom" class="section section--page-width spacing-style maison-reading" style="{% render 'spacing-style', settings: section.settings %}">
  <div class="maison-heirloom">
    <div class="maison-heirloom__media">
      <img
        src="{{ 'maison-dhanteras-tawa.webp' | asset_url }}"
        srcset="{{ 'maison-dhanteras-tawa-small.webp' | asset_url }} 768w, {{ 'maison-dhanteras-tawa.webp' | asset_url }} 1440w"
        sizes="(min-width: 56rem) 55vw, 100vw"
        alt="Two generations of hands steady a seasoned tawa beside lit clay lamps"
        width="1440"
        height="1080"
        loading="lazy"
        decoding="async"
      >
    </div>
    <div class="maison-heirloom__body">
      <p class="maison-editorial__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      <h2 class="maison-editorial__title">{{ section.settings.heading | escape }}</h2>
      <div class="maison-editorial__rte rte">{{ section.settings.text }}</div>
      {% if section.settings.link_label != blank and section.settings.link != blank %}
        <a href="{{ section.settings.link }}">{{ section.settings.link_label | escape }}</a>
      {% endif %}
    </div>
  </div>
</div>

{% stylesheet %}
  #heirloom {
    scroll-margin-block-start: calc(var(--header-group-height, 4rem) + 1rem);
  }

  .maison-heirloom {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-items: stretch;
  }

  .maison-heirloom__media img {
    display: block;
    inline-size: 100%;
    block-size: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }

  .maison-heirloom__body {
    display: grid;
    align-content: center;
    justify-items: start;
    gap: 1rem;
    padding: clamp(1.5rem, 4vw, 4rem);
    border: 1px solid var(--color-border);
    background: var(--color-background);
    min-inline-size: 0;
  }

  .maison-heirloom__body .maison-editorial__title {
    margin: 0;
  }

  .maison-heirloom__body a {
    color: inherit;
    text-decoration-color: currentColor;
    text-underline-offset: 0.2em;
  }

  @media (min-width: 56rem) {
    .maison-heirloom {
      grid-template-columns: minmax(0, 11fr) minmax(0, 9fr);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Dhanteras and heirlooms",
  "limit": 1,
  "tag": "section",
  "class": "section-wrapper",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Dhanteras" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Cookware that outlasts you" },
    { "type": "richtext", "id": "text", "label": "Story" },
    { "type": "text", "id": "link_label", "label": "Link label" },
    { "type": "url", "id": "link", "label": "Link" },
    { "type": "range", "id": "padding-block-start", "label": "Top spacing", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 40 },
    { "type": "range", "id": "padding-block-end", "label": "Bottom spacing", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 40 }
  ],
  "presets": [{ "name": "Dhanteras and heirlooms" }]
}
{% endschema %}
