{% liquid
  if section.settings.background_color != blank
    render 'contrast-override', background_color: section.settings.background_color, section_id: section.id
  endif
%}

<div
  class="section-background{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
></div>
<div
  class="section section--page-width spacing-style maison-editorial maison-lineups{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
  style="{% render 'spacing-style', settings: section.settings %}"
  data-maison-reveal-root
>
  <header class="maison-editorial__header maison-lineups__header">
    {% if section.settings.eyebrow != blank %}
      <p class="maison-editorial__eyebrow">{{ section.settings.eyebrow | escape }}</p>
    {% endif %}
    {% if section.settings.heading != blank %}
      <h2 class="maison-editorial__title maison-lineups__title">{{ section.settings.heading | escape }}</h2>
    {% endif %}
    {% if section.settings.lede != blank %}
      <p class="maison-editorial__lede">{{ section.settings.lede | escape }}</p>
    {% endif %}
  </header>

  {% if section.blocks.size > 0 %}
    <ul class="maison-lineups__grid list-unstyled" role="list">
      {% for block in section.blocks %}
        {% liquid
          assign lineup_url = block.settings.link
          if block.settings.collection != blank
            assign lineup_url = block.settings.collection.url
          endif
          if lineup_url == blank and block.settings.handle != blank
            assign lineup_url = '/collections/' | append: block.settings.handle
          endif
        %}
        <li
          class="maison-lineups__item"
          data-maison-reveal
          style="--maison-reveal-delay: {{ forloop.index0 | times: 80 }}ms"
          {{ block.shopify_attributes }}
        >
          {% if lineup_url != blank %}
            <a class="maison-lineups__link" href="{{ lineup_url }}">
          {% else %}
            <div class="maison-lineups__link maison-lineups__link--static">
          {% endif %}
            {% if block.settings.kicker != blank %}
              <p class="maison-lineups__kicker">{{ block.settings.kicker | escape }}</p>
            {% endif %}
            {% if block.settings.label != blank %}
              <h3 class="maison-lineups__label">{{ block.settings.label | escape }}</h3>
            {% endif %}
            {% if block.settings.text != blank %}
              <p class="maison-lineups__text">{{ block.settings.text | escape }}</p>
            {% endif %}
            <span class="maison-lineups__cta">{{ 'maison.lineup_browse' | t }}</span>
          {% if lineup_url != blank %}
            </a>
          {% else %}
            </div>
          {% endif %}
        </li>
      {% endfor %}
    </ul>
  {% endif %}
</div>

{% stylesheet %}
  .maison-lineups__header {
    max-width: 40rem;
    margin-block-end: 2.5rem;
  }

  .maison-lineups__title {
    font-family: var(--font-fraunces--family, var(--font-heading--family));
    font-variation-settings: 'opsz' 144;
    font-size: clamp(1.75rem, 1.2rem + 1.5vw, 2.5rem);
  }

  .maison-lineups__grid {
    display: grid;
    gap: 0;
    margin: 0;
    padding: 0;
    border-block-start: 1px solid var(--color-border);
  }

  .maison-lineups__item {
    border-block-end: 1px solid var(--color-border);
  }

  .maison-lineups__link {
    display: grid;
    gap: 0.4rem;
    padding-block: 1.5rem;
    padding-inline-end: 1rem;
    color: inherit;
    text-decoration: none;
  }

  .maison-lineups__link:hover .maison-lineups__label,
  .maison-lineups__link:focus-visible .maison-lineups__label {
    color: var(--brand-color-raw-copper, var(--color-foreground));
  }

  .maison-lineups__link:hover .maison-lineups__cta,
  .maison-lineups__link:focus-visible .maison-lineups__cta {
    transform: translateX(0.25rem);
  }

  .maison-lineups__kicker {
    margin: 0;
    font-family: var(--font-heading--family);
    font-size: 0.6875rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-foreground-muted);
  }

  .maison-lineups__label {
    margin: 0;
    font-family: var(--font-fraunces--family, var(--font-heading--family));
    font-weight: var(--font-heading--weight);
    font-size: clamp(1.35rem, 1.1rem + 0.8vw, 1.75rem);
    letter-spacing: 0.02em;
    transition: color 0.25s ease;
  }

  .maison-lineups__text {
    margin: 0;
    max-width: 36rem;
    color: var(--color-foreground-muted);
    font-size: 0.95rem;
    line-height: 1.55;
  }

  .maison-lineups__cta {
    display: inline-block;
    margin-block-start: 0.35rem;
    font-size: 0.75rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--brand-color-aged-bronze, var(--color-foreground-muted));
    transition: transform 0.25s ease;
  }

  @media screen and (min-width: 750px) {
    .maison-lineups__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      border: 1px solid var(--color-border);
      border-block-start: 1px solid var(--color-border);
    }

    .maison-lineups__item {
      border-block-end: 1px solid var(--color-border);
    }

    .maison-lineups__item:nth-child(odd) {
      border-inline-end: 1px solid var(--color-border);
    }

    .maison-lineups__item:nth-last-child(-n + 2) {
      border-block-end: none;
    }

    .maison-lineups__link {
      min-height: 100%;
      padding: 1.75rem 1.5rem;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .maison-lineups [data-maison-reveal] {
      opacity: 0;
      transform: translateY(0.75rem);
      transition:
        opacity 0.7s cubic-bezier(0.16, 1, 0.3, 1),
        transform 0.7s cubic-bezier(0.16, 1, 0.3, 1);
      transition-delay: var(--maison-reveal-delay, 0ms);
    }

    .maison-lineups [data-maison-reveal].is-revealed {
      opacity: 1;
      transform: none;
    }
  }
{% endstylesheet %}

{% javascript %}
  (() => {
    const root = document.querySelector('.maison-lineups[data-maison-reveal-root]');
    if (!root) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    const items = root.querySelectorAll('[data-maison-reveal]');
    if (!items.length || !('IntersectionObserver' in window)) {
      items.forEach((el) => el.classList.add('is-revealed'));
      return;
    }

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          entry.target.classList.add('is-revealed');
          observer.unobserve(entry.target);
        });
      },
      { rootMargin: '0px 0px -8% 0px', threshold: 0.15 }
    );

    items.forEach((el) => observer.observe(el));
  })();
{% endjavascript %}

{% schema %}
{
  "name": "t:names.maison_lineups",
  "tag": "section",
  "class": "section-wrapper",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:settings.maison_eyebrow",
      "default": "The rooms"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:settings.heading",
      "default": "Shop by lineage"
    },
    {
      "type": "textarea",
      "id": "lede",
      "label": "t:settings.maison_lede",
      "default": "Four collection rooms for when the draft catalog opens: Forge for skillets, Terre for clay, Kuro for knives, Sets for hybrid service."
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 64
    }
  ],
  "blocks": [
    {
      "type": "lineup",
      "name": "t:names.maison_lineup",
      "settings": [
        {
          "type": "text",
          "id": "kicker",
          "label": "t:settings.maison_kicker",
          "default": "Skillets"
        },
        {
          "type": "text",
          "id": "label",
          "label": "t:settings.heading",
          "default": "Forge"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "t:settings.content",
          "default": "Carbon-steel cookline concepts. Modular mass, hospitality service — still in draft."
        },
        {
          "type": "text",
          "id": "handle",
          "label": "t:settings.maison_collection_handle",
          "default": "forge",
          "info": "t:info.maison_collection_handle"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "t:settings.collection"
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:settings.link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:names.maison_lineups",
      "category": "t:categories.storytelling",
      "blocks": [
        {
          "type": "lineup",
          "settings": {
            "kicker": "Skillets",
            "label": "Forge",
            "text": "Carbon-steel cookline concepts. Modular mass for the pass — catalog still in draft.",
            "handle": "forge"
          }
        },
        {
          "type": "lineup",
          "settings": {
            "kicker": "Clay",
            "label": "Terre",
            "text": "Cast clay vessels and table forms. Grain and heat memory as design story, not a performance claim.",
            "handle": "terre"
          }
        },
        {
          "type": "lineup",
          "settings": {
            "kicker": "Knives",
            "label": "Kuro",
            "text": "Strip and hybrid-edge blade concepts. Edge geometry as craft language.",
            "handle": "kuro"
          }
        },
        {
          "type": "lineup",
          "settings": {
            "kicker": "Hybrids",
            "label": "Sets",
            "text": "Forge × Terre service sets and nested pieces for the shared kitchen spine.",
            "handle": "sets"
          }
        }
      ]
    }
  ]
}
{% endschema %}
