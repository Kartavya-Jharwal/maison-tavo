{% liquid
  if section.settings.background_color != blank
    render 'contrast-override', background_color: section.settings.background_color, section_id: section.id
  endif

  assign heading_tag = 'h2'
  if template.name == 'list-collections' and section.index == 1
    assign heading_tag = 'h1'
  endif
%}

{% if template.name == 'list-collections' and section.index == 1 %}
  {% render 'maison-breadcrumbs' %}
{% endif %}

<div
  class="section-background{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
></div>
<div
  class="section section--page-width spacing-style maison-editorial maison-lineups{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
  style="{% render 'spacing-style', settings: section.settings %}"
  data-maison-reveal-root
  data-mt-chapter
>
  <header class="maison-editorial__header maison-lineups__header" data-mt-scroll="chapter">
    {% if section.settings.eyebrow != blank %}
      <p class="maison-editorial__eyebrow">{{ section.settings.eyebrow | escape }}</p>
    {% endif %}
    {% if section.settings.heading != blank %}
      <{{ heading_tag }}
        class="maison-editorial__title maison-lineups__title"
        data-mt-scroll="kinetic"
      >{{ section.settings.heading | escape }}</{{ heading_tag }}>
    {% endif %}
    {% if section.settings.lede != blank %}
      <p class="maison-editorial__lede">{{ section.settings.lede | escape }}</p>
    {% endif %}
  </header>

  {% if section.blocks.size > 0 %}
    <ul class="maison-lineups__grid list-unstyled" role="list" data-mt-scroll="stagger">
      {% for block in section.blocks %}
          {% liquid
            assign target_col = block.settings.collection
            if target_col == blank and block.settings.handle != blank
              assign target_col = collections[block.settings.handle]
            endif
            assign lineup_url = block.settings.link
            if target_col != blank
              assign lineup_url = target_col.url
            endif
            if lineup_url == blank and block.settings.handle != blank
              assign lineup_url = '/collections/' | append: block.settings.handle
            endif
            if block.settings.handle == 'forge' or block.settings.handle == 'chulha'
              if target_col == blank or target_col.all_products_count == 0
                assign lineup_url = blank
              endif
            endif
          %}
        <li
          class="maison-lineups__item"
          data-mt-scroll-item
          {{ block.shopify_attributes }}
        >
          {% if lineup_url != blank %}
            <a class="maison-lineups__link" href="{{ lineup_url }}">
          {% else %}
            <div class="maison-lineups__link maison-lineups__link--static">
          {% endif %}
            <div class="maison-lineups__content">
              <div class="maison-lineups__kicker-row">
                {% if block.settings.kicker != blank %}
                  <p class="maison-lineups__kicker">{{ block.settings.kicker | escape }}</p>
                {% endif %}
                {% if target_col != blank and target_col.all_products_count > 0 %}
                  <span class="maison-lineups__count">{{ target_col.all_products_count }} {{ target_col.all_products_count | pluralize: 'piece', 'pieces' }}</span>
                {% endif %}
              </div>
              {% if block.settings.label != blank %}
                <h3 class="maison-lineups__label">{{ block.settings.label | escape }}</h3>
              {% endif %}
              {% if block.settings.text != blank %}
                <p class="maison-lineups__text">{{ block.settings.text | escape }}</p>
              {% endif %}
              {% if lineup_url != blank %}
                <span class="maison-lineups__cta">{{ 'maison.lineup_browse' | t }}</span>
              {% endif %}
            </div>
            {% liquid
              assign lineup_key = block.settings.handle | append: ' ' | append: block.settings.label | downcase
              if lineup_key contains 'cookware' or lineup_key contains 'forge'
                assign lineup_asset = 'maison-pan-stacked-showcase.webp'
                assign lineup_width = 1080
                assign lineup_height = 1350
              elsif lineup_key contains 'tableware' or lineup_key contains 'pottery' or lineup_key contains 'terre' or lineup_key contains 'clay'
                assign lineup_asset = 'maison-dining-set-6pc.webp'
                assign lineup_width = 493
                assign lineup_height = 493
              elsif lineup_key contains 'care' or lineup_key contains 'set'
                assign lineup_asset = 'maison-range-maintenance.webp'
                assign lineup_width = 823
                assign lineup_height = 823
              else
                assign lineup_asset = 'maison-hero.webp'
                assign lineup_width = 823
                assign lineup_height = 823
              endif
            %}
            <div class="maison-lineups__media" aria-hidden="true">
              <img
                class="maison-lineups__img"
                src="{{ lineup_asset | asset_url }}"
                alt=""
                loading="lazy"
                width="{{ lineup_width }}"
                height="{{ lineup_height }}"
              >
            </div>
          {% if lineup_url != blank %}
            </a>
          {% else %}
            </div>
          {% endif %}
        </li>
      {% endfor %}
    </ul>
  {% endif %}
</div>

{% stylesheet %}
  .maison-lineups__header {
    max-width: 40rem;
    margin-block-end: 2.5rem;
  }

  .maison-lineups__title {
    font-family: var(--mt-type-family-heading);
    font-variation-settings: 'opsz' 144;
    font-size: var(--mt-type-heading);
  }

  .maison-lineups__grid {
    display: grid;
    gap: 0;
    margin: 0;
    padding: 0;
    border-block-start: 1px solid var(--color-border);
  }

  .maison-lineups__item {
    border-block-end: 1px solid var(--color-border);
  }

  .maison-lineups__link {
    display: grid;
    gap: 0.4rem;
    padding-block: 1.5rem;
    padding-inline-end: 1rem;
    color: inherit;
    text-decoration: none;
  }

  .maison-lineups__link:hover .maison-lineups__label,
  .maison-lineups__link:focus-visible .maison-lineups__label {
    color: var(--brand-color-raw-copper, var(--color-foreground));
  }

  .maison-lineups__link:hover .maison-lineups__cta,
  .maison-lineups__link:focus-visible .maison-lineups__cta {
    transform: translateX(0.25rem);
  }

  .maison-lineups__kicker-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.75rem;
  }

  .maison-lineups__kicker {
    margin: 0;
    font-family: var(--mt-type-family-heading);
    font-size: var(--mt-type-mono);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-foreground-muted);
  }

  .maison-lineups__count {
    font-family: var(--mt-type-family-mono);
    font-size: var(--mt-type-mono);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--brand-color-aged-bronze, var(--color-foreground-muted));
  }

  .maison-lineups__label {
    margin: 0;
    font-family: var(--mt-type-family-heading);
    font-weight: var(--font-heading--weight);
    font-size: var(--mt-type-title);
    letter-spacing: 0.02em;
    transition: color 0.25s ease;
  }

  .maison-lineups__text {
    margin: 0;
    max-width: 36rem;
    color: var(--color-foreground-muted);
    font-size: var(--mt-type-body);
    line-height: 1.55;
  }

  .maison-lineups__cta {
    display: inline-block;
    margin-block-start: 0.35rem;
    font-size: var(--mt-type-accent);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--brand-color-aged-bronze, var(--color-foreground-muted));
    transition: transform 0.25s ease;
  }

  @media screen and (min-width: 750px) {
    .maison-lineups__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      border: 1px solid var(--color-border);
      border-block-start: 1px solid var(--color-border);
    }

    .maison-lineups__item {
      border-block-end: 1px solid var(--color-border);
    }

    .maison-lineups__item:nth-child(odd) {
      border-inline-end: 1px solid var(--color-border);
    }

    .maison-lineups__item:nth-last-child(-n + 2) {
      border-block-end: none;
    }

    .maison-lineups__link {
      min-height: 100%;
      padding: 1.75rem 1.5rem;
    }
  }

  .maison-lineups__content {
    display: grid;
    gap: 0.4rem;
  }

  .maison-lineups__media {
    margin-top: 1rem;
    border-radius: 4px;
    overflow: hidden;
    background: rgb(var(--color-foreground-rgb) / 0.04);
    border: 1px solid var(--color-border);
    aspect-ratio: 16 / 10;
  }

  .maison-lineups__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s ease;
  }

  .maison-lineups__link:hover .maison-lineups__img {
    transform: scale(1.035);
  }

  .maison-lineups__title .mt-word,
  .maison-lineups__title .mt-word-mask {
    vertical-align: top;
  }

  @media (prefers-reduced-motion: reduce) {
    .maison-lineups [data-mt-scroll],
    .maison-lineups [data-mt-scroll-item] {
      opacity: 1 !important;
      transform: none !important;
      visibility: visible !important;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.maison_lineups",
  "tag": "section",
  "class": "section-wrapper",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:settings.maison_eyebrow",
      "default": "The rooms"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:settings.heading",
      "default": "Shop by lineage"
    },
    {
      "type": "textarea",
      "id": "lede",
      "label": "t:settings.maison_lede",
      "default": "Four collection rooms: Forge Hybrid for skillets, Terre Clay for vessels, Kuro Strip for knives, Forge × Terre for hybrid service."
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 64
    }
  ],
  "blocks": [
    {
      "type": "lineup",
      "name": "t:names.maison_lineup",
      "settings": [
        {
          "type": "text",
          "id": "kicker",
          "label": "t:settings.maison_kicker",
          "default": "Skillets"
        },
        {
          "type": "text",
          "id": "label",
          "label": "t:settings.heading",
          "default": "Forge Hybrid"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "t:settings.content",
          "default": "Carbon-steel cookline concepts. Modular mass, hospitality service — still in draft."
        },
        {
          "type": "text",
          "id": "handle",
          "label": "t:settings.maison_collection_handle",
          "default": "forge",
          "info": "t:info.maison_collection_handle"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "t:settings.collection"
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:settings.link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:names.maison_lineups",
      "category": "t:categories.storytelling",
      "blocks": [
        {
          "type": "lineup",
          "settings": {
            "kicker": "Cookware and sets",
            "label": "Forge",
            "text": "Stainless steel cookware in grouped sizes, with matched sets.",
            "handle": "forge"
          }
        },
        {
          "type": "lineup",
          "settings": {
            "kicker": "Terracotta study",
            "label": "Chulha",
            "text": "Terracotta forms for flatbreads, chai and slow-cooked meals.",
            "handle": "chulha"
          }
        },
        {
          "type": "lineup",
          "settings": {
            "kicker": "Care and parts",
            "label": "Maintenance",
            "text": "Care supplies and replacement parts selected by vessel and fit.",
            "handle": "maintenance"
          }
        }
      ]
    }
  ]
}
{% endschema %}
