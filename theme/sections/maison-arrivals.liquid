{% comment %}
  Campaign room for the current heat. The grid follows the collection's
  own order; the full newest-first list is the sorted catalogue link.
{% endcomment %}

{% liquid
  assign source = collections.all
  if section.settings.collection != blank
    assign source = section.settings.collection
  endif
  assign limit = section.settings.limit | default: 8
%}

<div
  class="section section--page-width spacing-style maison-arrivals"
  style="{% render 'spacing-style', settings: section.settings %}"
>
  <header class="maison-arrivals__header">
    {% if section.settings.eyebrow != blank %}
      <p class="maison-arrivals__eyebrow">{{ section.settings.eyebrow | escape }}</p>
    {% endif %}
    <h1 class="maison-arrivals__title">
      {% if section.settings.heading != blank %}
        {{ section.settings.heading | escape }}
      {% else %}
        {{ page.title | escape }}
      {% endif %}
    </h1>
    {% if section.settings.lede != blank %}
      <p class="maison-arrivals__lede">{{ section.settings.lede | escape }}</p>
    {% endif %}
    <p class="maison-arrivals__actions">
      <a class="button" href="{{ source.url }}?sort_by=created-descending">Shop newest first</a>
      <a href="{{ routes.collections_url }}">All departments</a>
    </p>
  </header>

  {% if source.products_count > 0 %}
    <ul class="maison-arrivals__grid" role="list">
      {% for product in source.products limit: limit %}
        <li>
          <a class="maison-arrivals__card" href="{{ product.url }}">
            {% if product.featured_image %}
              {% assign image_alt = product.featured_image.alt | default: product.title %}
              {{
                product.featured_image
                | image_url: width: 900
                | image_tag:
                  widths: '300, 450, 600, 900',
                  sizes: '(min-width: 990px) 25vw, (min-width: 750px) 33vw, 100vw',
                  alt: image_alt,
                  loading: 'lazy'
              }}
            {% endif %}
            <span class="maison-arrivals__name">{{ product.title | escape }}</span>
            <span class="maison-arrivals__price">{{ product.price | money }}</span>
          </a>
        </li>
      {% endfor %}
    </ul>
  {% else %}
    <p>The catalogue has no published pieces in this room yet.</p>
  {% endif %}
</div>

{% stylesheet %}
  .maison-arrivals__header {
    max-width: 40rem;
    margin-block-end: 2rem;
  }

  .maison-arrivals__eyebrow {
    margin: 0;
    font-family: var(--font-mono--family, ui-monospace, monospace);
    font-size: 0.75rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-foreground-muted);
  }

  .maison-arrivals__title {
    margin: 0.5rem 0 1rem;
    font-family: var(--font-heading--family);
    font-size: clamp(2rem, 1.4rem + 2vw, 3.5rem);
    font-weight: 400;
    line-height: 1.05;
  }

  .maison-arrivals__lede {
    margin: 0 0 1.25rem;
    color: var(--color-foreground-muted);
  }

  .maison-arrivals__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 1.5rem;
    align-items: center;
  }

  .maison-arrivals__actions a {
    color: inherit;
  }

  .maison-arrivals__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem 1.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media screen and (min-width: 750px) {
    .maison-arrivals__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media screen and (min-width: 990px) {
    .maison-arrivals__grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .maison-arrivals__card {
    display: grid;
    gap: 0.45rem;
    color: inherit;
    text-decoration: none;
  }

  .maison-arrivals__card img {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
  }

  .maison-arrivals__name {
    font-family: var(--font-heading--family);
  }

  .maison-arrivals__card:focus-visible {
    outline: 2px solid var(--color-foreground);
    outline-offset: 3px;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.maison_arrivals",
  "tag": "section",
  "class": "section-wrapper",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:settings.maison_eyebrow",
      "default": "Campaign"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:settings.heading",
      "default": "New arrivals"
    },
    {
      "type": "textarea",
      "id": "lede",
      "label": "Introduction",
      "default": "The current heat. Pieces that entered the catalogue most recently, and the room we open when a foundry allocation is ready."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "t:settings.collection"
    },
    {
      "type": "range",
      "id": "limit",
      "label": "Pieces",
      "min": 4,
      "max": 16,
      "step": 1,
      "default": 8
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 64
    }
  ],
  "presets": [
    {
      "name": "t:names.maison_arrivals",
      "category": "t:categories.collection"
    }
  ]
}
{% endschema %}
