{% liquid
  if section.settings.background_color != blank
    render 'contrast-override', background_color: section.settings.background_color, section_id: section.id
  endif

  assign show_provenance = false
  if section.settings.place_1_label != blank or section.settings.place_2_label != blank or section.settings.place_3_label != blank
    assign show_provenance = true
  endif
%}

<div
  class="section-background{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
></div>
<div
  class="section section--page-width spacing-style maison-editorial maison-story{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
  style="{% render 'spacing-style', settings: section.settings %}"
>
  <header class="maison-editorial__header maison-story__header" data-mt-scroll="chapter">
    {% if section.settings.eyebrow != blank %}
      <p class="maison-editorial__eyebrow">{{ section.settings.eyebrow | escape }}</p>
    {% endif %}
    {% if section.settings.heading != blank %}
      <h1 class="maison-editorial__title" data-mt-scroll="kinetic">{{ section.settings.heading | escape }}</h1>
    {% endif %}
    {% if section.settings.lede != blank %}
      <p class="maison-editorial__lede">{{ section.settings.lede | escape }}</p>
    {% endif %}
  </header>

  {% if show_provenance %}
    <aside class="maison-story__provenance" aria-label="{{ 'maison.provenance_label' | t }}" data-mt-scroll>
      <p class="maison-story__provenance-eyebrow">{{ section.settings.provenance_eyebrow | default: 'Three places' | escape }}</p>
      <ul class="maison-story__places list-unstyled" role="list">
        {% if section.settings.place_1_label != blank %}
          <li class="maison-story__place">
            <p class="maison-story__place-label">{{ section.settings.place_1_label | escape }}</p>
            {% if section.settings.place_1_text != blank %}
              <p class="maison-story__place-text">{{ section.settings.place_1_text | escape }}</p>
            {% endif %}
          </li>
        {% endif %}
        {% if section.settings.place_2_label != blank %}
          <li class="maison-story__place">
            <p class="maison-story__place-label">{{ section.settings.place_2_label | escape }}</p>
            {% if section.settings.place_2_text != blank %}
              <p class="maison-story__place-text">{{ section.settings.place_2_text | escape }}</p>
            {% endif %}
          </li>
        {% endif %}
        {% if section.settings.place_3_label != blank %}
          <li class="maison-story__place">
            <p class="maison-story__place-label">{{ section.settings.place_3_label | escape }}</p>
            {% if section.settings.place_3_text != blank %}
              <p class="maison-story__place-text">{{ section.settings.place_3_text | escape }}</p>
            {% endif %}
          </li>
        {% endif %}
      </ul>
    </aside>
  {% endif %}

  {% if section.blocks.size > 0 %}
    <ol class="maison-story__chapters list-unstyled">
      {% for block in section.blocks %}
        <li
          class="maison-story__chapter"
          data-mt-scroll
          {{ block.shopify_attributes }}
        >
          {% if block.settings.kicker != blank %}
            <p class="maison-story__chapter-num" aria-hidden="true">{{ block.settings.kicker | escape }}</p>
          {% endif %}
          <div class="maison-story__chapter-body">
            {% if block.settings.kicker != blank %}
              <p class="maison-editorial__eyebrow">{{ block.settings.kicker | escape }}</p>
            {% endif %}
            {% if block.settings.heading != blank %}
              <h2 class="maison-editorial__card-title">{{ block.settings.heading | escape }}</h2>
            {% endif %}
            {% if block.settings.text != blank %}
              <div class="maison-editorial__rte rte">{{ block.settings.text }}</div>
            {% endif %}
          </div>
        </li>
      {% endfor %}
    </ol>
  {% endif %}
</div>

{% stylesheet %}
  .maison-editorial {
    color: var(--color-foreground);
    font-kerning: normal;
    text-rendering: optimizeLegibility;
    -webkit-font-smoothing: antialiased;
  }

  .maison-editorial__header {
    max-width: 44rem;
    margin-block-end: clamp(2rem, 4vw, 3.5rem);
  }

  .maison-editorial__eyebrow {
    margin: 0;
    font-family: var(--mt-type-family-mono);
    font-size: var(--mt-type-accent);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--brand-color-raw-copper, #C4784A);
    font-feature-settings: "zero" 1;
  }

  .maison-editorial__title {
    margin-block: 0.75rem 1.25rem;
    font-family: var(--mt-type-family-heading);
    font-weight: 400;
    letter-spacing: -0.015em;
    font-feature-settings: "liga" 1, "dlig" 1;
    font-variation-settings: 'opsz' 144;
    font-size: var(--mt-type-display);
    line-height: 1.08;
    color: var(--color-foreground);
  }

  .maison-editorial__lede {
    margin: 0;
    max-width: 42rem;
    color: var(--color-foreground);
    opacity: 0.85;
    font-size: var(--mt-type-lede);
    line-height: 1.7;
    font-kerning: normal;
  }

  .maison-editorial__card-title {
    margin: 0 0 0.75rem;
    font-family: var(--mt-type-family-heading);
    font-size: var(--mt-type-title);
    letter-spacing: -0.01em;
    font-feature-settings: "liga" 1;
    font-variation-settings: 'opsz' 72;
    color: var(--color-foreground);
  }

  .maison-editorial__rte,
  .maison-editorial__rte p {
    color: var(--color-foreground);
    opacity: 0.82;
    font-size: var(--mt-type-lede);
    line-height: 1.75;
    font-kerning: normal;
  }

  .maison-story__provenance {
    margin-block-end: clamp(2.5rem, 5vw, 4rem);
    padding-block: clamp(1.5rem, 3vw, 2.25rem);
    border-block: 1px solid var(--color-border, rgba(110, 90, 61, 0.25));
  }

  .maison-story__provenance-eyebrow {
    margin: 0 0 1.25rem;
    font-family: var(--mt-type-family-mono);
    font-size: var(--mt-type-mono);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--brand-color-aged-bronze, #6E5A3D);
  }

  .maison-story__places {
    display: grid;
    gap: 1.5rem;
    margin: 0;
    padding: 0;
  }

  .maison-story__place-label {
    margin: 0 0 0.5rem;
    font-family: var(--mt-type-family-heading);
    font-size: var(--mt-type-lede);
    letter-spacing: -0.01em;
    font-feature-settings: "liga" 1;
    color: var(--color-foreground);
  }

  .maison-story__place-text {
    margin: 0;
    max-width: 24rem;
    color: var(--color-foreground);
    opacity: 0.75;
    font-size: var(--mt-type-body);
    line-height: 1.6;
  }

  .maison-story__chapters {
    display: grid;
    gap: 0;
    margin: 0;
    padding: 0;
  }

  .maison-story__chapter {
    display: grid;
    gap: 1rem;
    padding-block: clamp(2rem, 4vw, 3rem);
    border-block-start: 1px solid var(--color-border, rgba(110, 90, 61, 0.2));
  }

  .maison-story__chapter:last-child {
    border-block-end: 1px solid var(--color-border, rgba(110, 90, 61, 0.2));
  }

  .maison-story__chapter-num {
    display: none;
    margin: 0;
    font-family: var(--mt-type-family-heading);
    font-size: var(--mt-type-display-lg);
    line-height: 0.9;
    letter-spacing: var(--mt-type-tracking-heading);
    color: rgb(var(--color-foreground-rgb, 26 23 20) / 0.15);
    font-variation-settings: 'opsz' 144;
    user-select: none;
  }

  .maison-story__chapter-body .maison-editorial__eyebrow {
    color: var(--brand-color-raw-copper, #C4784A);
    margin-bottom: 0.35rem;
  }

  @media screen and (min-width: 750px) {
    .maison-story__places {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 2rem;
    }

    .maison-story__chapter {
      grid-template-columns: 5.5rem minmax(0, 1fr);
      column-gap: 2rem;
      align-items: start;
    }

    .maison-story__chapter-num {
      display: block;
      grid-row: 1;
    }

    .maison-story__chapter-body {
      grid-column: 2;
      max-width: 40rem;
    }
  }

  .maison-story__header .mt-word,
  .maison-story__header .mt-word-mask {
    vertical-align: top;
  }

  @media (prefers-reduced-motion: reduce) {
    .maison-story [data-mt-scroll] {
      opacity: 1 !important;
      transform: none !important;
      visibility: visible !important;
    }
  }

  html[data-reduced-motion='true'] .maison-story [data-mt-scroll] {
    opacity: 1 !important;
    transform: none !important;
    visibility: visible !important;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.maison_story",
  "tag": "section",
  "class": "section-wrapper",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:settings.maison_eyebrow",
      "default": "Origin"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:settings.heading",
      "default": "Our story"
    },
    {
      "type": "textarea",
      "id": "lede",
      "label": "t:settings.maison_lede",
      "default": "Maison Tavo is Kartavya Jharwal's food house. The public record begins in Jaipur hospitality: a leased hotel, a property restaurant, and the work of feeding rooms, banquets, and walk-in tables from one kitchen."
    },
    {
      "type": "header",
      "content": "t:content.maison_provenance"
    },
    {
      "type": "text",
      "id": "provenance_eyebrow",
      "label": "t:settings.maison_eyebrow",
      "default": "Three places"
    },
    {
      "type": "text",
      "id": "place_1_label",
      "label": "t:settings.maison_place_1_label",
      "default": "Jaipur casting"
    },
    {
      "type": "textarea",
      "id": "place_1_text",
      "label": "t:settings.maison_place_1_text",
      "default": "Hospitality kitchens and clay grain — the Terre lineage as kitchen memory, not borrowed prestige."
    },
    {
      "type": "text",
      "id": "place_2_label",
      "label": "t:settings.maison_place_2_label",
      "default": "Japanese forging"
    },
    {
      "type": "textarea",
      "id": "place_2_text",
      "label": "t:settings.maison_place_2_text",
      "default": "Blade discipline and strip geometry — Kuro as craft language on the board."
    },
    {
      "type": "text",
      "id": "place_3_label",
      "label": "t:settings.maison_place_3_label",
      "default": "European rooms"
    },
    {
      "type": "textarea",
      "id": "place_3_text",
      "label": "t:settings.maison_place_3_text",
      "default": "Composition and restraint — the storefront behaves like a pass: quiet rooms, dual depth for chef and curator."
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 80
    }
  ],
  "blocks": [
    {
      "type": "chapter",
      "name": "t:names.maison_chapter",
      "settings": [
        {
          "type": "text",
          "id": "kicker",
          "label": "t:settings.maison_kicker",
          "default": "I"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "t:settings.heading",
          "default": "The hotel"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "t:settings.content",
          "default": "<p>Savi Hotels &amp; Resorts, Operational Lead, Jaipur, January 2021 to July 2026. Kartavya took entrepreneurship-through-acquisition control of a leased Savi property within SRBS Group — from handover and F&amp;B inventory through meeting rooms, banquet spaces, MICE catering, and walk-in lunches. He partnered with head chefs on kitchen standards and does not claim a formal line-cook title.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:names.maison_story",
      "category": "t:categories.storytelling"
    }
  ]
}
{% endschema %}
