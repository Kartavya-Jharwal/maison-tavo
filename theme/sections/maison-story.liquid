{% liquid
  if section.settings.background_color != blank
    render 'contrast-override', background_color: section.settings.background_color, section_id: section.id
  endif
%}

<div
  class="section-background{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
></div>
<div
  class="section section--page-width spacing-style maison-editorial maison-story{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
  style="{% render 'spacing-style', settings: section.settings %}"
>
  <header class="maison-editorial__header">
    {% if section.settings.eyebrow != blank %}
      <p class="maison-editorial__eyebrow">{{ section.settings.eyebrow | escape }}</p>
    {% endif %}
    {% if section.settings.heading != blank %}
      <h1 class="maison-editorial__title">{{ section.settings.heading | escape }}</h1>
    {% endif %}
    {% if section.settings.lede != blank %}
      <p class="maison-editorial__lede">{{ section.settings.lede | escape }}</p>
    {% endif %}
  </header>

  {% if section.blocks.size > 0 %}
    <ol class="maison-story__chapters list-unstyled">
      {% for block in section.blocks %}
        <li
          class="maison-story__chapter"
          {{ block.shopify_attributes }}
        >
          {% if block.settings.kicker != blank %}
            <p class="maison-editorial__eyebrow">{{ block.settings.kicker | escape }}</p>
          {% endif %}
          {% if block.settings.heading != blank %}
            <h2 class="maison-editorial__card-title">{{ block.settings.heading | escape }}</h2>
          {% endif %}
          {% if block.settings.text != blank %}
            <div class="maison-editorial__rte rte">{{ block.settings.text }}</div>
          {% endif %}
        </li>
      {% endfor %}
    </ol>
  {% endif %}
</div>

{% stylesheet %}
  .maison-editorial {
    color: var(--color-foreground);
  }

  .maison-editorial__header {
    max-width: 42rem;
    margin-block-end: 3rem;
  }

  .maison-editorial__eyebrow {
    margin: 0;
    font-family: var(--font-heading--family);
    font-size: 0.75rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-foreground-muted);
  }

  .maison-editorial__title {
    margin-block: 0.75rem 1rem;
    font-family: var(--font-heading--family);
    font-weight: var(--font-heading--weight);
    letter-spacing: 0.04em;
  }

  .maison-editorial__lede {
    margin: 0;
    max-width: 40rem;
    color: var(--color-foreground-muted);
    font-size: 1.125rem;
    line-height: 1.6;
  }

  .maison-editorial__card-title {
    margin: 0 0 0.75rem;
    font-family: var(--font-heading--family);
    font-size: 1.125rem;
    letter-spacing: 0.03em;
  }

  .maison-editorial__rte,
  .maison-editorial__rte p {
    color: var(--color-foreground-muted);
  }

  .maison-story__chapters {
    display: grid;
    gap: 2.5rem;
    margin: 0;
    padding: 0;
  }

  .maison-story__chapter {
    max-width: 42rem;
    padding-block-start: 1.5rem;
    border-block-start: 1px solid var(--color-border);
  }

  .maison-story .maison-editorial__card-title {
    margin-block-start: 0.5rem;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.maison_story",
  "tag": "section",
  "class": "section-wrapper",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:settings.maison_eyebrow",
      "default": "Origin"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:settings.heading",
      "default": "Our story"
    },
    {
      "type": "textarea",
      "id": "lede",
      "label": "t:settings.maison_lede",
      "default": "Maison Tavo is Kartavya Jharwal's food house. The public record begins in Jaipur hospitality: a leased hotel, a property restaurant, and the work of feeding rooms, banquets, and walk-in tables from one kitchen."
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 80
    }
  ],
  "blocks": [
    {
      "type": "chapter",
      "name": "t:names.maison_chapter",
      "settings": [
        {
          "type": "text",
          "id": "kicker",
          "label": "t:settings.maison_kicker",
          "default": "I"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "t:settings.heading",
          "default": "The hotel"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "t:settings.content",
          "default": "<p>Savi Hotels &amp; Resorts, Operational Lead, Jaipur, January 2021 to July 2026. Kartavya took entrepreneurship-through-acquisition control of a leased Savi property within SRBS Group — from handover and F&amp;B inventory through meeting rooms, banquet spaces, MICE catering, and walk-in lunches. He partnered with head chefs on kitchen standards and does not claim a formal line-cook title.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:names.maison_story",
      "category": "t:categories.storytelling"
    }
  ]
}
{% endschema %}
