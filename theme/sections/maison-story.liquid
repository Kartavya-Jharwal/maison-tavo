{% liquid
  if section.settings.background_color != blank
    render 'contrast-override', background_color: section.settings.background_color, section_id: section.id
  endif

  assign show_provenance = false
  if section.settings.place_1_label != blank or section.settings.place_2_label != blank or section.settings.place_3_label != blank
    assign show_provenance = true
  endif
%}

<div
  class="section-background{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
></div>
<div
  class="section section--page-width spacing-style maison-reading maison-story{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
  style="{% render 'spacing-style', settings: section.settings %}"
>
  <header class="maison-editorial__header" data-mt-scroll="chapter">
    {% if section.settings.eyebrow != blank %}
      <p class="maison-editorial__eyebrow">{{ section.settings.eyebrow | escape }}</p>
    {% endif %}
    {% if section.settings.heading != blank %}
      <h1 class="maison-editorial__title">{{ section.settings.heading | escape }}</h1>
    {% endif %}
    {% if section.settings.lede != blank %}
      <p class="maison-editorial__lede">{{ section.settings.lede | escape }}</p>
    {% endif %}
  </header>

  {% if show_provenance %}
    <aside class="maison-story__provenance" aria-label="{{ 'maison.provenance_label' | t }}" data-mt-scroll>
      <p class="maison-editorial__eyebrow maison-story__provenance-label">{{ section.settings.provenance_eyebrow | default: 'Three places' | escape }}</p>
      <ul class="maison-story__places list-unstyled" role="list">
        {% if section.settings.place_1_label != blank %}
          <li class="maison-story__place">
            <p class="maison-story__place-label">{{ section.settings.place_1_label | escape }}</p>
            {% if section.settings.place_1_text != blank %}
              <p class="maison-story__place-text">{{ section.settings.place_1_text | escape }}</p>
            {% endif %}
          </li>
        {% endif %}
        {% if section.settings.place_2_label != blank %}
          <li class="maison-story__place">
            <p class="maison-story__place-label">{{ section.settings.place_2_label | escape }}</p>
            {% if section.settings.place_2_text != blank %}
              <p class="maison-story__place-text">{{ section.settings.place_2_text | escape }}</p>
            {% endif %}
          </li>
        {% endif %}
        {% if section.settings.place_3_label != blank %}
          <li class="maison-story__place">
            <p class="maison-story__place-label">{{ section.settings.place_3_label | escape }}</p>
            {% if section.settings.place_3_text != blank %}
              <p class="maison-story__place-text">{{ section.settings.place_3_text | escape }}</p>
            {% endif %}
          </li>
        {% endif %}
      </ul>
    </aside>
  {% endif %}

  {% if section.blocks.size > 0 %}
    <ol class="maison-story__chapters list-unstyled" role="list">
      {% for block in section.blocks %}
        <li
          class="maison-story__chapter"
          data-mt-scroll
          {{ block.shopify_attributes }}
        >
          <div class="maison-story__chapter-body">
            {% if block.settings.kicker != blank %}
              <p class="maison-editorial__eyebrow">{{ block.settings.kicker | escape }}</p>
            {% endif %}
            {% if block.settings.heading != blank %}
              <h2 class="maison-editorial__card-title">{{ block.settings.heading | escape }}</h2>
            {% endif %}
            {% if block.settings.text != blank %}
              <div class="maison-editorial__rte rte">{{ block.settings.text }}</div>
            {% endif %}
          </div>
          {% liquid
            assign chapter_image = block.settings.image
            assign fallback_alt = ''
            if chapter_image == blank
              case forloop.index
                when 1
                  assign fallback_asset = 'maison-about-provenance.webp'
                  assign fallback_alt = 'Copper vessels stacked and hung in a cookware shop'
                  assign fallback_width = 435
                  assign fallback_height = 660
                when 2
                  assign fallback_asset = 'maison-editorial-pottery-courtney-cook.avif'
                  assign fallback_alt = 'Hands shaping a clay pot on a pottery wheel'
                  assign fallback_width = 687
                  assign fallback_height = 1030
                when 3
                  assign fallback_asset = 'maison-about-artisan-heritage.webp'
                  assign fallback_alt = 'A woman seated with terracotta pots'
                  assign fallback_width = 1080
                  assign fallback_height = 1350
                else
                  assign fallback_asset = 'maison-handle-engineering.webp'
                  assign fallback_alt = 'Close view of a metal cookware handle'
                  assign fallback_width = 493
                  assign fallback_height = 493
              endcase
            endif
          %}
          <div class="maison-story__chapter-media">
            {% if chapter_image != blank %}
              {{ chapter_image | image_url: width: 1200 | image_tag: class: 'maison-story__chapter-img', loading: 'lazy' }}
            {% else %}
              <img
                class="maison-story__chapter-img"
                src="{{ fallback_asset | asset_url }}"
                alt="{{ fallback_alt | escape }}"
                loading="lazy"
                width="{{ fallback_width }}"
                height="{{ fallback_height }}"
              >
            {% endif %}
          </div>
        </li>
      {% endfor %}
    </ol>
  {% endif %}
</div>

{% stylesheet %}
  .maison-story__provenance {
    margin-block-end: var(--maison-reading-gap);
    padding-block: clamp(1rem, 2.5vw, 1.75rem);
    border-block: 1px solid var(--color-border);
  }

  .maison-story .maison-story__provenance-label {
    margin-block-end: 1rem;
  }

  .maison-story__places {
    display: grid;
    gap: 1rem 2rem;
    margin: 0;
    padding: 0;
  }

  .maison-story__place-label {
    margin: 0 0 0.25rem;
    font-family: var(--mt-type-family-heading);
    font-size: var(--maison-reading-lede);
    letter-spacing: var(--mt-type-tracking-heading);
  }

  .maison-story__place-text {
    margin: 0;
    max-inline-size: 46ch;
  }

  .maison-story__chapters {
    margin: 0;
    padding: 0;
  }

  .maison-story__chapter {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--maison-reading-gap);
    align-items: start;
    padding-block: var(--maison-reading-gap);
    border-block-start: 1px solid var(--color-border);
  }

  .maison-story__chapter:last-child {
    border-block-end: 1px solid var(--color-border);
  }

  .maison-story .maison-story__chapter-body .maison-editorial__eyebrow {
    margin-block-end: 0.5rem;
  }

  .maison-story__chapter-media {
    inline-size: 100%;
    max-inline-size: 34rem;
    background: rgb(var(--color-foreground-rgb) / 0.04);
  }

  .maison-story__chapter-img {
    display: block;
    inline-size: 100%;
    block-size: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }

  @media (min-width: 56rem) {
    .maison-story__places {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .maison-story__chapter {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    }

    .maison-story__chapter-media {
      justify-self: end;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .maison-story [data-mt-scroll] {
      opacity: 1 !important;
      transform: none !important;
      visibility: visible !important;
    }
  }

  html[data-reduced-motion='true'] .maison-story [data-mt-scroll] {
    opacity: 1 !important;
    transform: none !important;
    visibility: visible !important;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.maison_story",
  "tag": "section",
  "class": "section-wrapper",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:settings.maison_eyebrow",
      "default": "Origin"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:settings.heading",
      "default": "Our story"
    },
    {
      "type": "textarea",
      "id": "lede",
      "label": "t:settings.maison_lede",
      "default": "Maison Tavo is a cookware concept rooted in Indian kitchens, from the flat tava to the terracotta handi."
    },
    {
      "type": "header",
      "content": "t:content.maison_provenance"
    },
    {
      "type": "text",
      "id": "provenance_eyebrow",
      "label": "t:settings.maison_eyebrow",
      "default": "Three places"
    },
    {
      "type": "text",
      "id": "place_1_label",
      "label": "t:settings.maison_place_1_label",
      "default": "Jaipur casting"
    },
    {
      "type": "textarea",
      "id": "place_1_text",
      "label": "t:settings.maison_place_1_text",
      "default": "Hospitality kitchens and clay grain — the Terre lineage as kitchen memory, not borrowed prestige."
    },
    {
      "type": "text",
      "id": "place_2_label",
      "label": "t:settings.maison_place_2_label",
      "default": "Japanese forging"
    },
    {
      "type": "textarea",
      "id": "place_2_text",
      "label": "t:settings.maison_place_2_text",
      "default": "Blade discipline and strip geometry — Kuro as craft language on the board."
    },
    {
      "type": "text",
      "id": "place_3_label",
      "label": "t:settings.maison_place_3_label",
      "default": "European rooms"
    },
    {
      "type": "textarea",
      "id": "place_3_text",
      "label": "t:settings.maison_place_3_text",
      "default": "Composition and restraint — the storefront behaves like a pass: quiet rooms, dual depth for chef and curator."
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 80
    }
  ],
  "blocks": [
    {
      "type": "chapter",
      "name": "t:names.maison_chapter",
      "settings": [
        {
          "type": "text",
          "id": "kicker",
          "label": "t:settings.maison_kicker",
          "default": "I"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "t:settings.heading",
          "default": "A house named for a griddle"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "t:settings.content",
          "default": "<p>Maison means house. Tavo takes its name from the tava, a flat griddle familiar to Indian kitchens.</p>"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:settings.image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:names.maison_story",
      "category": "t:categories.storytelling"
    }
  ]
}
{% endschema %}
