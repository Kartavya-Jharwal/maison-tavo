{% liquid
  if section.settings.background_color != blank
    render 'contrast-override', background_color: section.settings.background_color, section_id: section.id
  endif

  assign show_provenance = false
  if section.settings.place_1_label != blank or section.settings.place_2_label != blank or section.settings.place_3_label != blank
    assign show_provenance = true
  endif
%}

<div
  class="section-background{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
></div>
<div
  class="section section--page-width spacing-style maison-editorial maison-story{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
  style="{% render 'spacing-style', settings: section.settings %}"
  data-maison-reveal-root
>
  <header class="maison-editorial__header maison-story__header" data-maison-reveal>
    {% if section.settings.eyebrow != blank %}
      <p class="maison-editorial__eyebrow">{{ section.settings.eyebrow | escape }}</p>
    {% endif %}
    {% if section.settings.heading != blank %}
      <h1 class="maison-editorial__title">{{ section.settings.heading | escape }}</h1>
    {% endif %}
    {% if section.settings.lede != blank %}
      <p class="maison-editorial__lede">{{ section.settings.lede | escape }}</p>
    {% endif %}
  </header>

  {% if show_provenance %}
    <aside class="maison-story__provenance" aria-label="{{ 'maison.provenance_label' | t }}" data-maison-reveal>
      <p class="maison-story__provenance-eyebrow">{{ section.settings.provenance_eyebrow | default: 'Three places' | escape }}</p>
      <ul class="maison-story__places list-unstyled" role="list">
        {% if section.settings.place_1_label != blank %}
          <li class="maison-story__place">
            <p class="maison-story__place-label">{{ section.settings.place_1_label | escape }}</p>
            {% if section.settings.place_1_text != blank %}
              <p class="maison-story__place-text">{{ section.settings.place_1_text | escape }}</p>
            {% endif %}
          </li>
        {% endif %}
        {% if section.settings.place_2_label != blank %}
          <li class="maison-story__place">
            <p class="maison-story__place-label">{{ section.settings.place_2_label | escape }}</p>
            {% if section.settings.place_2_text != blank %}
              <p class="maison-story__place-text">{{ section.settings.place_2_text | escape }}</p>
            {% endif %}
          </li>
        {% endif %}
        {% if section.settings.place_3_label != blank %}
          <li class="maison-story__place">
            <p class="maison-story__place-label">{{ section.settings.place_3_label | escape }}</p>
            {% if section.settings.place_3_text != blank %}
              <p class="maison-story__place-text">{{ section.settings.place_3_text | escape }}</p>
            {% endif %}
          </li>
        {% endif %}
      </ul>
    </aside>
  {% endif %}

  {% if section.blocks.size > 0 %}
    <ol class="maison-story__chapters list-unstyled">
      {% for block in section.blocks %}
        <li
          class="maison-story__chapter"
          data-maison-reveal
          style="--maison-reveal-delay: {{ forloop.index0 | times: 70 }}ms"
          {{ block.shopify_attributes }}
        >
          {% if block.settings.kicker != blank %}
            <p class="maison-story__chapter-num" aria-hidden="true">{{ block.settings.kicker | escape }}</p>
          {% endif %}
          <div class="maison-story__chapter-body">
            {% if block.settings.kicker != blank %}
              <p class="maison-editorial__eyebrow">{{ block.settings.kicker | escape }}</p>
            {% endif %}
            {% if block.settings.heading != blank %}
              <h2 class="maison-editorial__card-title">{{ block.settings.heading | escape }}</h2>
            {% endif %}
            {% if block.settings.text != blank %}
              <div class="maison-editorial__rte rte">{{ block.settings.text }}</div>
            {% endif %}
          </div>
        </li>
      {% endfor %}
    </ol>
  {% endif %}
</div>

{% stylesheet %}
  .maison-editorial {
    color: var(--color-foreground);
  }

  .maison-editorial__header {
    max-width: 42rem;
    margin-block-end: 2.5rem;
  }

  .maison-editorial__eyebrow {
    margin: 0;
    font-family: var(--font-heading--family);
    font-size: 0.75rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-foreground-muted);
  }

  .maison-editorial__title {
    margin-block: 0.75rem 1rem;
    font-family: var(--font-fraunces--family, var(--font-heading--family));
    font-weight: var(--font-heading--weight);
    letter-spacing: 0.04em;
    font-variation-settings: 'opsz' 144;
    font-size: clamp(2.25rem, 1.6rem + 2.2vw, 3.5rem);
    line-height: 1.1;
  }

  .maison-editorial__lede {
    margin: 0;
    max-width: 40rem;
    color: var(--color-foreground-muted);
    font-size: 1.125rem;
    line-height: 1.6;
  }

  .maison-editorial__card-title {
    margin: 0 0 0.75rem;
    font-family: var(--font-fraunces--family, var(--font-heading--family));
    font-size: clamp(1.25rem, 1.1rem + 0.6vw, 1.5rem);
    letter-spacing: 0.03em;
    font-variation-settings: 'opsz' 72;
  }

  .maison-editorial__rte,
  .maison-editorial__rte p {
    color: var(--color-foreground-muted);
  }

  .maison-story__provenance {
    margin-block-end: 3.5rem;
    padding-block: 1.75rem;
    border-block: 1px solid var(--color-border);
  }

  .maison-story__provenance-eyebrow {
    margin: 0 0 1.25rem;
    font-family: var(--font-heading--family);
    font-size: 0.6875rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--brand-color-aged-bronze, var(--color-foreground-muted));
  }

  .maison-story__places {
    display: grid;
    gap: 1.5rem;
    margin: 0;
    padding: 0;
  }

  .maison-story__place-label {
    margin: 0 0 0.4rem;
    font-family: var(--font-fraunces--family, var(--font-heading--family));
    font-size: 1.05rem;
    letter-spacing: 0.02em;
  }

  .maison-story__place-text {
    margin: 0;
    max-width: 22rem;
    color: var(--color-foreground-muted);
    font-size: 0.9375rem;
    line-height: 1.55;
  }

  .maison-story__chapters {
    display: grid;
    gap: 0;
    margin: 0;
    padding: 0;
  }

  .maison-story__chapter {
    display: grid;
    gap: 0.75rem;
    padding-block: 2rem;
    border-block-start: 1px solid var(--color-border);
  }

  .maison-story__chapter:last-child {
    border-block-end: 1px solid var(--color-border);
  }

  .maison-story__chapter-num {
    display: none;
    margin: 0;
    font-family: var(--font-fraunces--family, var(--font-heading--family));
    font-size: clamp(3rem, 2rem + 3vw, 4.5rem);
    line-height: 0.9;
    letter-spacing: -0.02em;
    color: rgb(var(--color-foreground-rgb) / 0.12);
    font-variation-settings: 'opsz' 144;
  }

  .maison-story__chapter-body .maison-editorial__eyebrow {
    color: var(--brand-color-raw-copper, var(--color-foreground-muted));
  }

  @media screen and (min-width: 750px) {
    .maison-story__places {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 2rem;
    }

    .maison-story__chapter {
      grid-template-columns: 5.5rem minmax(0, 1fr);
      column-gap: 2rem;
      align-items: start;
    }

    .maison-story__chapter-num {
      display: block;
      grid-row: 1;
    }

    .maison-story__chapter-body {
      grid-column: 2;
      max-width: 40rem;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .maison-story [data-maison-reveal] {
      opacity: 0;
      transform: translateY(0.85rem);
      transition:
        opacity 0.75s cubic-bezier(0.16, 1, 0.3, 1),
        transform 0.75s cubic-bezier(0.16, 1, 0.3, 1);
      transition-delay: var(--maison-reveal-delay, 0ms);
    }

    .maison-story [data-maison-reveal].is-revealed {
      opacity: 1;
      transform: none;
    }
  }
{% endstylesheet %}

{% javascript %}
  (() => {
    const root = document.querySelector('.maison-story[data-maison-reveal-root]');
    if (!root) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    const items = root.querySelectorAll('[data-maison-reveal]');
    if (!items.length || !('IntersectionObserver' in window)) {
      items.forEach((el) => el.classList.add('is-revealed'));
      return;
    }

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          entry.target.classList.add('is-revealed');
          observer.unobserve(entry.target);
        });
      },
      { rootMargin: '0px 0px -6% 0px', threshold: 0.12 }
    );

    items.forEach((el) => observer.observe(el));
  })();
{% endjavascript %}

{% schema %}
{
  "name": "t:names.maison_story",
  "tag": "section",
  "class": "section-wrapper",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:settings.maison_eyebrow",
      "default": "Origin"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:settings.heading",
      "default": "Our story"
    },
    {
      "type": "textarea",
      "id": "lede",
      "label": "t:settings.maison_lede",
      "default": "Maison Tavo is Kartavya Jharwal's food house. The public record begins in Jaipur hospitality: a leased hotel, a property restaurant, and the work of feeding rooms, banquets, and walk-in tables from one kitchen."
    },
    {
      "type": "header",
      "content": "t:content.maison_provenance"
    },
    {
      "type": "text",
      "id": "provenance_eyebrow",
      "label": "t:settings.maison_eyebrow",
      "default": "Three places"
    },
    {
      "type": "text",
      "id": "place_1_label",
      "label": "t:settings.maison_place_1_label",
      "default": "Jaipur casting"
    },
    {
      "type": "textarea",
      "id": "place_1_text",
      "label": "t:settings.maison_place_1_text",
      "default": "Hospitality kitchens and clay grain — the Terre lineage as kitchen memory, not borrowed prestige."
    },
    {
      "type": "text",
      "id": "place_2_label",
      "label": "t:settings.maison_place_2_label",
      "default": "Japanese forging"
    },
    {
      "type": "textarea",
      "id": "place_2_text",
      "label": "t:settings.maison_place_2_text",
      "default": "Blade discipline and strip geometry — Kuro as craft language on the board."
    },
    {
      "type": "text",
      "id": "place_3_label",
      "label": "t:settings.maison_place_3_label",
      "default": "European rooms"
    },
    {
      "type": "textarea",
      "id": "place_3_text",
      "label": "t:settings.maison_place_3_text",
      "default": "Composition and restraint — the storefront behaves like a pass: quiet rooms, dual depth for chef and curator."
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 80
    }
  ],
  "blocks": [
    {
      "type": "chapter",
      "name": "t:names.maison_chapter",
      "settings": [
        {
          "type": "text",
          "id": "kicker",
          "label": "t:settings.maison_kicker",
          "default": "I"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "t:settings.heading",
          "default": "The hotel"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "t:settings.content",
          "default": "<p>Savi Hotels &amp; Resorts, Operational Lead, Jaipur, January 2021 to July 2026. Kartavya took entrepreneurship-through-acquisition control of a leased Savi property within SRBS Group — from handover and F&amp;B inventory through meeting rooms, banquet spaces, MICE catering, and walk-in lunches. He partnered with head chefs on kitchen standards and does not claim a formal line-cook title.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:names.maison_story",
      "category": "t:categories.storytelling"
    }
  ]
}
{% endschema %}
