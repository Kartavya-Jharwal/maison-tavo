{% doc %}
  Maison Tavo · Universal Commerce Protocol (UCP) & Agent-to-Agent Explorer.
  Renders a visual, syntax-highlighted protocol viewer for human walkthroughs,
  paired with embedded machine-readable JSON metadata for AI agents.
{% enddoc %}

<div class="maison-ucp section section--page-width" id="ucp" data-section-id="{{ section.id }}">
  <header class="maison-ucp__header">
    <div class="maison-ucp__eyebrow-row">
      <span class="maison-ucp__badge">UCP SPEC 2026-08-25</span>
      <span class="maison-ucp__badge maison-ucp__badge--a2a">A2A AGENT PROTOCOL</span>
      <span class="maison-ucp__status">● ACTIVE PROTOCOL ENDPOINT</span>
    </div>
    <h1 class="maison-ucp__title">Agentic Commerce &amp; Machine-Readable Spec Layer</h1>
    <p class="maison-ucp__lede">
      Maison Tavo exposes a dual-depth architecture: human-curated hospitality on the storefront,
      and deterministic UCP metadata for autonomous purchasing agents and culinary companion surfaces.
    </p>
  </header>

  <div class="maison-ucp__console">
    <div class="maison-ucp__console-bar">
      <div class="maison-ucp__traffic-lights">
        <span></span><span></span><span></span>
      </div>
      <div class="maison-ucp__tabs" role="tablist">
        <button class="maison-ucp__tab is-active" data-tab="tab-wellknown" role="tab" aria-selected="true">
          /.well-known/ucp
        </button>
        <button class="maison-ucp__tab" data-tab="tab-catalog" role="tab" aria-selected="false">
          /catalog/agent-spec.json
        </button>
        <button class="maison-ucp__tab" data-tab="tab-a2a" role="tab" aria-selected="false">
          /a2a/kansa-dispatch.json
        </button>
      </div>
      <button class="maison-ucp__copy-btn" id="ucp-copy-btn" title="Copy active JSON to clipboard">
        Copy JSON
      </button>
    </div>

    <!-- TAB 1: .well-known/ucp -->
    <div class="maison-ucp__panel is-active" id="tab-wellknown" role="tabpanel">
      <div class="maison-ucp__panel-meta">
        <span class="maison-ucp__url-pill">GET /.well-known/ucp</span>
        <span class="maison-ucp__note">Platform handshake profile · Validated by @maison-tavo/ucp</span>
      </div>
      <pre class="maison-ucp__code"><code id="code-wellknown">{
  "ucp": {
    "version": "2026-08-25",
    "name": "Maison Tavo",
    "domain": "maison-tavo.myshopify.com",
    "description": "Modern heirlooms for the working kitchen - metallurgy you can parse, craft you can live with.",
    "capabilities": {
      "dev.ucp.shopping.catalog.search": [
        {
          "version": "2026-08-25",
          "spec": "https://ucp.dev/2026-08-25/specification/shopping/catalog/",
          "schema": "https://ucp.dev/2026-08-25/schemas/shopping/catalog_search.json"
        }
      ],
      "dev.ucp.shopping.cart": [
        {
          "version": "2026-08-25",
          "spec": "https://ucp.dev/2026-08-25/specification/shopping/cart/",
          "schema": "https://ucp.dev/2026-08-25/schemas/shopping/cart.json"
        }
      ],
      "dev.ucp.shopping.checkout": [
        {
          "version": "2026-08-25",
          "spec": "https://ucp.dev/2026-08-25/specification/shopping/checkout/",
          "schema": "https://ucp.dev/2026-08-25/schemas/shopping/checkout.json"
        }
      ],
      "dev.ucp.shopping.order": [
        {
          "version": "2026-08-25",
          "spec": "https://ucp.dev/2026-08-25/specification/shopping/order/",
          "schema": "https://ucp.dev/2026-08-25/schemas/shopping/order.json"
        }
      ]
    },
    "payment_handlers": {
      "shopify_payments": [
        {
          "version": "2026-08-25",
          "spec": "https://ucp.dev/2026-08-25/specification/shopping/checkout/",
          "settlement_currency": "USD",
          "escalation_policy": {
            "on_status": "requires_escalation",
            "action": "follow_continue_url"
          }
        }
      ]
    },
    "companion_surface": {
      "name": "Kansa",
      "transport": "a2a",
      "version": "1.0.0",
      "endpoint": "/pages/kansa",
      "supported_intents": ["pan_care", "thermal_limits", "alloy_provenance", "order_escalation"]
    }
  }
}</code></pre>
    </div>

    <!-- TAB 2: /catalog/agent-spec.json -->
