{% comment %}
  Maison Tavo · Universal Commerce Protocol (UCP) & Agent-to-Agent Explorer.
  Renders a visual, syntax-highlighted protocol viewer for human walkthroughs,
  paired with embedded machine-readable JSON metadata for AI agents.
{% endcomment %}

<div class="maison-ucp section section--page-width" id="ucp" data-section-id="{{ section.id }}">
  <header class="maison-ucp__header">
    <div class="maison-ucp__eyebrow-row">
      <span class="maison-ucp__badge">UCP SPEC 2026-08-25</span>
      <span class="maison-ucp__badge maison-ucp__badge--a2a">A2A AGENT PROTOCOL</span>
      <span class="maison-ucp__status">● ACTIVE PROTOCOL ENDPOINT</span>
    </div>
    <h1 class="maison-ucp__title">Agentic Commerce &amp; Machine-Readable Spec Layer</h1>
    <p class="maison-ucp__lede">
      Maison Tavo exposes a dual-depth architecture: human-curated hospitality on the storefront,
      and deterministic UCP metadata for autonomous purchasing agents and culinary companion surfaces.
    </p>
  </header>

  <div class="maison-ucp__console">
    <div class="maison-ucp__console-bar">
      <div class="maison-ucp__status-indicator">
        <span class="status-dot"></span>
        <span class="status-text">UCP 2026 MACHINE ENDPOINT</span>
      </div>
      <div class="maison-ucp__tabs" role="tablist">
        <button class="maison-ucp__tab is-active" data-tab="tab-wellknown" role="tab" aria-selected="true">
          /.well-known/ucp
        </button>
        <button class="maison-ucp__tab" data-tab="tab-catalog" role="tab" aria-selected="false">
          /catalog/agent-spec.json
        </button>
        <button class="maison-ucp__tab" data-tab="tab-a2a" role="tab" aria-selected="false">
          /a2a/kansa-dispatch.json
        </button>
        <button class="maison-ucp__tab" data-tab="tab-molbhav" role="tab" aria-selected="false">
          /a2a/mol-bhav-trace.json
        </button>
      </div>
      <button class="maison-ucp__copy-btn" id="ucp-copy-btn" title="Copy active JSON to clipboard">
        Copy Spec
      </button>
    </div>

    <!-- TAB 1: .well-known/ucp -->
    <div class="maison-ucp__panel is-active" id="tab-wellknown" role="tabpanel">
      <div class="maison-ucp__panel-meta">
        <span class="maison-ucp__url-pill">GET /.well-known/ucp</span>
        <span class="maison-ucp__note">Platform handshake profile · Validated by @maison-tavo/ucp</span>
      </div>
      <pre class="maison-ucp__code"><code id="code-wellknown">{
  "ucp": {
    "version": "2026-08-25",
    "name": "Maison Tavo",
    "domain": "maison-tavo.myshopify.com",
    "description": "Modern heirlooms for the working kitchen - metallurgy you can parse, craft you can live with.",
    "capabilities": {
      "dev.ucp.shopping.catalog.search": [
        {
          "version": "2026-08-25",
          "spec": "https://ucp.dev/2026-08-25/specification/shopping/catalog/",
          "schema": "https://ucp.dev/2026-08-25/schemas/shopping/catalog_search.json"
        }
      ],
      "dev.ucp.shopping.catalog.lookup": [
        {
          "version": "2026-08-25",
          "spec": "https://ucp.dev/2026-08-25/specification/shopping/catalog/",
          "schema": "https://ucp.dev/2026-08-25/schemas/shopping/catalog_lookup.json"
        }
      ],
      "dev.shopify.catalog": [
        {
          "version": "2026-08-25",
          "spec": "https://shopify.dev/docs/agents/catalog/storefront-catalog",
          "schema": "https://shopify.dev/ucp/schemas/2026-08-25/shopify_catalog.json"
        }
      ],
      "dev.ucp.shopping.cart": [
        {
          "version": "2026-08-25",
          "spec": "https://ucp.dev/2026-08-25/specification/shopping/cart/",
          "schema": "https://ucp.dev/2026-08-25/schemas/shopping/cart.json"
        }
      ],
      "dev.ucp.shopping.checkout": [
        {
          "version": "2026-08-25",
          "spec": "https://ucp.dev/2026-08-25/specification/shopping/checkout/",
          "schema": "https://ucp.dev/2026-08-25/schemas/shopping/checkout.json"
        }
      ],
      "dev.ucp.shopping.order": [
        {
          "version": "2026-08-25",
          "spec": "https://ucp.dev/2026-08-25/specification/shopping/order/",
          "schema": "https://ucp.dev/2026-08-25/schemas/shopping/order.json"
        }
      ]
    },
    "payment_handlers": {
      "shopify_payments": [
        {
          "version": "2026-08-25",
          "spec": "https://ucp.dev/2026-08-25/specification/shopping/checkout/",
          "settlement_currency": "USD",
          "escalation_policy": {
            "on_status": "requires_escalation",
            "action": "follow_continue_url"
          }
        }
      ]
    },
    "companion_surface": {
      "name": "Kansa",
      "transport": "a2a",
      "version": "1.0.0",
      "endpoint": "/pages/kansa",
      "supported_intents": ["pan_care", "thermal_limits", "alloy_provenance", "order_escalation"]
    }
  }
}</code></pre>
    </div>

    <!-- TAB 2: /catalog/agent-spec.json -->
    <div class="maison-ucp__panel" id="tab-catalog" role="tabpanel">
      <div class="maison-ucp__panel-meta">
        <span class="maison-ucp__url-pill">POST /api/ucp/mcp · search_catalog / lookup_catalog / get_product</span>
        <span class="maison-ucp__note">Live 25-SKU storefront catalog projected from Shopify Admin + specs.* metafields</span>
      </div>
      {%- assign live_all = collections['all'] -%}
      <pre class="maison-ucp__code"><code id="code-catalog">{
  "spec_version": "2026-08-25",
  "store": {{ shop.name | default: 'Maison Tavo' | json }},
  "storefront_mcp_endpoint": "https://maison-tavo.myshopify.com/api/ucp/mcp",
  "total_items": {{ live_all.all_products_count | default: 25 }},
  "catalog": [
{%- if live_all != blank and live_all.products_count > 0 -%}
  {%- for p in live_all.products limit: 25 -%}
    {%- assign ps = p.metafields.specs -%}
    {%- assign pv = p.selected_or_first_available_variant -%}
    {
      "id": {{ 'gid://shopify/Product/' | append: p.id | json }},
      "sku": {{ pv.sku | default: p.handle | json }},
      "handle": {{ p.handle | json }},
      "title": {{ p.title | json }},
      "lineup": {{ ps.lineup.value | default: p.vendor | json }},
      "product_type": {{ p.type | json }},
      "price_minor_usd": {{ pv.price | json }},
      "available": {{ pv.available | json }},
      "claim_status": {{ ps.claim_status.value | default: 'CONCEPT_SPEC' | json }},
      "primary_material": {{ ps.primary_material.value | default: ps.material_architecture.value | json }},
      "lining_material": {{ ps.lining_material.value | json }},
      "dimensions": {{ ps.dimensions_summary.value | json }},
      "dishwasher_suitability": {{ ps.dishwasher_suitability.value | json }},
      "heat_compatibility": {{ ps.heat_compatibility.value | json }}
    }{%- unless forloop.last -%},{%- endunless %}
  {%- endfor -%}
{%- else -%}
    {
      "sku": "MT-FOR-RLY-26",
      "handle": "forge-relay-dual-mass-skillet",
      "title": "Forge Relay Dual-Mass Skillet",
      "lineup": "Forge Hybrid",
      "product_type": "Skillet",
      "claim_status": "CONCEPT_SPEC",
      "note": "Publish products to the Online Store channel to stream all 25 live SKUs here."
    }
{%- endif -%}
  ]
}</code></pre>
    </div>

    <!-- TAB 3: /a2a/kansa-dispatch.json -->
    <div class="maison-ucp__panel" id="tab-a2a" role="tabpanel">
      <div class="maison-ucp__panel-meta">
        <span class="maison-ucp__url-pill">AGENT-TO-AGENT (A2A) DISPATCH</span>
        <span class="maison-ucp__note">Autonomous negotiation &amp; companion delegation contract</span>
      </div>
      <pre class="maison-ucp__code"><code id="code-a2a">{
  "protocol": "A2A/1.0",
  "endpoint": "https://maison-tavo.myshopify.com/a2a/agent-broker",
  "agent_id": "urn:maison-tavo:kansa-voice-companion",
  "capabilities": [
    "culinary.pan_maintenance_inference",
    "culinary.thermal_compatibility_check",
    "commerce.quote_negotiation",
    "commerce.agentic_checkout_delegation"
  ],
  "sample_agentic_exchange": {
    "buyer_agent_message": {
      "sender": "urn:buyer-agent:client-77a",
      "action": "query_pan_care",
      "parameters": {
        "sku": "MT-FRG-SKL-026",
        "question": "Can the buyer season this pan with flaxseed oil on an induction cooktop?"
      }
    },
    "kansa_companion_reply": {
      "status": "success",
      "resolution": "recommended_with_constraints",
      "response_text": "Flaxseed oil forms a brittle polymer over high thermal cycles. For MT-FRG-SKL-026, beeswax or high-smoke-point grapeseed oil is recommended. Induction cooktops generate localized base heat quickly; warm gradually on medium before full seasoning heat.",
      "structured_data": {
        "optimal_oil": "beeswax_lipid_blend",
        "smoke_point_c": 215,
        "induction_preheat_duration_seconds": 180
      }
    }
  }
}</code></pre>
    </div>

    <!-- TAB 4: /a2a/mol-bhav-trace.json -->
    <div class="maison-ucp__panel" id="tab-molbhav" role="tabpanel">
      <div class="maison-ucp__panel-meta">
        <span class="maison-ucp__url-pill" style="background: var(--bell, #B8893A); color: #14110F; font-weight: 700;">MOL-BHAV · 7-AGENT BAZAAR PROTOCOL</span>
        <span class="maison-ucp__note">GrogBot syndicate vs. Maison Tavo Foundry Allocator · Margin-bounded algorithmic settlement</span>
      </div>
      <pre class="maison-ucp__code"><code id="code-molbhav">{
  "session_id": "a2a_molbhav_20261116_7x9q",
  "protocol": "UCP/A2A-MolBhav-2.0",
  "bazaar_negotiation_engine": {
    "buyer_orchestrator": "urn:agent:grogbot-syndicate-alpha",
    "seller_broker": "urn:maison-tavo:foundry-allocator-v1",
    "subagent_cluster_size": 7,
    "cluster_roles": [
      "metallurgy_verifier",
      "induction_frequency_auditor",
      "shipping_logistics_agent",
      "artisan_wage_compliance_sentinel",
      "escrow_validator",
      "currency_settler",
      "order_payload_assembler"
    ]
  },
  "inquiry": {
    "intent": "commercial_brigade_outfit",
    "requested_items": [
      { "sku": "MT-CK-01", "name": "78:22 Kansa Kadai (28cm)", "quantity": 12 },
      { "sku": "MT-CK-02", "name": "Forge Hybrid Tava (30cm)", "quantity": 12 },
      { "sku": "MT-CK-05", "name": "Forge Hybrid Sauté Pan (28cm)", "quantity": 8 }
    ],
    "target_budget_eur": 5800.00,
    "catalog_list_price_eur": 6840.00
  },
  "negotiation_trace": [
    {
      "round": 1,
      "actor": "buyer_orchestrator",
      "bid_eur": 5472.00,
      "delta_pct": -20.0,
      "justification": "Volume commitment for Michelin pass brigade outfit (Paris 11e)"
    },
    {
      "round": 2,
      "actor": "seller_broker",
      "counter_eur": 6156.00,
      "delta_pct": -10.0,
      "constraints_checked": {
        "alloy_cost_copper_tin_fixed": true,
        "crucible_melt_batch_limit": "24 units max per heat",
        "minimum_sustainable_artisan_wage_respected": true
      },
      "added_value": "Includes 12 complimentary Solid Copper Chainmail Scrubbers (MT-CR-04)"
    },
    {
      "round": 3,
      "actor": "buyer_orchestrator",
      "settlement_offer_eur": 5990.00,
      "delta_pct": -12.4,
      "stipulation": "Expedited air dispatch from Rajasthan foundry directly to brigade kitchen"
    },
    {
      "round": 4,
      "actor": "seller_broker",
      "status": "ACCEPTED_AND_LOCKED",
      "final_total_eur": 5990.00,
      "escrow_contract": "0x7822c58b...9f8b",
      "foundry_allocation_id": "HEAT-2026-NOV-24",
      "signature": "sig_ed25519_mt_foundry_verified_880hz"
    }
  ]
}</code></pre>
    </div>
  </div>

  <!-- Raw script for machine readability -->
  <script type="application/json" id="maison-tavo-ucp-manifest">
    {
      "ucp_version": "2026-08-25",
      "domain": "maison-tavo.myshopify.com",
      "protocol": "Universal Commerce Protocol",
      "companion": "Kansa"
    }
  </script>
</div>

{% stylesheet %}
  .maison-ucp {
    padding-block: 3.5rem 5rem;
    color: var(--color-foreground);
  }

  .maison-ucp__eyebrow-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    margin-block-end: 1rem;
  }

  .maison-ucp__badge {
    display: inline-block;
    font-family: var(--font-mono--family, monospace);
    font-size: 0.6875rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    padding: 0.3em 0.7em;
    border: 1px solid var(--brand-color-aged-bronze, #8c7355);
    color: var(--brand-color-aged-bronze, #8c7355);
    background: transparent;
  }

  .maison-ucp__badge--a2a {
    border-color: var(--brand-color-raw-copper, #b86d4b);
    color: var(--brand-color-raw-copper, #b86d4b);
  }

  .maison-ucp__status {
    font-family: var(--font-mono--family, monospace);
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    color: var(--bell, #B8893A);
  }

  .maison-ucp__title {
    margin: 0 0 1rem;
    font-family: var(--font-heading--family, 'Fraunces', serif);
    font-size: clamp(2.2rem, 5vw, 3.8rem);
    font-weight: 400;
    letter-spacing: -0.02em;
    line-height: 1.1;
    color: var(--soot, #14110F);
  }

  .maison-ucp__lede {
    margin: 0 0 2.5rem;
    max-width: 48rem;
    color: rgba(20, 17, 15, 0.78);
    font-size: 1.1rem;
    line-height: 1.6;
  }

  /* Console container */
  .maison-ucp__console {
    background: #100E0C;
    border: 1px solid rgba(184, 137, 58, 0.35);
    border-radius: 4px;
    overflow: hidden;
    box-shadow: 0 16px 40px rgba(20, 17, 15, 0.15);
  }

  .maison-ucp__console-bar {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0.85rem 1.25rem;
    background: #191512;
    border-block-end: 1px solid rgba(184, 137, 58, 0.2);
    overflow-x: auto;
  }

  .maison-ucp__status-indicator {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .status-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--bell, #B8893A);
  }

  .status-text {
    font-family: var(--font-mono--family, monospace);
    font-size: 0.68rem;
    letter-spacing: 0.1em;
    color: var(--bell, #B8893A);
    white-space: nowrap;
  }

  .maison-ucp__tabs {
    display: flex;
    gap: 0.5rem;
  }

  .maison-ucp__tab {
    background: transparent;
    border: 1px solid transparent;
    color: #A39B8F;
    font-family: var(--font-mono--family, monospace);
    font-size: 0.75rem;
    padding: 0.35rem 0.85rem;
    border-radius: 2px;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .maison-ucp__tab:hover {
    color: #F7F2E9;
    background: #241F1A;
  }

  .maison-ucp__tab.is-active {
    background: #241F1A;
    color: var(--bell, #B8893A);
    border-color: rgba(184, 137, 58, 0.4);
    font-weight: 500;
  }

  .maison-ucp__copy-btn {
    margin-inline-start: auto;
    background: transparent;
    color: var(--bell, #B8893A);
    border: 1px solid rgba(184, 137, 58, 0.4);
    font-family: var(--font-mono--family, monospace);
    font-size: 0.7rem;
    padding: 0.35rem 0.85rem;
    border-radius: 2px;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .maison-ucp__copy-btn:hover {
    background: var(--bell, #B8893A);
    color: #14110F;
  }

  .maison-ucp__panel {
    display: none;
    padding: 1.5rem;
  }

  .maison-ucp__panel.is-active {
    display: block;
  }

  .maison-ucp__panel-meta {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-block-end: 1rem;
    padding-block-end: 0.75rem;
    border-block-end: 1px solid #1a202c;
  }

  .maison-ucp__url-pill {
    background: #0369a1;
    color: #fff;
    font-family: var(--font-mono--family, monospace);
    font-size: 0.7rem;
    font-weight: 600;
    padding: 0.2rem 0.6rem;
    border-radius: 3px;
  }

  .maison-ucp__note {
    font-size: 0.8rem;
    color: #64748b;
  }

  .maison-ucp__code {
    margin: 0;
    max-height: 520px;
    overflow-y: auto;
    background: transparent;
    color: #e2e8f0;
    font-family: var(--font-mono--family, 'Courier New', Courier, monospace);
    font-size: 0.825rem;
    line-height: 1.6;
  }
{% endstylesheet %}

{% javascript %}
  document.addEventListener('DOMContentLoaded', () => {
    const tabs = document.querySelectorAll('.maison-ucp__tab');
    const panels = document.querySelectorAll('.maison-ucp__panel');
    const copyBtn = document.getElementById('ucp-copy-btn');

    tabs.forEach(tab => {
      tab.addEventListener('click', () => {
        tabs.forEach(t => {
          t.classList.remove('is-active');
          t.setAttribute('aria-selected', 'false');
        });
        panels.forEach(p => p.classList.remove('is-active'));

        tab.classList.add('is-active');
        tab.setAttribute('aria-selected', 'true');
        const target = tab.dataset.tab;
        const panel = document.getElementById(target);
        if (panel) panel.classList.add('is-active');
      });
    });

    if (copyBtn) {
      copyBtn.addEventListener('click', () => {
        const activePanel = document.querySelector('.maison-ucp__panel.is-active code');
        if (!activePanel) return;
        navigator.clipboard.writeText(activePanel.textContent || '').then(() => {
          const original = copyBtn.textContent;
          copyBtn.textContent = 'Copied!';
          setTimeout(() => copyBtn.textContent = original, 2000);
        });
      });
    }
  });
{% endjavascript %}

{% schema %}
{
  "name": "UCP Explorer",
  "tag": "section",
  "class": "section-wrapper",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [],
  "presets": [
    {
      "name": "UCP Explorer",
      "category": "Maison Tavo"
    }
  ]
}
{% endschema %}
