{% liquid
  if section.settings.background_color != blank
    render 'contrast-override', background_color: section.settings.background_color, section_id: section.id
  endif

  assign heading = section.settings.heading
  if heading == blank
    assign heading = 'Page not found'
  endif

  assign body = section.settings.body
  if body == blank
    capture body
      echo 'The link may be incorrect, or the page has moved. Search the atelier below, or start again from a known room.'
    endcapture
  endif
%}

<div
  class="section-background{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
></div>

{% render 'maison-breadcrumbs' %}

<div
  class="section section--page-width maison-404{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
  style="{% render 'spacing-style', settings: section.settings %}"
>
  <div class="maison-404__inner">
    <p class="maison-404__code" aria-hidden="true">404</p>

    <header class="maison-404__header">
      <p class="maison-404__eyebrow">Maison Tavo · Foundry Dispatch</p>
      <h1 class="maison-404__title">{{ heading | escape }}</h1>
      <p class="maison-404__body" id="Maison404Body">{{ body | escape }}</p>
    </header>

    <form
      class="maison-404__search"
      action="{{ routes.search_url }}"
      method="get"
      role="search"
      aria-describedby="Maison404Body"
    >
      <label class="visually-hidden" for="Maison404Search">
        Search products, pages, and journal entries
      </label>
      <input
        class="maison-404__input"
        id="Maison404Search"
        type="search"
        name="q"
        placeholder="Search the atelier"
        autocomplete="off"
        spellcheck="false"
      >
      <input type="hidden" name="options[prefix]" value="last">
      <button class="button maison-404__submit" type="submit">
        Search
      </button>
    </form>

    <nav class="maison-404__routes" aria-label="Suggested destinations">
      <ul class="maison-404__route-list">
        <li><a href="{{ routes.root_url }}">Home</a></li>
        <li><a href="{{ routes.all_products_collection_url }}">Shop all</a></li>
        <li><a href="{{ routes.collections_url }}">Collections</a></li>
        <li><a href="{{ blogs.journal.url | default: '/blogs/journal' }}">Journal</a></li>
        <li><a href="{{ pages.contact.url | default: '/pages/contact' }}">Contact</a></li>
        <li><a href="{{ pages['ask-ai'].url | default: '/pages/ask-ai' }}">Ask the atelier</a></li>
      </ul>
    </nav>

    {%- if collections.size > 0 -%}
      <section class="maison-404__rooms" aria-labelledby="Maison404Rooms">
        <h2 class="maison-404__rooms-title" id="Maison404Rooms">Browse a room</h2>
        <ul class="maison-404__room-list">
          {%- for room in collections limit: 4 -%}
            <li>
              <a class="maison-404__room" href="{{ room.url }}">
                <span class="maison-404__room-name">{{ room.title }}</span>
                {%- if room.description != blank -%}
                  <span class="maison-404__room-meta">
                    {{- room.description | strip_html | truncate: 80 -}}
                  </span>
                {%- endif -%}
              </a>
            </li>
          {%- endfor -%}
        </ul>
      </section>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="maison-404__blocks">
        {%- content_for 'blocks' -%}
      </div>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .maison-404 {
    display: block;
  }

  .maison-404__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--gap-2xl, 2rem);
    max-width: 44rem;
    margin-inline: auto;
    padding-block: 0;
    text-align: center;
  }

  .maison-404__code {
    margin: 0;
    font-family: var(--font-mono--family, monospace);
    font-size: clamp(4rem, 12vw, 8rem);
    line-height: 0.85;
    letter-spacing: 0.04em;
    color: rgb(var(--color-foreground-rgb) / 0.12);
  }

  .maison-404__eyebrow {
    margin: 0 0 var(--margin-sm, 0.75rem);
    font-family: var(--font-mono--family, monospace);
    font-size: var(--font-size--body-xs, 0.75rem);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-foreground);
  }

  .maison-404__title {
    margin: 0 0 var(--margin-md, 1rem);
    font-family: var(--font-heading--family, serif);
    font-size: var(--font-size--h2, 2rem);
    line-height: 1.1;
    text-wrap: pretty;
  }

  .maison-404__body {
    margin: 0;
    font-size: var(--font-size--body-md, 1rem);
    line-height: 1.6;
    text-wrap: pretty;
  }

  .maison-404__search {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    justify-content: center;
    width: 100%;
    max-width: 34rem;
  }

  .maison-404__input {
    flex: 1 1 14rem;
    min-width: 0;
    padding: 0.75rem 1rem;
    font: inherit;
    color: var(--color-foreground);
    background-color: var(--color-background);
    border: 1px solid rgb(var(--color-foreground-rgb) / 0.35);
    border-radius: var(--border-radius-sm, 0.25rem);
  }

  .maison-404__input:focus-visible {
    outline: var(--focus-outline-width, 2px) solid var(--color-foreground);
    outline-offset: var(--focus-outline-offset, 2px);
  }

  .maison-404__routes {
    width: 100%;
  }

  .maison-404__route-list {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem 1.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
    font-family: var(--font-mono--family, monospace);
    font-size: var(--font-size--body-xs, 0.75rem);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .maison-404__route-list a {
    color: inherit;
    text-decoration: none;
    border-bottom: 1px solid transparent;
  }

  .maison-404__route-list a:hover,
  .maison-404__route-list a:focus-visible {
    border-bottom-color: currentColor;
  }

  .maison-404__rooms {
    width: 100%;
    padding-top: var(--padding-2xl, 2rem);
    border-top: 1px solid rgb(var(--color-foreground-rgb) / 0.15);
  }

  .maison-404__rooms-title {
    margin: 0 0 var(--margin-md, 1rem);
    font-family: var(--font-mono--family, monospace);
    font-size: var(--font-size--body-xs, 0.75rem);
    font-weight: 400;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgb(var(--color-foreground-rgb) / 0.7);
  }

  .maison-404__room-list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr));
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .maison-404__room {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: 0.75rem;
    color: inherit;
    text-decoration: none;
    border: 1px solid rgb(var(--color-foreground-rgb) / 0.2);
    border-radius: var(--border-radius-sm, 0.25rem);
  }

  .maison-404__room:hover,
  .maison-404__room:focus-visible {
    border-color: currentColor;
  }

  .maison-404__room-name {
    font-family: var(--font-heading--family, serif);
    font-size: var(--font-size--body-md, 1rem);
  }

  .maison-404__room-meta {
    font-size: var(--font-size--body-xs, 0.75rem);
    line-height: 1.4;
    color: rgb(var(--color-foreground-rgb) / 0.7);
  }

  .maison-404__blocks {
    width: 100%;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.404",
  "class": "section-wrapper",
  "blocks": [
    {
      "type": "@theme"
    },
    {
      "type": "@app"
    }
  ],
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Page not found"
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "Body",
      "default": "The link may be incorrect, or the page has moved. Search the atelier below, or start again from a known room."
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 96
    }
  ]
}
{% endschema %}
