{% comment %}Full Round Room: lazy React/Three island bundled as maison-vessel.js.{% endcomment %}
{{ 'maison-round-room.css' | asset_url | stylesheet_tag }}
{% liquid
  assign initial_series = 'forge'
  assign initial_key = product.handle | append: ' ' | append: product.title | append: ' ' | append: collection.handle | append: ' ' | append: collection.title | downcase
  if initial_key contains 'chulha' or initial_key contains 'matka' or initial_key contains 'handi'
    assign initial_series = 'matka'
  endif
%}
<div class="maison-round-room" data-mt-vessel data-maison-round-room data-initial-series="{{ initial_series }}" data-initial-product="{{ product.handle | escape }}" data-product-handle="{{ product.handle | escape }}">
  <div data-round-room-mount></div>
  <figure data-round-room-fallback data-mt-fallback>
    {% if product.featured_image != blank %}
      {{ product.featured_image | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '600, 900, 1200', sizes: '100vw' }}
    {% else %}
      <img src="{{ 'maison-concept-tavo-collection.webp' | asset_url }}" alt="Cookware material study" width="1600" height="1600" loading="lazy">
    {% endif %}
    <figcaption>Explore Forge and Chulha in the round. Rotate the piece, inspect its layers, and switch on the illustrative heat map.</figcaption>
  </figure>
  <script type="application/json" data-round-room-products>
    [
    {% assign range_handles = 'forge,chulha' | split: ',' %}
    {% assign product_count = 0 %}
    {% for range_handle in range_handles %}
      {% for piece in collections[range_handle].products limit: 50 %}
        {% liquid
          assign model = 'skillet'
          assign name = piece.handle | append: ' ' | append: piece.title | downcase
          if name contains 'tawa'
            assign model = 'tawa'
          elsif name contains 'kadhai' or name contains 'kadai' or name contains 'wok'
            assign model = 'wok'
          elsif name contains 'handi'
            assign model = 'handi'
          elsif name contains 'pressure'
            assign model = 'pressure'
          elsif name contains 'chai'
            assign model = 'chai'
          elsif name contains 'stockpot'
            assign model = 'stockpot'
          elsif name contains 'saucier'
            assign model = 'saucier'
          elsif name contains 'saucepan'
            assign model = 'saucepan'
          elsif name contains 'saute'
            assign model = 'sauteuse'
          elsif name contains 'cocotte'
            assign model = 'cocotte'
          elsif name contains 'rondeau' or name contains 'roaster'
            assign model = 'rondeau'
          elsif name contains 'grill' or name contains 'plancha'
            assign model = 'grill'
          elsif name contains 'lid'
            assign model = 'lid'
          elsif name contains 'set'
            assign model = 'collection'
          elsif name contains 'matka'
            assign model = 'matka'
          endif
          assign series = 'forge'
          if range_handle == 'chulha'
            assign series = 'matka'
          endif
        %}
        {% if product_count > 0 %},{% endif %}
        {"handle":{{ piece.handle | json }},"title":{{ piece.title | json }},"url":{{ piece.url | json }},"series":{{ series | json }},"model":{{ model | json }}}
        {% assign product_count = product_count | plus: 1 %}
      {% endfor %}
    {% endfor %}
    ]
  </script>
</div>

{% schema %}
{
  "name": "t:names.maison_vessel",
  "tag": "section",
  "class": "section-wrapper",
  "enabled_on": {
    "templates": ["product", "page", "index", "collection"]
  },
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:settings.maison_eyebrow",
      "default": "Material study"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:settings.heading",
      "default": "Turn the metal"
    },
    {
      "type": "textarea",
      "id": "lede",
      "label": "Introduction",
      "default": "A study of mass and finish. Size, colour, and stock stay in the product form above â€” nothing here changes what you add to the bag."
    },
    {
      "type": "text",
      "id": "bronze_label",
      "label": "Bronze label",
      "default": "Bell bronze"
    },
    {
      "type": "text",
      "id": "clay_label",
      "label": "Clay label",
      "default": "Cast clay"
    },
    {
      "type": "text",
      "id": "soot_label",
      "label": "Soot label",
      "default": "Forged soot"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 64
    }
  ],
  "presets": [
    {
      "name": "t:names.maison_vessel",
      "category": "t:categories.product"
    }
  ]
}
{% endschema %}
