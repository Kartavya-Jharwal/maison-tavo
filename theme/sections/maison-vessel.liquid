{% comment %}
  Spatial material study. React Three Fiber mounts into the canvas from
  assets/maison-vessel.js. It does not select a variant or add to the bag.
{% endcomment %}

<div
  class="section section--page-width spacing-style maison-vessel"
  style="{% render 'spacing-style', settings: section.settings %}"
  data-mt-vessel
  data-finish="bronze"
  data-finish-group="mt-finish-{{ section.id }}"
>
  <div class="maison-vessel__layout" data-mt-scroll="chapter">
    <div class="maison-vessel__copy">
      {% if section.settings.eyebrow != blank %}
        <p class="maison-vessel__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {% endif %}
      <h2 class="maison-vessel__title">{{ section.settings.heading | escape }}</h2>
      {% if section.settings.lede != blank %}
        <p class="maison-vessel__lede">{{ section.settings.lede | escape }}</p>
      {% endif %}
    </div>

    <div
      class="maison-vessel__stage"
      data-finish="bronze"
      role="group"
      aria-label="{{ section.settings.heading | escape }}"
      aria-describedby="MaisonVesselHint-{{ section.id }}"
    >
      <div class="maison-vessel__canvas" data-mt-canvas></div>
      <p class="maison-vessel__fallback" data-mt-fallback hidden>
        This browser cannot draw the study. The finishes below still describe the metal.
      </p>

      <fieldset class="maison-vessel__finishes">
        <legend class="visually-hidden">Finish</legend>
        <label class="maison-vessel__finish">
          <input type="radio" name="mt-finish-{{ section.id }}" value="bronze" checked>
          <span>{{ section.settings.bronze_label | escape }}</span>
        </label>
        <label class="maison-vessel__finish">
          <input type="radio" name="mt-finish-{{ section.id }}" value="clay">
          <span>{{ section.settings.clay_label | escape }}</span>
        </label>
        <label class="maison-vessel__finish">
          <input type="radio" name="mt-finish-{{ section.id }}" value="soot">
          <span>{{ section.settings.soot_label | escape }}</span>
        </label>
      </fieldset>

      <div class="maison-vessel__controls">
        <button type="button" data-mt-turn="-1">Turn left</button>
        <button type="button" data-mt-turn="1">Turn right</button>
        <button type="button" data-mt-dolly="-1">Closer</button>
        <button type="button" data-mt-dolly="1">Further</button>
      </div>
      <p class="maison-vessel__hint" id="MaisonVesselHint-{{ section.id }}">
        Drag to turn the vessel. Pinch, or use the buttons, to come closer. This study does not change the piece selected above.
      </p>
      <p class="visually-hidden" data-mt-finish-status aria-live="polite"></p>
    </div>
  </div>
</div>

{% stylesheet %}
  .maison-vessel__layout {
    display: grid;
    gap: 2rem;
  }

  .maison-vessel__eyebrow {
    margin: 0 0 0.5rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    font-size: var(--mt-type-mono);
  }

  .maison-vessel__title,
  .maison-vessel__lede {
    margin: 0;
  }

  .maison-vessel__lede {
    margin-top: 0.85rem;
    max-width: 36rem;
  }

  .maison-vessel__stage {
    display: grid;
    gap: 0.85rem;
  }

  .maison-vessel__canvas {
    position: relative;
    height: min(68vh, 36rem);
    min-height: 22rem;
    background:
      radial-gradient(ellipse at center 72%, rgb(197 139 67 / 0.2), transparent 58%),
      #191613;
  }

  .maison-vessel__canvas canvas {
    display: block;
    width: 100%;
    height: 100%;
    touch-action: none;
  }

  .maison-vessel__fallback {
    margin: 0;
  }

  .maison-vessel__finishes {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    border: 0;
  }

  .maison-vessel__finish {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.45rem 0.75rem;
    border: 1px solid rgb(var(--color-foreground-rgb) / 0.28);
    cursor: pointer;
  }

  .maison-vessel__finish:has(:checked) {
    border-color: #c58b43;
  }

  .maison-vessel__finish input {
    accent-color: #c58b43;
  }

  .maison-vessel__controls {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .maison-vessel__controls button,
  .maison-vessel__finish {
    background: transparent;
    color: inherit;
    font: inherit;
  }

  .maison-vessel__controls button {
    padding: 0.45rem 0.75rem;
    border: 1px solid rgb(var(--color-foreground-rgb) / 0.28);
    cursor: pointer;
  }

  .maison-vessel__finish:focus-within,
  .maison-vessel__controls button:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 3px;
  }

  .maison-vessel__hint {
    margin: 0;
    max-width: 40rem;
    font-size: var(--mt-type-nav);
  }

  @media (min-width: 990px) {
    .maison-vessel__layout {
      grid-template-columns: minmax(16rem, 0.72fr) 1.28fr;
      align-items: end;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.maison_vessel",
  "tag": "section",
  "class": "section-wrapper",
  "enabled_on": {
    "templates": ["product"]
  },
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:settings.maison_eyebrow",
      "default": "Material study"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:settings.heading",
      "default": "Turn the metal"
    },
    {
      "type": "textarea",
      "id": "lede",
      "label": "Introduction",
      "default": "A study of mass and finish. Size, colour, and stock stay in the product form above — nothing here changes what you add to the bag."
    },
    {
      "type": "text",
      "id": "bronze_label",
      "label": "Bronze label",
      "default": "Bell bronze"
    },
    {
      "type": "text",
      "id": "clay_label",
      "label": "Clay label",
      "default": "Cast clay"
    },
    {
      "type": "text",
      "id": "soot_label",
      "label": "Soot label",
      "default": "Forged soot"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 64
    }
  ],
  "presets": [
    {
      "name": "t:names.maison_vessel",
      "category": "t:categories.product"
    }
  ]
}
{% endschema %}
