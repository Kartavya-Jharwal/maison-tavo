{
  "$schema": "./brand.schema.json",
  "meta": {
    "name": "Maison Tavo",
    "theme": "Horizon 4.2.0",
    "snapshot": "Current storefront: white/black palette, Inter, narrow page width. Not an invented identity.",
    "layers": ["primitive", "semantic", "component"],
    "howto": "Replace this file with a client bible, copy values into Theme settings (brand_tokens plus Colors / Typography / Page layout), then leave sections untouched. Sections consume CSS variables, not this JSON."
  },
  "color": {
    "primitive": {
      "white": {
        "value": "#ffffff",
        "css": ["--brand-color-white", "--color-white"],
        "setting": "brand_color_white"
      },
      "black": {
        "value": "#000000",
        "css": ["--brand-color-black"],
        "setting": "brand_color_black"
      },
      "accent": {
        "value": "#333333",
        "css": ["--brand-color-accent"],
        "setting": "brand_color_accent",
        "note": "Matches color_palette.color1 on this snapshot"
      },
      "muted": {
        "value": "#DFDFDF",
        "css": ["--brand-color-muted"],
        "setting": "brand_color_muted",
        "note": "Matches color_palette.color2 on this snapshot"
      },
      "error": {
        "value": "#8B0000",
        "css": ["--brand-color-error", "--color-error"],
        "setting": "brand_color_error"
      },
      "success": {
        "value": "#006400",
        "css": ["--brand-color-success", "--color-success"],
        "setting": "brand_color_success"
      },
      "instock": {
        "value": "#3ED660",
        "css": ["--color-instock"],
        "setting": "brand_color_instock"
      },
      "lowstock": {
        "value": "#EE9441",
        "css": ["--color-lowstock"],
        "setting": "brand_color_lowstock"
      },
      "outofstock": {
        "value": "#C8C8C8",
        "css": ["--color-outofstock"],
        "setting": "brand_color_outofstock"
      }
    },
    "semantic": {
      "canvas": {
        "value": "{color.primitive.white}",
        "css": ["--brand-color-canvas", "--color-background"],
        "setting": "page_background_color",
        "note": "Merchant semantic color lives in Page layout, not brand_tokens"
      },
      "ink": {
        "value": "{color.primitive.black}",
        "css": ["--brand-color-ink", "--color-foreground"],
        "setting": "page_text_color",
        "note": "Merchant semantic color lives in Typography / Colors"
      },
      "border": {
        "value": "{color.semantic.ink}",
        "css": ["--brand-color-border", "--color-border"]
      },
      "inverse-canvas": {
        "value": "{color.primitive.black}",
        "css": ["--brand-color-inverse-canvas"]
      },
      "inverse-ink": {
        "value": "{color.primitive.white}",
        "css": ["--brand-color-inverse-ink"]
      }
    }
  },
  "typography": {
    "families": {
      "body": {
        "value": "Inter",
        "css": ["--brand-font-body", "--font-body--family"],
        "setting": "type_body_font",
        "note": "Current snapshot. Schema default remains Work Sans until the merchant font picker changes."
      },
      "subheading": {
        "value": "Inter",
        "css": ["--brand-font-subheading", "--font-subheading--family"],
        "setting": "type_subheading_font"
      },
      "heading": {
        "value": "Inter",
        "css": ["--brand-font-heading", "--font-heading--family"],
        "setting": "type_heading_font"
      },
      "accent": {
        "value": "Inter",
        "css": ["--brand-font-accent", "--font-accent--family"],
        "setting": "type_accent_font"
      }
    },
    "letterSpacing": {
      "sm": {
        "value": "0.06em",
        "css": ["--brand-letter-spacing-sm", "--letter-spacing-sm"],
        "setting": "brand_letter_spacing_sm"
      }
    },
    "lineHeight": {
      "body": {
        "value": "1.4",
        "css": ["--brand-line-height-body", "--line-height--body-normal"],
        "setting": "brand_line_height_body"
      },
      "heading": {
        "value": "1.25",
        "css": ["--brand-line-height-heading", "--line-height--heading-normal"],
        "setting": "brand_line_height_heading"
      }
    }
  },
  "spacing": {
    "3xs": { "value": "0.125rem", "css": ["--brand-space-3xs", "--padding-3xs", "--margin-3xs", "--gap-3xs"], "setting": "brand_space_3xs" },
    "2xs": { "value": "0.25rem", "css": ["--brand-space-2xs", "--padding-2xs"], "setting": "brand_space_2xs", "note": "Horizon margin/gap 2xs was 0.3rem; brand scale uses padding 2xs (0.25rem) as the primitive" },
    "xs": { "value": "0.5rem", "css": ["--brand-space-xs", "--padding-xs", "--margin-xs", "--gap-xs"], "setting": "brand_space_xs" },
    "sm": { "value": "0.7rem", "css": ["--brand-space-sm", "--padding-sm", "--margin-sm", "--gap-sm"], "setting": "brand_space_sm" },
    "md": { "value": "0.8rem", "css": ["--brand-space-md", "--padding-md", "--margin-md"], "setting": "brand_space_md" },
    "lg": { "value": "1rem", "css": ["--brand-space-lg", "--padding-lg", "--margin-lg", "--gap-lg"], "setting": "brand_space_lg" },
    "xl": { "value": "1.25rem", "css": ["--brand-space-xl", "--padding-xl", "--margin-xl", "--gap-xl"], "setting": "brand_space_xl" },
    "2xl": { "value": "1.5rem", "css": ["--brand-space-2xl", "--padding-2xl", "--margin-2xl"], "setting": "brand_space_2xl" },
    "3xl": { "value": "1.75rem", "css": ["--brand-space-3xl", "--padding-3xl"], "setting": "brand_space_3xl" },
    "4xl": { "value": "2rem", "css": ["--brand-space-4xl", "--padding-4xl", "--margin-4xl", "--gap-2xl"], "setting": "brand_space_4xl" },
    "5xl": { "value": "3rem", "css": ["--brand-space-5xl", "--padding-5xl", "--gap-3xl"], "setting": "brand_space_5xl" },
    "6xl": { "value": "4rem", "css": ["--brand-space-6xl", "--padding-6xl"], "setting": "brand_space_6xl" }
  },
  "radius": {
    "xs": { "value": "0.2rem", "css": ["--brand-radius-xs", "--style-border-radius-xs"], "setting": "brand_radius_xs" },
    "sm": { "value": "0.6rem", "css": ["--brand-radius-sm", "--style-border-radius-sm"], "setting": "brand_radius_sm" },
    "md": { "value": "0.8rem", "css": ["--brand-radius-md", "--style-border-radius-md"], "setting": "brand_radius_md" },
    "lg": { "value": "1rem", "css": ["--brand-radius-lg", "--style-border-radius-lg"], "setting": "brand_radius_lg" },
    "pill": { "value": "50%", "css": ["--brand-radius-pill", "--style-border-radius-50"], "setting": "brand_radius_pill" }
  },
  "shadow": {
    "sm": { "value": "0 2px 3px rgb(0 0 0 / 20%)", "css": ["--brand-shadow-sm", "--shadow-button"], "setting": "brand_shadow_sm" },
    "md": { "value": "0px 4px 20px rgb(0 0 0 / 15%)", "css": ["--brand-shadow-md", "--shadow-drawer", "--shadow-popover"], "setting": "brand_shadow_md" },
    "lg": { "value": "0px 8px 32px rgb(0 0 0 / 20%)", "css": ["--brand-shadow-lg"], "setting": "brand_shadow_lg" }
  },
  "motion": {
    "fast": { "value": "0.0625s", "css": ["--brand-motion-fast", "--animation-speed-fast"], "setting": "brand_motion_fast" },
    "base": { "value": "0.125s", "css": ["--brand-motion-base", "--animation-speed"], "setting": "brand_motion_base" },
    "medium": { "value": "0.15s", "css": ["--brand-motion-medium", "--animation-speed-medium"], "setting": "brand_motion_medium" },
    "slow": { "value": "0.2s", "css": ["--brand-motion-slow", "--animation-speed-slow", "--drawer-animation-speed"], "setting": "brand_motion_slow" },
    "easing": { "value": "ease-in-out", "css": ["--brand-motion-easing", "--animation-easing"], "setting": "brand_motion_easing" }
  },
  "zIndex": {
    "section-background": { "value": -2, "css": ["--layer-section-background"], "setting": "brand_z_section_background" },
    "lowest": { "value": -1, "css": ["--layer-lowest"], "setting": "brand_z_lowest" },
    "base": { "value": 0, "css": ["--brand-z-base", "--layer-base"], "setting": "brand_z_base" },
    "flat": { "value": 1, "css": ["--layer-flat"], "setting": "brand_z_flat" },
    "raised": { "value": 2, "css": ["--layer-raised"], "setting": "brand_z_raised" },
    "heightened": { "value": 4, "css": ["--layer-heightened"], "setting": "brand_z_heightened" },
    "sticky": { "value": 8, "css": ["--brand-z-sticky", "--layer-sticky"], "setting": "brand_z_sticky" },
    "window-overlay": { "value": 10, "css": ["--layer-window-overlay"], "setting": "brand_z_window_overlay" },
    "header-menu": { "value": 12, "css": ["--layer-header-menu"], "setting": "brand_z_header_menu" },
    "overlay": { "value": 16, "css": ["--brand-z-overlay", "--layer-overlay"], "setting": "brand_z_overlay" },
    "menu-drawer": { "value": 18, "css": ["--layer-menu-drawer"], "setting": "brand_z_menu_drawer" },
    "temporary": { "value": 20, "css": ["--brand-z-temporary", "--layer-temporary"], "setting": "brand_z_temporary" },
    "splash": { "value": 30, "css": ["--brand-z-splash", "--layer-splash"], "setting": "brand_z_splash" }
  },
  "breakpoints": {
    "sm": { "value": "40em", "css": ["--brand-breakpoint-sm"], "setting": "brand_breakpoint_sm", "note": "Custom properties are not used inside @media in current Horizon CSS; emitted for JS and new CSS." },
    "md": { "value": "60em", "css": ["--brand-breakpoint-md"], "setting": "brand_breakpoint_md" },
    "lg": { "value": "750px", "css": ["--brand-breakpoint-lg"], "setting": "brand_breakpoint_lg" },
    "xl": { "value": "990px", "css": ["--brand-breakpoint-xl"], "setting": "brand_breakpoint_xl" }
  },
  "borders": {
    "width": { "value": "1px", "css": ["--brand-border-width", "--style-border-width", "--border-width-sm"], "setting": "brand_border_width" },
    "radius-utility": { "value": "0.25rem", "css": ["--border-radius-sm"], "setting": "brand_border_radius_utility" }
  },
  "layout": {
    "page-width": {
      "value": "narrow",
      "css": ["--narrow-page-width"],
      "setting": "page_width",
      "note": "Current snapshot. Width scale remains --narrow-page-width: 90rem; --normal-page-width: 120rem; --wide-page-width: 150rem."
    }
  },
  "component": {
    "splash": {
      "background": { "value": "{color.semantic.canvas}", "css": ["--splash-background"] },
      "foreground": { "value": "{color.semantic.ink}", "css": ["--splash-foreground"] },
      "duration": { "value": "2.5s", "css": ["--splash-duration"], "setting": "splash_duration" }
    }
  }
}
