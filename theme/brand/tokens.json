{
  "$schema": "./brand.schema.json",
  "meta": {
    "name": "Maison Tavo",
    "theme": "Horizon 4.2.0",
    "snapshot": "Approved M3 brand: Cast Clay canvas, Obsidian ink, Raw Copper accent, Fraunces headings, Anonymous Pro specs.",
    "layers": ["primitive", "semantic", "component"],
    "howto": "Replace this file with a client bible, copy values into Theme settings (brand_tokens plus Colors / Typography / Page layout), then leave sections untouched. Sections consume CSS variables, not this JSON."
  },
  "color": {
    "primitive": {
      "raw-copper": {
        "value": "#C4784A",
        "css": ["--brand-color-raw-copper"],
        "setting": "brand_color_raw_copper"
      },
      "aged-bronze": {
        "value": "#6E5A3D",
        "css": ["--brand-color-aged-bronze"],
        "setting": "brand_color_aged_bronze"
      },
      "obsidian-charcoal": {
        "value": "#1A1714",
        "css": ["--brand-color-obsidian-charcoal", "--brand-color-black"],
        "setting": "brand_color_obsidian_charcoal"
      },
      "cast-clay": {
        "value": "#E8DFD4",
        "css": ["--brand-color-cast-clay"],
        "setting": "brand_color_cast_clay"
      },
      "damascus-silver": {
        "value": "#9A9B9E",
        "css": ["--brand-color-damascus-silver", "--brand-color-muted"],
        "setting": "brand_color_damascus_silver"
      },
      "white": {
        "value": "#ffffff",
        "css": ["--brand-color-white", "--color-white"],
        "setting": "brand_color_white"
      },
      "black": {
        "value": "#1A1714",
        "css": ["--brand-color-black"],
        "setting": "brand_color_black"
      },
      "accent": {
        "value": "#C4784A",
        "css": ["--brand-color-accent"],
        "setting": "brand_color_accent",
        "note": "Alias of Raw Copper; matches color_palette.color1"
      },
      "muted": {
        "value": "#9A9B9E",
        "css": ["--brand-color-muted"],
        "setting": "brand_color_muted",
        "note": "Alias of Damascus Silver; matches color_palette.color2"
      },
      "error": {
        "value": "#8B0000",
        "css": ["--brand-color-error", "--color-error"],
        "setting": "brand_color_error"
      },
      "success": {
        "value": "#3D5C45",
        "css": ["--brand-color-success", "--color-success"],
        "setting": "brand_color_success"
      },
      "instock": {
        "value": "#3D5C45",
        "css": ["--color-instock"],
        "setting": "brand_color_instock"
      },
      "lowstock": {
        "value": "#C4784A",
        "css": ["--color-lowstock"],
        "setting": "brand_color_lowstock"
      },
      "outofstock": {
        "value": "#9A9B9E",
        "css": ["--color-outofstock"],
        "setting": "brand_color_outofstock"
      }
    },
    "semantic": {
      "canvas": {
        "value": "{color.primitive.cast-clay}",
        "css": ["--brand-color-canvas", "--color-background"],
        "setting": "page_background_color",
        "note": "Mapped via color_palette.background = Cast Clay"
      },
      "ink": {
        "value": "{color.primitive.obsidian-charcoal}",
        "css": ["--brand-color-ink", "--color-foreground"],
        "setting": "page_text_color",
        "note": "Mapped via color_palette.foreground = Obsidian Charcoal"
      },
      "border": {
        "value": "{color.primitive.damascus-silver}",
        "css": ["--brand-color-border", "--color-border"]
      },
      "inverse-canvas": {
        "value": "{color.primitive.obsidian-charcoal}",
        "css": ["--brand-color-inverse-canvas"]
      },
      "inverse-ink": {
        "value": "{color.primitive.white}",
        "css": ["--brand-color-inverse-ink"]
      }
    }
  },
  "typography": {
    "families": {
      "body": {
        "value": "Inter",
        "css": ["--brand-font-body", "--font-body--family"],
        "setting": "type_body_font"
      },
      "subheading": {
        "value": "Inter",
        "css": ["--brand-font-subheading", "--font-subheading--family"],
        "setting": "type_subheading_font"
      },
      "heading": {
        "value": "Fraunces Variable",
        "css": ["--brand-font-heading", "--font-heading--family", "--font-fraunces--family"],
        "setting": "type_heading_font",
        "note": "Self-hosted WOFF2 in fonts.liquid; picker face is remapped to Fraunces in theme-styles-variables"
      },
      "accent": {
        "value": "Anonymous Pro",
        "css": ["--brand-font-accent", "--font-accent--family"],
        "setting": "type_accent_font"
      },
      "mono": {
        "value": "Anonymous Pro",
        "css": ["--brand-font-mono", "--font-mono--family"],
        "setting": "type_accent_font",
        "note": "Industrial mono for metallurgical / PDP spec tables"
      }
    },
    "letterSpacing": {
      "sm": {
        "value": "0.06em",
        "css": ["--brand-letter-spacing-sm", "--letter-spacing-sm"],
        "setting": "brand_letter_spacing_sm"
      }
    },
    "lineHeight": {
      "body": {
        "value": "1.4",
        "css": ["--brand-line-height-body", "--line-height--body-normal"],
        "setting": "brand_line_height_body"
      },
      "heading": {
        "value": "1.25",
        "css": ["--brand-line-height-heading", "--line-height--heading-normal"],
        "setting": "brand_line_height_heading"
      }
    }
  },
  "layout": {
    "page-width": {
      "value": "narrow",
      "css": ["--narrow-page-width"],
      "setting": "page_width"
    }
  },
  "component": {
    "splash": {
      "background": { "value": "{color.semantic.canvas}", "css": ["--splash-background"] },
      "foreground": { "value": "{color.semantic.ink}", "css": ["--splash-foreground"] }
    }
  }
}
